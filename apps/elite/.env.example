# Website forms are submitted to the same-origin Cloudflare Pages Function at /api/form.
# Configure these as Cloudflare Pages Variables and Secrets, not PUBLIC_* browser variables.
# Secrets: ZOHO_REFRESH_TOKEN, ZOHO_CLIENT_ID, ZOHO_CLIENT_SECRET
# Text variables: ZOHO_ACCOUNT_ID, ZOHO_FROM_EMAIL
ZOHO_ACCOUNT_ID=
ZOHO_FROM_EMAIL=info@elitedancestudio.de

# Optional external media origin. Leave blank to keep using files from /public/media.
# Production target: https://media.elitedancestudio.de
PUBLIC_MEDIA_BASE_URL=

# Public media origin used by the TV signage page.
# Temporary test origin; later replace with https://media.elitedancestudio.de/tv
PUBLIC_TV_MEDIA_BASE_URL=https://pub-78965290644946caade1e59ed21bf9ce.r2.dev/tv
