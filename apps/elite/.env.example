# Canonical production origin used for metadata and the sitemap.
PUBLIC_SITE_URL=https://elitedancestudio.de

# Create two form endpoints and add the real values before a production build.
PUBLIC_TRIAL_FORM_ENDPOINT=https://formspree.io/f/replace-with-trial-form-id
PUBLIC_CONTACT_FORM_ENDPOINT=https://formspree.io/f/replace-with-contact-form-id

# Optional external media origin. Leave blank to keep using files from /public/media.
# Production target: https://media.elitedancestudio.de
PUBLIC_MEDIA_BASE_URL=
