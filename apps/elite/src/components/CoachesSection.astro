---
import InstagramIcon from "./InstagramIcon.astro";

interface CoachItem {
  slug: string;
  name: string;
  focus: string;
  text: string;
  schedule?: string;
  image?: string;
  imageAlt?: string;
  beginnerSupport?: string;
  instagramHandle?: string;
  instagramUrl?: string;
}

interface Props {
  coaches: CoachItem[];
  eyebrow?: string;
  title?: string;
  description?: string;
}

const {
  coaches,
  eyebrow = "Coaches",
  title = "Menschen machen aus Kursen ein Studio.",
  description = "Viele melden sich wegen eines Styles an und bleiben wegen Energie, Methodik und Atmosphäre."
} = Astro.props;
---

<section class="coach-grid panel related-coaches-v15 related-coaches-v19" id="coaches">
  <div class="section-head">
    <div>
      <div class="eyebrow">{eyebrow}</div>
      <h2>{title}</h2>
    </div>
    <p>{description}</p>
  </div>
  <div class="coach-cards">
    {coaches.map((coach, index) => (
      <article class:list={["coach", coach.image ? "coach-has-photo" : "coach-text-card", `coach-tone-${(index % 3) + 1}`]}>
        <a class="coach-photo" href={`/coaches/${coach.slug}/`} aria-label={`${coach.name} kennenlernen`}>
          {coach.image ? (
            <img src={coach.image} alt={coach.imageAlt ?? `${coach.name}, Coach bei Elite Dance Studio`} loading="lazy" />
          ) : (
            <div class="coach-photo-type" aria-hidden="true"><strong>{coach.focus}</strong></div>
          )}
        </a>
        <div class="coach-copy">
          <span class="coach-focus">{coach.focus}</span>
          <h3><a href={`/coaches/${coach.slug}/`}>{coach.name}</a></h3>
          {coach.schedule && <span class="coach-schedule">{coach.schedule}</span>}
          <p>{coach.text}</p>
          {coach.beginnerSupport && <span class="coach-support">{coach.beginnerSupport}</span>}
          <div class="coach-card-actions">
            <a class="coach-profile-link" href={`/coaches/${coach.slug}/`}>Profil ansehen <span aria-hidden="true">→</span></a>
          </div>
          <div class="coach-instagram-footer-v19">
            {coach.instagramUrl ? (
              <a
                class="coach-instagram-link"
                href={coach.instagramUrl}
                target="_blank"
                rel="noreferrer"
                aria-label={`${coach.name} auf Instagram öffnen`}
              >
                <InstagramIcon />
                <span>{coach.instagramHandle}</span>
              </a>
            ) : (
              <span class="coach-instagram-link is-disabled" aria-label={`Instagram von ${coach.name} folgt`}>
                <InstagramIcon />
                <span>Instagram folgt</span>
              </span>
            )}
          </div>
        </div>
      </article>
    ))}
  </div>
</section>
