---
interface GuideItem {
  kind: "level" | "format";
  badge: string;
  title: string;
  text: string;
  href: string;
  ctaLabel: string;
}

interface Props {
  items: GuideItem[];
}

const { items } = Astro.props;
const levels = items.filter((item) => item.kind === "level");
const formats = items.filter((item) => item.kind === "format");
---

<section class="course-guide level-guide-v2 level-guide-v23 panel" id="levels">
  <div class="level-guide-head-v23">
    <div>
      <div class="eyebrow">Dein Level</div>
      <h2>Wo passt du gerade rein?</h2>
    </div>
    <p>
      Ein kurzer Überblick reicht. Starte bei deiner Erfahrung und geh von dort weiter.
    </p>
  </div>

  <div class="level-path-v23" aria-label="Level im Elite Dance Studio">
    {levels.map((item, index) => (
      <a class="level-node-v23" href={item.href}>
        <span class="level-node-index-v23">{String(index + 1).padStart(2, "0")}</span>
        <div>
          <small>{item.badge}</small>
          <strong>{item.title}</strong>
        </div>
        <span class="level-node-arrow-v23" aria-hidden="true">→</span>
      </a>
    ))}
  </div>

  <div class="training-formats-v23">
    <div class="training-formats-intro-v23">
      <span>Mehr Fokus</span>
      <strong>Closed Groups & Intensives</strong>
    </div>

    {formats.map((item) => (
      <a class="training-format-v23" href={item.href}>
        <div>
          <span>{item.badge}</span>
          <strong>{item.title}</strong>
        </div>
        <b aria-hidden="true">→</b>
      </a>
    ))}
  </div>
</section>
