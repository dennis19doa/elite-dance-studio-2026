---
interface GuideItem {
  badge: string;
  title: string;
  text: string;
  href: string;
  ctaLabel: string;
}

interface Props {
  items: GuideItem[];
}

const { items } = Astro.props;
---

<section class="course-guide panel">
  <div class="section-head">
    <div>
      <div class="eyebrow">Level Guide</div>
      <h2>So liest du die Kursseite, wenn du neu bei Elite bist.</h2>
    </div>
    <p>
      Die besten Studios machen sofort klar, welcher Einstieg für wen gedacht ist. Genau das
      soll dir diese Orientierung hier geben.
    </p>
  </div>

  <div class="guide-grid">
    {items.map((item) => (
      <article class="guide-card">
        <span class="badge">{item.badge}</span>
        <strong>{item.title}</strong>
        <span>{item.text}</span>
        <a class="pill guide-link" href={item.href}>{item.ctaLabel}</a>
      </article>
    ))}
  </div>
</section>
