---
interface GuideItem { kind: "level" | "format"; badge: string; title: string; text: string; href: string; ctaLabel: string; }
interface Props { items: GuideItem[]; }
const { items } = Astro.props;
const levels = items.filter((item) => item.kind === "level");
const formats = items.filter((item) => item.kind === "format");
---
<section class="course-guide level-guide-v3" id="levels">
  <div class="level-guide-v3-head">
    <div><div class="eyebrow">Dein Level</div><h2>Level 0 → Advanced.</h2></div>
    <p>Wähle nach Erfahrung. Den Rest erklären wir im Kurs.</p>
  </div>

  <div class="level-line" aria-label="Level im Elite Dance Studio">
    {levels.map((item) => (
      <a class="level-line-item" href={item.href}>
        <span>{item.badge}</span>
        <strong>{item.title}</strong>
        <small>{item.text}</small>
      </a>
    ))}
  </div>

  <div class="training-format-split">
    {formats.map((item) => (
      <a class="training-format-wide" href={item.href}>
        <span>{item.badge}</span>
        <strong>{item.title}</strong>
        <b>{item.ctaLabel} ↗</b>
      </a>
    ))}
  </div>
</section>
