---
interface Props {
  id?: string;
  eyebrow?: string;
  title?: string;
  description?: string;
  home?: boolean;
}

const {
  id = "schedule",
  eyebrow = "Live-Stundenplan",
  title = "Alle Classes dieser Woche.",
  description = "Wähle deine Class und reserviere deinen Platz direkt über Eversports.",
  home = false
} = Astro.props;

const facts = [
  { label: "Direkt reservieren", text: "Dein Platz wird im Live-Kalender von Eversports gebucht." },
  { label: "USC", text: "Urban Sports Club gilt für unsere regulären Open Classes." },
  { label: "Neu bei Elite", text: "Welcome Pass: 2 Classes für 20€ zum Ausprobieren." }
];

const levels = [
  { label: "Level 0", text: "allererster Einstieg" },
  { label: "Beginner", text: "Basics ohne Vorwissen" },
  { label: "Beginner+", text: "Basics sind vertraut" },
  { label: "Intermediate", text: "mehr Tempo & Erfahrung" }
];
---

<section
  class:list={["eversports-panel", "panel", "schedule-v9", home && "eversports-home"]}
  id={id}
  aria-labelledby={`${id}-title`}
>
  <div class="schedule-head-v9">
    <div class="schedule-title-v9">
      <div class="schedule-live-v9"><i aria-hidden="true"></i> Live · aktueller Kursplan</div>
      <div class="eyebrow">{eyebrow}</div>
      <h2 id={`${id}-title`}>{title}</h2>
      <p>{description}</p>
    </div>

    <a
      class="schedule-question-v9"
      href="https://wa.me/491633863548?text=Hallo%20Elite%20Dance%20Studio%2C%20ich%20bin%20mir%20bei%20der%20Kurswahl%20noch%20unsicher."
    >
      <span>Kurswahl noch offen?</span>
      <strong>Frag uns auf WhatsApp ↗</strong>
    </a>
  </div>

  <div class="schedule-facts-v10" aria-label="Wichtige Informationen zur Buchung">
    {facts.map((fact) => (
      <div class="schedule-fact-v10">
        <strong>{fact.label}</strong>
        <span>{fact.text}</span>
      </div>
    ))}
  </div>

  <div class="schedule-level-inline-v9" aria-label="Level schnell erklärt">
    {levels.map((level) => (
      <span><strong>{level.label}</strong>{level.text}</span>
    ))}
  </div>

  <div class="eversports-frame">
    <div class="eversports-frame-topline">
      <span>Elite Dance Studio · Berlin-Moabit</span>
      <span>Live-Verfügbarkeit</span>
    </div>
    <div class="eversports-widget" aria-label="Eversports Stundenplan">
      <div data-eversports-widget-id="061d6c37-61a5-4378-8453-714ce19d595c"></div>
    </div>
  </div>

  <script is:inline>
    (() => {
      const schedule = document.currentScript?.closest(".eversports-panel");
      if (!schedule || document.querySelector('script[data-eversports-loader="true"]')) return;

      const loadWidget = () => {
        if (document.querySelector('script[data-eversports-loader="true"]')) return;
        const script = document.createElement("script");
        script.type = "module";
        script.src = "https://widget-static.eversports.io/loader.js";
        script.async = true;
        script.dataset.eversportsLoader = "true";
        document.head.append(script);
      };

      if (!("IntersectionObserver" in window)) {
        loadWidget();
        return;
      }

      const observer = new IntersectionObserver((entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        observer.disconnect();
        loadWidget();
      }, { rootMargin: "750px 0px" });

      observer.observe(schedule);
    })();
  </script>
</section>
