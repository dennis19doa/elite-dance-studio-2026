---
interface Props {
  id?: string;
  eyebrow?: string;
  title?: string;
  description?: string;
  home?: boolean;
}

const {
  id = "schedule",
  eyebrow = "Live-Stundenplan",
  title = "Finde deine nächste Class.",
  description = "Aktuelle Classes, freie Plätze und Buchung direkt im Eversports-Kalender.",
  home = false
} = Astro.props;

const venueHref = "https://www.eversports.de/s/elite-dance-studio";
const uscHref = "https://urbansportsclub.com/de/venues/elite-dance-studio-1";
---

<section
  class:list={["eversports-panel", "schedule-v3", "schedule-v7", home && "eversports-home"]}
  id={id}
  aria-labelledby={`${id}-title`}
>
  <div class="schedule-command">
    <div class="schedule-command-copy">
      <div class="schedule-live-pill"><i aria-hidden="true"></i> Live · diese Woche</div>
      <div class="eyebrow">{eyebrow}</div>
      <h2 id={`${id}-title`}>{title}</h2>
      <p>{description}</p>
    </div>

    <div class="schedule-info-grid" aria-label="Wichtige Informationen zur Buchung">
      <div><span>Reservierung</span><strong>Platz direkt im Kalender sichern.</strong></div>
      <div><span>Open Classes</span><strong>Reguläre Classes sind direkt buchbar.</strong></div>
      <a href={uscHref} target="_blank" rel="noreferrer"><span>Urban Sports Club</span><strong>USC-Verfügbarkeit separat prüfen ↗</strong></a>
      <a href="/kurse/#levels"><span>Level unsicher?</span><strong>Level 0 bis Advanced kurz erklärt →</strong></a>
    </div>

    <div class="schedule-command-actions">
      <a class="button primary" href={venueHref} target="_blank" rel="noreferrer">Eversports öffnen ↗</a>
      <a class="schedule-help-link" href="https://wa.me/491633863548?text=Hallo%20Elite%2C%20welcher%20Kurs%20passt%20zu%20mir%3F">Kurswahl fragen</a>
    </div>
  </div>

  <div class="eversports-frame eversports-frame-v3">
    <div class="eversports-frame-topline">
      <span>Elite Dance Studio · Berlin-Moabit</span>
      <span>Aktuelle Plätze & Buchung</span>
    </div>
    <div class="eversports-widget" aria-label="Eversports Stundenplan">
      <div data-eversports-widget-id="061d6c37-61a5-4378-8453-714ce19d595c"></div>
    </div>
  </div>

  <script is:inline>
    (() => {
      if (document.querySelector('script[data-eversports-loader="true"]')) return;
      const script = document.createElement("script");
      script.type = "module";
      script.src = "https://widget-static.eversports.io/loader.js";
      script.async = true;
      script.dataset.eversportsLoader = "true";
      document.head.append(script);
    })();
  </script>
</section>
