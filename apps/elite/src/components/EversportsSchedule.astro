---
interface Props {
  id?: string;
  eyebrow?: string;
  title?: string;
  description?: string;
  home?: boolean;
}

const {
  id = "schedule",
  eyebrow = "",
  title = "Live-Stundenplan",
  description = "",
  home = false
} = Astro.props;

const levels = ["Level 0", "Beginner", "Beginner+", "Intermediate", "Advanced", "Intensives"];
---

<section
  class:list={["eversports-panel", "panel", "schedule-v9", "schedule-v16", home && "eversports-home"]}
  id={id}
  aria-labelledby={`${id}-title`}
>
  <div class="schedule-head-v16">
    <div class="schedule-title-v16">
      <div class="schedule-live-v9"><i aria-hidden="true"></i> Live · aktueller Kursplan</div>
      {eyebrow && <div class="eyebrow">{eyebrow}</div>}
      <h2 id={`${id}-title`}>{title}</h2>
      {description && <p>{description}</p>}
    </div>

    <a
      class="schedule-question-v9 schedule-question-v16"
      href="https://wa.me/491633863548?text=Hallo%20Elite%20Dance%20Studio%2C%20ich%20bin%20mir%20bei%20der%20Kurswahl%20noch%20unsicher."
    >
      <span>Kurswahl offen?</span>
      <strong>Frag uns ↗</strong>
    </a>
  </div>

  <div class="schedule-levels-v16" aria-label="Level und Formate im Stundenplan">
    {levels.map((level) => <span>{level}</span>)}
  </div>

  <div class="eversports-frame">
    <div class="eversports-frame-topline">
      <span>Elite Dance Studio · Berlin-Moabit</span>
      <span>Live-Verfügbarkeit</span>
    </div>
    <div class="eversports-widget" aria-label="Eversports Stundenplan">
      <div data-eversports-widget-id="061d6c37-61a5-4378-8453-714ce19d595c"></div>
    </div>
  </div>

  <script is:inline>
    (() => {
      const schedule = document.currentScript?.closest(".eversports-panel");
      if (!schedule || document.querySelector('script[data-eversports-loader="true"]')) return;

      const loadWidget = () => {
        if (document.querySelector('script[data-eversports-loader="true"]')) return;
        const script = document.createElement("script");
        script.type = "module";
        script.src = "https://widget-static.eversports.io/loader.js";
        script.async = true;
        script.dataset.eversportsLoader = "true";
        document.head.append(script);
      };

      if (!("IntersectionObserver" in window)) {
        loadWidget();
        return;
      }

      const observer = new IntersectionObserver((entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        observer.disconnect();
        loadWidget();
      }, { rootMargin: "750px 0px" });

      observer.observe(schedule);
    })();
  </script>
</section>
