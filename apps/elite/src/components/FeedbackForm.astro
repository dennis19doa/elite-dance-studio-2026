---
const endpoint = import.meta.env.PUBLIC_FEEDBACK_FORM_ENDPOINT;
const isConfigured = Boolean(endpoint);

const ratingOptions = [1, 2, 3, 4, 5];
---

<section class="feedback-shell">
  <div class="feedback-accent-bar" aria-hidden="true"><span></span><span></span><span></span></div>
  <div class="feedback-intro">
    <div class="feedback-topline">
      <div class="eyebrow">First class feedback</div>
      <span class="feedback-time"><i aria-hidden="true"></i> 3 quick steps · about 60 sec</span>
    </div>
    <h1>How was your first class at Elite? 💛</h1>
    <p>
      A few quick taps help us improve the whole first visit — not just the class.
    </p>
  </div>

  <form
    class="feedback-form"
    action={endpoint || "#"}
    method="post"
    data-feedback-form
    data-configured={String(isConfigured)}
  >
    <input type="hidden" name="request_type" value="first_visit_feedback" />
    <input type="hidden" name="_subject" value="New first-class feedback" />
    <input type="hidden" name="source" value="eversports-first-visit" data-feedback-source />
    <input class="feedback-honeypot" type="text" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" />

    <div class="feedback-progress" aria-label="Survey progress">
      <div class="feedback-progress-meta">
        <strong data-progress-label>Step 1 of 3</strong>
        <span data-progress-copy>Getting here</span>
      </div>
      <div class="feedback-progress-track" aria-hidden="true">
        <span data-progress-bar></span>
      </div>
      <div class="feedback-progress-dots" aria-hidden="true">
        <i class="is-active"></i><i></i><i></i>
      </div>
    </div>

    <section class="feedback-step" data-feedback-step="1">
      <div class="feedback-step-head">
        <span>01</span>
        <div>
          <h2>First, the basics</h2>
          <p>Tell us which class you joined and whether anything made the first visit harder than it needed to be.</p>
        </div>
      </div>

      <div class="feedback-grid">
        <label class="feedback-field">
          <span>Which class did you attend? *</span>
          <input
            type="text"
            name="class_name"
            required
            placeholder="e.g. Heels Beginner"
            autocomplete="off"
            data-feedback-class
          />
        </label>

        <label class="feedback-field">
          <span>Who was your teacher? *</span>
          <input
            type="text"
            name="teacher_name"
            required
            placeholder="Teacher name"
            autocomplete="off"
            data-feedback-teacher
          />
        </label>
      </div>

      <fieldset class="feedback-question friction-question" data-friction-group>
        <legend>Before class, was anything difficult? *</legend>
        <p class="question-hint">Choose everything that applies.</p>
        <div class="chip-grid">
          <label><input type="checkbox" name="pre_visit_friction" value="finding_information" /><span>Finding information</span></label>
          <label><input type="checkbox" name="pre_visit_friction" value="choosing_class_level" /><span>Choosing a class / level</span></label>
          <label><input type="checkbox" name="pre_visit_friction" value="booking" /><span>Booking</span></label>
          <label><input type="checkbox" name="pre_visit_friction" value="finding_entrance" /><span>Finding the entrance</span></label>
          <label><input type="checkbox" name="pre_visit_friction" value="knowing_what_to_expect" /><span>Knowing what to expect</span></label>
          <label class="chip-positive"><input type="checkbox" name="pre_visit_friction" value="nothing_difficult" data-no-friction /><span>Nothing — it was easy ✓</span></label>
        </div>
        <p class="question-error" data-friction-error hidden>Please choose at least one option.</p>
      </fieldset>

      <div class="feedback-nav feedback-nav-end">
        <button class="button primary" type="button" data-next-step>Next: your class →</button>
      </div>
    </section>

    <section class="feedback-step" data-feedback-step="2" hidden>
      <div class="feedback-step-head">
        <span>02</span>
        <div>
          <h2>Nice — you’re halfway there.</h2>
          <p>Three quick taps about the class itself.</p>
        </div>
      </div>

      <fieldset class="feedback-question">
        <legend>What was your overall first impression of Elite? *</legend>
        <div class="rating-scale" aria-label="Overall first impression from 1 to 5">
          {ratingOptions.map((rating) => (
            <label>
              <input type="radio" name="overall_rating" value={rating} required />
              <span><b>{rating}</b><small>{rating === 1 ? "Not great" : rating === 5 ? "Loved it" : ""}</small></span>
            </label>
          ))}
        </div>
      </fieldset>

      <fieldset class="feedback-question">
        <legend>How was the class level for you? *</legend>
        <div class="choice-grid choice-grid-three">
          <label><input type="radio" name="level_fit" value="too_easy" required /><span>Too easy</span></label>
          <label><input type="radio" name="level_fit" value="just_right" required /><span>Just right ✓</span></label>
          <label><input type="radio" name="level_fit" value="too_difficult" required /><span>Too difficult</span></label>
        </div>
      </fieldset>

      <fieldset class="feedback-question">
        <legend>Would you come back for another class at Elite? *</legend>
        <div class="choice-grid">
          <label><input type="radio" name="return_intent" value="definitely" required /><span>Definitely</span></label>
          <label><input type="radio" name="return_intent" value="probably" required /><span>Probably</span></label>
          <label><input type="radio" name="return_intent" value="not_sure" required /><span>Not sure</span></label>
          <label><input type="radio" name="return_intent" value="probably_not" required /><span>Probably not</span></label>
        </div>
      </fieldset>

      <div class="feedback-nav">
        <button class="feedback-back" type="button" data-prev-step>← Back</button>
        <button class="button primary" type="button" data-next-step>Almost done →</button>
      </div>
    </section>

    <section class="feedback-step" data-feedback-step="3" hidden>
      <div class="feedback-step-head">
        <span>03</span>
        <div>
          <h2>Last step ✨</h2>
          <p>One useful detail, then you’re done.</p>
        </div>
      </div>

      <label class="feedback-field">
        <span>Anything you'd like us to know?</span>
        <textarea
          name="open_feedback"
          rows="4"
          placeholder="Something you loved, something confusing, or anything we could improve — optional"
        ></textarea>
      </label>

      <label class="feedback-field">
        <span>How did you first hear about Elite? *</span>
        <select name="discovery_source" required>
          <option value="">Please choose</option>
          <option value="instagram">Instagram</option>
          <option value="google">Google search</option>
          <option value="google_maps">Google Maps</option>
          <option value="friend">Friend / recommendation</option>
          <option value="urban_sports_club">Urban Sports Club</option>
          <option value="event_party">Event or party</option>
          <option value="walked_past">Walked past the studio</option>
          <option value="other">Other / I don't remember</option>
        </select>
      </label>

      <label class="feedback-consent">
        <input type="checkbox" name="privacy_consent" value="accepted" required />
        <span>I agree that Elite Dance Studio may use my answers internally to improve classes and the studio experience. *</span>
      </label>

      <div class="feedback-nav">
        <button class="feedback-back" type="button" data-prev-step>← Back</button>
        <button class="button primary feedback-finish" type="submit">Send feedback ✓</button>
      </div>

      <p class="feedback-status" role="status" aria-live="polite" data-feedback-status>
        {isConfigured
          ? "Your feedback is used for internal quality improvement."
          : "Preview mode: the form design is ready; the secure submission endpoint still needs to be connected."}
      </p>
    </section>
  </form>

  <div class="feedback-success" data-feedback-success hidden>
    <div class="feedback-celebration" aria-hidden="true">✓</div>
    <div class="eyebrow">Done</div>
    <h2>Thank you — that really helps. 💛</h2>
    <p>
      Your feedback helps us make the first Elite experience clearer, easier and more enjoyable.
      We hope to see you on the dance floor again soon.
    </p>
    <a class="button secondary" href="/stundenplan/">See the weekly schedule</a>
  </div>

  <details class="feedback-privacy">
    <summary>What happens with my answers?</summary>
    <p>
      We use the responses internally to understand the first-visit journey, class experience
      and where new students discover Elite. The answers are not used to subscribe you to marketing emails.
    </p>
  </details>
</section>

<script>
  const feedbackForm = document.querySelector<HTMLFormElement>("[data-feedback-form]");

  if (feedbackForm) {
    const steps = Array.from(feedbackForm.querySelectorAll<HTMLElement>("[data-feedback-step]"));
    const status = feedbackForm.querySelector<HTMLElement>("[data-feedback-status]");
    const button = feedbackForm.querySelector<HTMLButtonElement>('button[type="submit"]');
    const success = document.querySelector<HTMLElement>("[data-feedback-success]");
    const progressLabel = feedbackForm.querySelector<HTMLElement>("[data-progress-label]");
    const progressCopy = feedbackForm.querySelector<HTMLElement>("[data-progress-copy]");
    const progressBar = feedbackForm.querySelector<HTMLElement>("[data-progress-bar]");
    const progressDots = Array.from(feedbackForm.querySelectorAll<HTMLElement>(".feedback-progress-dots i"));
    const params = new URLSearchParams(window.location.search);
    let currentStep = 1;

    const sourceField = feedbackForm.querySelector<HTMLInputElement>("[data-feedback-source]");
    const classField = feedbackForm.querySelector<HTMLInputElement>("[data-feedback-class]");
    const teacherField = feedbackForm.querySelector<HTMLInputElement>("[data-feedback-teacher]");
    const frictionGroup = feedbackForm.querySelector<HTMLElement>("[data-friction-group]");
    const frictionError = feedbackForm.querySelector<HTMLElement>("[data-friction-error]");
    const noFriction = feedbackForm.querySelector<HTMLInputElement>("[data-no-friction]");
    const frictionInputs = Array.from(feedbackForm.querySelectorAll<HTMLInputElement>('input[name="pre_visit_friction"]'));

    if (sourceField && params.get("source")) sourceField.value = params.get("source") || sourceField.value;
    if (classField && params.get("class")) classField.value = params.get("class") || "";
    if (teacherField && params.get("teacher")) teacherField.value = params.get("teacher") || "";

    frictionInputs.forEach((input) => {
      input.addEventListener("change", () => {
        if (input === noFriction && input.checked) {
          frictionInputs.forEach((other) => {
            if (other !== input) other.checked = false;
          });
        } else if (input.checked && noFriction) {
          noFriction.checked = false;
        }

        if (frictionInputs.some((item) => item.checked) && frictionError) {
          frictionError.hidden = true;
        }
      });
    });

    const updateProgress = () => {
      const labels = ["Getting here", "Your class", "One last thing"];
      if (progressLabel) progressLabel.textContent = `Step ${currentStep} of 3`;
      if (progressCopy) progressCopy.textContent = labels[currentStep - 1];
      if (progressBar) progressBar.style.width = `${(currentStep / 3) * 100}%`;
      progressDots.forEach((dot, index) => {
        dot.classList.toggle("is-active", index < currentStep);
      });

      steps.forEach((step) => {
        step.hidden = Number(step.dataset.feedbackStep) !== currentStep;
      });

      feedbackForm.scrollIntoView({ behavior: "smooth", block: "start" });
    };

    const validateCurrentStep = () => {
      const step = steps.find((item) => Number(item.dataset.feedbackStep) === currentStep);
      if (!step) return true;

      if (currentStep === 1 && !frictionInputs.some((item) => item.checked)) {
        if (frictionError) frictionError.hidden = false;
        frictionGroup?.scrollIntoView({ behavior: "smooth", block: "center" });
        return false;
      }

      const requiredFields = Array.from(step.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>("[required]"));
      for (const field of requiredFields) {
        if (!field.checkValidity()) {
          field.reportValidity();
          return false;
        }
      }

      return true;
    };

    feedbackForm.querySelectorAll<HTMLButtonElement>("[data-next-step]").forEach((nextButton) => {
      nextButton.addEventListener("click", () => {
        if (!validateCurrentStep()) return;
        currentStep = Math.min(3, currentStep + 1);
        updateProgress();
      });
    });

    feedbackForm.querySelectorAll<HTMLButtonElement>("[data-prev-step]").forEach((backButton) => {
      backButton.addEventListener("click", () => {
        currentStep = Math.max(1, currentStep - 1);
        updateProgress();
      });
    });

    updateProgress();

    feedbackForm.addEventListener("submit", async (event) => {
      event.preventDefault();

      if (!validateCurrentStep()) return;

      if (feedbackForm.dataset.configured !== "true") {
        if (status) {
          status.textContent = "The survey flow is ready. We only need to connect the secure response storage before activating the Eversports email.";
          status.dataset.state = "preview";
        }
        return;
      }

      if (button) button.disabled = true;
      if (status) {
        status.textContent = "Sending your feedback …";
        status.dataset.state = "loading";
      }

      try {
        const response = await fetch(feedbackForm.action, {
          method: "POST",
          body: new FormData(feedbackForm),
          headers: { Accept: "application/json" }
        });

        if (!response.ok) throw new Error("Submission failed");

        feedbackForm.hidden = true;
        if (success) {
          success.hidden = false;
          success.scrollIntoView({ behavior: "smooth", block: "center" });
        }
      } catch {
        if (status) {
          status.textContent = "That did not work. Please try again in a moment.";
          status.dataset.state = "error";
        }
      } finally {
        if (button) button.disabled = false;
      }
    });
  }
</script>

<style>
  .feedback-shell {
    position: relative;
    max-width: 900px;
    margin: 0 auto;
    overflow: hidden;
    padding: clamp(28px, 5vw, 58px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 34px 10px 34px 10px;
    background:
      radial-gradient(circle at 92% 4%, rgba(162, 78, 105, 0.30), transparent 24rem),
      radial-gradient(circle at 8% 96%, rgba(125, 136, 165, 0.20), transparent 28rem),
      linear-gradient(145deg, #302035 0%, #211923 58%, #19141c 100%);
    box-shadow: 0 30px 80px rgba(37, 26, 42, 0.24);
    color: #fff;
  }

  .feedback-accent-bar {
    position: absolute;
    top: 0;
    right: 0;
    left: 0;
    display: grid;
    grid-template-columns: 1.2fr 0.9fr 0.7fr;
    height: 6px;
  }

  .feedback-accent-bar span:nth-child(1) {
    background: var(--coral);
  }

  .feedback-accent-bar span:nth-child(2) {
    background: var(--sky);
  }

  .feedback-accent-bar span:nth-child(3) {
    background: var(--sun);
  }

  .feedback-intro {
    max-width: 730px;
    margin-bottom: 30px;
  }

  .feedback-topline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    flex-wrap: wrap;
  }

  .feedback-shell .eyebrow {
    color: #d8bd87;
  }

  .feedback-time {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 11px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.07);
    color: rgba(255, 255, 255, 0.74);
    font-size: 0.75rem;
    font-weight: 700;
    backdrop-filter: blur(10px);
  }

  .feedback-time i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--sun);
    box-shadow: 0 0 0 5px rgba(197, 164, 107, 0.12);
  }

  .feedback-intro h1 {
    max-width: 12ch;
    margin-top: 14px;
    color: #fff;
    font-size: clamp(2.8rem, 7vw, 4.9rem);
  }

  .feedback-intro > p {
    max-width: 39rem;
    margin: 18px 0 0;
    color: rgba(255, 255, 255, 0.68);
    font-size: 1.02rem;
    line-height: 1.65;
  }

  .feedback-form {
    display: grid;
    gap: 18px;
  }

  .feedback-progress {
    position: sticky;
    top: 88px;
    z-index: 3;
    padding: 15px 17px 13px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 18px 5px 18px 5px;
    background: rgba(36, 23, 41, 0.91);
    box-shadow: 0 16px 36px rgba(8, 5, 10, 0.24);
    backdrop-filter: blur(18px);
  }

  .feedback-progress-meta {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 10px;
    font-size: 0.76rem;
  }

  .feedback-progress-meta strong {
    color: #fff;
    letter-spacing: 0.03em;
  }

  .feedback-progress-meta span {
    color: rgba(255, 255, 255, 0.58);
  }

  .feedback-progress-track {
    height: 6px;
    overflow: hidden;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.1);
  }

  .feedback-progress-track span {
    display: block;
    width: 33.333%;
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(90deg, var(--coral), var(--sun));
    transition: width 320ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .feedback-progress-dots {
    display: flex;
    justify-content: space-between;
    padding-top: 8px;
  }

  .feedback-progress-dots i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.16);
    transition: background-color 220ms ease, transform 220ms ease;
  }

  .feedback-progress-dots i.is-active {
    background: #d8bd87;
    transform: scale(1.15);
  }

  .feedback-step {
    display: grid;
    gap: 25px;
    padding: clamp(24px, 4vw, 36px);
    border: 1px solid rgba(255, 255, 255, 0.7);
    border-radius: 30px 8px 30px 8px;
    background:
      radial-gradient(circle at 100% 0%, rgba(162, 78, 105, 0.08), transparent 19rem),
      rgba(248, 248, 250, 0.97);
    box-shadow: 0 20px 54px rgba(7, 5, 9, 0.18);
    color: var(--text);
  }

  .feedback-step[data-feedback-step="2"] {
    background:
      radial-gradient(circle at 100% 0%, rgba(125, 136, 165, 0.15), transparent 20rem),
      rgba(248, 248, 250, 0.98);
  }

  .feedback-step[data-feedback-step="3"] {
    background:
      radial-gradient(circle at 100% 0%, rgba(197, 164, 107, 0.15), transparent 20rem),
      rgba(248, 248, 250, 0.98);
  }

  .feedback-step-head {
    display: grid;
    grid-template-columns: 48px 1fr;
    gap: 16px;
    align-items: start;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--line);
  }

  .feedback-step-head > span {
    display: grid;
    width: 42px;
    height: 42px;
    place-items: center;
    border-radius: 14px 4px 14px 4px;
    background: var(--coral-soft);
    color: var(--accent-deep);
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 0.08em;
  }

  .feedback-step[data-feedback-step="2"] .feedback-step-head > span {
    background: var(--sky-soft);
    color: #57627f;
  }

  .feedback-step[data-feedback-step="3"] .feedback-step-head > span {
    background: rgba(197, 164, 107, 0.2);
    color: #7d6338;
  }

  .feedback-step-head h2 {
    color: var(--forest);
    font-size: clamp(1.7rem, 3vw, 2.25rem);
  }

  .feedback-step-head p,
  .feedback-status,
  .feedback-privacy p,
  .feedback-success p,
  .question-hint {
    color: var(--muted);
    line-height: 1.6;
  }

  .feedback-step-head p {
    margin: 7px 0 0;
  }

  .feedback-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .feedback-field {
    display: grid;
    gap: 9px;
  }

  .feedback-field > span,
  .feedback-question legend {
    color: var(--forest);
    font-weight: 700;
    line-height: 1.4;
  }

  .feedback-field input,
  .feedback-field select,
  .feedback-field textarea {
    width: 100%;
    border: 1px solid rgba(48, 32, 53, 0.12);
    border-radius: 15px 4px 15px 4px;
    background: rgba(255, 255, 255, 0.86);
    color: var(--text);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.85);
    font: inherit;
  }

  .feedback-field input,
  .feedback-field select {
    min-height: 52px;
    padding: 0 15px;
  }

  .feedback-field textarea {
    padding: 15px;
    resize: vertical;
  }

  .feedback-field input:focus,
  .feedback-field select:focus,
  .feedback-field textarea:focus {
    outline: 3px solid rgba(162, 78, 105, 0.13);
    border-color: rgba(162, 78, 105, 0.48);
    background: #fff;
  }

  .feedback-question {
    margin: 0;
    padding: 0;
    border: 0;
  }

  .feedback-question legend {
    margin-bottom: 4px;
  }

  .question-hint {
    margin: 0 0 12px;
    font-size: 0.82rem;
  }

  .rating-scale {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 9px;
  }

  .rating-scale label,
  .choice-grid label,
  .chip-grid label {
    position: relative;
    cursor: pointer;
  }

  .rating-scale input,
  .choice-grid input,
  .chip-grid input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .rating-scale span,
  .choice-grid span,
  .chip-grid span {
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(48, 32, 53, 0.11);
    background: rgba(255, 255, 255, 0.7);
    color: var(--text);
    text-align: center;
    transition:
      transform 170ms ease,
      border-color 170ms ease,
      background-color 170ms ease,
      box-shadow 170ms ease;
  }

  .rating-scale span:hover,
  .choice-grid span:hover,
  .chip-grid span:hover {
    border-color: rgba(162, 78, 105, 0.28);
    box-shadow: 0 8px 20px rgba(48, 32, 53, 0.07);
    transform: translateY(-1px);
  }

  .rating-scale span {
    min-height: 70px;
    flex-direction: column;
    gap: 2px;
    border-radius: 17px 5px 17px 5px;
  }

  .rating-scale b {
    font-size: 1.25rem;
  }

  .rating-scale small {
    min-height: 14px;
    color: var(--muted);
    font-size: 0.68rem;
  }

  .rating-scale input:checked + span,
  .choice-grid input:checked + span,
  .chip-grid input:checked + span {
    border-color: var(--accent-deep);
    background: linear-gradient(145deg, #8e405e, var(--accent-deep));
    color: #fff;
    box-shadow: 0 11px 24px rgba(127, 53, 82, 0.18);
    transform: translateY(-2px);
  }

  .feedback-step[data-feedback-step="2"] .rating-scale input:checked + span,
  .feedback-step[data-feedback-step="2"] .choice-grid input:checked + span {
    border-color: #69758f;
    background: linear-gradient(145deg, #7d88a5, #616d88);
  }

  .feedback-step[data-feedback-step="3"] .choice-grid input:checked + span {
    border-color: #9f7f49;
    background: linear-gradient(145deg, #c5a46b, #967642);
  }

  .rating-scale input:checked + span small {
    color: rgba(255, 255, 255, 0.72);
  }

  .rating-scale input:focus-visible + span,
  .choice-grid input:focus-visible + span,
  .chip-grid input:focus-visible + span {
    outline: 3px solid rgba(162, 78, 105, 0.18);
    outline-offset: 3px;
