---
interface HeroData {
  eyebrow: string;
  title: string;
  description: string;
  primaryCtaLabel: string;
  primaryCtaHref: string;
  secondaryCtaLabel: string;
  secondaryCtaHref: string;
  beginnerNoteTitle: string;
  beginnerNoteText: string;
  videoSrc: string;
  videoMobileSrc?: string;
  videoPoster: string;
}

interface Props {
  hero: HeroData;
}

const { hero } = Astro.props;
---

<section class="home-hero">
  <div class="hero-visual hero-video-only panel">
    <video
      class="hero-video"
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      poster={hero.videoPoster}
      width="1920"
      height="1080"
      aria-label="Echte Kursszenen im Elite Dance Studio"
    >
      {hero.videoMobileSrc && (
        <source src={hero.videoMobileSrc} type="video/mp4" media="(max-width: 720px)" />
      )}
      <source src={hero.videoSrc} type="video/mp4" />
    </video>
  </div>

  <div class="hero-copy panel">
    <div class="hero-copy-index" aria-hidden="true">
      <span>Berlin · Moabit</span>
      <strong>Dance<br />Feel<br />Belong</strong>
    </div>

    <div class="hero-copy-main">
      <div class="eyebrow">{hero.eyebrow}</div>
      <h1>{hero.title}</h1>
      <p class="lead">{hero.description}</p>
      <div class="actions">
        <a class="button primary" href={hero.primaryCtaHref}>{hero.primaryCtaLabel}</a>
        <a class="button secondary" href={hero.secondaryCtaHref}>{hero.secondaryCtaLabel}</a>
      </div>
    </div>

    <aside class="hero-copy-support">
      <span class="hero-note-kicker">Neu im Tanzen?</span>
      <div class="hero-note">
        <strong>{hero.beginnerNoteTitle}</strong>
        <span>{hero.beginnerNoteText}</span>
      </div>
      <a class="hero-guided-link" href="/kurse/#kurskompass">
        Geführten Einstieg ansehen <span aria-hidden="true">↘</span>
      </a>
    </aside>
  </div>
</section>
