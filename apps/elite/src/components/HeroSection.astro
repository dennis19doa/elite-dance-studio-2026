---
interface HeroData {
  eyebrow: string;
  title: string;
  description: string;
  primaryCtaLabel: string;
  primaryCtaHref: string;
  secondaryCtaLabel: string;
  secondaryCtaHref: string;
  videoSrc: string;
  videoMobileSrc?: string;
  videoPoster: string;
}

interface Props {
  hero: HeroData;
}

const { hero } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const scheduleHref = `${baseUrl}#schedule`;
---

<section class="home-hero home-hero-v16 home-hero-clean-v19">
  <div class="hero-statement-v19" aria-label="We make you move.">
    <h1>
      <span class="hero-line-v19 hero-line-small-v19"><span>We make</span></span>
      <span class="hero-line-v19 hero-line-main-v19"><span><em>you</em> move.</span></span>
    </h1>
  </div>

  <div class="hero-visual hero-video-only panel">
    <video
      class="hero-video"
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      poster={hero.videoPoster}
      width="1920"
      height="1080"
      aria-label="Echte Kursszenen im Elite Dance Studio"
    >
      {hero.videoMobileSrc && (
        <source src={hero.videoMobileSrc} type="video/mp4" media="(max-width: 720px)" />
      )}
      <source src={hero.videoSrc} type="video/mp4" />
    </video>
  </div>

  <div class="hero-actions-v19">
    <div class="actions">
      <a class="button primary" href={scheduleHref}>{hero.primaryCtaLabel}</a>
      <a class="button secondary" href={hero.secondaryCtaHref}>{hero.secondaryCtaLabel}</a>
    </div>

    <div class="hero-proof-v19" aria-label="Elite Dance Studio auf einen Blick">
      <span>25+ Styles</span>
      <span>Level 0 → Advanced</span>
      <span>Berlin-Moabit</span>
    </div>
  </div>
</section>
