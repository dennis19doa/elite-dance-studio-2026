---
interface HeroData {
  eyebrow: string;
  title: string;
  primaryCtaHref: string;
  secondaryCtaHref: string;
  videoSrc: string;
  videoMobileSrc?: string;
  videoPoster: string;
}

interface Props {
  hero: HeroData;
}

const { hero } = Astro.props;
---

<section class="home-hero home-hero-v5">
  <div class="hero-stage">
    <video
      class="hero-video"
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      poster={hero.videoPoster}
      width="1920"
      height="1080"
      aria-label="Echte Kursszenen im Elite Dance Studio"
    >
      {hero.videoMobileSrc && (
        <source src={hero.videoMobileSrc} type="video/mp4" media="(max-width: 720px)" />
      )}
      <source src={hero.videoSrc} type="video/mp4" />
    </video>

    <div class="hero-stage-shade"></div>
    <div class="hero-stage-color hero-stage-color-rose" aria-hidden="true"></div>
    <div class="hero-stage-color hero-stage-color-blue" aria-hidden="true"></div>

    <div class="hero-stage-copy">
      <div class="eyebrow">Elite Dance Studio · Berlin-Moabit</div>
      <h1>Dance.<br />Feel.<br />Belong.</h1>
      <p>25+ Styles · Level 0 bis Advanced · Solo & Partner Dance.</p>
      <div class="actions">
        <a class="button primary" href={hero.primaryCtaHref}>Stundenplan ansehen</a>
        <a class="button secondary" href="/kurse/">Kurse entdecken</a>
      </div>
    </div>

    <div class="hero-stage-meta" aria-label="Elite Dance Studio Highlights">
      <span>Beginner-friendly</span>
      <span>Intermediate & Advanced</span>
      <span>Intensives</span>
      <span>Berlin-Moabit</span>
    </div>

    <a class="hero-scroll-cue" href="#schedule">
      <span>Live Stundenplan</span>
      <b aria-hidden="true">↓</b>
    </a>
  </div>
</section>
