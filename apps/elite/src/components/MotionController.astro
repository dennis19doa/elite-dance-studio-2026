<script>
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const header = document.querySelector<HTMLElement>(".site-header");

  const updateHeader = () => {
    if (!header) return;
    header.classList.toggle("is-scrolled", window.scrollY > 12);
  };

  updateHeader();
  window.addEventListener("scroll", updateHeader, { passive: true });

  if (!reducedMotion && "IntersectionObserver" in window) {
    const sections = Array.from(
      document.querySelectorAll<HTMLElement>("main > section, main > div > section")
    );

    const itemSelector = [
      ".visitor-path-card",
      ".home-new-strip-card",
      ".trust-proof-v7 > div",
      ".home-style-card",
      ".home-coach-card",
      ".style-poster-card",
      ".studio-world-card",
      ".coach-card",
      ".coach-mosaic-card-v7",
      ".faq-item",
      ".price-card",
      ".level-line-item",
      ".training-format-wide",
      ".intensive-roadmap-step",
      ".intensive-module-v7",
      ".rental-room-card",
      ".advanced-card",
      ".advanced-card-v7",
      ".advanced-format-band-v7 a",
      ".event-feature-v7",
      ".contact-choice-v3 a",
      ".trial-fact"
    ].join(",");

    const imageSelector = [
      ".hero-video",
      ".visitor-path-guided img",
      ".home-style-card img",
      ".home-coach-card img",
      ".trial-media img",
      ".studio-world-card img",
      ".trust-visual-v7 img",
      ".service-page-media img",
      ".pricing-page-media img",
      ".rental-room-card img",
      ".rental-hero-v3 img",
      ".advanced-card img",
      ".advanced-card-v7 img",
      ".advanced-hero-mosaic-v7 img",
      ".about-hero-v7 img",
      ".about-story-mosaic-v7 img",
      ".about-team-v7 img",
      ".about-community-v7 img",
      ".intensive-module-v7 img",
      ".intensive-hero-media-v7 img",
      ".events-hero-v7 img",
      ".event-feature-v7 img",
      ".coach-feature-v7 img",
      ".coach-mosaic-card-v7 img",
      ".contact-hero-v3 img"
    ].join(",");

    document.documentElement.classList.add("motion-ready");

    sections.forEach((section, index) => {
      let mode = ["rise", "editorial", "soft"][index % 3];
      if (section.classList.contains("home-hero")) mode = "hero";
      if (section.matches(".home-style-showcase, .rental-gallery-v3, .advanced-offer-v3, .advanced-offer-v7, .coach-wall-v7, .events-grid-v7")) mode = "gallery";
      if (section.matches(".about-hero-v7, .about-story-v7, .about-team-v7, .about-community-v7, .contact-hero-v3, .rental-hero-v3, .advanced-hero-v7, .events-hero-v7, .coaches-hero-v7, .intensive-hero-v7")) mode = "cinematic";
      if (section.matches(".schedule-v3, .schedule-page-hero-v3")) mode = "schedule";
      if (section.matches(".intensive-roadmap-panel, .intensive-roadmap-v7")) mode = "timeline";

      section.dataset.reveal = mode;

      section.querySelectorAll<HTMLElement>(itemSelector).forEach((item, itemIndex) => {
        item.dataset.revealItem = "";
        item.style.setProperty("--reveal-index", String(Math.min(itemIndex, 8)));
      });

      section.querySelectorAll<HTMLElement>(imageSelector).forEach((media) => {
        media.dataset.motionImage = "";
      });
    });

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add("is-visible");
          observer.unobserve(entry.target);
        });
      },
      { rootMargin: "0px 0px -6%", threshold: 0.08 }
    );

    sections.forEach((section) => observer.observe(section));
  }
</script>
