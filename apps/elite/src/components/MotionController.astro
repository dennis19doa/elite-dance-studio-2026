<script>
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const header = document.querySelector<HTMLElement>(".site-header");

  const updateHeader = () => {
    if (!header) return;
    header.classList.toggle("is-scrolled", window.scrollY > 12);
  };

  updateHeader();
  window.addEventListener("scroll", updateHeader, { passive: true });

  if (!reducedMotion && "IntersectionObserver" in window) {
    const sections = Array.from(
      document.querySelectorAll<HTMLElement>("main > section, main > div > section")
    );

    const itemSelector = [
      ".visitor-path-card",
      ".home-new-strip-card",
      ".home-style-card",
      ".home-coach-card",
      ".style-poster-card",
      ".studio-world-card",
      ".coach-card",
      ".coach-card-v8",
      ".faq-item",
      ".price-card",
      ".level-line-item",
      ".training-format-wide",
      ".intensive-roadmap-step",
      ".intensive-card-v8",
      ".rental-room-card",
      ".advanced-card",
      ".advanced-card-v8",
      ".advanced-formats-v8 a",
      ".events-types-grid-v8 > a",
      ".contact-choice-v3 a",
      ".trial-fact"
    ].join(",");

    const imageSelector = [
      ".hero-video",
      ".visitor-path-guided img",
      ".home-style-card img",
      ".home-coach-card img",
      ".trial-media img",
      ".studio-world-card img",
      ".service-page-media img",
      ".pricing-page-media img",
      ".rental-room-card img",
      ".rental-hero-v3 img",
      ".advanced-card img",
      ".advanced-card-v8 img",
      ".advanced-hero-poster-v8 img",
      ".about-cinematic-v3 img",
      ".about-story-images-v4 img",
      ".about-team-v4 img",
      ".about-community-v4 img",
      ".intensive-card-v8 img",
      ".intensives-hero-image-v8 img",
      ".events-hero-image-v8 img",
      ".events-feature-v8 img",
      ".events-types-grid-v8 img",
      ".coaches-hero-image-v8 img",
      ".coach-card-v8 img",
      ".contact-hero-v3 img"
    ].join(",");

    document.documentElement.classList.add("motion-ready");

    sections.forEach((section, index) => {
      let mode = ["rise", "editorial", "soft"][index % 3];
      if (section.classList.contains("home-hero")) mode = "hero";
      if (section.matches(".home-style-showcase, .rental-gallery-v3, .advanced-offer-v8, .coaches-all-v8, .events-types-v8")) mode = "gallery";
      if (section.matches(".about-cinematic-v3, .about-story-grid-v4, .about-team-v4, .about-community-v4, .contact-hero-v3, .rental-hero-v3, .advanced-hero-v8, .events-hero-v8, .coaches-hero-v8, .intensives-hero-v8")) mode = "cinematic";
      if (section.matches(".schedule-v3, .schedule-page-hero-v3")) mode = "schedule";
      if (section.matches(".intensive-modules-section-v8")) mode = "timeline";

      section.dataset.reveal = mode;

      section.querySelectorAll<HTMLElement>(itemSelector).forEach((item, itemIndex) => {
        item.dataset.revealItem = "";
        item.style.setProperty("--reveal-index", String(Math.min(itemIndex, 8)));
      });

      section.querySelectorAll<HTMLElement>(imageSelector).forEach((media) => {
        media.dataset.motionImage = "";
      });
    });

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add("is-visible");
          observer.unobserve(entry.target);
        });
      },
      { rootMargin: "0px 0px -6%", threshold: 0.08 }
    );

    sections.forEach((section) => observer.observe(section));
  }
</script>
