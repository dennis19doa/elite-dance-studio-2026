---
const bookingUrl = "https://www.eversports.de/org/activity/522f6512-9c95-4526-bd03-1f9f50eefc20";
---

<div class="papi-promo" data-papi-promo hidden aria-hidden="true">
  <div class="papi-promo__backdrop" data-papi-close aria-hidden="true"></div>

  <section
    class="papi-promo__dialog"
    role="dialog"
    aria-modal="true"
    aria-labelledby="papi-promo-title"
    aria-describedby="papi-promo-description"
    tabindex="-1"
  >
    <button
      class="papi-promo__close"
      type="button"
      data-papi-close
      aria-label="Workshop-Hinweis schließen"
      title="Schließen"
    >×</button>

    <a
      class="papi-promo__poster"
      href={bookingUrl}
      target="_blank"
      rel="noopener noreferrer"
      data-papi-register
      aria-label="Papi PeRReo Workshop am 21. November, 16 bis 18 Uhr – jetzt anmelden"
    >
      <img
        src="/media/events/papi-perreo-workshop.webp"
        alt="Nate × Mati: Papi PeRReo Workshop. Samstag, 21. November, 16–18 Uhr im Elite Dance Berlin. 40 € einzeln oder 30 € pro Person zu zweit."
        width="320"
        height="426"
        loading="eager"
        decoding="async"
      />
    </a>

    <div class="papi-promo__footer">
      <div class="papi-promo__details">
        <p class="papi-promo__eyebrow">Special Workshop · Open Level</p>
        <h2 id="papi-promo-title">Papi PeRReo · Nate × Mati</h2>
        <p id="papi-promo-description" class="papi-promo__date">Sa, 21. November · 16:00–18:00 Uhr</p>
      </div>
      <a
        href={bookingUrl}
        class="papi-promo__cta"
        target="_blank"
        rel="noopener noreferrer"
        data-papi-register
      >Platz sichern <span aria-hidden="true">↗</span></a>
    </div>
  </section>
</div>

<style>
  .papi-promo[hidden] { display: none !important; }
  .papi-promo {
    position: fixed;
    inset: 0;
    z-index: 1200;
    display: grid;
    place-items: center;
    padding: 18px;
    color: #fff;
    isolation: isolate;
  }
  .papi-promo__backdrop {
    position: absolute;
    inset: 0;
    background: rgb(9 8 7 / 60%);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    cursor: pointer;
  }
  .papi-promo__dialog {
    position: relative;
    display: flex;
    flex-direction: column;
    width: min(510px, 100%);
    max-height: calc(100dvh - 36px);
    overflow: hidden;
    border: 1px solid rgb(255 255 255 / 17%);
    border-radius: 22px;
    background: #181311;
    box-shadow: 0 32px 100px rgb(0 0 0 / 47%);
    animation: papi-promo-arrive 320ms cubic-bezier(.2, .75, .3, 1) both;
  }
  .papi-promo__close {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 3;
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border: 1px solid rgb(255 255 255 / 55%);
    border-radius: 50%;
    background: rgb(19 15 13 / 90%);
    color: #fff;
    font: 28px / 1 sans-serif;
    cursor: pointer;
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
  }
  .papi-promo__close:hover { background: #000; }
  .papi-promo__close:focus-visible,
  .papi-promo__cta:focus-visible,
  .papi-promo__poster:focus-visible {
    outline: 3px solid #ffe656;
    outline-offset: 3px;
  }
  .papi-promo__poster {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 0;
    overflow: hidden;
    text-decoration: none;
    background: #221911;
  }
  .papi-promo__poster img {
    display: block;
    width: 100%;
    height: auto;
    max-height: min(69dvh, 710px);
    object-fit: contain;
  }
  .papi-promo__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    padding: 14px 18px 16px;
    background: linear-gradient(180deg, #1e1713, #14100e);
  }
  .papi-promo__details { min-width: 0; }
  .papi-promo__eyebrow {
    margin: 0 0 4px;
    font-size: 10px;
    font-weight: 800;
    color: #f1d33f;
    letter-spacing: .1em;
    text-transform: uppercase;
  }
  .papi-promo__details h2 {
    margin: 0;
    color: #fff;
    font-size: 16px;
    font-weight: 800;
    line-height: 1.25;
  }
  .papi-promo__date {
    margin: 5px 0 0;
    color: rgb(255 255 255 / 80%);
    font-size: 12px;
    font-weight: 600;
    line-height: 1.3;
  }
  .papi-promo__cta {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    gap: 6px;
    min-height: 44px;
    padding: 0 16px;
    border-radius: 10px;
    background: #f5d528;
    color: #15100e;
    font-size: 13px;
    font-weight: 800;
    text-decoration: none;
    transition: background-color 160ms ease;
  }
  .papi-promo__cta:hover { background: #ffe95d; }
  html.papi-promo-open,
  html.papi-promo-open body { overflow: hidden; }

  @keyframes papi-promo-arrive {
    from { opacity: 0; transform: translateY(20px) scale(.96); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }
  @media (max-width: 540px) {
    .papi-promo { padding: 12px; }
    .papi-promo__dialog {
      width: min(430px, 100%);
      max-height: calc(100dvh - 24px);
      border-radius: 17px;
    }
    .papi-promo__poster img { max-height: 64dvh; }
    .papi-promo__footer { flex-direction: column; align-items: stretch; gap: 12px; padding: 12px 14px 14px; }
    .papi-promo__cta { width: 100%; }
    .papi-promo__details h2 { font-size: 15px; }
  }
  @media (max-height: 650px) {
    .papi-promo__poster img { max-height: 55dvh; }
  }
  @media (prefers-reduced-motion: reduce) {
    .papi-promo__dialog { animation: none; }
    .papi-promo__cta { transition: none; }
  }
</style>

<script>
  const promo = document.querySelector<HTMLElement>("[data-papi-promo]");
  if (promo) {
    const shownKey = "elite-papi-perreo-promo-shown";
    const dismissedKey = "elite-papi-perreo-promo-dismissed";
    const eventEndsAt = Date.parse("2026-11-21T18:00:00+01:00");
    const day = 24 * 60 * 60 * 1000;
    const now = Date.now();

    const lastTimestamp = (key: string): number => {
      try { return Number(window.localStorage.getItem(key)) || 0; }
      catch { return 0; }
    };
    const remember = (key: string): void => {
      try { window.localStorage.setItem(key, String(Date.now())); }
      catch { /* Storage may be disabled; the modal still works. */ }
    };

    const dismissedRecently = lastTimestamp(dismissedKey) > now - 14 * day;
    const shownRecently = lastTimestamp(shownKey) > now - 7 * day;
    if (now < eventEndsAt && !dismissedRecently && !shownRecently) {
      let previouslyFocused: HTMLElement | null = null;
      const dialog = promo.querySelector<HTMLElement>(".papi-promo__dialog");
      const closeButton = promo.querySelector<HTMLButtonElement>(".papi-promo__close");
      const dismiss = (): void => {
        window.clearTimeout(revealTimer);
        promo.hidden = true;
        promo.setAttribute("aria-hidden", "true");
        document.documentElement.classList.remove("papi-promo-open");
        remember(dismissedKey);
        previouslyFocused?.focus({ preventScroll: true });
      };

      const revealTimer = window.setTimeout(() => {
        previouslyFocused = document.activeElement instanceof HTMLElement ? document.activeElement : null;
        promo.hidden = false;
        promo.setAttribute("aria-hidden", "false");
        document.documentElement.classList.add("papi-promo-open");
        remember(shownKey);
        dialog?.focus({ preventScroll: true });
        closeButton?.focus({ preventScroll: true });
      }, 7000);

      promo.querySelectorAll("[data-papi-close]").forEach((element) =>
        element.addEventListener("click", dismiss)
      );
      promo.querySelectorAll("[data-papi-register]").forEach((element) =>
        element.addEventListener("click", () => remember(dismissedKey))
      );
      document.addEventListener("keydown", (event) => {
        if (promo.hidden) return;
        if (event.key === "Escape") dismiss();
        if (event.key !== "Tab") return;
        const focusables = Array.from(promo.querySelectorAll<HTMLElement>(
          "button:not([disabled]), a[href], [tabindex]:not([tabindex='-1'])"
        ));
        const first = focusables[0];
        const last = focusables[focusables.length - 1];
        if (!first || !last) return;
        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first.focus();
        }
      });
    }
  }
</script>
