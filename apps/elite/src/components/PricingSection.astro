---
interface PricingItem { category: string; label: string; name: string; price: string; text: string; ctaLabel?: string; href?: string; featured?: boolean; }
interface Props { pricing: PricingItem[]; eyebrow?: string; title?: string; description?: string; }
const { pricing, eyebrow = "Preise", title = "Einfach wählen. Einfach tanzen.", description = "Starten, flexibel bleiben oder regelmäßig trainieren." } = Astro.props;
const categories = [...new Set(pricing.map((item) => item.category))];
const slugify = (value: string) => value.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "");
const isExternal = (href?: string) => Boolean(href?.startsWith("http"));
---
<section class="pricing pricing-v3" id="pricing">
  <div class="section-head compact-section-head pricing-v3-head">
    <div><div class="eyebrow">{eyebrow}</div><h2>{title}</h2></div>
    {description && <p>{description}</p>}
  </div>
  <div class="pricing-groups">
    {categories.map((category) => (
      <section class="pricing-group" data-category={slugify(category)}>
        <div class="pricing-group-head"><h3>{category}</h3></div>
        <div class="price-cards">
          {pricing.filter((item) => item.category === category).map((item) => (
            <article class:list={["price-card", item.featured && "featured"]} data-plan={slugify(item.name)}>
              <div class="price-card-main">
                <span class="price-label">{item.label}</span>
                <strong>{item.name}</strong>
                <div class="price">{item.price}</div>
                <p>{item.text}</p>
              </div>
              {item.href && (
                <div class="price-card-footer price-card-footer-simple">
                  <a class="text-link" href={item.href} target={isExternal(item.href) ? "_blank" : undefined} rel={isExternal(item.href) ? "noreferrer" : undefined}>
                    {item.ctaLabel ?? "Mehr erfahren"} <span aria-hidden="true">↗</span>
                  </a>
                </div>
              )}
            </article>
          ))}
        </div>
      </section>
    ))}
  </div>
</section>
