---
interface PricingItem {
  category: string;
  label: string;
  name: string;
  price: string;
  text: string;
  bestFor?: string;
  features?: string[];
  ctaLabel?: string;
  href?: string;
  featured?: boolean;
}
interface Props { pricing: PricingItem[]; }

const { pricing } = Astro.props;
const isExternal = (href?: string) => Boolean(href?.startsWith("http"));
const byCategory = (category: string) => pricing.filter((item) => item.category === category);
const start = byCategory("Start");
const memberships = byCategory("Memberships");
const flexible = byCategory("Flexibel");
const usc = byCategory("USC");
const slugify = (value: string) => value.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "");
const membershipGlyph = (name: string) => name === "Bronze" ? "1×" : name === "Silber" ? "2×" : "∞";
const compactFeatures = (features?: string[]) => (features ?? []).filter((feature) => !feature.toLowerCase().includes("kündbar")).slice(0, 2);
const flexibleGlyph = (name: string) => name === "Drop-in" ? "1" : name.startsWith("5") ? "5" : "10";
---

<section class="pricing panel pricing-v20 pricing-v23 pricing-v25" id="pricing">
  <section class="pricing-start-v25" id="start" aria-labelledby="pricing-start-title">
    <div class="pricing-section-head-v25">
      <div>
        <span class="pricing-section-kicker-v25">01 · Neu bei Elite</span>
        <h2 id="pricing-start-title">Welcome Pass</h2>
      </div>
      <p>Dein erster Schritt. Zwei Classes testen und danach entscheiden, wie du weitermachen willst.</p>
    </div>

    {start.map((item) => (
      <article class="welcome-pass-premium-v25" data-plan={slugify(item.name)}>
        <div class="welcome-pass-art-v25" aria-hidden="true">
          <span class="welcome-pass-art-label-v25">FIRST VISIT</span>
          <strong>{item.price}</strong>
          <i></i>
          <small>2 CLASSES</small>
        </div>

        <div class="welcome-pass-body-v25">
          <span class="welcome-pass-badge-v25">Einmal pro Person</span>
          <h3>Probier Elite aus, ohne dich festzulegen.</h3>
          <div class="welcome-pass-facts-v25">
            <span>2 reguläre Classes</span>
            <span>10 Tage gültig</span>
            <span>Styles frei kombinieren</span>
          </div>
        </div>

        {item.href && (
          <a class="welcome-pass-button-v25" href={item.href} target="_blank" rel="noreferrer">
            <span>Welcome Pass kaufen</span>
            <b aria-hidden="true">→</b>
          </a>
        )}
      </article>
    ))}
  </section>

  <section class="pricing-memberships-v25" id="memberships" aria-labelledby="pricing-membership-title">
    <div class="pricing-section-head-v25 pricing-section-head-dark-v25">
      <div>
        <span class="pricing-section-kicker-v25">02 · Regelmäßig</span>
        <h2 id="pricing-membership-title">Deine Membership.</h2>
      </div>
      <p>Ein klarer Rhythmus pro Monat. Wähle, wie oft du trainieren möchtest.</p>
    </div>

    <div class="membership-grid-v25">
      {memberships.map((item, index) => (
        <article class:list={["membership-card-v25", `membership-${slugify(item.name)}-v25`, item.featured && "is-featured"]}>
          <div class="membership-index-v25">0{index + 1}</div>
          <div class="membership-glyph-v25" aria-hidden="true">{membershipGlyph(item.name)}</div>

          <div class="membership-name-v25">
            <span>{item.label}</span>
            <h3>{item.name}</h3>
          </div>

          <div class="membership-price-v25">{item.price}</div>

          <div class="membership-facts-v25">
            {compactFeatures(item.features).map((feature) => <span>{feature}</span>)}
            <span>Monatlich kündbar</span>
          </div>

          {item.featured && <div class="membership-featured-v25">Beliebteste Wahl</div>}

          {item.href && (
            <a class="membership-button-v25" href={item.href} target="_blank" rel="noreferrer">
              <span>{item.ctaLabel ?? "Membership wählen"}</span>
              <b aria-hidden="true">→</b>
            </a>
          )}
        </article>
      ))}
    </div>
  </section>

  <section class="pricing-flex-v25" id="flexible" aria-labelledby="pricing-flex-title">
    <div class="pricing-section-head-v25">
      <div>
        <span class="pricing-section-kicker-v25">03 · Ohne Membership</span>
        <h2 id="pricing-flex-title">Flexibel bleiben.</h2>
      </div>
      <p>Einzelne Classes oder Karten — du entscheidest, wann du kommst.</p>
    </div>

    <div class="flex-grid-v25">
      {flexible.map((item) => (
        <article class="flex-card-v25" data-plan={slugify(item.name)}>
          <div class="flex-card-top-v25">
            <div class="flex-card-glyph-v25" aria-hidden="true">{flexibleGlyph(item.name)}</div>
            <span>{item.label}</span>
          </div>

          <h3>{item.name}</h3>
          <div class="flex-card-price-v25">{item.price}</div>

          <div class="flex-card-facts-v25">
            {(item.features ?? []).slice(0, 2).map((feature) => <span>{feature}</span>)}
          </div>

          {item.href && (
            <a class="flex-card-link-v25" href={item.href} target={isExternal(item.href) ? "_blank" : undefined} rel={isExternal(item.href) ? "noreferrer" : undefined}>
              <span>{item.ctaLabel ?? "Mehr erfahren"}</span>
              <b aria-hidden="true">→</b>
            </a>
          )}
        </article>
      ))}
    </div>
  </section>

  {usc.map((item) => (
    <section class="pricing-usc-v25" id="usc" aria-labelledby="pricing-usc-title">
      <div class="usc-mark-v25" aria-hidden="true">USC</div>
      <div class="usc-copy-v25">
        <span class="pricing-section-kicker-v25">04 · Urban Sports Club</span>
        <h2 id="pricing-usc-title">Schon bei USC?</h2>
        <p>Reguläre Open Classes kannst du direkt über dein USC-Konto buchen.</p>
      </div>
      <div class="usc-meta-v25">
        <strong>{item.price}</strong>
        <small>Closed Groups & Intensives ausgenommen</small>
      </div>
      {item.href && (
        <a class="usc-button-v25" href={item.href} target="_blank" rel="noreferrer">
          <span>USC öffnen</span>
          <b aria-hidden="true">→</b>
        </a>
      )}
    </section>
  ))}
</section>
