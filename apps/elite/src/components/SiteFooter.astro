---
interface NavItem {
  label: string;
  href: string;
  children?: NavItem[];
}

interface Props {
  brand: string;
  nav: NavItem[];
}

const { brand, nav } = Astro.props;
const footerLinks = nav.flatMap((item) => item.children ?? [item]);
const baseUrl = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<footer class="site-footer">
  <div class="page-shell footer-shell">
    <div>
      <a class="brand footer-brand" href={baseUrl} aria-label={brand}>ELITE DANCE</a>
      <p class="footer-copy">
        Tanzkurse, Training und Community in Berlin-Moabit. Von Level 0 bis Advanced – offen,
        persönlich und mit Raum, deinen eigenen Style zu finden.
      </p>
    </div>
    <nav class="footer-nav" aria-label="Footer">
      {footerLinks.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
  </div>
</footer>
