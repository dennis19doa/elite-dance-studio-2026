---
interface NavItem { label: string; href: string; description?: string; children?: NavItem[]; }
interface Props { brand: string; nav: NavItem[]; }
const { brand, nav } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const logoSrc = `${baseUrl}media/current-site/elite-logo.webp`;
const rawPath = Astro.url.pathname;
const currentPath = rawPath.startsWith(baseUrl) ? `/${rawPath.slice(baseUrl.length)}`.replace(/\/+/g, "/") : rawPath;
const contactHref = "/kontakt/";
const bookingHref = `${baseUrl}#schedule`;
function isActive(href: string) { if (href === "/") return currentPath === "/"; return currentPath === href || currentPath.startsWith(href); }
function isGroupActive(item: NavItem) { return isActive(item.href) || item.children?.some((child) => isActive(child.href)); }
---
<header class="site-header site-header-v2 site-header-v17" data-site-header>
  <div class="page-shell topbar">
    <a class="brand brand-logo-link" href={baseUrl} aria-label={`${brand} – Startseite`}>
      <span class="brand-logo-glow" aria-hidden="true"></span>
      <img
        class="brand-logo-image"
        src={logoSrc}
        alt={brand}
        width="1620"
        height="1080"
        decoding="async"
        fetchpriority="high"
      />
    </a>

    <nav class="main-nav desktop-nav" aria-label="Primary">
      {nav.map((item) => item.children ? (
        <details class:list={["nav-dropdown", isGroupActive(item) && "is-active"]}>
          <summary class="nav-link">{item.label}<span class="nav-chevron" aria-hidden="true">⌄</span></summary>
          <div class="nav-dropdown-menu">
            {item.children.map((child) => (
              <a class:list={["nav-dropdown-link", isActive(child.href) && "is-active"]} href={child.href}>
                <span>{child.label}</span>
                {child.description && <small>{child.description}</small>}
              </a>
            ))}
          </div>
        </details>
      ) : (
        <a class:list={["nav-link", isActive(item.href) && "is-active"]} href={item.href}>{item.label}</a>
      ))}
    </nav>

    <div class="actions header-actions header-actions-v17">
      <a class="button header-contact-button-v17" href={contactHref}>Kontakt</a>
      <a class="button primary" href={bookingHref}>Buchen</a>
    </div>

    <details class="mobile-nav">
      <summary><span class="mobile-nav-icon" aria-hidden="true"><i></i><i></i></span><span>Menü</span></summary>
      <div class="mobile-menu panel">
        <nav class="mobile-menu-links" aria-label="Mobile Navigation">
          {nav.map((item) => item.children ? (
            <details class="mobile-nav-group" open={isGroupActive(item)}>
              <summary class:list={[isGroupActive(item) && "is-active"]}>{item.label}</summary>
              <div>
                {item.children.map((child) => (
                  <a class:list={["nav-link", isActive(child.href) && "is-active"]} href={child.href}>{child.label}</a>
                ))}
              </div>
            </details>
          ) : (
            <a class:list={["nav-link", isActive(item.href) && "is-active"]} href={item.href}>{item.label}</a>
          ))}
        </nav>
        <div class="mobile-menu-actions">
          <a class="button header-contact-button-v17" href={contactHref}>Kontakt</a>
          <a class="button primary" href={bookingHref}>Buchen</a>
        </div>
      </div>
    </details>
  </div>

  <style>
    .brand-logo-link {
      position: relative;
      isolation: isolate;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex: 0 0 auto;
      width: clamp(118px, 10vw, 158px);
      height: 60px;
      padding: 0;
      overflow: visible;
      text-decoration: none;
      transform: translateZ(0);
      transition: transform 220ms ease;
    }

    .brand-logo-glow {
      position: absolute;
      inset: -9px -18px;
      z-index: -1;
      pointer-events: none;
      border-radius: 999px;
      background:
        radial-gradient(ellipse at 50% 50%, rgba(186, 20, 42, 0.32) 0%, rgba(126, 10, 27, 0.2) 38%, rgba(75, 0, 15, 0.08) 58%, transparent 76%);
      filter: blur(11px);
      opacity: 0.72;
      transform: scale(0.94);
      transition: opacity 240ms ease, transform 240ms ease, filter 240ms ease;
    }

    .brand-logo-image {
      position: relative;
      z-index: 1;
      display: block;
      width: 100%;
      height: 100%;
      object-fit: contain;
      filter:
        drop-shadow(0 0 5px rgba(255, 215, 112, 0.16))
        drop-shadow(0 2px 8px rgba(0, 0, 0, 0.55));
      transition: transform 240ms ease, filter 240ms ease, brightness 240ms ease;
    }

    .brand-logo-link:hover,
    .brand-logo-link:focus-visible {
      transform: translateY(-1px) scale(1.025);
    }

    .brand-logo-link:hover .brand-logo-glow,
    .brand-logo-link:focus-visible .brand-logo-glow {
      opacity: 1;
      transform: scale(1.08);
      filter: blur(14px);
    }

    .brand-logo-link:hover .brand-logo-image,
    .brand-logo-link:focus-visible .brand-logo-image {
      transform: scale(1.015);
      filter:
        drop-shadow(0 0 7px rgba(255, 232, 158, 0.64))
        drop-shadow(0 0 18px rgba(186, 20, 42, 0.38))
        drop-shadow(0 3px 10px rgba(0, 0, 0, 0.62));
    }

    .brand-logo-link:focus-visible {
      outline: 1px solid rgba(255, 221, 133, 0.7);
      outline-offset: 5px;
      border-radius: 14px;
    }

    @media (max-width: 900px) {
      .brand-logo-link {
        width: 108px;
        height: 52px;
      }
      .brand-logo-glow {
        inset: -7px -13px;
      }
    }

    @media (max-width: 560px) {
      .brand-logo-link {
        width: 96px;
        height: 46px;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .brand-logo-link,
      .brand-logo-glow,
      .brand-logo-image {
        transition: none;
      }
    }
  </style>

  <script is:inline>
    (() => {
      const header = document.currentScript?.closest('[data-site-header]');
      if (!header) return;

      const desktopGroups = [...header.querySelectorAll('details.nav-dropdown')];
      const mobileGroups = [...header.querySelectorAll('details.mobile-nav-group')];
      const mobileMenu = header.querySelector('details.mobile-nav');

      const closeAll = (except = null) => {
        [...desktopGroups, ...mobileGroups].forEach((group) => {
          if (group !== except) group.removeAttribute('open');
        });
      };

      [...desktopGroups, ...mobileGroups].forEach((group) => {
        group.addEventListener('toggle', () => {
          if (group.open) closeAll(group);
        });
      });

      document.addEventListener('click', (event) => {
        if (!header.contains(event.target)) {
          closeAll();
          mobileMenu?.removeAttribute('open');
        }
      });

      document.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape') return;
        closeAll();
        mobileMenu?.removeAttribute('open');
      });
    })();
  </script>
</header>
