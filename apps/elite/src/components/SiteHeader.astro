---
interface NavItem { label: string; href: string; description?: string; children?: NavItem[]; }
interface Props { brand: string; nav: NavItem[]; }
const { brand, nav } = Astro.props;
const currentPath = Astro.url.pathname;
const contactHref = "https://wa.me/491633863548?text=Hallo%20Elite%20Dance%20Studio%2C%20ich%20habe%20eine%20Frage.";
const isExternal = (href: string) => href.startsWith("http");
function isActive(href: string) {
  if (isExternal(href)) return false;
  if (href === "/") return currentPath === "/";
  return currentPath === href || currentPath.startsWith(href);
}
function isGroupActive(item: NavItem) { return isActive(item.href) || item.children?.some((child) => isActive(child.href)); }
---
<header class="site-header site-header-v2">
  <div class="page-shell topbar">
    <a class="brand" href="/">{brand}</a>

    <nav class="main-nav desktop-nav" aria-label="Primary">
      {nav.map((item) => item.children ? (
        <details class:list={["nav-dropdown", isGroupActive(item) && "is-active"]}>
          <summary class="nav-link">{item.label}<span class="nav-chevron" aria-hidden="true">⌄</span></summary>
          <div class="nav-dropdown-menu">
            {item.children.map((child) => (
              <a
                class:list={["nav-dropdown-link", isActive(child.href) && "is-active"]}
                href={child.href}
                target={isExternal(child.href) ? "_blank" : undefined}
                rel={isExternal(child.href) ? "noreferrer" : undefined}
              >
                <span>{child.label}</span>{child.description && <small>{child.description}</small>}
              </a>
            ))}
          </div>
        </details>
      ) : (
        <a class:list={["nav-link", isActive(item.href) && "is-active"]} href={item.href}>{item.label}</a>
      ))}
    </nav>

    <div class="actions header-actions">
      <a class="header-contact header-contact-round" href={contactHref} aria-label="Elite auf WhatsApp kontaktieren" title="WhatsApp">
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20 11.5a8 8 0 0 1-11.7 7.1L4 20l1.4-4.1A8 8 0 1 1 20 11.5Z" />
          <path d="M8.6 8.4c.4 2.7 2.4 4.7 5 5.2" />
          <path d="M8.7 8.3 10 7.8l1 2-1 .8" />
          <path d="m13 12.7.8-1 2 1-.5 1.3" />
        </svg>
      </a>
      <a class="button primary" href="/stundenplan/">Buchen</a>
    </div>

    <details class="mobile-nav">
      <summary><span class="mobile-nav-icon" aria-hidden="true"><i></i><i></i></span><span>Menü</span></summary>
      <div class="mobile-menu panel">
        <nav class="mobile-menu-links" aria-label="Mobile Navigation">
          {nav.map((item) => item.children ? (
            <details class="mobile-nav-group" open={isGroupActive(item)}>
              <summary class:list={[isGroupActive(item) && "is-active"]}>{item.label}</summary>
              <div>
                {item.children.map((child) => (
                  <a
                    class:list={["nav-link", isActive(child.href) && "is-active"]}
                    href={child.href}
                    target={isExternal(child.href) ? "_blank" : undefined}
                    rel={isExternal(child.href) ? "noreferrer" : undefined}
                  >{child.label}</a>
                ))}
              </div>
            </details>
          ) : (
            <a class:list={["nav-link", isActive(item.href) && "is-active"]} href={item.href}>{item.label}</a>
          ))}
        </nav>
        <div class="mobile-menu-actions">
          <a class="button secondary" href={contactHref}>WhatsApp</a>
          <a class="button primary" href="/stundenplan/">Buchen</a>
        </div>
      </div>
    </details>
  </div>
</header>
