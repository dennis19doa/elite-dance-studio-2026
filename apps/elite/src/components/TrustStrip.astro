---
interface Signal {
  title: string;
  text: string;
}

interface Props {
  signals: Signal[];
}

const { signals } = Astro.props;
---

<section class="trust-band panel trust-band-v4">
  <div class="section-head">
    <div>
      <div class="eyebrow">Warum Elite</div>
      <h2>25+ Styles. Alle Levels. Ein Studio.</h2>
    </div>
  </div>

  <div class="trust-strip">
    {signals.map((signal) => (
      <div class="stat">
        <strong>{signal.title}</strong>
        <span>{signal.text}</span>
      </div>
    ))}
  </div>
</section>
