---
interface VisitData {
  address: string;
  entryNote: string;
  contactPrompt: string;
  ctaHeading: string;
  ctaText: string;
  phone: string;
  email: string;
  instagram: string;
  whatsappHref: string;
  mapHref: string;
  instagramHref: string;
}

interface Props {
  visit: VisitData;
  eyebrow?: string;
  title?: string;
  description?: string;
}

const {
  visit,
  eyebrow = "Kontakt & Anfahrt",
  title = "So findest du uns in Moabit.",
  description = "Wiclefstraße 16–17 · durch beide Tore · zweiter Hof links."
} = Astro.props;
---

<section class="visit visit-v3" id="visit">
  <div class="visit-v3-head">
    <div>
      <div class="eyebrow">{eyebrow}</div>
      <h2>{title}</h2>
    </div>
    <p>{description}</p>
  </div>

  <div class="arrival-flow" aria-label="Weg ins Studio">
    <span>Wiclefstraße 16–17</span>
    <i aria-hidden="true">→</i>
    <span>Durch beide Tore</span>
    <i aria-hidden="true">→</i>
    <span>Zweiter Hof · links</span>
  </div>

  <div class="visit-contact-band">
    <div>
      <span class="visit-contact-label">Elite Dance Studio Berlin</span>
      <strong>{visit.address}</strong>
      <span class="visit-entry-note">{visit.entryNote}</span>
    </div>
    <div class="visit-contact-details">
      <a href={`tel:${visit.phone.replace(/\s/g, "")}`}>{visit.phone}</a>
      <a href={`mailto:${visit.email}`}>{visit.email}</a>
      <a href={visit.instagramHref}>{visit.instagram}</a>
    </div>
    <div class="visit-contact-actions">
      <a class="button primary" href={visit.whatsappHref}>WhatsApp</a>
      <a class="button secondary" href={visit.mapHref}>Route öffnen ↗</a>
    </div>
  </div>
</section>
