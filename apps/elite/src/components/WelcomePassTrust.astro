---
interface Props {
  address: string;
}

const { address } = Astro.props;
---

<section class="welcome-trust panel" aria-labelledby="welcome-trust-title">
  <div class="welcome-trust-head">
    <div>
      <div class="eyebrow">Transparent vor dem Kauf</div>
      <h2 id="welcome-trust-title">Du weißt vorher genau, was du bekommst.</h2>
    </div>
    <p>
      Der Welcome Pass ist bewusst einfach: zwei reguläre Classes, einmalig 20€, ohne Membership
      und ohne automatische Verlängerung.
    </p>
  </div>

  <div class="welcome-trust-grid">
    <article>
      <span class="welcome-trust-value">20€</span>
      <strong>Einmalig</strong>
      <p>Für zwei reguläre Classes. Kein Abo und keine Membership nötig.</p>
    </article>

    <article>
      <span class="welcome-trust-value">10 Tage</span>
      <strong>Ab deinem ersten Besuch</strong>
      <p>Du kannst zwei Styles vergleichen oder denselben Style zweimal besuchen.</p>
    </article>

    <article>
      <span class="welcome-trust-value">Eversports</span>
      <strong>Buchung & Zahlung</strong>
      <p>Der Kauf und deine Kursbuchungen laufen direkt über Eversports.</p>
    </article>

    <article>
      <span class="welcome-trust-value">Berlin-Moabit</span>
      <strong>{address}</strong>
      <p>Komm beim ersten Mal am besten 10–15 Minuten früher an.</p>
    </article>
  </div>

  <div class="welcome-trust-note">
    <strong>Wichtig:</strong>
    <span>
      Der Welcome Pass gilt einmal pro Person. Advanced-Kurse, Closed Groups und Intensives sind
      ausgenommen.
    </span>
  </div>
</section>

<style>
  .welcome-trust {
    display: grid;
    gap: 24px;
  }

  .welcome-trust-head {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(260px, 0.85fr);
    gap: 28px;
    align-items: end;
  }

  .welcome-trust-head h2 {
    margin: 6px 0 0;
  }

  .welcome-trust-head > p {
    margin: 0;
    line-height: 1.65;
    color: var(--text-muted, #6f675f);
  }

  .welcome-trust-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
  }

  .welcome-trust-grid article {
    display: grid;
    align-content: start;
    gap: 7px;
    min-height: 170px;
    padding: 20px;
    border: 1px solid rgba(66, 50, 40, 0.12);
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.48);
  }

  .welcome-trust-value {
    font-family: "Sora", sans-serif;
    font-size: 1.2rem;
    font-weight: 800;
    letter-spacing: -0.025em;
  }

  .welcome-trust-grid strong {
    font-size: 0.95rem;
  }

  .welcome-trust-grid p {
    margin: 0;
    color: var(--text-muted, #6f675f);
    font-size: 0.86rem;
    line-height: 1.55;
  }

  .welcome-trust-note {
    display: flex;
    gap: 8px;
    align-items: flex-start;
    padding: 15px 17px;
    border-radius: 14px;
    background: rgba(147, 27, 52, 0.07);
    font-size: 0.88rem;
    line-height: 1.55;
  }

  @media (max-width: 900px) {
    .welcome-trust-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 680px) {
    .welcome-trust-head {
      grid-template-columns: 1fr;
      gap: 12px;
    }

    .welcome-trust-grid {
      grid-template-columns: 1fr;
    }

    .welcome-trust-grid article {
      min-height: 0;
    }
  }
</style>
