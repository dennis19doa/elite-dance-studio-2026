---
import "../styles/global.css";
import "../styles/v2.css";
import "../styles/redesign-v9.css";
import "../styles/stability-v10.css";
import "../styles/subpages-v11.css";
import "../styles/editorial-v12.css";
import "../styles/editorial-v12-pages.css";
import "../styles/coherent-v13.css";
import "../styles/polish-v14.css";
import "../styles/unified-v15.css";
import "../styles/home-v16.css";
import "../styles/courses-v16.css";
import "../styles/color-v17.css";
import "../styles/warm-v18.css";
import "../styles/pages-v18.css";
import "../styles/refine-v19.css";
import "../styles/mobile-v19.css";
import "../styles/pricing-v19-redesign.css";
import MobileJoinBar from "../components/MobileJoinBar.astro";
import MotionController from "../components/MotionController.astro";
import StructuredData from "../components/StructuredData.astro";

interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
  bodyClass?: string;
}

const {
  title,
  description,
  image = "/media/hero/elite-homepage-poster.jpg",
  noindex = false,
  bodyClass
} = Astro.props;
const siteUrl = Astro.site ?? new URL("https://elitedancestudio.de");
const canonicalUrl = new URL(Astro.url.pathname, siteUrl);
const socialImageUrl = new URL(image, siteUrl);
const baseUrl = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const rawPath = Astro.url.pathname;
const routePath = rawPath.startsWith(baseUrl) ? `/${rawPath.slice(baseUrl.length)}`.replace(/\/+/g, "/") : rawPath;
const isHome = routePath === "/" || routePath === "";
const routeKey = routePath.split("/").filter(Boolean)[0] ?? "home";
const routeClass = `route-${routeKey.replace(/[^a-z0-9-]/gi, "-").toLowerCase()}`;
const resolvedBodyClass = Array.from(new Set([isHome ? "home-page" : "site-subpage", routeClass, bodyClass].filter(Boolean))).join(" ");
const isPreviewBuild = import.meta.env.BASE_URL.includes("/preview/");
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow"} />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Elite Dance Studio" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:alt" content="Elite Dance Studio Berlin" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="theme-color" content="#17120f" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Sora:wght@500;600;700;800&display=swap" rel="stylesheet" />
    {!noindex && <StructuredData pageTitle={title} path={Astro.url.pathname} />}
    <slot name="head" />
  </head>
  <body class={resolvedBodyClass}>
    <slot />
    <MotionController />
    <MobileJoinBar />
    {isPreviewBuild && <div class="preview-build-badge" aria-hidden="true">Preview V19</div>}
  </body>
</html>
