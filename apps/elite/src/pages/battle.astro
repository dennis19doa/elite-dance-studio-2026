---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import site from "../data/site.json";
import { battle } from "../data/battle";

const { categoryNames, eversportsBookingUrl, uscBookingUrl, poster } = battle;
const categoryList = Object.values(categoryNames).join(" · ");
const baseUrl = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + "/";
const posterUrl = baseUrl + poster.large;
const categories = Object.entries(categoryNames) as [keyof typeof categoryNames, string][];
---

<BaseLayout
  title="Elite Dance Battle 2026 | Berlin-Moabit"
  description={"Elite Dance Battle am 5. Dezember 2026, " + battle.hours + " Uhr in Berlin-Moabit. " + categoryList + ". Zuschauen ist kostenlos. Battle-Teilnahme " + battle.onlineFee + " online, " + battle.doorFee + " vor Ort oder mit Urban Sports Club."}
  image={posterUrl}
  bodyClass="elite-battle-page"
>
  <SiteHeader brand={site.brand} nav={site.nav} />

  <main class="battle-main">
    <section class="battle-hero" aria-labelledby="battle-title">
      <div class="battle-container battle-hero-layout">
        <div class="battle-hero-copy">
          <p class="battle-event-date">
            <time datetime="2026-12-05">Sa., 5. Dezember 2026</time>
            <span>{battle.hours} Uhr</span>
          </p>
          <h1 id="battle-title"><span>Elite Dance</span> Battle</h1>
          <p class="battle-hero-venue">Elite Dance Studio · Berlin-Moabit</p>
          <ul class="battle-hero-categories" aria-label="Battle-Kategorien">
            {categories.map(([key, name]) => <li class={"battle-color-" + key}>{name}</li>)}
          </ul>

          <div class="battle-hero-actions" data-battle-hero-actions>
            <a class="battle-button battle-button-primary" href="#battle-registration">Für Battles anmelden</a>
            <a class="battle-button battle-button-secondary" href="#spectators">Kostenlos zuschauen</a>
          </div>
          <a class="battle-text-link battle-return-link" href="#battle-entries">Schon gebucht? Kategorien eintragen <span aria-hidden="true">↓</span></a>
        </div>

        <figure class="battle-poster" id="poster">
          <img
            src={posterUrl}
            srcset={baseUrl + poster.small + " " + poster.smallWidth + "w, " + posterUrl + " " + poster.width + "w"}
            sizes="(max-width: 760px) calc(100vw - 32px), (max-width: 1040px) 43vw, 460px"
            width={poster.width}
            height={poster.height}
            fetchpriority="high"
            decoding="async"
            alt="Offizielles Poster des Elite Dance Battle 2026"
          />
        </figure>
      </div>
    </section>

    <section class="battle-program" id="spectators" aria-labelledby="spectators-heading">
      <div class="battle-container battle-program-layout">
        <div class="battle-visitor-info">
          <h2 id="spectators-heading">Kostenlos zuschauen</h2>
          <p>Du kannst ohne Anmeldung vorbeikommen, die Battles anschauen oder bei der Jam Session mittanzen.</p>
          <p class="battle-address" id="final-cta"><strong>Elite Dance Studio</strong><br />Wiclefstraße 16–17 · 10551 Berlin</p>
        </div>

        <div class="battle-timetable" id="battle-schedule">
          <div class="battle-timetable-heading">
            <h3>Tagesprogramm</h3>
            <span>{battle.hours} Uhr</span>
          </div>
          <dl class="battle-program-rows">
            <div><dt>Hauptraum</dt><dd><strong>Battles &amp; Finale</strong><span>Vier Kategorien, Surprise Final Battle und Siegerehrung</span></dd></div>
            <div><dt>Zweiter Raum</dt><dd><strong>Kostenlose Jam Session</strong><span>Offen den ganzen Tag</span></dd></div>
            <div><dt>Im Studio</dt><dd><strong>Essen &amp; Musik</strong></dd></div>
          </dl>
          <p class="battle-program-note">Die Startzeiten der einzelnen Battles geben wir noch bekannt.</p>
        </div>

        <p class="battle-donation">
          Spenden sind freiwillig. Wenn der Termin in deiner Urban Sports Club App verfügbar ist, kannst du das Event auch mit einem Check-in unterstützen.
        </p>
      </div>
    </section>

    <section class="battle-container battle-registration" id="battle-registration" aria-labelledby="register-heading">
      <header class="battle-section-header">
        <h2 id="register-heading">Für Battles anmelden</h2>
        <p>Eine Buchung gilt für den ganzen Tag. Du kannst in mehreren Kategorien antreten.</p>
      </header>

      <div class="battle-registration-step" id="how-it-works">
        <h3><span class="battle-step-number">1</span> Teilnahme buchen</h3>
        <div class="battle-booking-options">
          <a class="battle-booking-option battle-booking-online" href={eversportsBookingUrl} target="_blank" rel="noopener noreferrer">
            <strong>{battle.onlineFee} online <span aria-hidden="true">↗</span></strong>
            <span>Vorab bei Eversports buchen</span>
          </a>
          <div class="battle-booking-option">
            <strong>{battle.doorFee} vor Ort</strong>
            <span>Am Eventtag im Studio anmelden und Kategorien angeben</span>
          </div>
          <a class="battle-booking-option" href={uscBookingUrl} target="_blank" rel="noopener noreferrer">
            <strong>Urban Sports Club <span aria-hidden="true">↗</span></strong>
            <span>Battle am 5. Dezember in der App reservieren und im Studio einchecken</span>
          </a>
        </div>
      </div>

      <div class="battle-registration-step battle-entries" id="battle-entries">
        <h3><span class="battle-step-number">2</span> Kategorien eintragen</h3>
        <p>Nach der Buchung über Eversports oder Urban Sports Club trägst du hier deine Kategorien ein. Nutze die E-Mail-Adresse deiner Buchung.</p>

        <form class="battle-entries-form" action="/api/form" method="post" data-battle-entries-form>
          <input type="hidden" name="form_kind" value="battle" />
          <label hidden>Leer lassen<input type="text" name="_gotcha" tabindex="-1" autocomplete="off" /></label>

          <fieldset class="battle-fieldset" id="choose-your-style">
            <legend>In welchen Kategorien trittst du an?</legend>
            <div class="battle-category-choices">
              {categories.map(([key, name]) => (
                <label class={"battle-category-choice battle-color-" + key}>
                  <input type="checkbox" name="battle_categories" value={key} data-battle-entry-category />
                  <span><strong>{name}</strong><small>{key === "breaking-kids" ? "Eigene Kids-Preise" : "100 € + Medaille"}</small></span>
                </label>
              ))}
            </div>
            <p class="battle-prize-note" id="battle-prizes">Sponsor-Goodie-Bags in allen vier Kategorien. Im Surprise Final Battle treten die Kategoriesieger:innen um einen Extrapreis an.</p>
          </fieldset>

          <div class="battle-kids-consent" data-battle-kids-consent hidden>
            <label class="battle-check">
              <input type="checkbox" name="guardian_consent" value="yes" data-battle-guardian-consent />
              <span>Ich bin erziehungsberechtigt und stimme der Teilnahme meines Kindes am Breaking Kids Battle zu. *</span>
            </label>
            <p>Gib den Namen des Kindes und die Buchungs-E-Mail der erziehungsberechtigten Person an.</p>
          </div>

          <div class="battle-entry-fields">
            <label>Name der teilnehmenden Person *<input name="name" type="text" autocomplete="name" maxlength="160" required /></label>
            <label>E-Mail-Adresse der Buchung *<input name="email" type="email" autocomplete="email" maxlength="254" required /></label>
            <label>Battle-Name (optional)<input name="stage_name" type="text" autocomplete="nickname" maxlength="120" /></label>
          </div>

          <fieldset class="battle-fieldset">
            <legend>Wie hast du gebucht? *</legend>
            <div class="battle-booking-methods">
              <label class="battle-check"><input type="radio" name="booking_method" value="eversports" required /> Eversports</label>
              <label class="battle-check"><input type="radio" name="booking_method" value="usc" required /> Urban Sports Club</label>
            </div>
          </fieldset>

          <div class="battle-confirmations">
            <label class="battle-check"><input type="checkbox" name="booking_confirmed" value="yes" required /> Ich habe den Battle Day bereits über Eversports oder Urban Sports Club gebucht. *</label>
            <label class="battle-check"><input type="checkbox" name="privacy_consent" value="accepted" required /> Ich stimme zu, dass meine Daten zur Organisation der Battle-Teilnahme verarbeitet und mit der Buchung abgeglichen werden. *</label>
          </div>

          <div class="battle-submit">
            <button class="battle-button battle-button-primary" type="submit">Kategorien abschicken <span aria-hidden="true">↗</span></button>
            <p data-battle-entry-status role="status"></p>
          </div>
        </form>
      </div>
    </section>
  </main>

  <SiteFooter brand={site.brand} nav={site.nav} />

  <nav slot="mobile-actions" class="battle-quick-nav" data-battle-quick-nav aria-label="Battle-Schnellzugriff" hidden>
    <a class="battle-button battle-button-primary" href="#battle-registration">Anmelden</a>
    <a class="battle-button battle-button-secondary" href="#battle-schedule">Tagesprogramm</a>
  </nav>
</BaseLayout>

<script>
  const heroActions = document.querySelector<HTMLElement>("[data-battle-hero-actions]");
  const quickNav = document.querySelector<HTMLElement>("[data-battle-quick-nav]");

  if (heroActions && quickNav && "IntersectionObserver" in window) {
    const headerOffset = 76;
    new IntersectionObserver(([entry]) => {
      quickNav.hidden = entry.isIntersecting || entry.boundingClientRect.bottom > headerOffset;
    }, { rootMargin: "-" + headerOffset + "px 0px 0px" }).observe(heroActions);
  }

  const form = document.querySelector<HTMLFormElement>("[data-battle-entries-form]");
  const kidsConsent = form?.querySelector<HTMLElement>("[data-battle-kids-consent]");
  const guardianInput = form?.querySelector<HTMLInputElement>("[data-battle-guardian-consent]");
  const submitButton = form?.querySelector<HTMLButtonElement>("button[type=submit]");
  const status = form?.querySelector<HTMLElement>("[data-battle-entry-status]");

  if (form && kidsConsent && guardianInput && submitButton && status) {
    const categoryInputs = [...form.querySelectorAll<HTMLInputElement>("[data-battle-entry-category]")];
    const kidsInput = categoryInputs.find((input) => input.value === "breaking-kids");

    function syncKidsConsent() {
      const kidsSelected = kidsInput?.checked ?? false;
      kidsConsent.hidden = !kidsSelected;
      guardianInput.required = kidsSelected;
      if (!kidsSelected) guardianInput.checked = false;
    }

    kidsInput?.addEventListener("change", syncKidsConsent);
    window.addEventListener("pageshow", syncKidsConsent);
    syncKidsConsent();

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (submitButton.disabled) return;

      if (!categoryInputs.some((input) => input.checked)) {
        status.textContent = "Bitte wähle mindestens eine Kategorie.";
        categoryInputs[0]?.focus();
        return;
      }

      if (!form.reportValidity()) return;

      if (location.hostname.endsWith("github.io") || location.pathname.startsWith("/preview/")) {
        status.textContent = "Vorschau – deine Auswahl wurde nicht verschickt.";
        return;
      }

      submitButton.disabled = true;
      status.textContent = "Wird verschickt …";

      try {
        const response = await fetch(form.action, {
          method: "POST",
          body: new FormData(form),
          headers: { Accept: "application/json" },
        });

        if (!response.ok || !(await response.json()).ok) throw new Error("send_failed");

        form.reset();
        syncKidsConsent();
        status.textContent = "Danke! Wir haben deine Kategorien erhalten und gleichen sie mit deiner Eventbuchung ab.";
      } catch {
        status.textContent = "Das hat leider nicht geklappt. Bitte versuche es erneut oder kontaktiere uns direkt.";
      } finally {
        submitButton.disabled = false;
      }
    });
  }
</script>

<style is:global>
  body.elite-battle-page {
    background: #141112;
    color: #f8f0e8;
  }

  .elite-battle-page .site-footer {
    background: #141112;
    color: #f8f0e8;
    border-top: 1px solid #453638;
  }

  .elite-battle-page .site-footer a {
    color: #f8f0e8;
  }

  @media (max-width: 760px) {
    body.elite-battle-page {
      padding-bottom: calc(76px + env(safe-area-inset-bottom, 0px));
    }
  }
</style>

<style>
  .battle-main,
  .battle-quick-nav {
    --battle-ink: #171314;
    --battle-text: #f8f0e8;
    --battle-muted: #d4c5bf;
    --battle-accent: #ff917b;
    --battle-action: #f3d2b2;
    --battle-border: #59454a;
    --battle-panel: #231c1e;
    color: var(--battle-text);
    font-family: "Inter", sans-serif;
  }

  .battle-main {
    background: #141112;
  }

  .battle-container {
    width: min(calc(100% - 56px), 1140px);
    margin-inline: auto;
  }

  .battle-main [id] {
    scroll-margin-top: 94px;
  }

  .battle-main h1,
  .battle-main h2,
  .battle-main h3 {
    color: var(--battle-text);
    font-family: "Sora", "Inter", sans-serif;
  }

  .battle-main h2 {
    margin: 0;
    font-size: clamp(1.95rem, 4vw, 3.4rem);
    line-height: 1.05;
    letter-spacing: -.055em;
  }

  .battle-main h3 {
    margin: 0;
    font-size: clamp(1.1rem, 2vw, 1.45rem);
    line-height: 1.25;
    letter-spacing: -.025em;
  }

  .battle-main p {
    color: var(--battle-muted);
    line-height: 1.65;
  }

  .battle-hero {
    background:
      radial-gradient(ellipse at 85% 35%, #412327 0, transparent 62%),
      linear-gradient(142deg, #261b1e 0, #161213 62%);
    border-bottom: 1px solid var(--battle-border);
  }

  .battle-hero-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, .94fr);
    align-items: center;
    gap: clamp(26px, 5.8vw, 92px);
    padding-block: clamp(42px, 5.8vw, 92px);
  }

  .battle-hero-copy {
    min-width: 0;
  }

  .battle-event-date {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 10px;
    margin: 0 0 clamp(12px, 2.5vw, 26px);
    font-size: clamp(.75rem, 1.3vw, .9rem);
    font-weight: 700;
  }

  .battle-event-date span {
    color: var(--battle-action);
  }

  .battle-event-date span::before {
    margin-right: 10px;
    content: "·";
  }

  .battle-hero h1 {
    margin: 0;
    color: var(--battle-accent);
    font-size: clamp(4rem, 9vw, 8.25rem);
    font-weight: 800;
    line-height: .85;
    letter-spacing: -.072em;
    text-transform: uppercase;
  }

  .battle-hero h1 > span {
    display: block;
    margin-bottom: .17em;
    color: var(--battle-text);
    font-size: .56em;
    line-height: 1;
    letter-spacing: -.06em;
  }

  .battle-hero-venue {
    margin: clamp(14px, 2.2vw, 24px) 0 0;
    font-size: clamp(.9rem, 1.45vw, 1.06rem);
    font-weight: 650;
  }

  .battle-hero-categories {
    display: flex;
    flex-wrap: wrap;
    gap: 5px 15px;
    margin: 13px 0 0;
    padding: 0;
    list-style: none;
  }

  .battle-color-breaking-kids { --battle-category-color: #ff9e80; }
  .battle-color-breaking { --battle-category-color: #91dbf8; }
  .battle-color-house { --battle-category-color: #d7aff7; }
  .battle-color-hip-hop { --battle-category-color: #f7a6d3; }

  .battle-hero-categories li {
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--battle-muted);
    font-size: .8rem;
    font-weight: 650;
  }

  .battle-hero-categories li::before {
    flex: 0 0 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--battle-category-color);
    content: "";
  }

  .battle-hero-actions,
  .battle-quick-nav {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 9px;
  }

  .battle-hero-actions {
    width: min(100%, 440px);
    margin-top: clamp(19px, 3vw, 32px);
  }

  .battle-button {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    justify-content: center;
    gap: 9px;
    padding: 9px 11px;
    border: 1px solid transparent;
    border-radius: 8px;
    font: 700 clamp(.75rem, 1.2vw, .92rem)/1.2 "Inter", sans-serif;
    text-align: center;
    text-decoration: none;
    transition: background-color .16s ease, border-color .16s ease;
  }

  .battle-button-primary {
    background: var(--battle-action);
    color: var(--battle-ink);
  }

  .battle-button-primary:hover {
    background: #ffe3c7;
    color: var(--battle-ink);
  }

  .battle-button-secondary {
    border-color: #9c7b78;
    background: #302427;
    color: var(--battle-text);
  }

  .battle-button-secondary:hover {
    background: #493336;
    color: var(--battle-text);
  }

  .battle-text-link {
    display: inline-block;
    color: var(--battle-muted);
    font-size: .82rem;
    font-weight: 650;
    text-decoration: underline;
    text-underline-offset: .2em;
  }

  .battle-text-link:hover {
    color: var(--battle-text);
  }

  .battle-return-link {
    margin-top: 13px;
    padding-block: 6px;
  }

  .battle-main :is(a, button, input):focus-visible,
  .battle-quick-nav a:focus-visible {
    outline: 2px solid var(--battle-action);
    outline-offset: 4px;
  }

  .battle-poster {
    width: min(100%, 460px);
    margin: 0;
    justify-self: end;
    overflow: hidden;
    border: 1px solid #855250;
    border-radius: 14px;
    box-shadow: 0 24px 60px #10090b75;
  }

  .battle-poster img {
    display: block;
    width: 100%;
    height: auto;
  }

  .battle-program {
    padding-block: clamp(36px, 5.4vw, 76px);
    border-bottom: 1px solid var(--battle-border);
    background: #1c1618;
  }

  .battle-program-layout {
    display: grid;
    grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr);
    gap: 16px clamp(25px, 5vw, 78px);
  }

  .battle-visitor-info > p {
    margin: 12px 0 0;
  }

  .battle-visitor-info .battle-address {
    margin-top: 19px;
    font-size: .9rem;
  }

  .battle-address strong {
    color: var(--battle-text);
  }

  .battle-timetable {
    min-width: 0;
    padding: clamp(16px, 3vw, 28px);
    border: 1px solid var(--battle-border);
    border-radius: 12px;
    background: var(--battle-panel);
  }

  .battle-timetable-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 7px 12px;
    padding-bottom: 13px;
  }

  .battle-timetable-heading > span {
    color: var(--battle-action);
    font-size: .84rem;
    font-weight: 700;
  }

  .battle-program-rows {
    margin: 0;
  }

  .battle-program-rows > div {
    display: grid;
    grid-template-columns: minmax(88px, .65fr) minmax(0, 1.55fr);
    gap: 11px;
    padding: 11px 0;
    border-top: 1px solid var(--battle-border);
  }

  .battle-program-rows dt,
  .battle-program-rows dd {
    margin: 0;
  }

  .battle-program-rows dt {
    padding-top: .12em;
    color: var(--battle-muted);
    font-size: .78rem;
  }

  .battle-program-rows dd strong {
    color: var(--battle-text);
    font-size: .92rem;
  }

  .battle-program-rows dd span,
  .battle-program-note,
  .battle-donation {
    display: block;
    color: var(--battle-muted);
    font-size: .8rem;
  }

  .battle-program-note {
    margin: 0;
    padding-top: 10px;
    border-top: 1px solid var(--battle-border);
  }

  .battle-donation {
    grid-column: 1 / -1;
    max-width: 72ch;
    margin: 0;
  }

  .battle-registration {
    padding-block: clamp(38px, 6vw, 85px);
  }

  .battle-section-header {
    margin-bottom: 24px;
  }

  .battle-section-header p {
    margin: 9px 0 0;
  }

  .battle-registration-step {
    padding: clamp(17px, 3.2vw, 32px);
    border: 1px solid var(--battle-border);
    border-radius: 12px;
    background: var(--battle-panel);
  }

  .battle-registration-step + .battle-registration-step {
    margin-top: 12px;
  }

  .battle-registration-step h3 {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .battle-step-number {
    display: inline-grid;
    flex: 0 0 27px;
    min-height: 27px;
    place-items: center;
    border: 1px solid #9c7770;
    border-radius: 50%;
    color: var(--battle-action);
    font: 700 .82rem "Inter", sans-serif;
  }

  .battle-booking-options {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 9px;
    margin-top: 16px;
  }

  .battle-booking-option {
    display: grid;
    align-content: start;
    gap: 5px;
    min-width: 0;
    padding: 13px 14px;
    border: 1px solid var(--battle-border);
    border-radius: 8px;
    background: #1a1517;
    color: var(--battle-text);
    text-decoration: none;
  }

  .battle-booking-option strong {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 6px;
    color: var(--battle-text);
    font-size: .96rem;
  }

  .battle-booking-option > span {
    color: var(--battle-muted);
    font-size: .79rem;
    line-height: 1.5;
  }

  .battle-booking-option strong span {
    color: var(--battle-action);
  }

  .battle-booking-online {
    border-color: #bd947a;
    background: #332628;
  }

  a.battle-booking-option:hover {
    border-color: var(--battle-action);
    background: #432e32;
    color: var(--battle-text);
  }

  .battle-entries > p {
    margin: 10px 0 17px;
  }

  .battle-entries-form {
    display: grid;
    gap: 18px;
  }

  .battle-entries-form [hidden] {
    display: none;
  }

