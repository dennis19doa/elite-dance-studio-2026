---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import site from "../data/site.json";

const categories = [
  { key: "breaking", number: "01", name: "Breaking", motif: "FREESTYLE", label: "Toprock · Footwork", image: "05-breaking.webp", className: "battle-category battle-category-breaking" },
  { key: "hip-hop", number: "02", name: "Hip-Hop", motif: "FREESTYLE", label: "Groove · Freestyle", image: "06-hip-hop-beginner-amy.webp", className: "battle-category battle-category-hiphop" },
  { key: "house", number: "03", name: "House", motif: "FREESTYLE", label: "Rhythm · Footwork", image: "03-house-beginner.webp", className: "battle-category battle-category-house" },
  { key: "bachata", number: "04", name: "Bachata", motif: "FREESTYLE", label: "Musicality · Partnerwork", image: "19-bachata-intermediate.webp", className: "battle-category battle-category-bachata" },
];
---

<BaseLayout
  title="Elite Dance Battle 2026 | Vier Freestyle Battles in Berlin"
  description="Breaking, Hip-Hop, House und Bachata Freestyle am 5. Dezember 2026 in Berlin-Moabit. Vier Kategorien mit je 100€ Preisgeld."
  bodyClass="elite-battle-page"
  noindex={true}
>
  <SiteHeader brand={site.brand} nav={site.nav} />

  <main class="battle-main">
    <section class="battle-hero" aria-labelledby="battle-title">
      <div class="battle-hero-grid" aria-hidden="true"></div>
      <div class="battle-hero-noise" aria-hidden="true"></div>
      <div class="battle-container battle-hero-inner">
        <div class="battle-hero-topline">
          <span class="battle-kicker"><span class="battle-live-dot"></span> Elite Dance Studio presents</span>
          <span class="battle-edition">BERLIN · FIRST EDITION · 2026</span>
        </div>
        <div class="battle-hero-body">
          <div class="battle-hero-copy">
            <p class="battle-eyebrow">Vier Kategorien · Freestyle</p>
            <h1 id="battle-title"><span>ELITE</span><span class="battle-title-outline">DANCE</span><span>BATTLE<span class="battle-title-star">*</span></span></h1>
            <p class="battle-hero-lead">Breaking · Hip-Hop · House · Bachata</p>
            <p class="battle-hero-description">Vier Freestyle-Battles an einem Tag. Jede Kategorie hat ein eigenes Preisgeld.</p>
            <div class="battle-hero-actions">
              <a class="battle-button battle-button-primary" href="#choose-your-style">Kategorien <span aria-hidden="true">↘</span></a>
              <a class="battle-button battle-button-ghost" href="#how-it-works">Anmeldung <span aria-hidden="true">↗</span></a>
            </div>
          </div>
          <aside class="battle-hero-stamp" aria-label="Event-Details">
            <span class="battle-stamp-overline">SAVE THE DATE</span>
            <strong>05<span>.</span>12<span>.</span>26</strong>
            <span class="battle-stamp-rule"></span>
            <span>ELITE DANCE STUDIO</span>
            <span>BERLIN · MOABIT</span>
            <div class="battle-stamp-ring" aria-hidden="true">✳</div>
          </aside>
          <div class="battle-arena-visual" aria-hidden="true">
            <div class="battle-arena-tile battle-arena-tile-one"><img src={`${import.meta.env.BASE_URL}media/style-posters/05-breaking.webp`} alt="" /></div>
            <div class="battle-arena-tile battle-arena-tile-two"><img src={`${import.meta.env.BASE_URL}media/style-posters/06-hip-hop-beginner-amy.webp`} alt="" /></div>
            <div class="battle-arena-tile battle-arena-tile-three"><img src={`${import.meta.env.BASE_URL}media/style-posters/03-house-beginner.webp`} alt="" /></div>
            <div class="battle-arena-tile battle-arena-tile-four"><img src={`${import.meta.env.BASE_URL}media/style-posters/19-bachata-intermediate.webp`} alt="" /></div>
            <div class="battle-arena-orbit"><div class="battle-arena-orbit-inner"><span>SAMSTAG</span><strong>05.12.</strong><span>2026</span></div></div>
            <div class="battle-arena-caption"><span>ELITE DANCE STUDIO</span><span>EDB / 001</span></div>
          </div>
        </div>
        <div class="battle-hero-stats">
          <div><strong>04</strong><span>Freestyle-Kategorien</span></div>
          <div><strong>04</strong><span>Gewinner:innen</span></div>
          <div><strong>100<span>€</span></strong><span>Preis pro Kategorie*</span></div>
          <div class="battle-stats-tail">SPONSOR GOODIE BAGS <span aria-hidden="true">↗</span></div>
        </div>
      </div>
    </section>

    <div class="battle-ticker" aria-hidden="true">
      <div>BREAKING FREESTYLE ✳ HIP-HOP FREESTYLE ✳ HOUSE FREESTYLE ✳ BACHATA FREESTYLE ✳ 05.12.2026 ✳</div>
      <div>BREAKING FREESTYLE ✳ HIP-HOP FREESTYLE ✳ HOUSE FREESTYLE ✳ BACHATA FREESTYLE ✳ 05.12.2026 ✳</div>
    </div>

    <section class="battle-choose-section battle-container" id="choose-your-style" aria-labelledby="choose-heading">
      <div class="battle-section-heading">
        <div><p class="battle-section-label">01 / Kategorien</p><h2 id="choose-heading">FREESTYLE <em>BATTLES.</em></h2></div>
        <p>Wähle deine Kategorie. Du kannst auch bei mehreren Freestyle-Battles teilnehmen.</p>
      </div>
      <div class="battle-category-grid" role="group" aria-label="Battle-Kategorie auswählen">
        {categories.map((category) => (
          <button
            type="button"
            class={category.className}
            data-select-style={category.key}
            aria-pressed="false"
            aria-controls="battle-registration"
          >
            <span class="battle-category-top"><span>EDB / {category.number}</span><span class="battle-select-indicator" aria-hidden="true">↗</span></span>
            <img class="battle-category-photo" src={`${import.meta.env.BASE_URL}media/style-posters/${category.image}`} alt="" loading="lazy" decoding="async" /><span class="battle-category-photo-wash" aria-hidden="true"></span>
            <span class="battle-category-art" aria-hidden="true">{category.motif.split(" / ").map((word) => <span>{word}</span>)}</span>
            <span class="battle-category-lower">
              <span class="battle-category-name">{category.name} Freestyle</span>
              <span class="battle-category-traits">{category.label}</span>
            </span>
            <span class="battle-category-footer"><span><strong>100€</strong> Preisgeld*</span><span class="battle-select-text">Auswählen ↗</span></span>
          </button>
        ))}
      </div>
      <div class="battle-selection-deck" aria-live="polite">
        <div class="battle-selection-indicator"><span>◉</span><small>DEINE KATEGORIE</small></div>
        <strong data-battle-selected-name>Noch keine Kategorie gewählt</strong>
        <a href="#battle-registration" data-battle-next>Buchungsoptionen <span aria-hidden="true">↗</span></a>
      </div>
      <p class="battle-choose-footnote">* Aktuell 100€ je Gewinner:in. Das Preisgeld kann sich noch erhöhen. Zusätzlich sind Goodie Bags von Sponsoren geplant.</p>
    </section>

    <section class="battle-register-section" id="battle-registration" aria-labelledby="register-heading">
      <div class="battle-container battle-register-grid">
        <div class="battle-register-intro">
          <p class="battle-section-label">02 / Anmeldung</p>
          <h2 id="register-heading">SO FUNKTIONIERT DIE <em>BUCHUNG.</em></h2>
          <p>Jede Kategorie wird einzeln gebucht. Die Online-Zahlung soll direkt über Eversports laufen.</p>
          <div class="battle-register-steps" id="how-it-works">
            <div><span>01</span><div><strong>Freestyle-Kategorie auswählen</strong><p>Breaking, Hip-Hop, House oder Bachata.</p></div></div>
            <div><span>02</span><div><strong>Über Eversports buchen</strong><p>Ein Ticket pro Kategorie.</p></div></div>
            <div><span>03</span><div><strong>Bestätigung erhalten</strong><p>Die Eversports-Buchung bestätigt deinen Platz.</p></div></div>
          </div>
          <div class="battle-ticket-note"><span class="battle-ticket-note-icon" aria-hidden="true">€</span><div><strong>5€ online — Preisvorschlag</strong><p>Am Eventtag könnte die Anmeldung zum Beispiel 8€ kosten, sofern noch Plätze frei sind.</p></div></div>
        </div>
        <div class="battle-register-card">
          <div class="battle-form-heading"><span>ELITE BATTLE / 05.12.2026</span><span class="battle-form-availability">BUCHUNG FOLGT</span></div>
          <h3>Kategorie buchen</h3>
          <p class="battle-form-description">Wähle eine Kategorie und deinen Buchungsweg. Die Links folgen, sobald das Ticketing eingerichtet ist.</p>
          <div class="battle-selected-style" aria-live="polite"><span>KATEGORIE</span><strong data-style-display>Noch nicht gewählt</strong></div>
          <div class="battle-booking-options" role="group" aria-label="Buchungsweg auswählen">
            <button type="button" class="battle-booking-option is-active" data-book-choice="eversports" aria-pressed="true"><span><strong>Eversports</strong><small>Online-Ticket pro Freestyle-Kategorie</small></span><b>5€*</b></button>
            <button type="button" class="battle-booking-option" data-book-choice="usc" aria-pressed="false"><span><strong>Urban Sports Club</strong><small>Nur falls das Event für USC freigegeben ist</small></span><b class="battle-usc-state">In Prüfung</b></button>
          </div>
          <p class="battle-price-disclaimer" data-book-notice>* 5€ ist ein Preisvorschlag. Aktuell ist noch keine Zahlung möglich.</p>
          <button type="button" class="battle-submit" disabled><span data-book-button>Eversports-Buchungslink folgt</span><span aria-hidden="true">↗</span></button>
          <p class="battle-form-hint">Keine Zahlung und keine verbindliche Reservierung auf dieser Entwurfsseite.</p>
        </div>
      </div>
    </section>

    <section class="battle-prizes-section battle-container" aria-labelledby="prizes-heading">
      <div class="battle-prizes-lead"><span class="battle-section-label">03 / Preise</span><h2 id="prizes-heading">PREISGELD &amp;<br /><em>GOODIE BAGS</em></h2></div>
      <div class="battle-prize-block"><span class="battle-prize-overline">AKTUELLES PREISGELD / PRO KATEGORIE</span><div class="battle-prize-amount">100<span>€</span></div><p>Aktuell 100€ je Gewinner:in.</p><span class="battle-prize-future">Weitere Sponsoren möglich</span></div>
      <div class="battle-goodies-block"><span aria-hidden="true">✳</span><h3>SPONSOR<br />GOODIE BAGS</h3><p>Zusätzliche Preise und Goodie Bags von unseren Sponsoren. Details folgen.</p></div>
    </section>

    <section class="battle-workshop-strip" aria-label="Workshops und Urban Sports Club">
      <div class="battle-container battle-workshop-inner">
        <div><span class="battle-section-label">Workshops</span><h2>WORKSHOPS &amp;<br /><em>CLASSES</em></h2></div>
        <div><p>Weitere Classes und Workshops sind geplant. Zeiten und Buchungsmöglichkeiten folgen mit dem Programm.</p><span>WORKSHOP-DETAILS FOLGEN</span></div>
      </div>
    </section>

    <section class="battle-schedule-section" aria-labelledby="schedule-heading">
      <div class="battle-container battle-schedule-layout">
        <div><p class="battle-section-label">04 / Programm</p><h2 id="schedule-heading">ZEITPLAN <em>FOLGT.</em></h2><p>Samstag, 5. Dezember 2026 im Elite Dance Studio in Berlin-Moabit. Zeiten und Regeln veröffentlichen wir noch.</p><a href="https://www.instagram.com/elitedanceberlin/" target="_blank" rel="noopener noreferrer">Updates auf Instagram ↗</a></div>
        <div class="battle-lineup-card"><div class="battle-lineup-top"><span>SAT / 05 DEC</span><span>2026</span></div>{categories.map((category) => <div class="battle-lineup-item"><span>{category.number}</span><strong>{category.name} Freestyle</strong><small>UHRZEIT FOLGT</small></div>)}<div class="battle-lineup-foot">VOLLSTÄNDIGES PROGRAMM FOLGT <span aria-hidden="true">↘</span></div></div>
      </div>
    </section>

    <section class="battle-last-cta battle-container" aria-labelledby="final-cta"><p class="battle-section-label">ELITE DANCE BATTLE 2026</p><h2 id="final-cta">5. DEZEMBER<br /><em>2026</em></h2><a class="battle-button battle-button-primary" href="#choose-your-style">Kategorien ansehen <span aria-hidden="true">↗</span></a><p>Elite Dance Studio · Wiclefstraße 16–17 · 10551 Berlin-Moabit</p></section>
  </main>

  <SiteFooter brand={site.brand} nav={site.nav} />
</BaseLayout>

<script is:inline>
  (() => {
    const cards = Array.from(document.querySelectorAll("[data-select-style]"));
    const names = { breaking: "Breaking Freestyle", "hip-hop": "Hip-Hop Freestyle", house: "House Freestyle", bachata: "Bachata Freestyle" };
    const selectedName = document.querySelector("[data-battle-selected-name]");
    const bookingName = document.querySelector("[data-style-display]");
    const deck = document.querySelector(".battle-selection-deck");
    const motion = matchMedia("(hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)").matches;
    cards.forEach((card) => {
      card.addEventListener("click", () => {
        const style = names[card.dataset.selectStyle] || "Freestyle";
        cards.forEach((item) => {
          const chosen = item === card;
          item.classList.toggle("is-selected", chosen);
          item.setAttribute("aria-pressed", String(chosen));
          const indicator = item.querySelector(".battle-select-text");
          if (indicator) indicator.textContent = chosen ? "Ausgewählt ✓" : "Auswählen ↗";
        });
        if (selectedName) selectedName.textContent = style;
        if (bookingName) bookingName.textContent = style;
        deck?.classList.add("has-selection");
      });
      if (motion) {
        card.addEventListener("pointermove", (event) => {
          const box = card.getBoundingClientRect();
          const x = (event.clientX - box.left) / box.width;
          const y = (event.clientY - box.top) / box.height;
          card.style.setProperty("--px", Math.round(x * 100) + "%");
          card.style.setProperty("--py", Math.round(y * 100) + "%");
          card.style.setProperty("--ty", ((x - .5) * 5).toFixed(2) + "deg");
          card.style.setProperty("--tx", ((.5 - y) * 4).toFixed(2) + "deg");
        });
        card.addEventListener("pointerleave", () => {
          card.style.setProperty("--tx", "0deg"); card.style.setProperty("--ty", "0deg");
          card.style.setProperty("--px", "50%"); card.style.setProperty("--py", "50%");
        });
      }
    });
    const methods = Array.from(document.querySelectorAll("[data-book-choice]"));
    const notice = document.querySelector("[data-book-notice]");
    const buttonText = document.querySelector("[data-book-button]");
    methods.forEach((button) => button.addEventListener("click", () => {
      const usc = button.dataset.bookChoice === "usc";
      methods.forEach((item) => {
        const chosen = item === button;
        item.classList.toggle("is-active", chosen);
        item.setAttribute("aria-pressed", String(chosen));
      });
      if (notice) notice.textContent = usc ? "Die USC-Teilnahme muss erst bestätigt werden. Aktuell ist keine Reservierung möglich." : "* 5€ ist ein Preisvorschlag. Aktuell ist noch keine Zahlung möglich.";
      if (buttonText) buttonText.textContent = usc ? "USC-Reservierung folgt" : "Eversports-Buchungslink folgt";
    }));
  })();
</script>

<style is:global>
  body.elite-battle-page { background: #0c0d10; color: #f5f2ec; }
  body.elite-battle-page .site-header { background: rgba(12,13,16,.95); border-bottom: 1px solid rgba(255,255,255,.12); }
  body.elite-battle-page .site-header .nav-link,
  body.elite-battle-page .site-header .nav-dropdown > summary,
  body.elite-battle-page .site-header .header-contact-button-v17 { color: #f5f2ec; }
  body.elite-battle-page .site-footer { background: #0c0d10; color: #f5f2ec; border-top: 1px solid rgba(255,255,255,.12); }
  body.elite-battle-page .site-footer a { color: #f5f2ec; }
  body.elite-battle-page .mobile-menu { background: #17191f; }
  body.elite-battle-page .mobile-nav > summary { color: #fff; }
  body.elite-battle-page .nav-dropdown-menu { background: #17191f; }
  body.elite-battle-page .nav-dropdown-link span { color: #f5f2ec; }
  body.elite-battle-page .page-shell { max-width: 1180px; }
</style>

<style>
  .battle-main { font-family: "Inter",sans-serif; --acid:#d8fa53; --ink:#0c0d10; --cream:#f5f2ec; background: var(--ink); color: var(--cream); overflow: clip; }
  .battle-container { width: min(calc(100% - 48px), 1180px); margin: 0 auto; }
  .battle-main h1,.battle-main h2,.battle-main h3,.battle-category-name { font-family: "Sora","Inter",sans-serif; }
  .battle-main em { font-style: normal; color: var(--acid); }
  .battle-section-label,.battle-eyebrow { margin: 0; color: var(--acid); font-size: .74rem; font-weight: 800; letter-spacing: .18em; text-transform: uppercase; }
  .battle-hero { position: relative; min-height: 690px; isolation: isolate; background: radial-gradient(circle at 83% 28%,rgba(216,250,83,.13),transparent 23rem),radial-gradient(circle at 17% 80%,rgba(236,75,94,.14),transparent 22rem),#0c0d10; }
  .battle-hero-grid { position: absolute; inset: 0; z-index: -1; opacity: .18; background-image: linear-gradient(90deg,rgba(255,255,255,.09) 1px,transparent 1px),linear-gradient(rgba(255,255,255,.09) 1px,transparent 1px); background-size: 58px 58px; mask-image:linear-gradient(90deg,transparent,black 25%,black 80%,transparent); }
  .battle-hero-noise { position:absolute; inset: 0; z-index:-1; pointer-events:none; opacity:.2; background:repeating-linear-gradient(150deg,transparent 0 18px,rgba(255,255,255,.025) 19px 20px); }
  .battle-hero-inner { padding: 34px 0 0; }
  .battle-hero-topline { display:flex; justify-content:space-between; align-items:center; gap:16px; border-bottom:1px solid rgba(255,255,255,.22); padding-bottom:16px; }
  .battle-kicker,.battle-edition { font-size:.7rem; text-transform:uppercase; font-weight:800; letter-spacing:.15em; }
  .battle-kicker { display:flex; align-items:center; gap:11px; }
  .battle-live-dot { width:8px; height:8px; border-radius:50%; background:var(--acid); box-shadow:0 0 16px rgba(216,250,83,.85); }
  .battle-edition { color:#a4a5a6; }
  .battle-hero-body { display:grid; grid-template-columns:minmax(0,1fr) 270px; align-items:end; gap:36px; padding:70px 0 68px; }
  .battle-hero-copy { min-width:0; }
  .battle-hero h1 { display:flex; flex-direction:column; margin:18px 0 25px; font-weight:800; font-size:clamp(4.2rem,9.7vw,9.1rem); line-height:.84; letter-spacing:-.085em; color:#f5f2ec; }
  .battle-title-outline { color:transparent; -webkit-text-stroke: 2px var(--cream); }
  .battle-title-star { color:var(--acid); font-size:.55em; vertical-align:top; -webkit-text-stroke:0; margin-left:6px; }
  .battle-hero-lead { font-family:"Sora",sans-serif; font-size:clamp(1.05rem,2vw,1.4rem); font-weight:800; letter-spacing:-.03em; }
  .battle-hero-description { max-width:600px; color:#acacb0; line-height:1.7; margin-top:14px; font-size:.95rem; }
  .battle-hero-actions { display:flex; gap:12px; flex-wrap:wrap; margin-top:30px; }
  .battle-button { display:inline-flex; align-items:center; justify-content:space-between; gap:36px; min-height:52px; padding:0 22px; text-decoration:none; font-size:.85rem; font-weight:800; text-transform:uppercase; letter-spacing:.04em; transition:transform .18s ease,background .18s ease; }
  .battle-button:hover { transform:translateY(-3px); }
  .battle-button:focus-visible,.battle-category:focus-visible,.battle-submit:focus-visible { outline:3px solid #fff; outline-offset:4px; }
  .battle-button-primary { background:var(--acid); color:var(--ink); }
  .battle-button-ghost { border:1px solid rgba(255,255,255,.34); color:var(--cream); }
  .battle-hero-stamp { position:relative; padding:24px 20px 32px; min-height:312px; display:flex; flex-direction:column; justify-content:center; align-items:center; gap:9px; border:2px solid var(--acid); text-align:center; transform:rotate(4deg); }
  .battle-stamp-overline { font-weight:900; letter-spacing:.23em; font-size:.65rem; color:var(--acid); }
  .battle-hero-stamp strong { font-family:"Sora",sans-serif; font-size:2.65rem; letter-spacing:-.08em; white-space:nowrap; }
  .battle-hero-stamp strong span { color:var(--acid); }
  .battle-hero-stamp > span:not(.battle-stamp-overline):not(.battle-stamp-rule):not(.battle-stamp-ring) { font-size:.65rem; font-weight:800; letter-spacing:.09em; }
  .battle-stamp-rule { display:block; width:75%; height:1px; background:var(--acid); margin:9px 0; }
  .battle-stamp-ring { position:absolute; left:-28px; bottom:-32px; display:grid; place-items:center; width:76px; height:76px; border-radius:50%; background:var(--acid); color:var(--ink); font-size:3.6rem; }
  .battle-hero-stats { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)) auto; border-top:1px solid rgba(255,255,255,.22); }
  .battle-hero-stats > div { padding:22px 20px 26px 0; border-right:1px solid rgba(255,255,255,.16); }
  .battle-hero-stats strong { display:block; font-family:"Sora",sans-serif; font-size:2.35rem; line-height:1; letter-spacing:-.08em; }
  .battle-hero-stats strong span { color:var(--acid); }
  .battle-hero-stats div > span { display:block; margin-top:6px; color:#aaaab0; font-size:.72rem; letter-spacing:.06em; text-transform:uppercase; }
  .battle-hero-stats .battle-stats-tail { display:flex; align-items:center; gap:14px; max-width:180px; padding-left:24px; border-right:0; font-size:.7rem; font-weight:800; line-height:1.6; }
  .battle-stats-tail span { font-size:1.2rem !important; color:var(--acid) !important; }
  .battle-ticker { display:flex; gap:36px; width:100%; padding:13px 0; background:var(--acid); color:var(--ink); font-family:"Sora",sans-serif; font-size:1.12rem; font-weight:800; letter-spacing:.03em; white-space:nowrap; overflow:hidden; }
  .battle-ticker div { flex:0 0 auto; animation:battle-marquee 30s linear infinite; }
  @keyframes battle-marquee { to{transform:translateX(calc(-100% - 36px))} }
  .battle-choose-section { padding:108px 0 112px; scroll-margin-top:95px; }
  .battle-section-heading { display:flex; align-items:end; justify-content:space-between; gap:44px; margin-bottom:38px; }
  .battle-section-heading h2,.battle-register-intro h2,.battle-prizes-lead h2,.battle-schedule-layout h2,.battle-last-cta h2 { margin:14px 0 0; font-size:clamp(2.6rem,5.6vw,5.4rem); font-weight:800; line-height:.96; letter-spacing:-.065em; }
