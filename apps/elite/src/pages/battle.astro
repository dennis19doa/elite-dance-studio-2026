<script is:inline>
  (() => {
    const cards = Array.from(document.querySelectorAll("[data-select-style]"));
    const inputs = Array.from(document.querySelectorAll("[data-battle-entry-category]"));
    const deckLabel = document.querySelector("[data-battle-selected-name]");
    const deck = document.querySelector(".battle-selection-deck");
    const names = { "breaking-kids": "Breaking Kids", breaking: "Breaking", "hip-hop": "Hip-Hop", house: "House" };
    const chosen = new Set();
    const guardianBlock = document.querySelector("[data-kids-consent]");
    const guardianInput = document.querySelector("[data-guardian-consent]");
    const update = () => {
      cards.forEach((card) => {
        const yes = chosen.has(card.dataset.selectStyle);
        card.classList.toggle("is-selected", yes);
        card.setAttribute("aria-pressed", String(yes));
        const text = card.querySelector(".battle-select-text");
        if (text) text.textContent = yes ? "Vorgemerkt ✓" : "Merken +";
      });
      inputs.forEach((input) => { input.checked = chosen.has(input.value); });
      if (deckLabel) deckLabel.textContent = chosen.size ? Array.from(chosen).map((key) => names[key]).join(" · ") : "Mehrere Kategorien möglich";
      deck?.classList.toggle("has-selection", chosen.size > 0);
      const kidsSelected = chosen.has("breaking-kids");
      if (guardianBlock) guardianBlock.hidden = !kidsSelected;
      if (guardianInput) { guardianInput.required = kidsSelected; if (!kidsSelected) guardianInput.checked = false; }
    };
    const motion = matchMedia("(hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)").matches;
    cards.forEach((card) => {
      card.addEventListener("click", () => {
        const key = card.dataset.selectStyle;
        if (chosen.has(key)) chosen.delete(key); else chosen.add(key);
        update();
      });
      if (motion) {
        card.addEventListener("pointermove", (event) => {
          const rect = card.getBoundingClientRect();
          card.style.setProperty("--px", Math.round(((event.clientX - rect.left) / rect.width) * 100) + "%");
          card.style.setProperty("--py", Math.round(((event.clientY - rect.top) / rect.height) * 100) + "%");
        });
        card.addEventListener("pointerleave", () => {
          card.style.setProperty("--px", "50%");
          card.style.setProperty("--py", "50%");
        });
      }
    });
    inputs.forEach((input) => input.addEventListener("change", () => {
      if (input.checked) chosen.add(input.value); else chosen.delete(input.value);
      update();
    }));
    const form = document.querySelector("[data-battle-entries-form]");
    if (!form) return;
    const status = form.querySelector("[data-battle-entry-status]");
    const button = form.querySelector("[data-battle-entry-send]");
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!chosen.size) {
        if (status) status.textContent = "Bitte wähle mindestens eine Kategorie.";
        inputs[0]?.focus();
        return;
      }
      if (!form.reportValidity()) return;
      if (location.hostname.endsWith("github.io") || location.pathname.startsWith("/preview/")) {
        if (status) status.textContent = "Vorschau: Deine Auswahl wurde nicht verschickt.";
        return;
      }
      if (button) button.disabled = true;
      if (status) status.textContent = "Wird verschickt …";
      try {
        const response = await fetch(form.action, { method: "POST", body: new FormData(form), headers: { Accept: "application/json" } });
        const result = await response.json();
        if (!response.ok || !result.ok) throw new Error("send_failed");
        if (status) status.textContent = "Danke! Wir haben deine Kategorien erhalten und gleichen sie mit deiner Eventbuchung ab.";
        form.reset();
        chosen.clear();
        update();
      } catch {
        if (status) status.textContent = "Das hat leider nicht geklappt. Bitte versuche es erneut oder kontaktiere uns direkt.";
      } finally {
        if (button) button.disabled = false;
      }
    });
  })();
</script>

