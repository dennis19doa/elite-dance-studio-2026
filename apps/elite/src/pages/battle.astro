---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import site from "../data/site.json";

const categories = [
  { key: "breaking", number: "01", name: "Breaking", motif: "BREAK / THE / FLOOR", label: "Power · Flow · Freestyle", className: "battle-category battle-category-breaking" },
  { key: "hip-hop", number: "02", name: "Hip-Hop", motif: "OWN / THE / BEAT", label: "Groove · Attitude · Musicality", className: "battle-category battle-category-hiphop" },
  { key: "house", number: "03", name: "House", motif: "FEEL / THE / FLOW", label: "Footwork · Rhythm · Soul", className: "battle-category battle-category-house" },
  { key: "bachata", number: "04", name: "Bachata", motif: "MOVE / WITH / MUSIC", label: "Connection · Rhythm · Creativity", className: "battle-category battle-category-bachata" },
];
---

<BaseLayout
  title="Elite Dance Battle 2026 | Breaking, Hip-Hop, House & Bachata in Berlin"
  description="Vier Styles, vier Battles, vier Preisgelder: Elite Dance Battle am 5. Dezember 2026 in Berlin-Moabit. Wähle deine Kategorie und melde dich an."
  bodyClass="elite-battle-page"
  noindex={true}
>
  <SiteHeader brand={site.brand} nav={site.nav} />

  <main class="battle-main">
    <section class="battle-hero" aria-labelledby="battle-title">
      <div class="battle-hero-grid" aria-hidden="true"></div>
      <div class="battle-hero-noise" aria-hidden="true"></div>
      <div class="battle-container battle-hero-inner">
        <div class="battle-hero-topline">
          <span class="battle-kicker"><span class="battle-live-dot"></span> Elite Dance Studio presents</span>
          <span class="battle-edition">BERLIN · FIRST EDITION · 2026</span>
        </div>
        <div class="battle-hero-body">
          <div class="battle-hero-copy">
            <p class="battle-eyebrow">Four styles. One floor.</p>
            <h1 id="battle-title"><span>ELITE</span><span class="battle-title-outline">DANCE</span><span>BATTLE<span class="battle-title-star">*</span></span></h1>
            <p class="battle-hero-lead">Your style. Your round. Your moment.</p>
            <p class="battle-hero-description">Vier Communities. Vier Battles. Eine Bühne für deinen eigenen Style. Egal, woher du kommst: Bring deine Energie mit auf den Floor.</p>
            <div class="battle-hero-actions">
              <a class="battle-button battle-button-primary" href="#choose-your-style">Choose your style <span aria-hidden="true">↘</span></a>
              <a class="battle-button battle-button-ghost" href="#how-it-works">So funktioniert's <span aria-hidden="true">↗</span></a>
            </div>
          </div>
          <aside class="battle-hero-stamp" aria-label="Event-Details">
            <span class="battle-stamp-overline">SAVE THE DATE</span>
            <strong>05<span>.</span>12<span>.</span>26</strong>
            <span class="battle-stamp-rule"></span>
            <span>ELITE DANCE STUDIO</span>
            <span>BERLIN · MOABIT</span>
            <div class="battle-stamp-ring" aria-hidden="true">✳</div>
          </aside>
        </div>
        <div class="battle-hero-stats">
          <div><strong>04</strong><span>Battle Styles</span></div>
          <div><strong>04</strong><span>Winners</span></div>
          <div><strong>100<span>€</span></strong><span>Prize per Style*</span></div>
          <div class="battle-stats-tail">PLUS SPONSOR GOODIE BAGS <span aria-hidden="true">↗</span></div>
        </div>
      </div>
    </section>

    <div class="battle-ticker" aria-hidden="true">
      <div>BREAKING ✳ HIP-HOP ✳ HOUSE ✳ BACHATA ✳ YOUR FLOOR. YOUR RULES. ✳</div>
      <div>BREAKING ✳ HIP-HOP ✳ HOUSE ✳ BACHATA ✳ YOUR FLOOR. YOUR RULES. ✳</div>
    </div>

    <section class="battle-choose-section battle-container" id="choose-your-style" aria-labelledby="choose-heading">
      <div class="battle-section-heading">
        <div><p class="battle-section-label">01 / Pick your arena</p><h2 id="choose-heading">CHOOSE YOUR <em>STYLE.</em></h2></div>
        <p>Du entscheidest, auf welchem Floor du antrittst. Jede Kategorie ist ein eigenes Battle mit eigenem Gewinnerpreis.</p>
      </div>
      <div class="battle-category-grid" role="group" aria-label="Battle-Kategorie auswählen">
        {categories.map((category) => (
          <button
            type="button"
            class={category.className}
            data-select-style={category.key}
            aria-pressed="false"
            aria-controls="battle-registration"
          >
            <span class="battle-category-top"><span>{category.number} / BATTLE</span><span class="battle-select-indicator" aria-hidden="true">↗</span></span>
            <span class="battle-category-art" aria-hidden="true">{category.motif.split(" / ").map((word) => <span>{word}</span>)}</span>
            <span class="battle-category-lower">
              <span class="battle-category-name">{category.name}</span>
              <span class="battle-category-traits">{category.label}</span>
            </span>
            <span class="battle-category-footer"><span><strong>100€</strong> Winner prize*</span><span class="battle-select-text">Select style →</span></span>
          </button>
        ))}
      </div>
      <p class="battle-choose-footnote">* Derzeit 100€ Preisgeld pro Kategorie. Das Preisgeld kann sich durch weitere Partner noch erhöhen. Dazu kommen Goodie Bags unserer Sponsoren.</p>
    </section>

    <section class="battle-register-section" id="battle-registration" aria-labelledby="register-heading">
      <div class="battle-container battle-register-grid">
        <div class="battle-register-intro">
          <p class="battle-section-label">02 / Claim your spot</p>
          <h2 id="register-heading">READY TO <em>BATTLE?</em></h2>
          <p>Ein Style, eine Anmeldung. Du kannst dich für weitere Kategorien separat anmelden.</p>
          <div class="battle-register-steps" id="how-it-works">
            <div><span>01</span><div><strong>Wähle dein Battle</strong><p>Breaking, Hip-Hop, House oder Bachata.</p></div></div>
            <div><span>02</span><div><strong>Schick deine Anmeldung ab</strong><p>Wir erhalten deine Daten und deine gewählte Kategorie.</p></div></div>
            <div><span>03</span><div><strong>Reserviere und buche deinen Platz</strong><p>Danach schließt du die Buchung über Eversports oder die reservierte USC-Option ab.</p></div></div>
          </div>
          <div class="battle-ticket-note">
            <span class="battle-ticket-note-icon" aria-hidden="true">%</span>
            <div><strong>Online anmelden. Weniger zahlen.</strong><p>Der Vorverkauf wird günstiger als die Anmeldung am Veranstaltungstag. Die genauen Preise veröffentlichen wir mit den Buchungslinks.</p></div>
          </div>
        </div>
        <div class="battle-register-card">
          <div class="battle-form-heading"><span>REGISTRATION / 2026</span><span class="battle-form-availability">Booking setup in progress</span></div>
          <h3>Dein Platz auf dem Floor.</h3>
          <p class="battle-form-description">Wähle zuerst eine Battle-Kategorie. Die Anmeldung ist eine Voranmeldung; dein Platz wird erst durch die anschließende Buchung bestätigt.</p>
          <form id="battle-signup-form" action="/api/battle-register" method="post" data-battle-form>
            <input type="hidden" name="form_kind" value="battle" />
            <input type="hidden" name="style" value="" data-chosen-style />
            <label class="battle-honeypot" aria-hidden="true">Leave empty <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" /></label>

            <div class="battle-selected-style" aria-live="polite"><span>YOUR STYLE</span><strong data-style-display>Choose a style above ↑</strong></div>
            <div class="battle-field-row">
              <label class="battle-field"><span>Name *</span><input name="name" type="text" placeholder="Dein Name" autocomplete="name" maxlength="160" required /></label>
              <label class="battle-field"><span>E-Mail *</span><input name="email" type="email" placeholder="you@example.com" autocomplete="email" maxlength="254" required /></label>
            </div>
            <label class="battle-field"><span>Telefon / WhatsApp <small>optional</small></span><input name="phone" type="tel" placeholder="Für kurzfristige Event-Updates" autocomplete="tel" maxlength="80" /></label>
            <fieldset class="battle-booking-methods">
              <legend>Wie willst du buchen? *</legend>
              <label><input type="radio" name="booking_method" value="eversports" checked /><span><strong>Eversports</strong><small>Online-Vorverkauf · vergünstigter Preis (folgt)</small></span></label>
              <label><input type="radio" name="booking_method" value="usc" /><span><strong>Urban Sports Club</strong><small>Platz über USC reservieren · vorbehaltlich verfügbarer Plätze</small></span></label>
            </fieldset>
            <label class="battle-consent"><input type="checkbox" name="privacy_consent" value="accepted" required /><span>Ich bin einverstanden, dass Elite Dance Studio meine Daten zur Bearbeitung meiner Battle-Anmeldung nutzt und mich dazu kontaktiert. *</span></label>
            <button class="battle-submit" type="submit" disabled data-battle-submit>Select a style to continue <span aria-hidden="true">↗</span></button>
            <p class="battle-form-hint">Noch keine Zahlung auf dieser Seite. Für eine verbindliche Teilnahme ist die anschließende Buchung erforderlich.</p>
            <p class="battle-form-status" data-battle-status role="status" aria-live="polite" hidden></p>
          </form>
          <div class="battle-success" data-battle-success hidden role="status" aria-live="polite">
            <span>✓ STEP 1 COMPLETE</span>
            <h4>Voranmeldung eingegangen.</h4>
            <p data-success-copy>Deine Anmeldung wurde an unser Team geschickt.</p>
            <div class="battle-success-next">Nächster Schritt: die Buchung über Eversports bzw. USC abschließen. Die jeweiligen Links werden veröffentlicht, sobald die Buchung freigeschaltet ist.</div>
            <button type="button" data-battle-again>Weitere Kategorie anmelden ↗</button>
          </div>
        </div>
      </div>
    </section>

    <section class="battle-prizes-section battle-container" aria-labelledby="prizes-heading">
      <div class="battle-prizes-lead"><span class="battle-section-label">03 / The rewards</span><h2 id="prizes-heading">BRING THE <em>HEAT.</em><br />TAKE THE PRIZE.</h2></div>
      <div class="battle-prize-block"><span class="battle-prize-overline">CURRENT WINNER PRIZE / EACH STYLE</span><div class="battle-prize-amount">100<span>€</span></div><p>4 Styles. 4 Gewinner:innen. Und das ist erst der Anfang.</p><span class="battle-prize-future">Prize pool may grow ↗</span></div>
      <div class="battle-goodies-block"><span aria-hidden="true">✳</span><h3>SPONSOR<br />GOODIE BAGS</h3><p>Zusätzlich warten Goodie Bags unserer Partner auf die Gewinner:innen. Wir stellen die Sponsoren in Kürze vor.</p></div>
    </section>

    <section class="battle-workshop-strip" aria-label="Workshops und Urban Sports Club">
      <div class="battle-container battle-workshop-inner">
        <div><span class="battle-section-label">Bonus / Join the session</span><h2>NOT BATTLING?<br /><em>STILL JOIN IN.</em></h2></div>
        <div><p>Auch Classes und Workshops rund um den Battle Day sind geplant. Die Termine und Möglichkeiten zur Reservierung über Urban Sports Club veröffentlichen wir mit dem vollständigen Programm.</p><span>WORKSHOP BOOKINGS &amp; USC AVAILABILITY — COMING SOON ↗</span></div>
      </div>
    </section>

    <section class="battle-schedule-section" aria-labelledby="schedule-heading">
      <div class="battle-container battle-schedule-layout">
        <div><p class="battle-section-label">04 / The day</p><h2 id="schedule-heading">THE LINEUP <em>IS COMING.</em></h2><p>Die Battles finden am Samstag, 5. Dezember 2026, in unserem Studio in Berlin-Moabit statt. Den vollständigen Zeitplan, Regeln und die Details zu den Runden veröffentlichen wir bald.</p><a href="https://www.instagram.com/elitedanceberlin/" target="_blank" rel="noopener noreferrer">Updates auf Instagram ↗</a></div>
        <div class="battle-lineup-card"><div class="battle-lineup-top"><span>SAT / 05 DEC</span><span>2026</span></div>{categories.map((category) => <div class="battle-lineup-item"><span>{category.number}</span><strong>{category.name}</strong><small>TIME TBA</small></div>)}<div class="battle-lineup-foot">FULL SCHEDULE DROPPING SOON <span aria-hidden="true">↘</span></div></div>
      </div>
    </section>

    <section class="battle-last-cta battle-container" aria-labelledby="final-cta"><p class="battle-section-label">Your moment starts here</p><h2 id="final-cta">SEE YOU ON<br /><em>THE FLOOR.</em></h2><a class="battle-button battle-button-primary" href="#choose-your-style">Choose your battle <span aria-hidden="true">↗</span></a><p>Elite Dance Studio · Wiclefstraße 16–17 · 10551 Berlin-Moabit</p></section>
  </main>

  <SiteFooter brand={site.brand} nav={site.nav} />
</BaseLayout>

<script is:inline>
  (() => {
    const form = document.querySelector("[data-battle-form]");
    if (!form) return;
    const buttons = Array.from(document.querySelectorAll("[data-select-style]"));
    const selectedInput = form.querySelector("[data-chosen-style]");
    const selectedDisplay = form.querySelector("[data-style-display]");
    const submitButton = form.querySelector("[data-battle-submit]");
    const status = form.querySelector("[data-battle-status]");
    const success = document.querySelector("[data-battle-success]");
    const successCopy = document.querySelector("[data-success-copy]");
    const labels = { "breaking": "Breaking", "hip-hop": "Hip-Hop", "house": "House", "bachata": "Bachata" };
    const choose = (button, scroll = true) => {
      const key = button.dataset.selectStyle;
      selectedInput.value = key;
      selectedDisplay.textContent = labels[key] || key;
      submitButton.disabled = false;
      submitButton.innerHTML = 'Send registration <span aria-hidden="true">↗</span>';
      buttons.forEach((item) => {
        const active = item === button;
        item.setAttribute("aria-pressed", String(active));
        item.classList.toggle("is-selected", active);
        const copy = item.querySelector(".battle-select-text");
        if (copy) copy.textContent = active ? "Selected ✓" : "Select style →";
      });
      status.hidden = true;
      success.hidden = true;
      form.hidden = false;
      if (scroll) document.querySelector("#battle-registration").scrollIntoView({ behavior: "smooth", block: "start" });
    };
    buttons.forEach((button) => button.addEventListener("click", () => choose(button)));

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!selectedInput.value) {
        status.hidden = false;
        status.textContent = "Bitte wähle zuerst einen Style aus.";
        document.querySelector("#choose-your-style").scrollIntoView({ behavior: "smooth" });
        return;
      }
      if (!form.reportValidity()) return;
      if (location.hostname.endsWith("github.io") || location.pathname.includes("/preview/")) {
        status.hidden = false;
        status.textContent = "Dies ist die Design-Vorschau. Anmeldungen werden hier noch nicht versendet.";
        return;
      }
      const original = submitButton.innerHTML;
      submitButton.disabled = true;
      submitButton.textContent = "Sending...";
      status.hidden = true;
      try {
        const response = await fetch(form.action, { method: "POST", body: new FormData(form), headers: { accept: "application/json" } });
        const result = await response.json().catch(() => ({}));
        if (!response.ok || !result.ok) throw new Error("registration_failed");
        const method = new FormData(form).get("booking_method") === "usc" ? "Urban Sports Club" : "Eversports";
        successCopy.textContent = "Deine Voranmeldung für " + selectedDisplay.textContent + " wurde an unser Team gesendet. Du hast " + method + " als Buchungsweg gewählt.";
        form.hidden = true;
        success.hidden = false;
      } catch (_) {
        status.hidden = false;
        status.textContent = "Das hat leider nicht geklappt. Bitte versuche es noch einmal oder kontaktiere info@elitedancestudio.de.";
      } finally {
        submitButton.disabled = false;
        submitButton.innerHTML = original;
      }
    });
    document.querySelector("[data-battle-again]")?.addEventListener("click", () => {
      const oldStyle = selectedInput.value;
      form.reset();
      form.hidden = false;
      success.hidden = true;
      const active = buttons.find((button) => button.dataset.selectStyle === oldStyle);
      if (active) choose(active, false);
      form.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  })();
</script>

<style is:global>
  body.elite-battle-page { background: #0c0d10; color: #f5f2ec; }
  body.elite-battle-page .site-header { background: rgba(12,13,16,.95); border-bottom: 1px solid rgba(255,255,255,.12); }
  body.elite-battle-page .site-header .nav-link,
  body.elite-battle-page .site-header .nav-dropdown > summary,
  body.elite-battle-page .site-header .header-contact-button-v17 { color: #f5f2ec; }
  body.elite-battle-page .site-footer { background: #0c0d10; color: #f5f2ec; border-top: 1px solid rgba(255,255,255,.12); }
  body.elite-battle-page .site-footer a { color: #f5f2ec; }
  body.elite-battle-page .mobile-menu { background: #17191f; }
  body.elite-battle-page .mobile-nav > summary { color: #fff; }
  body.elite-battle-page .nav-dropdown-menu { background: #17191f; }
  body.elite-battle-page .nav-dropdown-link span { color: #f5f2ec; }
  body.elite-battle-page .page-shell { max-width: 1180px; }
</style>

<style>
  .battle-main { font-family: "Inter",sans-serif; --acid:#d8fa53; --ink:#0c0d10; --cream:#f5f2ec; background: var(--ink); color: var(--cream); overflow: clip; }
  .battle-container { width: min(calc(100% - 48px), 1180px); margin: 0 auto; }
  .battle-main h1,.battle-main h2,.battle-main h3,.battle-category-name { font-family: "Sora","Inter",sans-serif; }
  .battle-main em { font-style: normal; color: var(--acid); }
  .battle-section-label,.battle-eyebrow { margin: 0; color: var(--acid); font-size: .74rem; font-weight: 800; letter-spacing: .18em; text-transform: uppercase; }
  .battle-hero { position: relative; min-height: 690px; isolation: isolate; background: radial-gradient(circle at 83% 28%,rgba(216,250,83,.13),transparent 23rem),radial-gradient(circle at 17% 80%,rgba(236,75,94,.14),transparent 22rem),#0c0d10; }
  .battle-hero-grid { position: absolute; inset: 0; z-index: -1; opacity: .18; background-image: linear-gradient(90deg,rgba(255,255,255,.09) 1px,transparent 1px),linear-gradient(rgba(255,255,255,.09) 1px,transparent 1px); background-size: 58px 58px; mask-image:linear-gradient(90deg,transparent,black 25%,black 80%,transparent); }
  .battle-hero-noise { position:absolute; inset: 0; z-index:-1; pointer-events:none; opacity:.2; background:repeating-linear-gradient(150deg,transparent 0 18px,rgba(255,255,255,.025) 19px 20px); }
  .battle-hero-inner { padding: 34px 0 0; }
  .battle-hero-topline { display:flex; justify-content:space-between; align-items:center; gap:16px; border-bottom:1px solid rgba(255,255,255,.22); padding-bottom:16px; }
  .battle-kicker,.battle-edition { font-size:.7rem; text-transform:uppercase; font-weight:800; letter-spacing:.15em; }
  .battle-kicker { display:flex; align-items:center; gap:11px; }
  .battle-live-dot { width:8px; height:8px; border-radius:50%; background:var(--acid); box-shadow:0 0 16px rgba(216,250,83,.85); }
  .battle-edition { color:#a4a5a6; }
  .battle-hero-body { display:grid; grid-template-columns:minmax(0,1fr) 270px; align-items:end; gap:36px; padding:70px 0 68px; }
  .battle-hero-copy { min-width:0; }
  .battle-hero h1 { display:flex; flex-direction:column; margin:18px 0 25px; font-weight:800; font-size:clamp(4.2rem,9.7vw,9.1rem); line-height:.84; letter-spacing:-.085em; color:#f5f2ec; }
  .battle-title-outline { color:transparent; -webkit-text-stroke: 2px var(--cream); }
  .battle-title-star { color:var(--acid); font-size:.55em; vertical-align:top; -webkit-text-stroke:0; margin-left:6px; }
  .battle-hero-lead { font-family:"Sora",sans-serif; font-size:clamp(1.05rem,2vw,1.4rem); font-weight:800; letter-spacing:-.03em; }
  .battle-hero-description { max-width:600px; color:#acacb0; line-height:1.7; margin-top:14px; font-size:.95rem; }
  .battle-hero-actions { display:flex; gap:12px; flex-wrap:wrap; margin-top:30px; }
  .battle-button { display:inline-flex; align-items:center; justify-content:space-between; gap:36px; min-height:52px; padding:0 22px; text-decoration:none; font-size:.85rem; font-weight:800; text-transform:uppercase; letter-spacing:.04em; transition:transform .18s ease,background .18s ease; }
  .battle-button:hover { transform:translateY(-3px); }
  .battle-button:focus-visible,.battle-category:focus-visible,.battle-submit:focus-visible { outline:3px solid #fff; outline-offset:4px; }
  .battle-button-primary { background:var(--acid); color:var(--ink); }
  .battle-button-ghost { border:1px solid rgba(255,255,255,.34); color:var(--cream); }
  .battle-hero-stamp { position:relative; padding:24px 20px 32px; min-height:312px; display:flex; flex-direction:column; justify-content:center; align-items:center; gap:9px; border:2px solid var(--acid); text-align:center; transform:rotate(4deg); }
  .battle-stamp-overline { font-weight:900; letter-spacing:.23em; font-size:.65rem; color:var(--acid); }
  .battle-hero-stamp strong { font-family:"Sora",sans-serif; font-size:2.65rem; letter-spacing:-.08em; white-space:nowrap; }
  .battle-hero-stamp strong span { color:var(--acid); }
  .battle-hero-stamp > span:not(.battle-stamp-overline):not(.battle-stamp-rule):not(.battle-stamp-ring) { font-size:.65rem; font-weight:800; letter-spacing:.09em; }
  .battle-stamp-rule { display:block; width:75%; height:1px; background:var(--acid); margin:9px 0; }
  .battle-stamp-ring { position:absolute; left:-28px; bottom:-32px; display:grid; place-items:center; width:76px; height:76px; border-radius:50%; background:var(--acid); color:var(--ink); font-size:3.6rem; }
  .battle-hero-stats { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)) auto; border-top:1px solid rgba(255,255,255,.22); }
  .battle-hero-stats > div { padding:22px 20px 26px 0; border-right:1px solid rgba(255,255,255,.16); }
  .battle-hero-stats strong { display:block; font-family:"Sora",sans-serif; font-size:2.35rem; line-height:1; letter-spacing:-.08em; }
  .battle-hero-stats strong span { color:var(--acid); }
  .battle-hero-stats div > span { display:block; margin-top:6px; color:#aaaab0; font-size:.72rem; letter-spacing:.06em; text-transform:uppercase; }
  .battle-hero-stats .battle-stats-tail { display:flex; align-items:center; gap:14px; max-width:180px; padding-left:24px; border-right:0; font-size:.7rem; font-weight:800; line-height:1.6; }
  .battle-stats-tail span { font-size:1.2rem !important; color:var(--acid) !important; }
  .battle-ticker { display:flex; gap:36px; width:100%; padding:13px 0; background:var(--acid); color:var(--ink); font-family:"Sora",sans-serif; font-size:1.12rem; font-weight:800; letter-spacing:.03em; white-space:nowrap; overflow:hidden; }
  .battle-ticker div { flex:0 0 auto; animation:battle-marquee 30s linear infinite; }
  @keyframes battle-marquee { to{transform:translateX(calc(-100% - 36px))} }
  .battle-choose-section { padding:108px 0 112px; scroll-margin-top:95px; }
