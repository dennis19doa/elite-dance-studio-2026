<style>
  /* Event launch: official poster, general schedule and community areas */
  .battle-poster-showcase { background:linear-gradient(180deg,#191a1d,#202124);padding:48px 0 85px;border-bottom:1px solid #474143; }
  .battle-poster-layout { display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);gap:clamp(28px,5vw,74px);align-items:center; }
  .battle-poster-copy h2 { font:900 clamp(2.5rem,4.5vw,5rem)/.97 "Sora","Inter",sans-serif;letter-spacing:-.068em;margin:16px 0 25px;color:#efebe6; }
  .battle-poster-copy h2 em { font-style:normal;color:#c9ab99; }
  .battle-poster-copy>p:not(.battle-section-label) { color:#c5bdb6;line-height:1.8;font-size:1rem;max-width:535px; }
  .battle-poster-facts { display:grid;gap:11px;margin:31px 0; }
  .battle-poster-facts>div { display:flex;flex-direction:column;gap:5px;padding:13px 16px;border-left:2px solid #b49a87;background:#29292b; }
  .battle-poster-facts span { color:#bda897;font-size:.68rem;font-weight:900;letter-spacing:.16em; }
  .battle-poster-facts strong { color:#eeeae5;font-size:.92rem;line-height:1.5; }
  .battle-poster-actions { display:flex;flex-wrap:wrap;gap:12px; }
  .battle-poster-art { width:min(100%,585px);margin:0 auto;position:relative; }
  .battle-poster-art::before { content:"";pointer-events:none;position:absolute;inset:12px -12px -12px 12px;border:1px solid #ad655855;z-index:0; }
  .battle-poster-art img { display:block;width:100%;height:auto;position:relative;z-index:1;border:1px solid #55413e;box-shadow:0 27px 70px #0007; }
  .battle-poster-art figcaption { color:#aaa19b;font-size:.72rem;letter-spacing:.12em;text-transform:uppercase;margin:14px 0 0;text-align:right; }
  .battle-overview-grid { display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px; }
  .battle-overview-card { min-width:0;min-height:163px;display:flex;flex-direction:column;gap:11px;padding:19px;background:#26272a;border:1px solid #4a4b4f;transition:border-color .26s,background .26s; }
  .battle-overview-card:hover { border-color:#a78d7d;background:#292a2d; }
  .battle-overview-card span { color:#b6a497;font-size:.67rem;letter-spacing:.16em;font-weight:900; }
  .battle-overview-card strong { font-size:clamp(.94rem,1.4vw,1.15rem);line-height:1.3;letter-spacing:-.025em; }
  .battle-overview-card small { color:#b2aba6;line-height:1.6;font-size:.77rem; }
  .battle-format-section .battle-bracket-note { margin-top:24px;color:#bbb1aa; }
  .battle-community-strip { padding:79px 0;border-top:1px solid #3a393b;border-bottom:1px solid #3a393b; }
  .battle-community-layout { display:grid;grid-template-columns:minmax(0,1.15fr) minmax(0,1fr);column-gap:70px;align-items:start; }
  .battle-community-title { min-width:0; }
  .battle-community-title h2 { font:900 clamp(2.2rem,4vw,4.25rem)/1 "Sora","Inter",sans-serif;letter-spacing:-.068em;margin:13px 0 0; }
  .battle-community-title h2 em { color:#c7ab98;font-style:normal; }
  .battle-community-layout>p { color:#d0c5bd;font-size:.95rem;line-height:1.85;margin:0; }
  .battle-community-pills { display:flex;grid-column:1/-1;align-items:center;flex-wrap:wrap;gap:12px;margin-top:25px; }
  .battle-community-pills>span { color:#e9e4dd;border:1px solid #665d58;padding:11px 15px;font-size:.78rem;font-weight:800;letter-spacing:.04em; }
  .battle-general-timetable .battle-lineup-item { grid-template-columns:110px minmax(0,1fr);column-gap:19px;row-gap:3px; }
  .battle-general-timetable .battle-lineup-item>span { grid-row:1/3;align-self:center;max-width:110px;line-height:1.4;font-size:.75rem; }
  .battle-general-timetable .battle-lineup-item strong { grid-column:2;grid-row:1; }
  .battle-general-timetable .battle-lineup-item small { grid-column:2;grid-row:2;text-align:left;line-height:1.5;max-width:100%; }
  .battle-general-timetable .battle-lineup-top { gap:18px; }
  @media(max-width:1040px) {
    .battle-overview-grid { grid-template-columns:repeat(2,minmax(0,1fr)); }
    .battle-poster-layout { gap:32px; }
    .battle-community-layout { column-gap:36px; }
  }
  @media(max-width:760px) {
    .battle-poster-showcase { padding:54px 0 66px; }
    .battle-poster-layout { grid-template-columns:1fr; }
    .battle-poster-copy { max-width:720px; }
    .battle-poster-art { width:min(100%,535px); }
    .battle-community-layout { grid-template-columns:1fr; }
    .battle-community-layout>p { margin-top:22px; }
    .battle-community-strip { padding:60px 0; }
  }
  @media(max-width:450px) {
    .battle-overview-grid { grid-template-columns:1fr; }
    .battle-overview-card { min-height:0; }
    .battle-general-timetable .battle-lineup-item { grid-template-columns:83px minmax(0,1fr);column-gap:10px; }
    .battle-general-timetable .battle-lineup-item>span { max-width:83px;font-size:.65rem; }
  }
  @media(prefers-reduced-motion:reduce) {
    .battle-overview-card { transition:none; }
  }
</style>


<style>
  /* Four-category battle, free spectator entry and voluntary contributions */
  .battle-category-grid { display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px; }
  .battle-category,.battle-category:nth-child(4),.battle-category:nth-child(5) { grid-column:auto;min-height:340px; }
  .battle-arena-tile-kids { display:flex;align-items:center;justify-content:center;background:linear-gradient(145deg,#3c322b,#131c24); }
  .battle-arena-tile-kids span { font:900 clamp(1.6rem,3vw,3rem)/.95 "Sora","Inter",sans-serif;letter-spacing:-.09em;color:#e1c899;text-align:center;transform:rotate(-12deg); }
  .battle-spectator-hero-note { margin-top:20px;display:inline-flex;flex-direction:column;gap:4px;background:rgba(240,232,217,.09);border:1px solid rgba(220,202,172,.46);padding:14px 17px;color:#fff8f0;text-decoration:none;transition:background .25s,border-color .25s; }
  .battle-spectator-hero-note:hover { background:rgba(240,232,217,.17);border-color:#dbc0a2; }
  .battle-spectator-hero-note strong { font-size:.86rem;font-weight:900;letter-spacing:.065em; }
  .battle-spectator-hero-note span { color:#d6c5b7;font-size:.74rem;font-weight:700; }
  .battle-spectators { padding:clamp(64px,7vw,112px) 0;background:#eae7df;color:#292729; }
  .battle-spectators-layout { display:grid;grid-template-columns:minmax(0,1.04fr) minmax(0,.96fr);gap:clamp(35px,5vw,76px);align-items:center; }
  .battle-spectator-free .battle-section-label { color:#8d7162; }
  .battle-free-overline { display:inline-flex;align-items:center;margin-top:24px;padding:8px 12px;border:1px solid #9e9a8e;color:#5c534c;font-size:.72rem;font-weight:900;letter-spacing:.13em; }
  .battle-spectator-free h2 { font:900 clamp(2.8rem,5.25vw,5.5rem)/.96 "Sora","Inter",sans-serif;letter-spacing:-.07em;margin:17px 0 23px;color:#222224; }
  .battle-spectator-free h2 em { color:#b47566; }
  .battle-spectator-free p { max-width:640px;font-size:.99rem;line-height:1.75;color:#5d5651; }
  .battle-spectator-free p strong { color:#2f2928; }
  .battle-free-highlights { display:flex;flex-wrap:wrap;gap:9px;margin-top:24px; }
  .battle-free-highlights span { background:#f7f4ef;border:1px solid #d5cec5;padding:10px 12px;color:#393332;font-size:.77rem;font-weight:850; }
  .battle-donation-card { padding:clamp(24px,3.6vw,40px);background:#24262a;color:#f1ece7;border:1px solid #514a46;box-shadow:12px 12px 0 #b8b0a246; }
  .battle-donation-card .battle-section-label { color:#c3a694; }
  .battle-donation-card h3 { font:850 clamp(1.6rem,2.45vw,2.4rem)/1.12 "Sora","Inter",sans-serif;letter-spacing:-.05em;margin:17px 0 18px;color:#fff8ef; }
  .battle-donation-card p:not(.battle-section-label) { color:#cec5bf;font-size:.87rem;line-height:1.7; }
  .battle-donation-card p strong { color:#f8eee6; }
  .battle-donation-card .battle-donation-disclaimer { color:#a9a2a0!important;font-size:.75rem!important; }
  .battle-donation-card a { display:inline-flex;justify-content:space-between;gap:12px;align-items:center;text-decoration:none;margin-top:13px;padding:13px 17px;background:#bda18f;color:#252124;font-size:.8rem;font-weight:900;transition:background .25s; }
  .battle-donation-card a:hover { background:#d6bdac; }
  .battle-register-card .battle-form-description { color:#d6cbc3; }
  .battle-community-pills { flex-wrap:wrap; }
  @media(max-width:850px) { .battle-spectators-layout { grid-template-columns:1fr; } }
  @media(max-width:750px) {
    .battle-category-grid { grid-template-columns:repeat(2,minmax(0,1fr)); }
    .battle-category,.battle-category:nth-child(4),.battle-category:nth-child(5) { grid-column:auto;min-height:310px; }
  }
  @media(max-width:490px) {
    .battle-category-grid { grid-template-columns:1fr; }
    .battle-category,.battle-category:nth-child(4),.battle-category:nth-child(5) { grid-column:auto;min-height:285px; }
    .battle-spectator-free h2 { font-size:clamp(2.55rem,10vw,4rem); }
    .battle-spectator-hero-note { display:flex;width:100%; }
  }
  @media(prefers-reduced-motion:reduce) { .battle-spectator-hero-note,.battle-donation-card a { transition:none; } }
</style>
<style>
  /* Hip-Hop battle uses abstract typography instead of an instructor portrait. */
  .battle-arena-tile-hiphop {
    display:flex;
    align-items:center;
    justify-content:center;
    background:
      radial-gradient(circle at 72% 31%,rgba(116,167,197,.28),transparent 55%),
      repeating-linear-gradient(135deg,transparent 0 20px,rgba(120,163,197,.055) 20px 21px),
      linear-gradient(145deg,#263641,#101a25);
  }
  .battle-arena-tile-hiphop span {
    color:#b0d2e2;
    font:900 clamp(1.6rem,3.3vw,3.5rem)/.92 "Sora","Inter",sans-serif;
    letter-spacing:-.09em;
    text-align:center;
    transform:rotate(-10deg);
    opacity:.78;
  }
  .battle-category-hiphop .battle-category-photo-wash {
    background:linear-gradient(135deg,rgba(25,37,49,.8),rgba(16,23,32,.36));
  }
  .battle-category-hiphop-graphic {
    position:absolute;
    top:24%;
    right:-7%;
    color:rgba(125,177,211,.16);
    font:900 clamp(4rem,7vw,7.5rem)/.8 "Sora","Inter",sans-serif;
    letter-spacing:-.09em;
    white-space:nowrap;
    transform:rotate(-12deg);
    pointer-events:none;
    user-select:none;
  }
</style>