---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import site from "../data/site.json";

const eversportsBookingUrl = "https://www.eversports.de/org/activity/946397ed-f7ae-4ea1-8ee1-2e985945d6f1";
const uscBookingUrl = "https://urbansportsclub.com/de/venues/elite-dance-studio-1"; // Replace with direct event class link if available
const battleBase = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + "/";
const battlePosterSrc = (filename: string) => battleBase + "media/style-posters/" + filename;
const heroBreaking = battlePosterSrc("05-breaking.webp");
const heroHouse = battlePosterSrc("03-house-beginner.webp");
const battlePoster = battleBase + "media/events/elite-battle-2026-four-styles.svg";

const categories = [
  { key: "breaking-kids", number: "01", name: "Breaking Kids", motif: "KIDS", label: "Kinder-Battle", image: "", className: "battle-category battle-category-kids", prize: "Kinderpreise folgen" },
  { key: "breaking", number: "02", name: "Breaking", motif: "BREAKING", label: "Toprock · Footwork", image: "05-breaking.webp", className: "battle-category battle-category-breaking", prize: "100€ Preisgeld*" },
  { key: "hip-hop", number: "03", name: "Hip-Hop", motif: "HIP-HOP", label: "Groove · Musicality", image: "", className: "battle-category battle-category-hiphop", prize: "100€ Preisgeld*" },
  { key: "house", number: "04", name: "House", motif: "HOUSE", label: "Rhythm · Footwork", image: "03-house-beginner.webp", className: "battle-category battle-category-house", prize: "100€ Preisgeld*" },
].map((item) => ({ ...item, posterSrc: item.image ? battlePosterSrc(item.image) : "" }));
---

<BaseLayout
  title="Elite Dance Battle 2026 | Breaking Kids, Breaking, Hip-Hop & House"
  description="Elite Dance Battle am 5. Dezember 2026 in Berlin-Moabit: Breaking Kids, Breaking, Hip-Hop und House. Zuschauen kostenlos, freiwillige Unterstützung möglich."
  bodyClass="elite-battle-page"
  noindex={false}
>
  <SiteHeader brand={site.brand} nav={site.nav} />

  <main class="battle-main">
    <section class="battle-hero" aria-labelledby="battle-title">
      <div class="battle-hero-grid" aria-hidden="true"></div>
      <div class="battle-hero-noise" aria-hidden="true"></div>
      <div class="battle-container battle-hero-inner">
        <div class="battle-hero-topline">
          <span class="battle-kicker"><span class="battle-live-dot"></span> Elite Dance Studio presents</span>
          <span class="battle-edition">BERLIN · FIRST EDITION · 2026</span>
        </div>
        <div class="battle-hero-body">
          <div class="battle-hero-copy">
            <p class="battle-eyebrow">4 Kategorien · 12:00–19:00</p>
            <h1 id="battle-title"><span>ELITE</span><span class="battle-title-outline">DANCE</span><span>BATTLE<span class="battle-title-star">*</span></span></h1>
            <p class="battle-hero-lead">Breaking Kids · Breaking · Hip-Hop · House</p>
            <p class="battle-hero-description">Vier Kategorien von 12:00 bis 19:00 Uhr, gemeinsame Jury und ein Überraschungsfinale.</p>
            <a class="battle-spectator-hero-note" href="#spectators"><strong>ZUSCHAUEN KOSTENLOS</strong><span>Spenden freiwillig · USC-Check-in optional ↗</span></a>
            <div class="battle-hero-actions">
              <a class="battle-button battle-button-primary" href="#battle-registration">Jetzt anmelden <span aria-hidden="true">↘</span></a>
              <a class="battle-button battle-button-ghost" href="#how-it-works">Anmeldung <span aria-hidden="true">↗</span></a>
            </div>
          </div>
          <aside class="battle-hero-stamp" aria-label="Event-Details">
            <span class="battle-stamp-overline">BATTLE DAY</span>
            <strong>05<span>.</span>12<span>.</span>26</strong>
            <span class="battle-stamp-rule"></span>
            <span>ELITE DANCE STUDIO</span>
            <span>BERLIN · MOABIT</span>
            <div class="battle-stamp-ring" aria-hidden="true">✳</div>
          </aside>
          <div class="battle-arena-visual" aria-hidden="true">
            <div class="battle-arena-tile battle-arena-tile-one"><img src={heroBreaking} alt="" /></div>
            <div class="battle-arena-tile battle-arena-tile-two battle-arena-tile-hiphop"><span aria-hidden="true">HIP<br />HOP</span></div>
            <div class="battle-arena-tile battle-arena-tile-three"><img src={heroHouse} alt="" /></div>
            <div class="battle-arena-tile battle-arena-tile-four battle-arena-tile-kids"><span aria-hidden="true">KIDS<br />BATTLE</span></div>
            <div class="battle-arena-orbit"><div class="battle-arena-orbit-inner"><span>SAMSTAG</span><strong>05.12.</strong><span>2026</span></div></div>
            <div class="battle-arena-caption"><span>ELITE DANCE STUDIO</span><span>EDB / 001</span></div>
          </div>
        </div>
        <div class="battle-hero-stats">
          <div><strong>04</strong><span>Battle-Kategorien</span></div>
          <div><strong>12–19</strong><span>Uhr · Samstag</span></div>
          <div><strong>100<span>€</span></strong><span>Preisgeld · offene Kategorien*</span></div>
          <div class="battle-stats-tail">SPONSOR GOODIE BAGS <span aria-hidden="true">↗</span></div>
        </div>
      </div>
    </section>

    <div class="battle-ticker" aria-hidden="true">
      <div>BREAKING KIDS ✳ BREAKING ✳ HIP-HOP ✳ HOUSE ✳ 05.12.2026 ✳ ZUSCHAUEN KOSTENLOS ✳</div>
      <div>BREAKING KIDS ✳ BREAKING ✳ HIP-HOP ✳ HOUSE ✳ 05.12.2026 ✳ ZUSCHAUEN KOSTENLOS ✳</div>
    </div>

<section class="battle-poster-showcase" id="poster" aria-labelledby="poster-heading">
      <div class="battle-container battle-poster-layout">
        <div class="battle-poster-copy">
          <p class="battle-section-label">05. Dezember 2026 · Berlin-Moabit</p>
          <h2 id="poster-heading">DAS EVENT <em>IM ÜBERBLICK.</em></h2>
          <p>Vier Kategorien, eine gemeinsame Jury und ein Überraschungsfinale. Zuschauer:innen und Besucher:innen der Jam Session sind kostenlos willkommen.</p>
          <div class="battle-poster-facts">
            <div><span>ZEIT</span><strong>12:00–19:00 Uhr</strong></div>
            <div><span>KATEGORIEN</span><strong>Breaking Kids · Breaking · Hip-Hop · House</strong></div>
            <div><span>ZUSCHAUEN</span><strong>Kostenlos · Keine Spende oder USC-Check-in notwendig</strong></div>
          </div>
          <div class="battle-poster-actions">
            <a class="battle-button battle-button-primary" href="#battle-registration">Zur Anmeldung <span aria-hidden="true">↗</span></a>
            <a class="battle-button battle-button-ghost" href="#battle-schedule">Tagesprogramm <span aria-hidden="true">↘</span></a>
          </div>
        </div>
        <figure class="battle-poster-art">
          <img src={battlePoster} width="700" height="875" loading="eager" decoding="async" alt="Elite Dance Battle 2026: Breaking Kids, Breaking, Hip-Hop und House. Zuschauer kostenlos, Spenden freiwillig." />
          <figcaption>Elite Dance Battle 2026 · Eventübersicht</figcaption>
        </figure>
      </div>
    </section>

    <section class="battle-choose-section battle-container" id="choose-your-style" aria-labelledby="choose-heading">
      <div class="battle-section-heading">
        <div><p class="battle-section-label">01 / Kategorien</p><h2 id="choose-heading">VIER <em>KATEGORIEN.</em></h2></div>
        <p>Breaking Kids, Breaking, Hip-Hop und House. Mit einem Eventticket kannst du an mehreren Kategorien teilnehmen.</p>
      </div>
      <div class="battle-category-grid" role="group" aria-label="Battle-Kategorien auswählen, mehrere möglich">
        {categories.map((category) => (
          <button
            type="button"
            class={category.className}
            data-select-style={category.key}
            aria-pressed="false"
            aria-controls="battle-entries"
          >
            <span class="battle-category-top"><span>EDB / {category.number}</span><span class="battle-select-indicator" aria-hidden="true">↗</span></span>
            {category.image ? (
              <img class="battle-category-photo" src={category.posterSrc} alt="" loading="lazy" decoding="async" />
            ) : (
              <span class={category.key === "hip-hop" ? "battle-category-hiphop-graphic" : "battle-category-kids-graphic"} aria-hidden="true">{category.key === "hip-hop" ? "HIP-HOP" : "EDB / 05.12"}</span>
            )}
            <span class="battle-category-photo-wash" aria-hidden="true"></span>
            <span class="battle-category-art" aria-hidden="true"><span>{category.motif}</span></span>
            <span class="battle-category-lower">
              <span class="battle-category-name">{category.name}</span>
              <span class="battle-category-traits">{category.label}</span>
            </span>
            <span class="battle-category-footer"><span class="battle-prize-mini">{category.prize}</span><span class="battle-select-text">Merken +</span></span>
          </button>
        ))}
      </div>
      <div class="battle-selection-deck" aria-live="polite">
        <div class="battle-selection-indicator"><span>◉</span><small>DEINE AUSWAHL</small></div>
        <strong data-battle-selected-name>Mehrere Kategorien möglich</strong>
        <a href="#battle-entries" data-battle-next>Teilnahme angeben <span aria-hidden="true">↗</span></a>
      </div>
      <p class="battle-choose-footnote">* Je 100€ Preisgeld in den vier offenen Kategorien. Für Breaking Kids sind separate Kinderpreise geplant. Details folgen.</p>
    </section>

<section class="battle-format-section battle-container" id="battle-format" aria-labelledby="format-heading">
      <div class="battle-format-heading">
        <div>
          <p class="battle-section-label">02 / Event-Infos</p>
          <h2 id="format-heading">VIER KATEGORIEN. <em>EIN EVENT.</em></h2>
        </div>
        <p>Battles am Nachmittag, eine gemeinsame Jury und ein besonderes Finale zum Abschluss.</p>
      </div>
      <div class="battle-overview-grid">
        <div class="battle-overview-card"><span>12:00–19:00</span><strong>Battle Day</strong><small>Vier Kategorien verteilt über den Tag</small></div>
        <div class="battle-overview-card"><span>4 KATEGORIEN</span><strong>Breaking Kids, Breaking, Hip-Hop &amp; House</strong><small>Ein Ticket für das ganze Event</small></div>
        <div class="battle-overview-card"><span>JURY</span><strong>Alle Judges bewerten alle Kategorien</strong><small>Gemeinsames Judging während des gesamten Events</small></div>
        <div class="battle-overview-card"><span>FINALE</span><strong>Surprise Final Battle</strong><small>Besonderes Finale mit den Kategoriesieger:innen</small></div>
      </div>
      <p class="battle-bracket-note">Zusätzlich gibt es eine kostenlose Jam Session im zweiten Raum und Essen vor Ort. Zuschauer:innen müssen weder buchen noch spenden.</p>
    </section>

<section class="battle-spectators" id="spectators" aria-labelledby="spectator-heading">
      <div class="battle-container battle-spectators-layout">
        <div class="battle-spectator-free">
          <p class="battle-section-label">Besucher:innen &amp; Community</p>
          <div class="battle-free-overline">KEIN TICKET NÖTIG</div>
          <h2 id="spectator-heading">ZUSCHAUEN IST <em>KOSTENLOS.</em></h2>
          <p>Du kannst einfach vorbeikommen, Battles anschauen oder bei der kostenlosen Jam Session im zweiten Raum mitmachen. <strong>Kein Eintritt, keine Anmeldung und keine Spende erforderlich.</strong></p>
          <div class="battle-free-highlights"><span>Eintritt: 0€</span><span>Jam kostenlos</span><span>Spende freiwillig</span></div>
        </div>
        <div class="battle-donation-card">
          <p class="battle-section-label">Freiwillige Unterstützung</p>
          <h3>Du möchtest das Event unterstützen?</h3>
          <p>Du kannst am Veranstaltungstag freiwillig etwas spenden. Wenn du Urban Sports Club nutzt, kannst du uns alternativ durch einen <strong>freiwilligen USC-Check-in</strong> unterstützen, sofern du am Event bzw. der Jam Session teilnimmst und die Buchung in deiner USC-App verfügbar ist.</p>
          <p class="battle-donation-disclaimer">Das ist komplett optional. Du kannst ohne Spende oder USC-Check-in kostenlos zuschauen. Pro Tag ist nur ein USC-Check-in am selben Standort möglich – wer bereits eingecheckt hat, braucht keinen zweiten.</p>
          <a href={uscBookingUrl} target="_blank" rel="noopener noreferrer">Elite Dance Studio bei USC ansehen <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </section>

    <section class="battle-register-section" id="battle-registration" aria-labelledby="register-heading">
  <div class="battle-container battle-register-grid">
    <div class="battle-register-intro">
      <p class="battle-section-label">03 / Anmeldung</p>
      <h2 id="register-heading">EIN TICKET.<br /><em>ALLE BATTLES.</em></h2>
      <p>Wer bei den Battles antreten möchte, meldet sich einmal für den Tag an. Das Ticket gilt für Breaking Kids, Breaking, Hip-Hop und House. <strong>Zuschauen ist ohne Ticket kostenlos.</strong></p>
      <div class="battle-register-steps" id="how-it-works">
        <div><span>01</span><div><strong>Nur für die Battle-Teilnahme anmelden</strong><p>€5 über Eversports oder eine passende USC-Buchung. Zuschauer:innen benötigen keine Anmeldung.</p></div></div>
        <div><span>02</span><div><strong>Deine Kategorien angeben</strong><p>Nach der Buchung gibst du unten an, in welchen Kategorien du antrittst. Mehrfachauswahl möglich.</p></div></div>
        <div><span>03</span><div><strong>Am 5. Dezember einchecken</strong><p>Buchungsbestätigung mitbringen; USC-Mitglieder checken zusätzlich in der App ein.</p></div></div>
      </div>
      <div class="battle-ticket-note">
        <span class="battle-ticket-note-icon" aria-hidden="true">✓</span>
        <div><strong>Battle-Teilnahme: eine Buchung für alle Kategorien</strong><p>Keine zweite Zahlung bei mehreren Battles. Zuschauer:innen und die Jam Session sind kostenlos.</p></div>
      </div>
    </div>
    <div class="battle-register-card">
      <div class="battle-form-heading"><span>BATTLE / 05.12.2026</span><span class="battle-form-availability">BUCHBAR</span></div>
      <h3>Für die Battles anmelden</h3>
      <p class="battle-form-description">Nur für Battle-Teilnehmende nötig: €5 über Eversports oder eine passende USC-Buchung. Beide Optionen gelten für den ganzen Tag.</p>
      <div class="battle-booking-links">
        <a class="battle-booking-link" href={eversportsBookingUrl} target="_blank" rel="noopener noreferrer">
          <span><strong>Eversports · €5</strong><small>Ein Ticket für alle vier Battle-Kategorien</small></span><b aria-hidden="true">↗</b>
        </a>
        <a class="battle-booking-link battle-booking-link-usc" href={uscBookingUrl} target="_blank" rel="noopener noreferrer">
          <span><strong>Urban Sports Club</strong><small>Für berechtigte USC-Mitglieder inklusive</small></span><b aria-hidden="true">↗</b>
        </a>
      </div>
      <p class="battle-price-disclaimer">Der Eversports-Button öffnet direkt die Elite Dance Battle Buchungsseite. Für USC führt der Link zunächst zum Studio-Profil – dort den Battle-Termin am 05.12.2026 auswählen.</p>
      <p class="battle-form-hint"><strong>Bereits angemeldet?</strong> Trag unten noch deine Kategorien ein. <strong>Nur zuschauen?</strong> Dann brauchst du keine Buchung und keinen Check-in.</p>
      <a class="battle-booking-next" href="#battle-entries">Meine Battle-Kategorien eintragen ↘</a>
    </div>
  </div>
</section>

<section class="battle-entries-section" id="battle-entries" aria-labelledby="entries-heading">
  <div class="battle-container battle-entries-layout">
    <div class="battle-entries-intro">
      <p class="battle-section-label">04 / Battle-Kategorien</p>
      <h2 id="entries-heading">DEINE <em>BATTLES.</em></h2>
      <p>Bereits gebucht? Hier gibst du an, in welchen Kategorien du antrittst. Mehrere Kategorien sind möglich.</p>
      <p>Wichtig: Verwende dieselbe E-Mail-Adresse wie in deiner Eversports- oder USC-Buchung. Wir gleichen die Kategorien mit der Teilnehmerliste ab.</p>
    </div>
    <form class="battle-entries-form" action="/api/form" method="post" data-battle-entries-form>
      <input type="hidden" name="form_kind" value="battle" />
      <label class="battle-entry-trap" aria-hidden="true">Leer lassen<input type="text" name="_gotcha" tabindex="-1" autocomplete="off" /></label>
      <h3>Teilnahme eintragen</h3>
      <div class="battle-entry-fields">
        <label>Name der teilnehmenden Person *<input name="name" type="text" autocomplete="name" maxlength="160" required placeholder="Bei Kids: Name des Kindes" /></label>
        <label>E-Mail-Adresse der Buchung *<input name="email" type="email" autocomplete="email" maxlength="254" required placeholder="Bei Kids: E-Mail des Elternteils" /></label>
        <label class="battle-entry-wide">Battle-Name (optional)<input name="stage_name" type="text" maxlength="120" placeholder="Dein Name im Battle" /></label>
      </div>
      <fieldset class="battle-entry-fieldset">
        <legend>In welchen Kategorien trittst du an? *</legend>
        <div class="battle-entry-checkboxes">
          {categories.map((category) => (
            <label class={"battle-entry-checkbox battle-entry-checkbox-" + category.key}>
              <input type="checkbox" name="battle_categories" value={category.key} data-battle-entry-category={category.key} />
              <span>{category.name}</span>
            </label>
          ))}
        </div>
      </fieldset>
      <div class="battle-kids-consent" data-kids-consent hidden>
        <label><input type="checkbox" name="guardian_consent" value="yes" data-guardian-consent />
          <span>Ich bin erziehungsberechtigt und stimme der Teilnahme meines Kindes am Breaking Kids Battle zu. *</span>
        </label>
        <small>Für Breaking Kids bitte den Namen des Kindes und die Buchungs-E-Mail der erziehungsberechtigten Person angeben.</small>
      </div>
      <fieldset class="battle-entry-fieldset"><legend>Wie hast du gebucht? *</legend>
        <div class="battle-entry-methods">
          <label><input type="radio" name="booking_method" value="eversports" required /> Eversports</label>
          <label><input type="radio" name="booking_method" value="usc" required /> Urban Sports Club</label>
        </div>
      </fieldset>
      <label class="battle-entry-confirm"><input type="checkbox" name="booking_confirmed" value="yes" required /> Ich habe den Battle Day bereits über Eversports oder USC gebucht. *</label>
      <label class="battle-entry-confirm"><input type="checkbox" name="privacy_consent" value="accepted" required /> Ich stimme zu, dass meine Daten zur Organisation der Battle-Teilnahme verarbeitet und mit der Buchung abgeglichen werden. *</label>
      <button class="battle-entry-send" type="submit" data-battle-entry-send>Kategorien abschicken <span aria-hidden="true">↗</span></button>
      <p class="battle-entry-status" data-battle-entry-status role="status" aria-live="polite">Diese Meldung kostet nichts und ersetzt keine Eventbuchung.</p>
    </form>
  </div>
</section>

    <section class="battle-prizes-section battle-container" aria-labelledby="prizes-heading">
      <div class="battle-prizes-lead"><span class="battle-section-label">05 / Preise</span><h2 id="prizes-heading">PREISGELD &amp;<br /><em>GOODIE BAGS</em></h2></div>
      <div class="battle-prize-block"><span class="battle-prize-overline">AKTUELLES PREISGELD / OFFENE KATEGORIEN</span><div class="battle-prize-amount">100<span>€</span></div><p>Aktuell 100€ pro Sieger:in in Breaking, Hip-Hop und House. Kinderpreise separat.</p><span class="battle-prize-future">Weitere Sponsoren möglich</span></div>
      <div class="battle-goodies-block"><span aria-hidden="true">✳</span><h3>SPONSOR<br />GOODIE BAGS</h3><p>Zusätzliche Preise und Goodie Bags von unseren Sponsoren. Details folgen.</p></div>
    </section>

    <section class="battle-workshop-strip battle-community-strip" id="battle-community" aria-labelledby="community-heading">
      <div class="battle-container battle-community-layout">
        <div class="battle-community-title">
          <p class="battle-section-label">Community</p>
          <h2 id="community-heading">JAM, FOOD <em>&amp; COMMUNITY.</em></h2>
        </div>
        <p>Du musst nicht am Battle teilnehmen, um dabei zu sein. Der Eintritt und die Jam Session im zweiten Raum sind kostenlos. Essen gibt es vor Ort. Eine Spende ist immer freiwillig.</p>
        <div class="battle-community-pills"><span>Jam kostenlos</span><span>Essen vor Ort</span><span>Zuschauen kostenlos</span><span>Spenden freiwillig</span></div>
      </div>
    </section>

    <section class="battle-schedule-section" id="battle-schedule" aria-labelledby="schedule-heading">
      <div class="battle-container battle-schedule-layout">
        <div class="battle-schedule-intro">
          <p class="battle-section-label">06 / Tagesprogramm</p>
          <h2 id="schedule-heading">12:00 BIS 19:00 <em>UHR.</em></h2>
          <p>Der genaue Zeitplan der einzelnen Kategorien wird noch bekannt gegeben. Der Battle Day läuft von 12:00 bis 19:00 Uhr mit einem Überraschungsfinale zum Abschluss.</p>
          <div class="battle-schedule-rooms">
            <div><span>RAUM 01</span><strong>Battles · Finale · Siegerehrung</strong></div>
            <div><span>RAUM 02</span><strong>Kostenlose Jam Session</strong></div>
            <div><span>ESSEN</span><strong>Food-Bereich vor Ort</strong></div>
          </div>
          <a class="battle-schedule-instagram" href="https://www.instagram.com/elitedanceberlin/" target="_blank" rel="noopener noreferrer">Updates auf Instagram ↗</a>
        </div>
        <div class="battle-lineup-card battle-general-timetable">
          <div class="battle-lineup-top"><span>SA / 05 DEZ 2026</span><span>PROGRAMMÜBERSICHT</span></div>
          <div class="battle-lineup-item"><span>12:00</span><strong>Start des Battle Days</strong><small>Einlass &amp; Battles</small></div>
          <div class="battle-lineup-item"><span>AB 12:00</span><strong>Vier Battle-Kategorien</strong><small>Breaking Kids · Breaking · Hip-Hop · House</small></div>
          <div class="battle-lineup-item"><span>ALLE RUNDEN</span><strong>Gemeinsame Jury</strong><small>Alle Judges bewerten alle Kategorien</small></div>
          <div class="battle-lineup-item"><span>DEN GANZEN TAG</span><strong>Kostenlose Jam Session</strong><small>Im zweiten Raum</small></div>
          <div class="battle-lineup-item"><span>DEN GANZEN TAG</span><strong>Food &amp; Community</strong><small>Essen vor Ort · Zuschauen kostenlos</small></div>
          <div class="battle-lineup-item battle-lineup-item-special"><span>ZUM ABSCHLUSS</span><strong>Surprise Final Battle</strong><small>Mit den Kategoriesieger:innen</small></div>
          <div class="battle-lineup-item battle-lineup-item-special"><span>BIS 19:00</span><strong>Abschluss</strong><small>Siegerehrung &amp; Community</small></div>
          <div class="battle-lineup-foot">KONKRETE STARTZEITEN DER KATEGORIEN FOLGEN <span aria-hidden="true">↗</span></div>
        </div>
      </div>
    </section>

