---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import InstagramIcon from "../components/InstagramIcon.astro";

import coaches from "../data/coaches.json";
import site from "../data/site.json";

const categoryFor = (focus: string) => {
  const value = focus.toLowerCase();
  if (/bachata|zouk|kizomba|salsa|lambada/.test(value)) return "partner";
  if (/hip hop|breaking|house/.test(value)) return "urban";
  if (/heels|commercial|k-pop|reggaeton|jazz|twerk/.test(value)) return "performance";
  return "movement";
};

const featured = coaches.slice(0, 3);
---

<BaseLayout
  title="Coaches & Tanzlehrer:innen | Elite Dance Studio Berlin"
  description="Lerne die Coaches für Bachata, Reggaeton, Heels, Hip Hop, Commercial, K-Pop und weitere Styles im Elite Dance Studio Berlin kennen."
  bodyClass="site-subpage coaches-page-v9"
>
  <SiteHeader brand={site.brand} nav={site.nav} />

  <main class="page-shell page-main">
    <section class="coaches-v9-hero">
      <div class="coaches-v9-hero-copy">
        <div class="eyebrow">Meet the people behind the classes</div>
        <h1 class="page-title">Finde nicht nur deinen Style. Finde deinen Coach.</h1>
        <p class="lead">
          Jede Class hat eine andere Energie. Hier siehst du, wer unterrichtet, worauf der Fokus
          liegt, wann die Class stattfindet und was du auf Instagram erwarten kannst.
        </p>
        <div class="actions">
          <a class="button primary" href="#coach-directory">Team entdecken</a>
          <a class="button secondary" href="/#schedule">Class buchen</a>
        </div>
      </div>

      <div class="coaches-v9-hero-portraits" aria-label="Auswahl unserer Coaches">
        {featured.map((coach) => (
          <a href={`/coaches/${coach.slug}/`}>
            <img src={coach.image} alt={coach.imageAlt} loading="eager" />
            <span><strong>{coach.name}</strong><small>{coach.focus}</small></span>
          </a>
        ))}
      </div>
    </section>

    <section class="coach-directory-v9" id="coach-directory" data-coach-directory>
      <header class="coach-directory-head-v9">
        <div>
          <div class="eyebrow">Unser Team</div>
          <h2>Menschen, nicht austauschbare Kursnamen.</h2>
        </div>
        <p>
          Filtere nach Richtung. Jede Karte zeigt dir Teaching-Fokus, aktuellen Termin,
          Beginner-Hinweis, Profil und – wenn vorhanden – den direkten Instagram-Account.
        </p>
      </header>

      <div class="coach-filters-v9" role="group" aria-label="Coaches nach Richtung filtern">
        <button class="coach-filter-v9 is-active" type="button" data-filter="all">Alle Coaches</button>
        <button class="coach-filter-v9" type="button" data-filter="partner">Partner Dance</button>
        <button class="coach-filter-v9" type="button" data-filter="urban">Urban</button>
        <button class="coach-filter-v9" type="button" data-filter="performance">Performance</button>
        <button class="coach-filter-v9" type="button" data-filter="movement">Movement</button>
      </div>

      <div class="coach-grid-v9">
        {coaches.map((coach) => (
          <article class="coach-card-v9" data-coach-card data-category={categoryFor(coach.focus)}>
            <a class="coach-card-image-v9" href={`/coaches/${coach.slug}/`} aria-label={`${coach.name} Profil öffnen`}>
              <img src={coach.image} alt={coach.imageAlt} loading="lazy" decoding="async" />
              <span class="coach-style-v9">{coach.focus}</span>
            </a>

            <div class="coach-card-body-v9">
              <div class="coach-card-top-v9">
                <h3>{coach.name}</h3>
                {coach.schedule && <time>{coach.schedule}</time>}
              </div>

              <p>{coach.text}</p>
              {coach.beginnerSupport && <span class="coach-support-v9">{coach.beginnerSupport}</span>}

              <div class="coach-card-actions-v9">
                <a class="coach-profile-v9" href={`/coaches/${coach.slug}/`}>Profil ansehen →</a>
                {coach.instagramUrl ? (
                  <a
                    class="coach-instagram-v9"
                    href={coach.instagramUrl}
                    target="_blank"
                    rel="noreferrer"
                    aria-label={`${coach.name} auf Instagram öffnen`}
                  >
                    <InstagramIcon />
                    <span>{coach.instagramHandle}</span>
                  </a>
                ) : (
                  <span class="coach-instagram-v9" aria-label="Instagram folgt">
                    <InstagramIcon />
                    <span>Instagram folgt</span>
                  </span>
                )}
              </div>
            </div>
          </article>
        ))}
      </div>

      <script is:inline>
        (() => {
          const root = document.currentScript?.closest('[data-coach-directory]');
          if (!root) return;
          const buttons = [...root.querySelectorAll('[data-filter]')];
          const cards = [...root.querySelectorAll('[data-coach-card]')];

          buttons.forEach((button) => {
            button.addEventListener('click', () => {
              const filter = button.dataset.filter;
              buttons.forEach((item) => item.classList.toggle('is-active', item === button));
              cards.forEach((card) => {
                card.hidden = filter !== 'all' && card.dataset.category !== filter;
              });
            });
          });
        })();
      </script>
    </section>

    <section class="cta-banner panel">
      <div>
        <div class="eyebrow">Noch unsicher?</div>
        <h2>Beschreib uns kurz, was du tanzen möchtest.</h2>
        <p>Wir empfehlen dir einen passenden Style, Level und Coach.</p>
      </div>
      <div class="actions">
        <a class="button primary" href="https://wa.me/491633863548?text=Hallo%20Elite%2C%20ich%20suche%20einen%20passenden%20Kurs%20und%20Coach.">Coach empfehlen lassen</a>
      </div>
    </section>
  </main>

  <SiteFooter brand={site.brand} nav={site.nav} />
</BaseLayout>
