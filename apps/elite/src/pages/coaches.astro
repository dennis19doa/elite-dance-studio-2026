---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import InstagramIcon from "../components/InstagramIcon.astro";

import coaches from "../data/coaches.json";
import site from "../data/site.json";

const firstCoach = coaches[0];
const baseUrl = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const bookingHref = `${baseUrl}#schedule`;
---

<BaseLayout
  title="Coaches & Tanzlehrer:innen | Elite Dance Studio Berlin"
  description="Lerne die Coaches für Bachata, Reggaeton, Heels, Hip Hop, Commercial, K-Pop und weitere Styles im Elite Dance Studio Berlin kennen."
  bodyClass="coaches-page-v12"
>
  <SiteHeader brand={site.brand} nav={site.nav} />

  <main class="page-shell page-main coaches-main-v12">
    <header class="coaches-intro-v12">
      <div>
        <div class="eyebrow">22 Coaches · viele Handschriften</div>
        <h1 class="page-title">Nicht jeder Coach passt zu jedem Menschen. Genau das ist gut.</h1>
      </div>
      <div class="coaches-intro-side-v12">
        <p>
          Klick dich durch unser Team und finde die Person, deren Energie, Style und Art zu unterrichten
          zu dir passt. Instagram, Class-Zeit und Profil sind direkt dabei.
        </p>
        <a href={bookingHref}>Class buchen ↗</a>
      </div>
    </header>

    <section class="coach-browser-v12" data-coach-browser aria-label="Elite Coaches entdecken">
      <div class="coach-browser-list-v12" role="listbox" aria-label="Coach auswählen">
        {coaches.map((coach, index) => (
          <button
            type="button"
            class:list={["coach-browser-item-v12", index === 0 && "is-active"]}
            role="option"
            aria-selected={index === 0 ? "true" : "false"}
            data-coach-button
            data-name={coach.name}
            data-focus={coach.focus}
            data-schedule={coach.schedule ?? ""}
            data-text={coach.text}
            data-support={coach.beginnerSupport ?? ""}
            data-image={coach.image}
            data-image-alt={coach.imageAlt}
            data-profile={`/coaches/${coach.slug}/`}
            data-instagram-handle={coach.instagramHandle ?? ""}
            data-instagram-url={coach.instagramUrl ?? ""}
          >
            <span>{coach.name}</span>
            <small>{coach.focus}</small>
          </button>
        ))}
      </div>

      <article class="coach-browser-stage-v12" data-coach-stage>
        <figure class="coach-browser-photo-v12">
          <img data-coach-image src={firstCoach.image} alt={firstCoach.imageAlt} />
          <figcaption>
            <span data-coach-focus>{firstCoach.focus}</span>
            <strong data-coach-name>{firstCoach.name}</strong>
          </figcaption>
        </figure>

        <div class="coach-browser-copy-v12">
          <div class="coach-browser-meta-v12">
            <span>Aktuelle Class</span>
            <strong data-coach-schedule>{firstCoach.schedule}</strong>
          </div>

          <p data-coach-text>{firstCoach.text}</p>
          <p class="coach-browser-support-v12" data-coach-support>{firstCoach.beginnerSupport}</p>

          <div class="coach-browser-actions-v12">
            <a class="button primary" data-coach-profile href={`/coaches/${firstCoach.slug}/`}>Profil ansehen</a>
            <a
              class="coach-browser-instagram-v12"
              data-coach-instagram
              href={firstCoach.instagramUrl}
              target="_blank"
              rel="noreferrer"
            >
              <InstagramIcon />
              <span data-coach-instagram-handle>{firstCoach.instagramHandle}</span>
            </a>
          </div>
        </div>
      </article>

      <script is:inline>
        (() => {
          const root = document.currentScript?.closest('[data-coach-browser]');
          if (!root) return;

          const buttons = [...root.querySelectorAll('[data-coach-button]')];
          const image = root.querySelector('[data-coach-image]');
          const name = root.querySelector('[data-coach-name]');
          const focus = root.querySelector('[data-coach-focus]');
          const schedule = root.querySelector('[data-coach-schedule]');
          const text = root.querySelector('[data-coach-text]');
          const support = root.querySelector('[data-coach-support]');
          const profile = root.querySelector('[data-coach-profile]');
          const instagram = root.querySelector('[data-coach-instagram]');
          const instagramHandle = root.querySelector('[data-coach-instagram-handle]');

          const selectCoach = (button) => {
            buttons.forEach((item) => {
              const active = item === button;
              item.classList.toggle('is-active', active);
              item.setAttribute('aria-selected', String(active));
            });

            const d = button.dataset;
            image.classList.add('is-changing');
            window.setTimeout(() => {
              image.src = d.image || '';
              image.alt = d.imageAlt || d.name || '';
              image.classList.remove('is-changing');
            }, 120);

            name.textContent = d.name || '';
            focus.textContent = d.focus || '';
            schedule.textContent = d.schedule || 'Aktuelle Termine im Stundenplan';
            text.textContent = d.text || '';
            support.textContent = d.support || '';
            support.hidden = !d.support;
            profile.href = d.profile || '#';

            if (d.instagramUrl) {
              instagram.hidden = false;
              instagram.href = d.instagramUrl;
              instagramHandle.textContent = d.instagramHandle || 'Instagram';
            } else {
              instagram.hidden = true;
            }
          };

          buttons.forEach((button) => {
            button.addEventListener('click', () => selectCoach(button));
            button.addEventListener('mouseenter', () => selectCoach(button));
          });
        })();
      </script>
    </section>

    <section class="coaches-outro-v12">
      <p>Du musst nicht wissen, wer zu dir passt.</p>
      <a href="https://wa.me/491633863548?text=Hallo%20Elite%2C%20ich%20suche%20einen%20passenden%20Kurs%20und%20Coach.">Sag uns, was du tanzen möchtest →</a>
    </section>
  </main>

  <SiteFooter brand={site.brand} nav={site.nav} />
</BaseLayout>
