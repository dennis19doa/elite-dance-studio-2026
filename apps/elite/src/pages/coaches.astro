---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";

import coaches from "../data/coaches.json";
import site from "../data/site.json";

const featured = coaches.slice(0, 4);
---

<BaseLayout
  title="Coaches & Tanzlehrer:innen | Elite Dance Studio Berlin"
  description="Lerne die Coaches für Bachata, Reggaeton, Heels, Hip Hop, Commercial, K-Pop und weitere Styles im Elite Dance Studio Berlin kennen."
  bodyClass="coaches-page-v8"
>
  <SiteHeader brand={site.brand} nav={site.nav} />

  <main class="page-shell page-main coaches-main-v8">
    <section class="coaches-hero-v8">
      <div class="coaches-hero-copy-v8">
        <div class="eyebrow">Unser Team · Berlin-Moabit</div>
        <h1 class="page-title">22 Coaches.<br />Viele Styles.<br />Ein Studio.</h1>
        <p>Bei Elite geht es nicht um austauschbare Classes. Unterschiedliche Persönlichkeiten, Teaching-Styles und Tanzrichtungen geben dir die Chance, die Energie zu finden, bei der du gern wiederkommst.</p>
        <div class="actions">
          <a class="button primary" href="#all-coaches">Coaches entdecken</a>
          <a class="button secondary" href="/#schedule">Class buchen</a>
        </div>
      </div>
      <figure class="coaches-hero-image-v8">
        <img src="/media/current-site/elena-dennis-bachata.png" alt="Coaches im Elite Dance Studio Berlin" />
      </figure>
    </section>

    <section class="coaches-featured-v8" aria-labelledby="featured-coaches-title">
      <header class="coaches-section-head-v8">
        <div><div class="eyebrow">Meet the team</div><h2 id="featured-coaches-title">Menschen hinter der Class.</h2></div>
        <p>Öffne ein Profil für Teaching-Fokus, aktuelle Classes und Instagram.</p>
      </header>
      <div class="coaches-featured-grid-v8">
        {featured.map((coach) => (
          <a class="coach-card-v8" href={`/coaches/${coach.slug}/`}>
            <figure><img src={coach.image} alt={coach.imageAlt} loading="lazy" decoding="async" /></figure>
            <div><small>{coach.focus}</small><strong>{coach.name}</strong><span>{coach.schedule ?? "Profil ansehen"}</span></div>
          </a>
        ))}
      </div>
    </section>

    <section class="coaches-all-v8" id="all-coaches" aria-labelledby="all-coaches-title">
      <header class="coaches-section-head-v8">
        <div><div class="eyebrow">Alle Coaches</div><h2 id="all-coaches-title">Finde deinen Style. Finde deinen Coach.</h2></div>
        <a class="text-link" href="/kurse/">Kurse & Styles ansehen ↗</a>
      </header>
      <div class="coaches-grid-v8">
        {coaches.map((coach, index) => (
          <a class:list={["coach-card-v8", `accent-${(index % 3) + 1}`]} href={`/coaches/${coach.slug}/`}>
            <figure><img src={coach.image} alt={coach.imageAlt} loading="lazy" decoding="async" /></figure>
            <div><small>{coach.focus}</small><strong>{coach.name}</strong><span>Profil ansehen ↗</span></div>
          </a>
        ))}
      </div>
    </section>

    <section class="coaches-cta-v8">
      <div><div class="eyebrow">Nicht sicher?</div><h2>Wähle zuerst eine Class. Den Rest findest du beim Tanzen.</h2></div>
      <a class="button primary" href="/#schedule">Live-Stundenplan</a>
    </section>
  </main>

  <SiteFooter brand={site.brand} nav={site.nav} />
</BaseLayout>
