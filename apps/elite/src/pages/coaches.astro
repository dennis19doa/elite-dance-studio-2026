---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import InstagramIcon from "../components/InstagramIcon.astro";

import coaches from "../data/coaches.json";
import site from "../data/site.json";

const categoryFor = (focus: string) => {
  const value = focus.toLowerCase();
  if (/bachata|zouk|kizomba|salsa|lambada/.test(value)) return "partner";
  if (/hip hop|breaking|house/.test(value)) return "urban";
  if (/heels|commercial|k-pop|reggaeton|jazz|twerk/.test(value)) return "performance";
  return "movement";
};

const featured = coaches.slice(0, 3);
const baseUrl = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const scheduleHref = `${baseUrl}#schedule`;
---

<BaseLayout
  title="Coaches & Tanzlehrer:innen | Elite Dance Studio Berlin"
  description="Lerne die Coaches für Bachata, Reggaeton, Heels, Hip Hop, Commercial, K-Pop und weitere Styles im Elite Dance Studio Berlin kennen."
  bodyClass="site-subpage coaches-page-v11"
>
  <SiteHeader brand={site.brand} nav={site.nav} />

  <main class="page-shell page-main">
    <section class="coaches-hero-v11">
      <div class="coaches-hero-copy-v11">
        <div class="v11-kicker">22 Coaches · viele Handschriften</div>
        <h1 class="v11-display">Finde die Energie, bei der du bleiben willst.</h1>
        <p class="v11-copy">
          Ein guter Kurs ist mehr als ein Style-Name. Entdecke, wer bei Elite unterrichtet, wie sich
          die Class anfühlt und welcher Coach zu deinem nächsten Schritt passt.
        </p>
        <div class="coaches-hero-actions-v11">
          <a class="button primary" href="#coach-directory">Coaches entdecken</a>
          <a class="button secondary" href={scheduleHref}>Classes ansehen</a>
        </div>
      </div>

      <div class="coaches-hero-gallery-v11" aria-label="Auswahl unserer Coaches">
        {featured.map((coach) => (
          <a href={`/coaches/${coach.slug}/`}>
            <img src={coach.image} alt={coach.imageAlt} loading="eager" />
            <span>
              <strong>{coach.name}</strong>
              <small>{coach.focus}</small>
            </span>
          </a>
        ))}
      </div>
    </section>

    <section class="coach-directory-v11" id="coach-directory" data-coach-directory>
      <header class="coach-directory-head-v11">
        <div>
          <div class="v11-kicker">Unser Team</div>
          <h2>Persönlichkeiten statt austauschbarer Kurskarten.</h2>
        </div>
        <p>
          Filtere nach Richtung oder scroll einfach durch das Team. Termine, Teaching-Fokus,
          Einstiegshinweise und Instagram findest du direkt auf der Karte.
        </p>
      </header>

      <div class="coach-filters-v11" role="group" aria-label="Coaches nach Richtung filtern">
        <button class="coach-filter-v11 is-active" type="button" data-filter="all">Alle Coaches</button>
        <button class="coach-filter-v11" type="button" data-filter="partner">Partner Dance</button>
        <button class="coach-filter-v11" type="button" data-filter="urban">Urban</button>
        <button class="coach-filter-v11" type="button" data-filter="performance">Performance</button>
        <button class="coach-filter-v11" type="button" data-filter="movement">Movement</button>
      </div>

      <div class="coach-grid-v11">
        {coaches.map((coach) => (
          <article class="coach-card-v11" data-coach-card data-category={categoryFor(coach.focus)}>
            <a class="coach-card-image-v11" href={`/coaches/${coach.slug}/`} aria-label={`${coach.name} Profil öffnen`}>
              <img src={coach.image} alt={coach.imageAlt} loading="lazy" decoding="async" />
              <span class="coach-card-style-v11">{coach.focus}</span>
            </a>

            <div class="coach-card-body-v11">
              <div class="coach-card-meta-v11">
                <h3>{coach.name}</h3>
                {coach.schedule && <time>{coach.schedule}</time>}
              </div>

              <p>{coach.text}</p>
              {coach.beginnerSupport && <span class="coach-card-support-v11">{coach.beginnerSupport}</span>}

              <div class="coach-card-actions-v11">
                <a class="coach-profile-v11" href={`/coaches/${coach.slug}/`}>Profil ansehen ↗</a>
                {coach.instagramUrl ? (
                  <a
                    class="coach-instagram-v11"
                    href={coach.instagramUrl}
                    target="_blank"
                    rel="noreferrer"
                    aria-label={`${coach.name} auf Instagram öffnen`}
                  >
                    <InstagramIcon />
                    <span>{coach.instagramHandle}</span>
                  </a>
                ) : (
                  <span class="coach-instagram-v11" aria-label="Instagram folgt">
                    <InstagramIcon />
                    <span>Instagram folgt</span>
                  </span>
                )}
              </div>
            </div>
          </article>
        ))}
      </div>

      <script is:inline>
        (() => {
          const root = document.currentScript?.closest('[data-coach-directory]');
          if (!root) return;
          const buttons = [...root.querySelectorAll('[data-filter]')];
          const cards = [...root.querySelectorAll('[data-coach-card]')];

          buttons.forEach((button) => {
            button.addEventListener('click', () => {
              const filter = button.dataset.filter;
              buttons.forEach((item) => item.classList.toggle('is-active', item === button));
              cards.forEach((card) => {
                card.hidden = filter !== 'all' && card.dataset.category !== filter;
              });
            });
          });
        })();
      </script>
    </section>

    <section class="coaches-cta-v11">
      <div>
        <div class="v11-kicker">Noch unsicher?</div>
        <h2>Du musst den perfekten Coach nicht vorher kennen.</h2>
        <p>Schreib uns, was du suchst – wir empfehlen dir eine konkrete Class und einen passenden Einstieg.</p>
      </div>
      <a class="button" href="https://wa.me/491633863548?text=Hallo%20Elite%2C%20ich%20suche%20einen%20passenden%20Kurs%20und%20Coach.">Empfehlung bekommen</a>
    </section>
  </main>

  <SiteFooter brand={site.brand} nav={site.nav} />
</BaseLayout>
