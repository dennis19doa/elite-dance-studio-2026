---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import CoachesSection from "../components/CoachesSection.astro";

import coaches from "../data/coaches.json";
import site from "../data/site.json";
---

<BaseLayout
  title="Coaches & Tanzlehrer:innen | Elite Dance Studio Berlin"
  description="Lerne die Coaches für Bachata, Reggaeton, Heels, Hip Hop, Commercial und K-Pop im Elite Dance Studio Berlin kennen."
>
  <SiteHeader brand={site.brand} nav={site.nav} />

  <main class="page-shell page-main">
    <section class="coaches-page-hero panel">
      <div class="coaches-page-copy">
        <div class="eyebrow">Menschen vor Perfektion</div>
        <h1 class="page-title">Ein guter Coach lässt deinen ersten Schritt leicht wirken.</h1>
        <p class="lead">
          Unsere Coaches geben dir Technik, Energie und Orientierung, ohne dass du dich schon
          wie ein:e Tänzer:in fühlen musst.
        </p>
        <div class="actions">
          <a class="button primary" href="#coach-list">Coaches kennenlernen</a>
          <a class="button secondary" href="/kurse/">Beginner-Kurs finden</a>
        </div>
      </div>
      <figure class="coaches-page-media">
        <img
          src="/media/placeholders/community-beginners.jpg"
          alt="Konzeptbild einer freundlichen Beginner-Gruppe im Tanzstudio"
        />
        <figcaption>Bildidee · echte Kursmomente ersetzen dieses Konzept</figcaption>
      </figure>
    </section>

    <section class="coach-values panel">
      <div class="coach-value value-coral"><span>01</span><strong>Verständlich</strong><p>Klare Erklärungen und Fundamentals, die du wirklich anwenden kannst.</p></div>
      <div class="coach-value value-blue"><span>02</span><strong>Aufmerksam</strong><p>Du wirst gesehen, auch wenn du zum allerersten Mal im Raum stehst.</p></div>
      <div class="coach-value value-gold"><span>03</span><strong>Motivierend</strong><p>Fortschritt darf sich leicht, persönlich und nach dir anfühlen.</p></div>
    </section>

    <div id="coach-list">
      <CoachesSection
      coaches={coaches}
      eyebrow="Unser Team"
      title="Finde die Energie, bei der du bleiben willst."
      description="Öffne ein Profil, lerne den Teaching-Fokus kennen und springe über das Instagram-Icon direkt zu aktuellen Videos und Eindrücken."
      />
    </div>

    <section class="quote-panel panel">
      <div>
        <div class="eyebrow">Unser Anspruch</div>
        <blockquote>{site.communityQuote}</blockquote>
      </div>
      <div class="coach-callout">
        <strong>Du musst keinen Coach vorher kennen.</strong>
        <p>Wähle zuerst den Style, der dich neugierig macht. Beim ersten Besuch helfen wir dir dabei, das richtige Level und die passende Atmosphäre zu finden.</p>
        <div class="point-list">
          <span>Die meisten laufenden Klassen sind beginner-friendly.</span>
          <span>Allein kommen ist bei Elite vollkommen normal.</span>
          <span>Fragen vor dem Kurs beantworten wir direkt.</span>
        </div>
        <a class="text-link" href="/kontakt/">Persönliche Empfehlung bekommen <span aria-hidden="true">→</span></a>
      </div>
    </section>
  </main>

  <SiteFooter brand={site.brand} nav={site.nav} />
</BaseLayout>
