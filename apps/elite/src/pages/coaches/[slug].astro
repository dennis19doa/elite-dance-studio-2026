---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import InstagramIcon from "../../components/InstagramIcon.astro";
import { cloudMediaUrl } from "../../lib/media";

import coaches from "../../data/coaches.json";
import site from "../../data/site.json";

export function getStaticPaths() {
  return coaches.map((coach) => ({ params: { slug: coach.slug }, props: { coach } }));
}

const { coach } = Astro.props;
const relatedCoaches = coaches
  .filter((item) => item.slug !== coach.slug)
  .sort((a, b) => {
    const aMatches = a.focus.split(" · ").some((focus) => coach.focus.includes(focus));
    const bMatches = b.focus.split(" · ").some((focus) => coach.focus.includes(focus));
    return Number(bMatches) - Number(aMatches);
  })
  .slice(0, 3);

const siteUrl = Astro.site ?? new URL("https://elitedancestudio.de");
const previewBase = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const bookingHref = `${previewBase}stundenplan/#schedule`;
const coachClasses = coach.classes ?? [];
const scheduleSummary = coachClasses.length
  ? `${coachClasses.length} Classes · ${coachClasses[0].day}`
  : coach.schedule;
const coachVideoSrc = coach.videoCloudSrc ? cloudMediaUrl(coach.videoCloudSrc) : undefined;
const profileText = coach.bio ?? coach.text;
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: coach.name,
  jobTitle: `Dance Coach · ${coach.focus}`,
  image: new URL(coach.image, siteUrl).toString(),
  url: new URL(`/coaches/${coach.slug}/`, siteUrl).toString(),
  worksFor: {
    "@type": "Organization",
    name: "Elite Dance Studio"
  },
  ...(coach.instagramUrl ? { sameAs: [coach.instagramUrl] } : {})
};
---

<BaseLayout
  title={`${coach.name} · ${coach.focus} Coach | Elite Dance Studio Berlin`}
  description={`Lerne ${coach.name}, ${coach.focus} Coach im Elite Dance Studio Berlin, kennen und finde die passenden Kurstermine.`}
  image={coach.image}
  bodyClass="coach-profile-page-v15"
>
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(personSchema)}></script>
  <SiteHeader brand={site.brand} nav={site.nav} />

  <main class="page-shell page-main coach-profile-main-v15">
    <section class="coach-stage-v26">
      <a class="coach-back-v26" href="/coaches/"><span aria-hidden="true">←</span> Alle Coaches</a>

      <div class="coach-stage-grid-v26">
        <article class="coach-story-v26">
          <figure class="coach-portrait-v26">
            <img
              src={coach.image}
              alt={coach.imageAlt}
              width="900"
              height="1125"
              style={`--coach-image-position: ${coach.slug === "sora" ? "center center" : "center top"};`}
            />
            <div class="coach-portrait-shade-v26" aria-hidden="true"></div>
            <span class="coach-kicker-v26">Meet your coach</span>
            <div class="coach-portrait-title-v26">
              <h1>{coach.name}</h1>
              <span>{coach.focus}</span>
            </div>
          </figure>

          <div class="coach-story-copy-v26">
            <p>{profileText}</p>

            <div class="coach-story-meta-v26">
              {coach.beginnerSupport && <span>{coach.beginnerSupport}</span>}
              <span>{scheduleSummary}</span>
            </div>

            <div class="coach-story-actions-v26">
              <a class="button primary" href={bookingHref}>Class finden</a>
              {coach.instagramUrl && (
                <a class="coach-instagram-v26" href={coach.instagramUrl} target="_blank" rel="noreferrer" aria-label={`${coach.name} auf Instagram öffnen`}>
                  <InstagramIcon />
                  <span class="coach-instagram-label-v26">Instagram</span>
                  <strong>{coach.instagramHandle}</strong>
                  <b aria-hidden="true">↗</b>
                </a>
              )}
            </div>
          </div>
        </article>

        <aside class="coach-experience-v26">
          <figure class:list={["coach-video-v26", { "has-video": Boolean(coachVideoSrc) }]}>
            {coachVideoSrc ? (
              <video
                autoplay
                muted
                loop
                playsinline
                preload="metadata"
                poster={coach.image}
                aria-label={`Tanzvideo mit ${coach.name}`}
              >
                <source src={coachVideoSrc} type="video/mp4" />
              </video>
            ) : (
              <>
                <img class="coach-video-poster-v26" src={coach.image} alt="" aria-hidden="true" />
                <div class="coach-video-shade-v26" aria-hidden="true"></div>
                <div class="coach-video-copy-v26">
                  <span class="coach-video-orb-v26" aria-hidden="true">▶</span>
                  <div>
                    <small>Coach video · folgt</small>
                    <strong>{coach.name} in Bewegung</strong>
                    <p>Bald siehst du hier direkt, wie sich die Class anfühlt.</p>
                  </div>
                </div>
              </>
            )}
          </figure>

          <div class="coach-classes-v26">
            <div class="coach-classes-head-v26">
              <div>
                <small>Train with {coach.name}</small>
                <strong>Classes bei Elite</strong>
              </div>
              <a href={bookingHref}>Live-Stundenplan ↗</a>
            </div>

            <div class="coach-class-list-v26">
              {coachClasses.length ? (
                coachClasses.map((item) => (
                  <a class="coach-class-v26" href={bookingHref} aria-label={`${item.title} ${item.time} im Live-Stundenplan öffnen`}>
                    <span>{item.day}</span>
                    <time>{item.time}</time>
                    <strong>{item.title}</strong>
                    <b>{item.meta}</b>
                    <i aria-hidden="true">→</i>
                  </a>
                ))
              ) : (
                <a class="coach-class-v26" href={bookingHref} aria-label={`${coach.name} im Live-Stundenplan öffnen`}>
                  <span>Regelmäßig</span>
                  <time>{coach.schedule}</time>
                  <strong>{coach.focus}</strong>
                  <b>Details</b>
                  <i aria-hidden="true">→</i>
                </a>
              )}
            </div>
          </div>
        </aside>
      </div>
    </section>

    <section class="coach-related-v27" aria-label="Weitere Coaches">
      <div class="coach-related-head-v27">
        <div>
          <small>Weitere Coaches</small>
          <strong>Vielleicht passt auch jemand hiervon zu dir.</strong>
        </div>
        <a href="/coaches/">Alle ansehen ↗</a>
      </div>

      <div class="coach-related-row-v27">
        {relatedCoaches.map((item) => (
          <a class="coach-related-card-v27" href={`/coaches/${item.slug}/`}>
            <figure>
              <img src={item.image} alt="" loading="lazy" />
            </figure>
            <span>
              <strong>{item.name}</strong>
              <small>{item.focus}</small>
            </span>
            <b aria-hidden="true">→</b>
          </a>
        ))}
      </div>
    </section>

    <style is:inline>
      .coach-profile-main-v15 {
        padding-top: clamp(18px, 3vw, 34px) !important;
      }

      .coach-stage-v26 {
        position: relative;
        overflow: hidden;
        padding: clamp(16px, 2.4vw, 28px);
        border: 1px solid rgba(255,255,255,.09);
        border-radius: 26px;
        background:
          radial-gradient(circle at 8% 10%, rgba(255,79,123,.11), transparent 28rem),
          radial-gradient(circle at 92% 22%, rgba(210,248,90,.055), transparent 24rem),
          linear-gradient(145deg, rgba(255,255,255,.025), rgba(255,255,255,.006));
        box-shadow: 0 28px 80px rgba(0,0,0,.24);
      }

      .coach-stage-v26::before {
        position: absolute;
        top: 0;
        right: 16%;
        left: 16%;
        height: 1px;
        background: linear-gradient(90deg, transparent, rgba(255,79,123,.8), rgba(210,248,90,.7), transparent);
        content: "";
      }

      .coach-back-v26 {
        position: relative;
        z-index: 2;
        display: inline-flex;
        gap: 7px;
        align-items: center;
        margin-bottom: 14px;
        color: rgba(255,255,255,.5);
        font-size: .72rem;
        font-weight: 650;
        text-decoration: none;
      }

      .coach-back-v26:hover { color: #fff; }

      .coach-stage-grid-v26 {
        position: relative;
        z-index: 1;
        display: grid !important;
        grid-template-columns: minmax(290px, .78fr) minmax(430px, 1.22fr) !important;
        gap: clamp(24px, 4.5vw, 58px) !important;
        align-items: start !important;
      }

      .coach-story-v26,
      .coach-experience-v26 {
        min-width: 0 !important;
        max-width: none !important;
      }

      .coach-portrait-v26 {
        position: relative !important;
        display: block !important;
        width: 100% !important;
        max-width: 410px !important;
        height: 430px !important;
        min-height: 0 !important;
        margin: 0 !important;
        overflow: hidden !important;
        aspect-ratio: auto !important;
        border: 1px solid rgba(255,255,255,.11);
        border-radius: 22px;
        background: #1a171c;
        box-shadow: 0 24px 58px rgba(0,0,0,.28);
      }

      .coach-portrait-v26 img {
        display: block !important;
        width: 100% !important;
        height: 100% !important;
        max-width: 100% !important;
        min-height: 0 !important;
        object-fit: cover !important;
        object-position: var(--coach-image-position, center top) !important;
        transform: scale(1.002);
      }

      .coach-portrait-shade-v26 {
        position: absolute;
        inset: 0;
        background:
          linear-gradient(180deg, transparent 40%, rgba(12,10,14,.16) 58%, rgba(12,10,14,.9) 100%),
          linear-gradient(90deg, rgba(11,9,13,.08), transparent 48%);
        pointer-events: none;
      }

      .coach-kicker-v26 {
        position: absolute;
        top: 16px;
        left: 16px;
        z-index: 2;
        padding: 7px 9px;
        border: 1px solid rgba(255,255,255,.16);
        border-radius: 999px;
        background: rgba(12,10,14,.56);
        color: rgba(255,255,255,.84);
        font-size: .58rem;
        font-weight: 850;
        letter-spacing: .1em;
        text-transform: uppercase;
        backdrop-filter: blur(12px);
      }

      .coach-portrait-title-v26 {
        position: absolute;
        right: 18px;
        bottom: 18px;
        left: 18px;
        z-index: 2;
      }

      .coach-portrait-title-v26 h1 {
        margin: 0 !important;
        color: #fff !important;
        font-size: clamp(3rem, 5vw, 5.4rem) !important;
        line-height: .86 !important;
        letter-spacing: -.06em !important;
        text-shadow: 0 10px 28px rgba(0,0,0,.35);
      }

      .coach-portrait-title-v26 > span {
        display: block;
        margin-top: 8px;
        color: #d2f85a;
        font-size: .67rem;
        font-weight: 900;
        letter-spacing: .1em;
        text-transform: uppercase;
      }

      .coach-story-copy-v26 {
        max-width: 410px;
        padding: 18px 3px 0;
      }

      .coach-story-copy-v26 > p {
        margin: 0 !important;
        color: rgba(255,255,255,.67) !important;
        font-size: .92rem !important;
        line-height: 1.65 !important;
      }

      .coach-story-meta-v26 {
        display: flex;
        flex-wrap: wrap;
        gap: 7px;
        margin-top: 14px;
      }

      .coach-story-meta-v26 span {
        padding: 7px 9px;
        border: 1px solid rgba(255,255,255,.10);
        border-radius: 999px;
        background: rgba(255,255,255,.035);
        color: rgba(255,255,255,.62);
        font-size: .62rem;
        font-weight: 720;
      }

      .coach-story-actions-v26 {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        align-items: center;
        margin-top: 15px;
      }

      .coach-story-actions-v26 .button {
        min-height: 42px !important;
        padding: 0 15px !important;
      }

      .coach-instagram-v26 {
        display: inline-flex;
        min-width: 0;
        min-height: 40px;
        align-items: center;
        gap: 7px;
        padding: 0 11px;
        border: 1px solid rgba(255,79,123,.30);
        border-radius: 999px;
        background: rgba(255,79,123,.055);
        color: #ff668b;
        font-size: .68rem;
        font-weight: 760;
        text-decoration: none;
      }

      .coach-instagram-v26 svg {
        width: 15px;
        height: 15px;
        flex: 0 0 auto;
      }

      .coach-instagram-v26 span {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      .coach-experience-v26 {
        display: grid !important;
        align-content: start;
      }

      .coach-video-v26 {
        position: relative !important;
        display: block !important;
        width: 100% !important;
        max-width: 760px !important;
        height: 350px !important;
        min-height: 0 !important;
        margin: 0 0 0 auto !important;
        overflow: hidden !important;
        aspect-ratio: auto !important;
        border: 1px solid rgba(255,255,255,.10);
        border-radius: 24px;
        background: #09090c;
        box-shadow: 0 30px 72px rgba(0,0,0,.34);
      }

      .coach-video-v26 video {
        display: block !important;
        width: 100% !important;
        height: 100% !important;
        object-fit: contain !important;
        background: #08080b !important;
      }

      .coach-video-poster-v26 {
        position: absolute !important;
        inset: -24px !important;
        width: calc(100% + 48px) !important;
        height: calc(100% + 48px) !important;
        max-width: none !important;
        object-fit: cover !important;
        object-position: var(--coach-image-position, center 28%) !important;
        filter: blur(13px) saturate(.82) brightness(.44);
        transform: scale(1.08);
      }

      .coach-video-shade-v26 {
        position: absolute;
        inset: 0;
        background:
          radial-gradient(circle at 25% 28%, rgba(255,79,123,.18), transparent 32%),
          radial-gradient(circle at 78% 72%, rgba(210,248,90,.08), transparent 28%),
          linear-gradient(110deg, rgba(8,8,11,.72), rgba(8,8,11,.9));
      }

      .coach-video-copy-v26 {
        position: absolute;
        inset: 0;
        z-index: 2;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 18px;
        padding: 34px;
        color: #fff;
      }

      .coach-video-orb-v26 {
        position: relative;
        display: grid;
        width: 68px;
        height: 68px;
        flex: 0 0 auto;
        place-items: center;
        padding-left: 4px;
        border: 1px solid rgba(210,248,90,.42);
        border-radius: 999px;
        background: rgba(16,16,20,.52);
        color: #d2f85a;
        font-size: 1rem;
        box-shadow: 0 0 0 10px rgba(210,248,90,.035);
        backdrop-filter: blur(10px);
      }

      .coach-video-copy-v26 small {
        display: block;
        margin-bottom: 6px;
        color: #ff668b;
        font-size: .63rem;
        font-weight: 900;
        letter-spacing: .1em;
        text-transform: uppercase;
      }

      .coach-video-copy-v26 strong {
        display: block;
        max-width: 13ch;
        color: #fff;
        font-size: clamp(2rem, 3.4vw, 3.35rem);
        line-height: .94;
        letter-spacing: -.045em;
      }

      .coach-video-copy-v26 p {
        max-width: 27rem;
        margin: 9px 0 0 !important;
        color: rgba(255,255,255,.56) !important;
        font-size: .78rem !important;
        line-height: 1.5 !important;
      }

      .coach-classes-v26 {
        position: relative;
        z-index: 4;
        width: calc(100% - 34px);
        max-width: 720px;
        margin: -24px 17px 0 auto;
        overflow: hidden;
        border: 1px solid rgba(255,255,255,.12);
        border-radius: 18px;
        background: rgba(20,17,19,.94);
        box-shadow: 0 22px 52px rgba(0,0,0,.32);
        backdrop-filter: blur(16px);
      }

      .coach-classes-head-v26 {
        display: flex;
        justify-content: space-between;
        gap: 16px;
        align-items: center;
        padding: 13px 15px;
        border-bottom: 1px solid rgba(255,255,255,.09);
      }

      .coach-classes-head-v26 > div {
        display: grid;
        gap: 2px;
      }

      .coach-classes-head-v26 small {
        color: rgba(255,255,255,.4);
        font-size: .56rem;
        font-weight: 800;
        letter-spacing: .08em;
        text-transform: uppercase;
      }

      .coach-classes-head-v26 strong {
        color: #fff;
        font-size: .82rem;
      }

      .coach-classes-head-v26 > a {
        color: #d2f85a;
        font-size: .64rem;
        font-weight: 850;
        text-decoration: none;
        white-space: nowrap;
      }

      .coach-class-list-v26 { display: grid; }

      .coach-class-v26 {
        display: grid;
        grid-template-columns: 74px 104px minmax(130px,1fr) auto 18px;
        gap: 10px;
        align-items: center;
        min-height: 54px;
        padding: 9px 13px;
        color: inherit;
        text-decoration: none;
        transition: background .2s ease, transform .2s ease;
      }

      .coach-class-v26 + .coach-class-v26 {
        border-top: 1px solid rgba(255,255,255,.075);
      }

      .coach-class-v26:hover,
      .coach-class-v26:focus-visible {
        background: rgba(255,255,255,.055);
      }

      .coach-class-v26 > span {
        color: #ff668b;
        font-size: .56rem;
        font-weight: 900;
        letter-spacing: .06em;
        text-transform: uppercase;
      }

      .coach-class-v26 time {
        color: rgba(255,255,255,.62);
        font-size: .69rem;
        font-weight: 760;
        font-variant-numeric: tabular-nums;
      }

      .coach-class-v26 > strong {
        color: #fff;
        font-size: .81rem;
      }

      .coach-class-v26 > b {
        justify-self: end;
        padding: 5px 7px;
        border: 1px solid rgba(210,248,90,.18);
        border-radius: 999px;
        color: #d2f85a;
        font-size: .55rem;
        font-weight: 850;
        white-space: nowrap;
      }

      .coach-class-v26 > i {
        color: #d2f85a;
        font-size: .82rem;
        font-style: normal;
      }

      .coach-related-v26 {
        padding: clamp(24px, 3vw, 34px) 0 0 !important;
      }

      .coach-related-head-v26 {
        display: flex;
        justify-content: space-between;
        gap: 16px;
        align-items: end;
        margin-bottom: 10px;
      }

      .coach-related-head-v26 > div {
        display: grid;
        gap: 2px;
      }

      .coach-related-head-v26 small {
        color: #ff668b;
        font-size: .55rem;
        font-weight: 900;
        letter-spacing: .09em;
        text-transform: uppercase;
      }

      .coach-related-head-v26 strong {
        color: #fff;
        font-size: .9rem;
      }

      .coach-related-head-v26 > a {
        color: rgba(255,255,255,.48);
        font-size: .65rem;
        font-weight: 760;
        text-decoration: none;
      }

      .coach-related-row-v26 {
        display: grid !important;
        grid-template-columns: repeat(3, minmax(0,1fr)) !important;
        gap: 10px !important;
      }

      .coach-related-card-v26 {
        position: relative;
        display: block;
        height: 96px;
        overflow: hidden;
        border: 1px solid rgba(255,255,255,.085);
        border-radius: 15px;
        background: #17151a;
        color: #fff;
        text-decoration: none;
        transition: transform .24s ease, border-color .24s ease;
      }

      .coach-related-card-v26:hover {
        transform: translateY(-3px);
        border-color: rgba(210,248,90,.22);
      }

      .coach-related-card-v26 > img {
        display: block !important;
        width: 100% !important;
        height: 100% !important;
        max-width: none !important;
        object-fit: cover !important;
        object-position: center 32%;
        transition: transform .45s cubic-bezier(.22,1,.36,1);
      }

      .coach-related-card-v26:hover > img { transform: scale(1.035); }

      .coach-related-shade-v26 {
        position: absolute;
        inset: 0;
        background: linear-gradient(90deg, rgba(10,9,12,.9) 0%, rgba(10,9,12,.58) 54%, rgba(10,9,12,.08) 100%);
      }

      .coach-related-copy-v26 {
        position: absolute;
        top: 50%;
        left: 14px;
        z-index: 2;
        display: grid;
        gap: 3px;
        transform: translateY(-50%);
      }

      .coach-related-copy-v26 strong {
        color: #fff;
        font-size: .78rem;
      }

      .coach-related-copy-v26 small {
        color: rgba(255,255,255,.58);
        font-size: .61rem;
      }

      .coach-related-card-v26 > b {
        position: absolute;
        top: 50%;
        right: 14px;
        z-index: 2;
        color: #d2f85a;
        font-size: .8rem;
        transform: translateY(-50%);
      }

      @media (prefers-reduced-motion: no-preference) {
        .coach-portrait-v26 {
          animation: coachRevealV26 .55s cubic-bezier(.22,1,.36,1) both;
        }

        .coach-experience-v26 {
          animation: coachRevealV26 .55s .08s cubic-bezier(.22,1,.36,1) both;
        }

        @keyframes coachRevealV26 {
          from { opacity: 0; transform: translateY(10px); }
          to { opacity: 1; transform: translateY(0); }
        }
      }

      @media (max-width: 980px) {
        .coach-stage-grid-v26 {
          grid-template-columns: minmax(250px,.78fr) minmax(330px,1.22fr) !important;
          gap: 24px !important;
        }

        .coach-portrait-v26 {
          height: 380px !important;
        }

        .coach-video-v26 {
          height: 310px !important;
        }

        .coach-class-v26 {
          grid-template-columns: 1fr auto;
          gap: 5px 10px;
        }

        .coach-class-v26 > strong,
        .coach-class-v26 > b,
        .coach-class-v26 > i {
          grid-column: 1 / -1;
        }

        .coach-class-v26 > b,
        .coach-class-v26 > i {
          justify-self: start;
        }

        .coach-class-v26 > i { display: none; }
      }

      @media (max-width: 720px) {
        .coach-stage-v26 {
          padding: 12px;
          border-radius: 20px;
        }

        .coach-stage-grid-v26 {
          grid-template-columns: 1fr !important;
        }

        .coach-portrait-v26 {
          max-width: none !important;
          height: min(112vw, 520px) !important;
