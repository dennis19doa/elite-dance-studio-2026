---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import CoachesSection from "../../components/CoachesSection.astro";
import InstagramIcon from "../../components/InstagramIcon.astro";
import { cloudMediaUrl } from "../../lib/media";

import coaches from "../../data/coaches.json";
import site from "../../data/site.json";

export function getStaticPaths() {
  return coaches.map((coach) => ({ params: { slug: coach.slug }, props: { coach } }));
}

const { coach } = Astro.props;
const relatedCoaches = coaches
  .filter((item) => item.slug !== coach.slug)
  .sort((a, b) => {
    const aMatches = a.focus.split(" · ").some((focus) => coach.focus.includes(focus));
    const bMatches = b.focus.split(" · ").some((focus) => coach.focus.includes(focus));
    return Number(bMatches) - Number(aMatches);
  })
  .slice(0, 3);

const siteUrl = Astro.site ?? new URL("https://elitedancestudio.de");
const previewBase = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const bookingHref = `${previewBase}stundenplan/#schedule`;
const coachClasses = coach.classes ?? [];
const scheduleSummary = coachClasses.length
  ? `${coachClasses.length} Classes · ${coachClasses[0].day}`
  : coach.schedule;
const coachVideoSrc = coach.videoCloudSrc ? cloudMediaUrl(coach.videoCloudSrc) : undefined;
const profileText = coach.bio ?? coach.text;
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: coach.name,
  jobTitle: `Dance Coach · ${coach.focus}`,
  image: new URL(coach.image, siteUrl).toString(),
  url: new URL(`/coaches/${coach.slug}/`, siteUrl).toString(),
  worksFor: {
    "@type": "Organization",
    name: "Elite Dance Studio"
  },
  ...(coach.instagramUrl ? { sameAs: [coach.instagramUrl] } : {})
};
---

<BaseLayout
  title={`${coach.name} · ${coach.focus} Coach | Elite Dance Studio Berlin`}
  description={`Lerne ${coach.name}, ${coach.focus} Coach im Elite Dance Studio Berlin, kennen und finde die passenden Kurstermine.`}
  image={coach.image}
  bodyClass="coach-profile-page-v15"
>
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(personSchema)}></script>
  <SiteHeader brand={site.brand} nav={site.nav} />

  <main class="page-shell page-main coach-profile-main-v15">
    <section class="coach-profile-shell-v24">
      <a class="coach-profile-back-v15" href="/coaches/"><span aria-hidden="true">←</span> Alle Coaches</a>

      <div class="coach-profile-grid-v24">
        <div class="coach-profile-left-v24">
          <figure class="coach-profile-portrait-v24">
            <img
              src={coach.image}
              alt={coach.imageAlt}
              width="900"
              height="1125"
              style={`--coach-image-position: ${coach.slug === "sora" ? "center center" : "center top"};`}
            />
          </figure>

          <div class="coach-profile-copy-v24">
            <div class="coach-profile-name-row-v24">
              <div>
                <h1>{coach.name}</h1>
                <p class="coach-profile-focus-v24">{coach.focus}</p>
              </div>
              {coach.instagramUrl && (
                <a class="coach-profile-instagram-v24" href={coach.instagramUrl} target="_blank" rel="noreferrer" aria-label={`${coach.name} auf Instagram öffnen`}>
                  <InstagramIcon />
                  <span>{coach.instagramHandle}</span>
                </a>
              )}
            </div>

            <p class="coach-profile-bio-v24">{profileText}</p>

            <div class="coach-profile-chips-v24">
              <span>{scheduleSummary}</span>
              {coach.beginnerSupport && <span>{coach.beginnerSupport}</span>}
            </div>

            <a class="button primary coach-profile-book-v24" href={bookingHref}>Class finden</a>
          </div>
        </div>

        <div class="coach-profile-right-v24">
          <div class="coach-profile-video-top-v24">
            <span>Coach Video</span>
            <b>{coach.focus}</b>
          </div>

          <figure class:list={["coach-profile-video-v24", { "has-video": Boolean(coachVideoSrc) }]}>
            {coachVideoSrc ? (
              <video
                autoplay
                muted
                loop
                playsinline
                preload="metadata"
                poster={coach.image}
                aria-label={`Tanzvideo mit ${coach.name}`}
              >
                <source src={coachVideoSrc} type="video/mp4" />
              </video>
            ) : (
              <div class="coach-profile-video-empty-v24">
                <span aria-hidden="true">▶</span>
                <div>
                  <small>Video folgt</small>
                  <strong>{coach.name} in Bewegung</strong>
                </div>
              </div>
            )}
          </figure>

          <div class="coach-profile-classes-v24">
            <div class="coach-profile-classes-top-v24">
              <strong>Classes bei Elite</strong>
              <a href={bookingHref}>Live-Stundenplan ↗</a>
            </div>

            <div class="coach-profile-class-list-v24">
              {coachClasses.length ? (
                coachClasses.map((item) => (
                  <a
                    class="coach-profile-class-row-v24"
                    href={bookingHref}
                    aria-label={`${item.title} ${item.time} im Live-Stundenplan öffnen`}
                  >
                    <span>{item.day}</span>
                    <time>{item.time}</time>
                    <strong>{item.title}</strong>
                    <b>{item.meta}</b>
                  </a>
                ))
              ) : (
                <a class="coach-profile-class-row-v24" href={bookingHref} aria-label={`${coach.name} im Live-Stundenplan öffnen`}>
                  <span>Regelmäßig</span>
                  <time>{coach.schedule}</time>
                  <strong>{coach.focus}</strong>
                  <b>Details ↗</b>
                </a>
              )}
            </div>
          </div>
        </div>
      </div>
    </section>

    <CoachesSection
      coaches={relatedCoaches}
      eyebrow=""
      title="Weitere Coaches"
      description=""
    />
  </main>

  <SiteFooter brand={site.brand} nav={site.nav} />
</BaseLayout>
