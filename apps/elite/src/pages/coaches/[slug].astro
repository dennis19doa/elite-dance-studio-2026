---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import CoachesSection from "../../components/CoachesSection.astro";
import InstagramIcon from "../../components/InstagramIcon.astro";
import { cloudMediaUrl } from "../../lib/media";

import coaches from "../../data/coaches.json";
import site from "../../data/site.json";

export function getStaticPaths() {
  return coaches.map((coach) => ({ params: { slug: coach.slug }, props: { coach } }));
}

const { coach } = Astro.props;
const relatedCoaches = coaches
  .filter((item) => item.slug !== coach.slug)
  .sort((a, b) => {
    const aMatches = a.focus.split(" · ").some((focus) => coach.focus.includes(focus));
    const bMatches = b.focus.split(" · ").some((focus) => coach.focus.includes(focus));
    return Number(bMatches) - Number(aMatches);
  })
  .slice(0, 3);

const siteUrl = Astro.site ?? new URL("https://elitedancestudio.de");
const previewBase = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const bookingHref = `${previewBase}#schedule`;
const coachClasses = coach.classes ?? [];
const scheduleSummary = coachClasses.length
  ? `${coachClasses.length} Classes · ${coachClasses[0].day}`
  : coach.schedule;
const coachVideoSrc = coach.videoCloudSrc ? cloudMediaUrl(coach.videoCloudSrc) : coach.videoSrc;
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: coach.name,
  jobTitle: `Dance Coach · ${coach.focus}`,
  image: new URL(coach.image, siteUrl).toString(),
  url: new URL(`/coaches/${coach.slug}/`, siteUrl).toString(),
  worksFor: {
    "@type": "Organization",
    name: "Elite Dance Studio"
  },
  ...(coach.instagramUrl ? { sameAs: [coach.instagramUrl] } : {})
};
---

<BaseLayout
  title={`${coach.name} · ${coach.focus} Coach | Elite Dance Studio Berlin`}
  description={`Lerne ${coach.name}, ${coach.focus} Coach im Elite Dance Studio Berlin, kennen und finde die passenden Kurstermine.`}
  image={coach.image}
  bodyClass="coach-profile-page-v15"
>
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(personSchema)}></script>
  <SiteHeader brand={site.brand} nav={site.nav} />

  <main class="page-shell page-main coach-profile-main-v15">
    <section class="coach-profile-hero-v15">
      <div class="coach-profile-copy-v15">
        <a class="coach-profile-back-v15" href="/coaches/"><span aria-hidden="true">←</span> Alle Coaches</a>
        <div class="eyebrow">Meet your coach</div>
        <h1>{coach.name}</h1>
        <p class="coach-profile-focus-v15">{coach.focus}</p>
        <p class="lead">{coach.text}</p>

        <div class="coach-profile-meta-v15">
          <div><span>Aktuelle Classes</span><strong>{scheduleSummary}</strong></div>
          {coach.beginnerSupport && <div><span>Für deinen Einstieg</span><strong>{coach.beginnerSupport}</strong></div>}
        </div>

        <div class="coach-profile-actions-v15">
          <a class="button primary" href={bookingHref}>Class finden</a>
          {coach.instagramUrl ? (
            <a class="coach-profile-instagram-v15" href={coach.instagramUrl} target="_blank" rel="noreferrer">
              <InstagramIcon />
              <span>{coach.instagramHandle}</span>
            </a>
          ) : (
            <span class="coach-profile-instagram-v15 is-disabled">
              <InstagramIcon />
              <span>Instagram folgt</span>
            </span>
          )}
        </div>
      </div>

      <figure class="coach-profile-portrait-v15">
        <img src={coach.image} alt={coach.imageAlt} width="900" height="1125" style={`--coach-image-position: ${coach.slug === "sora" ? "center center" : "center top"};`} />
      </figure>
    </section>

    <section class="coach-profile-teaching-v21">
      <div class="coach-profile-teaching-copy-v21">
        <div class="eyebrow">Teaching & Background</div>
        <h2>So unterrichtet {coach.name}.</h2>
        <p>{coach.bio ?? coach.text}</p>
      </div>
      <div class="coach-profile-teaching-facts-v21">
        <article>
          <span>Style & Fokus</span>
          <strong>{coach.focus}</strong>
          <p>{coach.text}</p>
        </article>
        <article>
          <span>Für deinen Einstieg</span>
          <strong>{coach.beginnerSupport ?? "Frag uns nach dem passenden Level"}</strong>
          <p>Wenn du bei Level oder Class unsicher bist, helfen wir dir vor der Buchung persönlich weiter.</p>
        </article>
      </div>
    </section>

    <section class="coach-profile-classes-v21" aria-labelledby={`coach-classes-${coach.slug}`}>
      <div class="coach-profile-classes-head-v21">
        <div>
          <div class="eyebrow">Regelmäßige Classes</div>
          <h2 id={`coach-classes-${coach.slug}`}>Wann du mit {coach.name} trainieren kannst.</h2>
        </div>
        <a class="button secondary" href={bookingHref}>Live-Stundenplan öffnen</a>
      </div>

      {coachClasses.length ? (
        <div class="coach-profile-class-list-v21">
          {coachClasses.map((item) => (
            <article class="coach-profile-class-row-v21">
              <span class="coach-profile-class-day-v21">{item.day}</span>
              <time>{item.time}</time>
              <strong>{item.title}</strong>
              <span class="coach-profile-class-meta-v21">{item.meta}</span>
            </article>
          ))}
        </div>
      ) : (
        <div class="coach-profile-class-list-v21">
          <article class="coach-profile-class-row-v21">
            <span class="coach-profile-class-day-v21">Regelmäßig</span>
            <time>{coach.schedule}</time>
            <strong>{coach.focus}</strong>
            <span class="coach-profile-class-meta-v21">Aktuelle Zeiten im Live-Stundenplan</span>
          </article>
        </div>
      )}
    </section>

    {coachVideoSrc && (
      <section class="coach-profile-video-v21">
        <div class="coach-profile-video-copy-v21">
          <div class="eyebrow">In Bewegung</div>
          <h2>{coach.videoTitle ?? `Erlebe ${coach.name} im Tanz.`}</h2>
          <p>{coach.videoText ?? "Ein kurzer visueller Eindruck von Style, Energie und Bewegung."}</p>
        </div>
        <figure class="coach-profile-video-frame-v21">
          <video
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
            poster={coach.image}
            aria-label={`Tanzvideo mit ${coach.name}`}
          >
            <source src={coachVideoSrc} type="video/mp4" />
          </video>
          <figcaption>{coach.name} · {coach.focus}</figcaption>
        </figure>
      </section>
    )}

    {coach.instagramUrl && (
      <section class="coach-profile-social-v15">
        <div>
          <div class="eyebrow">Mehr von {coach.name}</div>
          <h2>Bewegung sagt oft mehr als ein Profiltext.</h2>
          <p>Auf Instagram bekommst du einen direkteren Eindruck von Style, Energie und aktuellen Projekten.</p>
        </div>
        <a class="coach-social-link-v15" href={coach.instagramUrl} target="_blank" rel="noreferrer">
          <InstagramIcon />
          <span>{coach.instagramHandle}</span>
          <b>Instagram öffnen ↗</b>
        </a>
      </section>
    )}

    <CoachesSection
      coaches={relatedCoaches}
      eyebrow="Weitere Coaches"
      title="Noch mehr Teaching-Persönlichkeiten entdecken."
      description="Alle Portraits bleiben kompakt, damit du schnell vergleichen kannst."
    />
  </main>

  <SiteFooter brand={site.brand} nav={site.nav} />
</BaseLayout>
