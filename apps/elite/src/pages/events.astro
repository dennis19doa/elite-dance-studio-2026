---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";

import site from "../data/site.json";
---

<BaseLayout
  title="Events & Elite Dance Party | Elite Dance Studio Berlin"
  description="Elite Dance Party, Socials, Workshops und Community-Events im Elite Dance Studio in Berlin-Moabit."
>
  <SiteHeader brand={site.brand} nav={site.nav} />

  <main class="page-shell page-main">
    <section class="service-page-hero panel">
      <div class="service-page-copy">
        <div class="eyebrow">Community in Bewegung</div>
        <h1 class="page-title">Kurse bringen dich rein. Events lassen dich bleiben.</h1>
        <p class="lead">
          Elite ist nicht nur Unterricht. Partys, Socials und Workshops geben dir Raum, Menschen
          kennenzulernen und das Gelernte ohne Druck zu erleben.
        </p>
        <div class="actions">
          <a class="button primary" href="https://www.instagram.com/elitedanceberlin/">Aktuelle Events auf Instagram</a>
          <a class="button secondary" href="/stundenplan/">Klasse buchen</a>
        </div>
      </div>
      <figure class="service-page-media">
        <img src="/media/placeholders/community-beginners.jpg" alt="Tanz-Community in einer hellen, offenen Studioatmosphäre" />
      </figure>
    </section>

    <section class="event-story panel">
      <div class="event-story-copy">
        <div class="eyebrow">Elite Dance Party</div>
        <h2>Dein erster Social muss sich nicht wie eine Prüfung anfühlen.</h2>
        <p>
          Unsere Partys verbinden Musik, Community und echte Tanzmomente. Auch wenn du gerade erst
          angefangen hast, kannst du vorbeikommen, zuschauen, Menschen treffen und in deinem Tempo
          mittanzen.
        </p>
        <div class="event-facts">
          <span>Beginner willkommen</span>
          <span>Social Dance & Community</span>
          <span>Termine über Instagram</span>
        </div>
        <a class="text-link" href="https://www.instagram.com/elitedanceberlin/">Nächsten Termin prüfen →</a>
      </div>
      <figure class="event-poster-frame">
        <img src="/media/current-site/elite-party.jpg" alt="Bisheriges Elite Dance Party Jubiläumsplakat" loading="lazy" />
        <figcaption>Bestehendes Elite-Eventmotiv · aktuelle Poster werden hier später automatisch ergänzt.</figcaption>
      </figure>
    </section>

    <section class="event-type-grid" aria-label="Eventformate bei Elite">
      <article class="event-type-card event-type-plum">
        <span>01</span><strong>Dance Parties</strong><p>Gemeinsam tanzen, üben und die Community außerhalb des Kursformats erleben.</p>
      </article>
      <article class="event-type-card event-type-slate">
        <span>02</span><strong>Workshops</strong><p>Neue Styles, Gast-Coaches und fokussierte Themen für einen intensiveren Einblick.</p>
      </article>
      <article class="event-type-card event-type-gold">
        <span>03</span><strong>Studio Specials</strong><p>Open Classes, Community-Treffen und besondere Formate rund um Elite.</p>
      </article>
    </section>
  </main>

  <SiteFooter brand={site.brand} nav={site.nav} />
</BaseLayout>
