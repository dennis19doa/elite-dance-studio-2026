---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";

import site from "../data/site.json";
---

<BaseLayout
  title="Events & Elite Dance Party | Elite Dance Studio Berlin"
  description="Elite Dance Party, Socials, Workshops und Community-Events im Elite Dance Studio in Berlin-Moabit."
  bodyClass="events-page-v7"
>
  <SiteHeader brand={site.brand} nav={site.nav} />

  <main class="page-shell page-main events-main-v7">
    <section class="events-hero-v7">
      <figure class="events-hero-poster-v7">
        <img src="/media/current-site/elite-party.jpg" alt="Elite Dance Party Eventmotiv" width="1080" height="1350" />
      </figure>
      <div class="events-hero-copy-v7">
        <div class="eyebrow">Events · Socials · Workshops</div>
        <h1 class="page-title">The class ends. The night starts.</h1>
        <p>Elite ist mehr als Unterricht. Unsere Events bringen Musik, Training und Community in denselben Raum.</p>
        <div class="actions">
          <a class="button primary" href="https://www.instagram.com/elitedanceberlin/" target="_blank" rel="noreferrer">Aktuelle Events ↗</a>
          <a class="button secondary" href="/#schedule">Vorher eine Class buchen</a>
        </div>
      </div>
    </section>

    <section class="events-marquee-v7" aria-label="Eventformate">
      <span>Dance Parties</span><b>•</b><span>Socials</span><b>•</b><span>Workshops</span><b>•</b><span>Guest Coaches</span><b>•</b><span>Community Nights</span>
    </section>

    <section class="events-grid-v7">
      <a class="event-feature-v7 is-large" href="https://www.instagram.com/elitedanceberlin/" target="_blank" rel="noreferrer">
        <img src="/media/hero/elite-homepage-poster.jpg" alt="Tanzmoment bei Elite Dance Studio" loading="lazy" />
        <span class="event-feature-shade-v7"></span>
        <div><small>Elite Dance Party</small><strong>Tanzen, ausprobieren, Leute treffen.</strong><b>Nächsten Termin ansehen ↗</b></div>
      </a>
      <a class="event-feature-v7 is-blue" href="https://www.instagram.com/elitedanceberlin/" target="_blank" rel="noreferrer">
        <img src="/media/current-site/elena-dennis-bachata.png" alt="Workshop bei Elite Dance Studio" loading="lazy" />
        <span class="event-feature-shade-v7"></span>
        <div><small>Workshops</small><strong>Mehr Fokus. Neue Impulse.</strong><b>Aktuelle Workshops ↗</b></div>
      </a>
      <a class="event-feature-v7 is-lime" href="/ueber-uns/">
        <img src="/media/current-site/studio-room-a.jpg" alt="Elite Dance Studio Raum" loading="lazy" />
        <span class="event-feature-shade-v7"></span>
        <div><small>Community</small><strong>Ein Studio, das auch nach der Class weiterlebt.</strong><b>Über Elite →</b></div>
      </a>
    </section>

    <section class="events-info-v7">
      <div>
        <div class="eyebrow">Auch neu dabei?</div>
        <h2>Du musst niemanden kennen, um zu kommen.</h2>
      </div>
      <p>Unsere Socials und Partys sind kein Test. Komm zum Tanzen, Zuschauen oder Leute kennenlernen. Aktuelle Termine veröffentlichen wir über Instagram.</p>
      <a class="button primary" href="https://www.instagram.com/elitedanceberlin/" target="_blank" rel="noreferrer">@elitedanceberlin ↗</a>
    </section>
  </main>

  <SiteFooter brand={site.brand} nav={site.nav} />
</BaseLayout>
