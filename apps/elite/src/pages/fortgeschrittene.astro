---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import site from "../data/site.json";
const advancedClasses = [
  { title: "Bachata Intermediate", focus: "Intermediate · Partnerwork · Musikalität", image: "/media/style-posters/19-bachata-intermediate.webp", alt: "Bachata Intermediate Kursmotiv bei Elite Dance Studio" },
  { title: "High Heels Intermediate", focus: "Intermediate · Technik · Performance", image: "/media/style-posters/08-high-heels-intermediate.webp", alt: "High Heels Intermediate Kursmotiv bei Elite Dance Studio" },
  { title: "Breaking Intermediate / Advanced", focus: "Closed Group · Power · Technik", image: "/media/style-posters/05-breaking.webp", alt: "Breaking Kursmotiv bei Elite Dance Studio" },
  { title: "Reggaeton Beginner / Intermediate", focus: "Beginner+ / Intermediate · Groove · Dynamik", image: "/media/style-posters/23-reggaeton-beginner-intermediate.webp", alt: "Reggaeton Beginner Intermediate Kursmotiv bei Elite Dance Studio" }
];
---
<BaseLayout title="Intermediate, Advanced & Closed Groups | Elite Dance Studio Berlin" description="Intermediate- und Advanced-Tanztraining, Closed Groups und Intensives im Elite Dance Studio Berlin-Moabit." image="/media/style-posters/19-bachata-intermediate.webp" bodyClass="advanced-page-v3">
  <SiteHeader brand={site.brand} nav={site.nav} />
  <main class="page-shell page-main advanced-main-v3">
    <section class="advanced-hero-v3">
      <figure><img src="/media/style-posters/19-bachata-intermediate.webp" alt="Bachata Intermediate Kursmotiv bei Elite Dance Studio" width="1080" height="1350" /></figure>
      <div><div class="eyebrow">Intermediate · Advanced · Closed Groups</div><h1 class="page-title">Train deeper.</h1><p class="lead">Mehr Technik, mehr Challenge und Formate für kontinuierliche Progression.</p><div class="actions"><a class="button primary" href="#advanced-classes">Training ansehen</a><a class="button secondary" href="/intensives/">Intensives</a></div></div>
    </section>

    <section class="advanced-format-band-v3" aria-label="Trainingsformate">
      <a href="/stundenplan/"><span>Flexibel</span><strong>Regular Classes</strong><small>Im Wochenplan trainieren.</small></a>
      <a href="/kontakt/"><span>Kontinuierlich</span><strong>Closed Groups</strong><small>Feste Gruppe, klarer Aufbau.</small></a>
      <a href="/intensives/"><span>Fokussiert</span><strong>Intensives</strong><small>Mehrere Wochen, ein Thema.</small></a>
    </section>

    <section class="advanced-offer advanced-offer-v3" id="advanced-classes"><div class="section-head compact-section-head"><div><div class="eyebrow">Aktuelles Training</div><h2>Intermediate bis Advanced.</h2></div><a class="text-link" href="/stundenplan/">Live-Stundenplan ↗</a></div><div class="advanced-card-grid">{advancedClasses.map((course) => <article class="advanced-card"><a href="/stundenplan/"><img src={course.image} alt={course.alt} width="1080" height="1350" loading="lazy" /></a><div><small>{course.focus}</small><h3>{course.title}</h3><a class="text-link" href="/stundenplan/">Termin finden ↗</a></div></article>)}</div></section>
  </main>
  <SiteFooter brand={site.brand} nav={site.nav} />
</BaseLayout>
