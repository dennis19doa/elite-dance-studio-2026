---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import site from "../data/site.json";

const closedGroups = [
  {
    title: "Bachata Advanced",
    schedule: "Dienstag · 20:30–21:30",
    meta: "Partnerwork · Technik · Musikalität",
    image: "/media/current-site/elena-dennis-bachata.png",
    alt: "Bachata Advanced Closed Group bei Elite Dance Studio",
    href: "#bachata-advanced",
    cta: "2026-Blöcke ansehen →",
    featured: true
  },
  {
    title: "Bachata Footwork",
    schedule: "Donnerstag · 20:00–21:00",
    meta: "Solo · Technik · Präzision",
    image: "/media/style-posters/21-bachata-footwork.webp",
    alt: "Bachata Footwork Closed Group bei Elite Dance Studio",
    href: "/kontakt/",
    cta: "Platz anfragen →"
  },
  {
    title: "Heels Closed Group",
    schedule: "Mittwoch · 20:00–21:30",
    meta: "Lines · Performance · Confidence",
    image: "/media/style-posters/08-high-heels-intermediate.webp",
    alt: "Heels Closed Group bei Elite Dance Studio",
    href: "/kontakt/",
    cta: "Platz anfragen →"
  },
  {
    title: "Breaking Closed Group",
    schedule: "Donnerstag · 20:00–21:30",
    meta: "Power · Technik · Progression",
    image: "/media/style-posters/05-breaking.webp",
    alt: "Breaking Closed Group mit Minh bei Elite Dance Studio",
    href: "/kontakt/",
    cta: "Platz anfragen →"
  }
];

const bachataMonths = ["Oktober", "November", "Dezember"].map((month) => ({
  month,
  href: `https://wa.me/491633863548?text=${encodeURIComponent(`Hallo Elite Dance Studio! Ich möchte mich für Bachata Advanced im ${month} 2026 anmelden.`)}`
}));

const topicHref = `https://wa.me/491633863548?text=${encodeURIComponent("Hallo Elite Dance Studio! Mein Wunschthema für Bachata Advanced bis Ende 2026 ist: ")}`;
---

<BaseLayout
  title="Advanced & Closed Groups | Elite Dance Studio Berlin"
  description="Advanced Training und Closed Groups im Elite Dance Studio Berlin-Moabit. Feste Gruppen, klare Progression und Bachata Advanced Registrierung für Oktober bis Dezember 2026."
  image="/media/current-site/elena-dennis-bachata.png"
  bodyClass="advanced-page-v21"
>
  <SiteHeader brand={site.brand} nav={site.nav} />

  <main class="page-shell page-main advanced-main-v21">
    <section class="advanced-brand-hero-v21 panel">
      <div class="advanced-brand-copy-v21">
        <div class="eyebrow">Advanced & Closed Groups</div>
        <h1>Trainiere tiefer. Bleib dran.</h1>
        <p class="lead">
          Feste Gruppen, klarer Fokus und mehr Kontinuität für Tänzer:innen, die nicht jede Woche bei null anfangen wollen.
        </p>
        <div class="advanced-hero-tags-v21" aria-label="Trainingsformate">
          <span>Advanced</span>
          <span>Closed Groups</span>
          <span>Berlin-Moabit</span>
        </div>
        <div class="actions">
          <a class="button primary" href="#closed-groups">Gruppen ansehen</a>
          <a class="button secondary" href="#bachata-advanced">Bachata Advanced 2026</a>
        </div>
      </div>
      <div class="advanced-brand-visual-v21" aria-hidden="true">
        <span>ELITE</span>
        <strong>TRAIN<br />DEEPER</strong>
        <small>Technique · Progression · Community</small>
      </div>
    </section>

    <section class="advanced-groups-v21 panel" id="closed-groups">
      <header class="advanced-section-head-v21">
        <div>
          <div class="eyebrow">Aktuelle Closed Groups</div>
          <h2>Wähle dein Training.</h2>
        </div>
        <p>Feste Woche. Gleiche Gruppe. Mehr Fortschritt.</p>
      </header>

      <div class="advanced-group-grid-v21">
        {closedGroups.map((course) => (
          <article class:list={["advanced-group-card-v21", course.featured && "is-featured"]}>
            <a class="advanced-group-image-v21" href={course.href}>
              <img src={course.image} alt={course.alt} width="1080" height="1350" loading="lazy" decoding="async" />
              {course.featured && <span class="advanced-card-badge-v21">Okt–Dez offen</span>}
            </a>
            <div class="advanced-group-copy-v21">
              <small>{course.schedule}</small>
              <h3>{course.title}</h3>
              <p>{course.meta}</p>
              <a class="text-link" href={course.href}>{course.cta}</a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="bachata-advanced-v21 panel" id="bachata-advanced">
      <div class="bachata-advanced-copy-v21">
        <div class="eyebrow">Bachata Advanced · Rest of 2026</div>
        <h2>Plane dein Training bis Dezember.</h2>
        <p class="bachata-intro-v21">
          Die Anmeldung für Oktober, November und Dezember ist bereits offen. Wähle direkt den Monat, in dem du dabei sein möchtest.
        </p>

        <div class="bachata-update-v21">
          <span>Neu</span>
          <div>
            <strong>Practice before class.</strong>
            <p>Vor den Classes schicken wir kurze Übungen und Drills zum Vorbereiten – damit wir im Training schneller in Technik, Feedback und Partnerwork einsteigen können.</p>
          </div>
        </div>

        <div class="bachata-topic-v21">
          <div>
            <small>Du kannst mitgestalten</small>
            <strong>Was möchtest du bis Jahresende trainieren?</strong>
          </div>
          <a class="button secondary" href={topicHref} target="_blank" rel="noreferrer">Thema vorschlagen</a>
        </div>
      </div>

      <div class="bachata-months-v21">
        <div class="bachata-months-head-v21">
          <span>2026</span>
          <h3>Wähle deinen Monat.</h3>
        </div>
        <div class="bachata-month-grid-v21">
          {bachataMonths.map((item, index) => (
            <a class="bachata-month-card-v21" href={item.href} target="_blank" rel="noreferrer">
              <small>{String(index + 10).padStart(2, "0")} / 2026</small>
              <strong>{item.month}</strong>
              <span>Anmelden →</span>
            </a>
          ))}
        </div>
        <p class="bachata-month-note-v21">Die Anmeldung startet als direkte WhatsApp-Anfrage. Wir bestätigen dir anschließend den passenden Block.</p>
      </div>
    </section>

    <section class="advanced-next-v21 panel">
      <div>
        <span class="eyebrow">Noch mehr Fokus?</span>
        <h2>Intensives bauen Technik über mehrere Wochen auf.</h2>
      </div>
      <div class="actions">
        <a class="button primary" href="/intensives/">Intensives ansehen</a>
        <a class="button secondary" href="/stundenplan/">Stundenplan</a>
      </div>
    </section>
  </main>

  <SiteFooter brand={site.brand} nav={site.nav} />
</BaseLayout>
