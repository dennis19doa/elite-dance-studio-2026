---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import site from "../data/site.json";

const advancedClasses = [
  {
    title: "Bachata Advanced",
    focus: "Dienstag · 20:30–21:30",
    image: "/media/current-site/elena-dennis-bachata.png",
    alt: "Bachata Advanced Closed Group bei Elite Dance"
  },
  {
    title: "Bachata Footwork",
    focus: "Donnerstag · 20:00–21:00",
    image: "/media/style-posters/21-bachata-footwork.webp",
    alt: "Bachata Footwork Closed Group bei Elite Dance"
  },
  {
    title: "Heels Closed Group",
    focus: "Mittwoch · 20:00–21:30",
    image: "/media/style-posters/08-high-heels-intermediate.webp",
    alt: "Heels Closed Group bei Elite Dance"
  },
  {
    title: "Breaking Closed Group",
    focus: "Donnerstag · 20:00–21:30",
    image: "/media/style-posters/05-breaking.webp",
    alt: "Breaking Closed Group mit Minh bei Elite Dance"
  }
];
---

<BaseLayout title="Intermediate, Advanced & Closed Groups | Elite Dance Studio Berlin" description="Intermediate- und Advanced-Tanztraining, Closed Groups und Intensives im Elite Dance Studio Berlin-Moabit." image="/media/current-site/elena-dennis-bachata.png" bodyClass="advanced-page-v18 advanced-page-v20 advanced-page-review-v19">
  <SiteHeader brand={site.brand} nav={site.nav} />
  <main class="page-shell page-main advanced-main-v18">
    <section class="advanced-hero-v20 panel">
      <div class="eyebrow">Intermediate · Advanced · Closed Groups</div>
      <div class="advanced-hero-grid-v20">
        <h1 class="page-title">Wenn du tiefer trainieren willst.</h1>
        <div class="advanced-hero-side-v20">
          <p class="lead">Vertiefe Technik, Präzision und Ausdruck in festen Gruppen und Trainingsformaten mit echter Progression.</p>
          <div class="advanced-hero-proof-v20">
            <span>Advanced Training</span>
            <span>Closed Groups</span>
            <span>Intensives</span>
          </div>
          <div class="actions">
            <a class="button primary" href="#advanced-classes">Closed Groups ansehen</a>
            <a class="button secondary" href="/intensives/">Intensives</a>
          </div>
        </div>
      </div>
    </section>

    <section class="advanced-level-check panel advanced-level-check-v18">
      <div>
        <div class="eyebrow">Welches Format passt?</div>
        <h2>Drei Wege, tiefer zu trainieren.</h2>
      </div>
      <div class="advanced-format-grid-v18">
        <article><strong>Regular Class</strong><p>Flexibel im Wochenplan trainieren und dein Level kontinuierlich halten.</p></article>
        <article><strong>Closed Group</strong><p>Mit derselben Gruppe arbeiten und über mehrere Wochen gemeinsam aufbauen.</p></article>
        <article><strong>Intensive</strong><p>Mehrere Wochen konzentriert an einem konkreten technischen Thema arbeiten.</p></article>
      </div>
    </section>

    <section class="advanced-offer panel advanced-offer-v18" id="advanced-classes">
      <div class="section-head compact-section-head advanced-section-head-review-v19">
        <div><div class="eyebrow">Aktuelle Closed Groups</div><h2>Vier feste Trainingsgruppen.</h2></div>
        <p>Feste Woche, gleiche Gruppe, mehr Kontinuität. Freie Plätze bitte direkt bei uns anfragen.</p>
      </div>
      <div class="advanced-card-grid advanced-card-grid-v18 closed-group-grid-v19">
        {advancedClasses.map((course) => (
          <article class="advanced-card advanced-card-v18 closed-group-card-v19">
            <a class="advanced-card-image-v18" href="/kontakt/">
              <img src={course.image} alt={course.alt} width="1080" height="1350" loading="lazy" decoding="async" />
            </a>
            <div class="advanced-card-copy-v18">
              <small>Closed Group · {course.focus}</small>
              <h3>{course.title}</h3>
              <a class="text-link" href="/kontakt/">Platz anfragen →</a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="progression-choice panel">
      <div><span>Regelmäßig</span><h3>Advanced Classes</h3><p>Kontinuierliches Training im Wochenplan.</p><a class="button secondary" href="/stundenplan/">Class buchen</a></div>
      <div><span>Feste Gruppe</span><h3>Closed Groups</h3><p>Verbindlicher Aufbau mit derselben Trainingsgruppe.</p><a class="button secondary" href="/kontakt/">Gruppe anfragen</a></div>
      <div><span>Roadmap</span><h3>Intensives</h3><p>Mehrere Wochen fokussiert an Technik und Movement arbeiten.</p><a class="button primary" href="/intensives/">Intensives ansehen</a></div>
    </section>
  </main>
  <SiteFooter brand={site.brand} nav={site.nav} />
</BaseLayout>
