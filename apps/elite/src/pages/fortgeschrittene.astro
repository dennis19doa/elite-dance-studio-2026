---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import site from "../data/site.json";

const advancedClasses = [
  { title: "Bachata Intermediate", focus: "Intermediate · Partnerwork · Musikalität", image: "/media/style-posters/19-bachata-intermediate.webp", alt: "Bachata Intermediate Kursmotiv bei Elite Dance Studio" },
  { title: "High Heels Intermediate", focus: "Intermediate · Technik · Performance", image: "/media/style-posters/08-high-heels-intermediate.webp", alt: "High Heels Intermediate Kursmotiv bei Elite Dance Studio" },
  { title: "Breaking Intermediate / Advanced", focus: "Closed Group · Power · Technik", image: "/media/style-posters/05-breaking.webp", alt: "Breaking Kursmotiv bei Elite Dance Studio" },
  { title: "Reggaeton Beginner / Intermediate", focus: "Beginner+ / Intermediate · Groove · Dynamik", image: "/media/style-posters/23-reggaeton-beginner-intermediate.webp", alt: "Reggaeton Beginner Intermediate Kursmotiv bei Elite Dance Studio" }
];
---

<BaseLayout
  title="Intermediate, Advanced & Closed Groups | Elite Dance Studio Berlin"
  description="Intermediate- und Advanced-Tanztraining, Closed Groups und Intensives im Elite Dance Studio Berlin-Moabit."
  image="/media/style-posters/19-bachata-intermediate.webp"
  bodyClass="advanced-page-v8"
>
  <SiteHeader brand={site.brand} nav={site.nav} />

  <main class="page-shell page-main advanced-main-v8">
    <section class="advanced-hero-v8">
      <div class="advanced-hero-copy-v8">
        <div class="eyebrow">Intermediate · Advanced · Closed Groups</div>
        <h1 class="page-title">Push your training.</h1>
        <p>Mehr Technik, mehr Challenge und Formate für Tänzer:innen, die kontinuierlich weitergehen wollen.</p>
        <div class="actions">
          <a class="button primary" href="#advanced-classes">Training ansehen</a>
          <a class="button secondary" href="/intensives/">Intensives</a>
        </div>
      </div>
      <figure class="advanced-hero-poster-v8">
        <img src="/media/style-posters/19-bachata-intermediate.webp" alt="Bachata Intermediate bei Elite Dance Studio" />
      </figure>
    </section>

    <section class="advanced-formats-v8" aria-label="Trainingsformate">
      <a href="/#schedule"><small>Flexibel</small><strong>Regular Classes</strong><span>Im Wochenplan trainieren →</span></a>
      <a href="https://wa.me/491633863548?text=Hallo%20Elite%2C%20ich%20interessiere%20mich%20f%C3%BCr%20eine%20Closed%20Group."><small>Kontinuierlich</small><strong>Closed Groups</strong><span>Feste Gruppe anfragen →</span></a>
      <a href="/intensives/"><small>Fokussiert</small><strong>Intensives</strong><span>Trainingsblöcke ansehen →</span></a>
    </section>

    <section class="advanced-offer-v8" id="advanced-classes">
      <header class="advanced-section-head-v8">
        <div><div class="eyebrow">Aktuelles Training</div><h2>Intermediate bis Advanced.</h2></div>
        <a class="text-link" href="/#schedule">Live-Stundenplan ↗</a>
      </header>
      <div class="advanced-grid-v8">
        {advancedClasses.map((course, index) => (
          <article class:list={["advanced-card-v8", `accent-${(index % 3) + 1}`]}>
            <a class="advanced-poster-v8" href="/#schedule">
              <img src={course.image} alt={course.alt} loading="lazy" decoding="async" />
            </a>
            <div>
              <small>{course.focus}</small>
              <h3>{course.title}</h3>
              <a class="text-link" href="/#schedule">Termin finden ↗</a>
            </div>
          </article>
        ))}
      </div>
    </section>
  </main>

  <SiteFooter brand={site.brand} nav={site.nav} />
</BaseLayout>
