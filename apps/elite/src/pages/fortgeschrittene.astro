---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import site from "../data/site.json";

const closedGroups = [
  {
    title: "Bachata Advanced",
    schedule: "Dienstag · 20:30–21:30",
    focus: "Partnerwork · Technik · Musikalität",
    image: "/media/current-site/elena-dennis-bachata.png",
    alt: "Bachata Advanced mit Elena und Dennis bei Elite Dance Studio",
    href: "#bachata-advanced",
    cta: "Details & Anmeldung",
    featured: true
  },
  {
    title: "Bachata Footwork",
    schedule: "Donnerstag · 20:00–21:00",
    focus: "Solo · Präzision · Kontrolle",
    image: "/media/style-posters/21-bachata-footwork.webp",
    alt: "Bachata Footwork Closed Group bei Elite Dance Studio",
    href: "/kontakt/",
    cta: "Platz anfragen"
  },
  {
    title: "Heels Closed Group",
    schedule: "Mittwoch · 20:00–21:30",
    focus: "Lines · Technik · Performance",
    image: "/media/style-posters/08-high-heels-intermediate.webp",
    alt: "Heels Closed Group bei Elite Dance Studio",
    href: "/kontakt/",
    cta: "Platz anfragen"
  },
  {
    title: "Breaking Closed Group",
    schedule: "Donnerstag · 20:00–21:30",
    focus: "Power · Technik · Progression",
    image: "/media/style-posters/05-breaking.webp",
    alt: "Breaking Closed Group mit Minh bei Elite Dance Studio",
    href: "/kontakt/",
    cta: "Platz anfragen"
  }
];

---

<BaseLayout
  title="Advanced & Closed Groups | Elite Dance Studio Berlin"
  description="Advanced Training und Closed Groups im Elite Dance Studio Berlin-Moabit. Feste Gruppen, klare Progression und Bachata Advanced Anmeldung für Oktober bis Dezember 2026."
  image="/media/current-site/elena-dennis-bachata.png"
  bodyClass="advanced-page-v22"
>
  <SiteHeader brand={site.brand} nav={site.nav} />

  <main class="page-shell page-main advanced-main-v22">
    <section class="advanced-hero-v22">
      <div class="advanced-hero-copy-v22">
        <div class="eyebrow">Advanced & Closed Groups</div>
        <h1>Mehr ist nicht das Ziel. Besser ist das Ziel.</h1>
        <p>
          Feste Gruppen für Tänzer:innen, die Technik, Qualität und Fortschritt über mehrere Wochen wirklich aufbauen wollen.
        </p>
        <div class="advanced-hero-actions-v22">
          <a class="button primary" href="#closed-groups">Closed Groups ansehen</a>
          <a class="button secondary" href="#bachata-advanced">Bachata Advanced anmelden</a>
        </div>
        <div class="advanced-hero-meta-v22" aria-label="Advanced Training Vorteile">
          <span>Feste Gruppe</span>
          <span>Klare Progression</span>
          <span>Mehr Feedback</span>
        </div>
      </div>

      <div class="advanced-hero-type-v24" aria-hidden="true">
        <span>ADVANCED</span>
        <strong>TECHNIK</strong>
        <strong>KONTROLLE</strong>
        <strong>PROGRESSION</strong>
        <small>Elite Dance Studio · Berlin</small>
      </div>
    </section>

    <section class="advanced-groups-v22" id="closed-groups">
      <header class="advanced-section-head-v22">
        <div>
          <div class="eyebrow">Aktuelle Gruppen</div>
          <h2>Vier Formate. Ein Ziel: besser werden.</h2>
        </div>
        <p>Closed Groups laufen mit derselben Gruppe und bauen inhaltlich aufeinander auf.</p>
      </header>

      <div class="advanced-group-grid-v22">
        {closedGroups.map((course) => (
          <article class:list={["advanced-group-card-v22", course.featured && "is-featured"]}>
            <a class="advanced-group-image-v22" href={course.href}>
              <img src={course.image} alt={course.alt} width="1080" height="1350" loading="lazy" decoding="async" />
              {course.featured && <span class="advanced-group-badge-v22">Anmeldung offen</span>}
            </a>
            <div class="advanced-group-body-v22">
              <small>{course.schedule}</small>
              <h3>{course.title}</h3>
              <p>{course.focus}</p>
              <a class="advanced-card-link-v22" href={course.href}>{course.cta} <span aria-hidden="true">→</span></a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="bachata-advanced-v22" id="bachata-advanced">
      <div class="bachata-program-v22">
        <div class="eyebrow">Bachata Advanced · Oktober–Dezember 2026</div>
        <h2>Du kannst die nächsten Monate jetzt schon planen.</h2>
        <p class="bachata-program-lead-v22">
          Melde dich direkt für Oktober, November und/oder Dezember an. Die Themen für den Rest des Jahres bauen wir auch anhand eurer Wünsche weiter aus.
        </p>

        <div class="bachata-story-v23">
          <article>
            <small>Vor der Class</small>
            <strong>Practice first.<br />Go deeper in class.</strong>
            <p>Du bekommst kurze Übungen und Drills vor dem Training. So können wir in der Class direkt an Details, Qualität und Feedback arbeiten.</p>
          </article>
          <article>
            <small>Im Training</small>
            <strong>Ein Block.<br />Ein klarer Fokus.</strong>
            <p>Die Inhalte bauen aufeinander auf, damit Fortschritt nicht jede Woche wieder bei null beginnt.</p>
          </article>
          <article>
            <small>Dein Input</small>
            <strong>Du sagst uns,<br />was du brauchst.</strong>
            <p>Schreib uns bei der Anmeldung frei, welche Themen du bis Jahresende wirklich trainieren möchtest.</p>
          </article>
        </div>
      </div>

      <div class="bachata-registration-v22">
        <div class="bachata-form-heading-v22">
          <span>Advanced Registration</span>
          <h3>Für welche Monate bist du dabei?</h3>
          <p>Wähle deine Monate und schreib uns deine Trainingswünsche. Wir bestätigen dir den Platz anschließend per WhatsApp.</p>
        </div>

        <form class="advanced-registration-form-v22" action="https://formsubmit.co/ajax/info@elitedancestudio.de" method="post" data-advanced-form>
          <input type="hidden" name="form_kind" value="advanced" />
          <input class="advanced-honeypot-v22" type="text" name="_honey" tabindex="-1" autocomplete="off" aria-hidden="true" />

          <fieldset class="advanced-month-fieldset-v22">
            <legend>Monat auswählen *</legend>
            <div class="advanced-month-options-v22">
              <label>
                <input type="checkbox" name="months" value="Oktober 2026" data-advanced-month />
                <span><small>10 / 2026</small><strong>Oktober</strong></span>
              </label>
              <label>
                <input type="checkbox" name="months" value="November 2026" data-advanced-month />
                <span><small>11 / 2026</small><strong>November</strong></span>
              </label>
              <label>
                <input type="checkbox" name="months" value="Dezember 2026" data-advanced-month />
                <span><small>12 / 2026</small><strong>Dezember</strong></span>
              </label>
            </div>
          </fieldset>

          <div class="advanced-form-grid-v22">
            <label>
              <span>Name *</span>
              <input type="text" name="name" autocomplete="name" required placeholder="Dein Name" />
            </label>
            <label>
              <span>E-Mail *</span>
              <input type="email" name="email" autocomplete="email" required placeholder="du@beispiel.de" />
            </label>
            <label class="advanced-form-wide-v22">
              <span>WhatsApp-Nummer *</span>
              <input type="tel" name="phone" autocomplete="tel" required placeholder="+49 …" />
              <small class="advanced-field-note-v23">Bitte die Nummer angeben, unter der wir dir die Bestätigung schicken können.</small>
            </label>
          </div>

          <label class="advanced-subject-v23">
            <span>Was möchtest du trainieren? *</span>
            <textarea rows="4" name="training_subject" required data-advanced-subject placeholder="Schreib uns frei deine Themenwünsche – z. B. Connection, Turns, Musicality, Body Movement …"></textarea>
            <small class="advanced-field-note-v23">Keine Auswahlboxen – schreib genau das, woran du arbeiten möchtest.</small>
          </label>

          <label class="advanced-note-v22">
            <span>Noch etwas, das wir wissen sollten?</span>
            <textarea rows="3" name="extra_note" data-advanced-note placeholder="Optional"></textarea>
          </label>

          <label class="advanced-consent-v22">
            <input type="checkbox" name="privacy_consent" value="accepted" required />
            <span>Ich stimme zu, dass Elite Dance Studio meine Angaben über den Formular-Dienst zur Bearbeitung dieser Anmeldung verwendet. *</span>
          </label>

          <div class="advanced-submit-row-v22">
            <button class="button primary" type="submit">Bachata Advanced anmelden</button>
            <span>* Pflichtfelder</span>
          </div>

          <p class="advanced-form-status-v22" role="status" aria-live="polite" data-advanced-status>
            Deine Anmeldung wird direkt an das Elite-Team geschickt.
          </p>
        </form>
      </div>
    </section>

    <section class="advanced-footer-cta-v22">
      <div>
        <div class="eyebrow">Andere Trainingsform gesucht?</div>
        <h2>Intensives für Fokus. Stundenplan für Flexibilität.</h2>
      </div>
      <div class="advanced-footer-actions-v22">
        <a class="button secondary" href="/intensives/">Intensives ansehen</a>
        <a class="button primary" href="/stundenplan/">Stundenplan öffnen</a>
      </div>
    </section>
  </main>

  <SiteFooter brand={site.brand} nav={site.nav} />

  <script is:inline>
    (() => {
      const form = document.querySelector("[data-advanced-form]");
      if (!(form instanceof HTMLFormElement)) return;

      const status = form.querySelector("[data-advanced-status]");
      const submit = form.querySelector('button[type="submit"]');

      form.addEventListener("submit", async (event) => {
        event.preventDefault();

        const months = [...form.querySelectorAll("[data-advanced-month]:checked")].map((input) => input.value);
        if (!months.length) {
          if (status) {
            status.textContent = "Bitte wähle mindestens einen Monat aus.";
            status.dataset.state = "error";
          }
          return;
        }

        if (!form.reportValidity()) return;

        if (submit instanceof HTMLButtonElement) submit.disabled = true;
        if (status) {
          status.textContent = "Deine Anmeldung wird gesendet …";
          status.dataset.state = "loading";
        }

        try {
          const formData = new FormData(form);

          const payload = {
            _subject: `Bachata Advanced Anmeldung – ${String(formData.get("name") || "Website")}`,
            _template: "table",
            _url: "https://elitedancestudio.de/fortgeschrittene/#bachata-advanced",
            _honey: String(formData.get("_honey") || ""),
            request_type: "bachata_advanced_registration",
            name: String(formData.get("name") || ""),
            email: String(formData.get("email") || ""),
            whatsapp: String(formData.get("phone") || ""),
            monate: formData.getAll("months").map(String).join(", "),
            trainingswuensche: String(formData.get("training_subject") || ""),
            weitere_nachricht: String(formData.get("extra_note") || ""),
            datenschutz: String(formData.get("privacy_consent") || ""),
          };

          const response = await fetch(form.action, {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
              Accept: "application/json",
            },
            body: JSON.stringify(payload),
          });

          const result = await response.json().catch(() => ({}));

          if (!response.ok || result?.success === "false" || result?.success === false) {
            const providerMessage =
              String(result?.message || result?.error || "").trim() ||
              `HTTP ${response.status}`;
            throw new Error(providerMessage);
          }

          form.reset();
          if (status) {
            status.textContent = "Danke! Deine Anmeldung wurde gesendet. Wir melden uns mit der Bestätigung per WhatsApp bei dir.";
            status.dataset.state = "success";
          }
        } catch (error) {
          const providerMessage = error instanceof Error ? error.message : "Unbekannter Fehler";
          const normalized = providerMessage.toLowerCase();
          let explanation = "FormSubmit konnte die Anmeldung gerade nicht versenden.";

          if (
            normalized.includes("confirm") ||
            normalized.includes("activate") ||
            normalized.includes("verification")
          ) {
            explanation = "FormSubmit wartet noch auf die Aktivierung der Empfängeradresse. Bitte prüft info@elitedancestudio.de auf eine Aktivierungs-E-Mail von FormSubmit.";
          } else if (
            normalized.includes("spam") ||
            normalized.includes("captcha") ||
            normalized.includes("bot")
          ) {
            explanation = "FormSubmit hat die Anfrage durch seinen Spam-Schutz blockiert.";
          } else if (
            normalized.includes("email") ||
            normalized.includes("recipient")
          ) {
            explanation = "FormSubmit konnte die Empfängeradresse nicht bestätigen.";
          }

          console.error("FormSubmit advanced registration failed:", providerMessage);

          if (status) {
            status.textContent = `${explanation} (${providerMessage})`;
            status.dataset.state = "error";
          }
        }
        } finally {
          if (submit instanceof HTMLButtonElement) submit.disabled = false;
        }
      });
    })();
  </script>
<!-- production-deploy-refresh -->
</BaseLayout>
