---
import SiteHeader from "../components/SiteHeader.astro";
import HeroSection from "../components/HeroSection.astro";
import TrustStrip from "../components/TrustStrip.astro";
import TrialOfferSection from "../components/TrialOfferSection.astro";
import FaqSection from "../components/FaqSection.astro";
import SiteFooter from "../components/SiteFooter.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import StudioExperienceSection from "../components/StudioExperienceSection.astro";
import HomeNewVisitorStrip from "../components/HomeNewVisitorStrip.astro";
import HomeStyleShowcase from "../components/HomeStyleShowcase.astro";
import HomeCoachRail from "../components/HomeCoachRail.astro";
import EversportsSchedule from "../components/EversportsSchedule.astro";

import faqs from "../data/faqs.json";
import site from "../data/site.json";
import trialOffer from "../data/trial-offer.json";
import trustSignals from "../data/trust-signals.json";
---

<BaseLayout
  title="Tanzkurse in Berlin-Moabit | Elite Dance Studio"
  description="25+ Tanzstyles in Berlin-Moabit: von Level 0 und Beginner bis Intermediate und Advanced. Live-Stundenplan ansehen und direkt buchen."
  bodyClass="home-page home-page-v5"
>
  <SiteHeader brand={site.brand} nav={site.nav} />

  <main class="page-shell page-main home-main">
    <HeroSection hero={site.hero} />

    <EversportsSchedule
      home
      eyebrow="Live · diese Woche"
      title="Dein Stundenplan. Direkt buchen."
      description="Aktuelle Classes, freie Plätze und Buchung an einem Ort."
    />

    <HomeNewVisitorStrip />
    <HomeStyleShowcase />
    <HomeCoachRail />
    <TrustStrip signals={trustSignals} />
    <TrialOfferSection offer={trialOffer} />
    <StudioExperienceSection />

    <FaqSection
      items={faqs.slice(0, 3)}
      eyebrow="Gut zu wissen"
      title="Vor deinem ersten Kurs."
      description=""
      linkHref="/faq/"
      linkLabel="Alle Fragen ansehen"
    />

    <section class="cta-banner panel home-final-cta">
      <div>
        <div class="eyebrow">Persönliche Hilfe</div>
        <h2>Nicht sicher, welcher Kurs passt?</h2>
      </div>
      <div class="actions">
        <a class="button primary" href={site.visit.whatsappHref}>WhatsApp schreiben</a>
      </div>
    </section>
  </main>

  <SiteFooter brand={site.brand} nav={site.nav} />
</BaseLayout>
