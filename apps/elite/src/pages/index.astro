---
import SiteHeader from "../components/SiteHeader.astro";
import HeroSection from "../components/HeroSection.astro";
import TrustStrip from "../components/TrustStrip.astro";
import TrialOfferSection from "../components/TrialOfferSection.astro";
import FaqSection from "../components/FaqSection.astro";
import SiteFooter from "../components/SiteFooter.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import StudioExperienceSection from "../components/StudioExperienceSection.astro";
import EversportsSchedule from "../components/EversportsSchedule.astro";
import HomeCoachRail from "../components/HomeCoachRail.astro";
import { cloudMediaBaseUrl, cloudMediaUrl } from "../lib/media";

import faqs from "../data/faqs.json";
import site from "../data/site.json";
import trialOffer from "../data/trial-offer.json";

const hero = {
  ...site.hero,
  videoCloudSrc: cloudMediaUrl(site.hero.videoCloudSrc),
  videoCloudMobileSrc: cloudMediaUrl(site.hero.videoCloudMobileSrc),
  videoSrc: site.hero.videoSrc,
  videoMobileSrc: site.hero.videoMobileSrc,
  videoPoster: site.hero.videoPoster
};
---

<BaseLayout
  title="Beginner Tanzkurse in Berlin | Elite Dance Studio"
  description="Beginner-friendly Tanzkurse in Berlin-Moabit: ohne Vorkenntnisse starten, oft ohne festen Partner. Welcome Pass: 2 Klassen für 20 Euro."
  bodyClass="home-page"
>
  <link slot="head" rel="preconnect" href={cloudMediaBaseUrl} crossorigin="anonymous" />
  <SiteHeader brand={site.brand} nav={site.nav} />

  <main class="page-shell page-main home-main">
    <HeroSection hero={hero} />

    <EversportsSchedule
      home
      title="Was tanzt du diese Woche?"
    />

    <HomeCoachRail />
    <TrustStrip />
    <TrialOfferSection offer={trialOffer} />
    <StudioExperienceSection />

    <FaqSection
      items={faqs.slice(0, 4)}
      eyebrow="Gut zu wissen"
      title="Noch Fragen vor deinem ersten Kurs?"
      description=""
      linkHref="/faq/"
      linkLabel="Alle Fragen ansehen"
    />

    <section class="cta-banner panel">
      <div>
        <div class="eyebrow">Persönliche Hilfe</div>
        <h2>Nicht sicher, welcher Kurs zu dir passt?</h2>
        <p>Schreib uns kurz, was du suchst. Wir empfehlen dir eine konkrete Class.</p>
      </div>
      <div class="actions">
        <a class="button primary" href={site.visit.whatsappHref}>WhatsApp schreiben</a>
      </div>
    </section>
  </main>

  <SiteFooter brand={site.brand} nav={site.nav} />
</BaseLayout>
