---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import intensives from "../data/intensives.json";
import site from "../data/site.json";

const phases = ["Foundation", "Control", "Layering", "Integration"];
const images = [
  "/media/style-posters/20-bachata-beginner.webp",
  "/media/style-posters/01-heels-beginner.webp",
  "/media/style-posters/03-house-beginner.webp",
  "/media/style-posters/08-high-heels-intermediate.webp"
];
---

<BaseLayout
  title="Tanz-Intensives in Berlin | Elite Dance Studio"
  description="Strukturierte Tanz-Intensives in Berlin-Moabit: Fundamentals, Body Movement I & II und Combined Training mit klarer Progression."
  image="/media/hero/elite-homepage-poster.jpg"
  bodyClass="intensives-page-v8"
>
  <SiteHeader brand={site.brand} nav={site.nav} />

  <main class="page-shell page-main intensives-main-v8">
    <section class="intensives-hero-v8">
      <div class="intensives-hero-copy-v8">
        <div class="eyebrow">Elite Intensives</div>
        <h1 class="page-title">Train deeper.</h1>
        <p>Mehrere Wochen, ein klarer Fokus und genug Zeit, damit Technik wirklich hängen bleibt.</p>
        <div class="actions">
          <a class="button primary" href="#intensive-modules">Module ansehen</a>
          <a class="button secondary" href="https://wa.me/491633863548?text=Hallo%20Elite%2C%20ich%20interessiere%20mich%20f%C3%BCr%20ein%20Intensive.">Starttermin fragen</a>
        </div>
      </div>
      <figure class="intensives-hero-image-v8">
        <img src="/media/hero/elite-homepage-poster.jpg" alt="Training im Elite Dance Studio" />
      </figure>
    </section>

    <section class="intensive-modules-section-v8" id="intensive-modules">
      <header class="intensives-section-head-v8">
        <div><div class="eyebrow">Deine Progression</div><h2>Vier Module. Ein Trainingsweg.</h2></div>
        <p>Jeder Block funktioniert einzeln. Zusammen bauen sie Technik, Kontrolle und Ausdruck Schritt für Schritt auf.</p>
      </header>

      <div class="intensive-cards-v8">
        {intensives.map((intensive, index) => (
          <article class:list={["intensive-card-v8", `accent-${(index % 3) + 1}`]}>
            <figure>
              <img src={images[index]} alt={`${intensive.name} im Elite Dance Studio`} loading="lazy" decoding="async" />
              <span>{intensive.number}</span>
            </figure>
            <div class="intensive-card-copy-v8">
              <div class="intensive-meta-v8"><span>{phases[index]}</span><small>{intensive.duration}</small></div>
              <h3>{intensive.name}</h3>
              <p>{intensive.summary}</p>
              <div class="intensive-prices-v8">
                <span><small>Training</small><strong>{intensive.standardPrice}</strong></span>
                <span><small>Premium</small><strong>{intensive.premiumPrice}</strong></span>
              </div>
              <details>
                <summary>Was du trainierst</summary>
                <ul>{intensive.points.map((point) => <li>{point}</li>)}</ul>
              </details>
              <a class="text-link" href={`https://wa.me/491633863548?text=${encodeURIComponent(`Hallo Elite, ich interessiere mich für ${intensive.name}.`)}`}>Verfügbarkeit anfragen →</a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="training-options-v8">
      <a href="/#schedule"><small>Flexibel</small><strong>Regular Classes</strong><span>Stundenplan →</span></a>
      <a href="/fortgeschrittene/"><small>Kontinuierlich</small><strong>Closed Groups</strong><span>Advanced Training →</span></a>
      <a href="#intensive-modules"><small>Fokussiert</small><strong>Intensives</strong><span>Module ansehen ↑</span></a>
    </section>
  </main>

  <SiteFooter brand={site.brand} nav={site.nav} />
</BaseLayout>
