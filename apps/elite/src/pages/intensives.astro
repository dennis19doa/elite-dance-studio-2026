---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import intensives from "../data/intensives.json";
import site from "../data/site.json";

const baseUrl = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const intensiveImages = [
  { src: `${baseUrl}media/current-site/elena-dennis-bachata.png`, alt: "Fundamentals Training im Elite Dance Studio" },
  { src: `${baseUrl}media/current-site/current-home-visual.webp`, alt: "Body Movement Training im Elite Dance Studio" },
  { src: `${baseUrl}media/current-site/kathy-reggaeton.png`, alt: "Bewegungs- und Techniktraining im Elite Dance Studio" },
  { src: `${baseUrl}media/current-site/studio-room-a.jpg`, alt: "Intensive Training im Elite Dance Studio Berlin" }
];
---

<BaseLayout
  title="Tanz-Intensives in Berlin | Elite Dance Studio"
  description="Strukturierte Tanz-Intensives in Berlin-Moabit: Fundamentals, Body Movement I & II und Combined Training mit klarer Progression."
  image={intensives[0].image}
  bodyClass="intensives-page-v15 intensives-page-review-v19"
>
  <SiteHeader brand={site.brand} nav={site.nav} />

  <main class="page-shell page-main intensives-main-v15">
    <section class="service-page-hero intensive-hero panel">
      <div class="service-page-copy">
        <div class="eyebrow">Elite Intensives</div>
        <h1 class="page-title">Mehr Zeit. Mehr Fokus. Mehr Fortschritt.</h1>
        <p class="lead">Mehrwöchige Trainingswege für Technik, Body Movement und echte Progression.</p>
        <div class="actions">
          <a class="button primary" href="#roadmap">Intensives ansehen</a>
          <a class="button secondary" href="https://wa.me/491633863548?text=Hallo%20Elite%2C%20ich%20interessiere%20mich%20f%C3%BCr%20ein%20Intensive.">Starttermin fragen</a>
        </div>
      </div>
      <figure class="service-page-media intensive-hero-media">
        <img src={intensives[0].image} alt={intensives[0].imageAlt} width="1920" height="1080" />
      </figure>
    </section>

    <section class="intensive-roadmap-panel panel" id="roadmap">
      <div class="section-head compact-section-head">
        <div>
          <div class="eyebrow">Deine Progression</div>
          <h2>Vier Intensives. Unterschiedliche Ziele.</h2>
        </div>
        <p>Jedes Intensive gibt es als Training mit Book / Workbook oder mit zusätzlichem persönlichem Feedback. Auf der Detailseite siehst du genau, was enthalten ist.</p>
      </div>

      <div class="intensive-roadmap intensive-roadmap-review-v19">
        {intensives.map((intensive, index) => (
          <article class="intensive-roadmap-step intensive-roadmap-step-v15 intensive-roadmap-step-v16 intensive-card-review-v19">
            <div class="roadmap-card roadmap-card-v15 roadmap-card-v16">
              <figure class="intensive-card-image-v15">
                <img src={intensiveImages[index]?.src ?? intensive.image} alt={intensiveImages[index]?.alt ?? intensive.imageAlt} loading="lazy" decoding="async" />
                <span>{intensive.phase}</span>
              </figure>

              <div class="roadmap-card-body-v15 roadmap-card-body-v16">
                <div class="roadmap-meta"><span>{intensive.phase}</span><small>{intensive.duration}</small></div>
                <h3>{intensive.name}</h3>
                <p class="intensive-summary-v16">{intensive.summary}</p>

                <div class="intensive-detail-grid-v16">
                  <div>
                    <small>Für wen</small>
                    <p>{intensive.audience}</p>
                  </div>
                  <div>
                    <small>Dein Ziel</small>
                    <p>{intensive.outcome}</p>
                  </div>
                </div>

                <div class="roadmap-pricing">
                  <div><small>Intensive + Book</small><strong>{intensive.standardPrice}</strong></div>
                  <div><small>Intensive + Feedback</small><strong>{intensive.premiumPrice}</strong></div>
                </div>

                <a class="text-link intensive-more-link-v19" href={`${baseUrl}intensives/${intensive.slug}/`}>
                  Alle Informationen →
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="progression-choice panel intensive-choice-v2">
      <div>
        <span>Wöchentlich</span>
        <h3>Reguläre Classes</h3>
        <p>Für deine kontinuierliche Routine im Stundenplan.</p>
        <a class="button secondary" href={`${baseUrl}stundenplan/`}>Stundenplan</a>
      </div>
      <div>
        <span>Mehr Fokus</span>
        <h3>Closed Groups</h3>
        <p>Feste Gruppen, verbindliche Progression und mehr Kontinuität.</p>
        <a class="button secondary" href={`${baseUrl}fortgeschrittene/`}>Closed Groups</a>
      </div>
      <div>
        <span>Strukturiert</span>
        <h3>Intensives</h3>
        <p>Mehrere Wochen konzentriert an einem Thema arbeiten.</p>
        <a class="button primary" href="#roadmap">Intensives ansehen</a>
      </div>
    </section>
  </main>

  <SiteFooter brand={site.brand} nav={site.nav} />
</BaseLayout>
