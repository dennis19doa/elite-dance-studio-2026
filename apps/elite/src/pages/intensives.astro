---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";

import intensives from "../data/intensives.json";
import site from "../data/site.json";
---

<BaseLayout
  title="Tanz-Intensives in Berlin | Elite Dance Studio"
  description="Mehrwöchige Tanz-Intensives in Berlin-Moabit: Fundamentals, Body Movement, Video Reviews und strukturiertes Feedback in kleinen Gruppen."
  image="/media/hero/elite-homepage-poster.jpg"
>
  <SiteHeader brand={site.brand} nav={site.nav} />

  <main class="page-shell page-main">
    <section class="service-page-hero intensive-hero panel">
      <div class="service-page-copy">
        <div class="eyebrow">Gezielt besser werden</div>
        <h1 class="page-title">Mehr Fokus. Mehr Feedback. Spürbarer Fortschritt.</h1>
        <p class="lead">
          Unsere Intensives verbinden mehrere Wochen Training mit klarer Technik, Body Awareness,
          Musikalität und persönlicherem Feedback in kleinen Gruppen.
        </p>
        <div class="actions">
          <a class="button primary" href="#intensive-list">Programme ansehen</a>
          <a class="button secondary" href="https://wa.me/491633863548?text=Hallo%20Elite%2C%20ich%20interessiere%20mich%20f%C3%BCr%20ein%20Intensive.">Starttermin anfragen</a>
        </div>
      </div>
      <figure class="service-page-media intensive-hero-media">
        <img
          src="/media/hero/elite-homepage-poster.jpg"
          alt="Tanzmoment im Elite Dance Studio in Berlin-Moabit"
          width="1920"
          height="1080"
        />
      </figure>
    </section>

    <section class="intensive-proof" aria-label="Vorteile der Elite Intensives">
      <div><span>01</span><strong>4 Wochen Fokus</strong><p>Ein Thema wird aufgebaut, vertieft und verbunden.</p></div>
      <div><span>02</span><strong>Kleine Gruppen</strong><p>Mehr Raum für Korrekturen und individuelle Fragen.</p></div>
      <div><span>03</span><strong>Video Reviews</strong><p>Optionales Feedback, das über die Class hinausgeht.</p></div>
      <div><span>04</span><strong>Private Class</strong><p>In der Premium-Option für noch gezieltere Arbeit.</p></div>
    </section>

    <section class="intensive-programs panel" id="intensive-list">
      <div class="section-head">
        <div>
          <div class="eyebrow">Intensive Programme</div>
          <h2>Wähle den Fokus, der dein Tanzen weiterbringt.</h2>
        </div>
        <p>Aktuelle Starttermine und freie Plätze bestätigen wir dir vor der Buchung persönlich.</p>
      </div>

      <div class="intensive-card-grid">
        {intensives.map((intensive) => (
          <article class="intensive-card">
            <div class="intensive-card-top">
              <span>{intensive.number}</span>
              <small>{intensive.duration}</small>
            </div>
            <h3>{intensive.name}</h3>
            <p>{intensive.summary}</p>
            <ul>
              {intensive.points.map((point) => <li>{point}</li>)}
            </ul>
            <div class="intensive-prices">
              <div><small>Training</small><strong>{intensive.standardPrice}</strong></div>
              <div><small>{intensive.premiumLabel}</small><strong>{intensive.premiumPrice}</strong></div>
            </div>
            <a class="text-link" href={`https://wa.me/491633863548?text=${encodeURIComponent(`Hallo Elite, ich interessiere mich für ${intensive.name}.`)}`}>
              Verfügbarkeit anfragen →
            </a>
          </article>
        ))}
      </div>
    </section>

    <section class="cta-banner panel">
      <div>
        <div class="eyebrow">Noch nicht sicher?</div>
        <h2>Wir helfen dir, das richtige Intensive und Level zu wählen.</h2>
        <p>Schreib uns kurz, wie lange du tanzt und woran du arbeiten möchtest.</p>
      </div>
      <div class="actions">
        <a class="button primary" href="https://wa.me/491633863548?text=Hallo%20Elite%2C%20welches%20Intensive%20passt%20zu%20mir%3F">Auf WhatsApp fragen</a>
        <a class="button secondary" href="/fortgeschrittene/">Advanced Training</a>
      </div>
    </section>
  </main>

  <SiteFooter brand={site.brand} nav={site.nav} />
</BaseLayout>
