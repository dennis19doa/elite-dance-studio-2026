---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import intensives from "../data/intensives.json";
import site from "../data/site.json";

const phases = ["Foundation", "Control", "Layering", "Integration"];
const images = [
  "/media/style-posters/20-bachata-beginner.webp",
  "/media/style-posters/01-heels-beginner.webp",
  "/media/style-posters/03-house-beginner.webp",
  "/media/style-posters/08-high-heels-intermediate.webp"
];
---

<BaseLayout
  title="Tanz-Intensives in Berlin | Elite Dance Studio"
  description="Strukturierte Tanz-Intensives in Berlin-Moabit: Fundamentals, Body Movement I & II und Combined Training mit klarer Progression."
  image="/media/hero/elite-homepage-poster.jpg"
  bodyClass="intensives-page-v7"
>
  <SiteHeader brand={site.brand} nav={site.nav} />

  <main class="page-shell page-main intensive-main-v7">
    <section class="intensive-hero-v7">
      <div class="intensive-hero-copy-v7">
        <div class="eyebrow">Elite Intensives</div>
        <h1 class="page-title">Train deeper.</h1>
        <p>Mehrere Wochen. Ein Fokus. Klarer Fortschritt.</p>
        <div class="actions">
          <a class="button primary" href="#roadmap">Roadmap ansehen</a>
          <a class="button secondary" href="https://wa.me/491633863548?text=Hallo%20Elite%2C%20ich%20interessiere%20mich%20f%C3%BCr%20ein%20Intensive.">Starttermin fragen</a>
        </div>
      </div>
      <figure class="intensive-hero-media-v7">
        <img src="/media/hero/elite-homepage-poster.jpg" alt="Training im Elite Dance Studio" width="1920" height="1080" />
        <figcaption>Fundamentals → Body Movement → Integration</figcaption>
      </figure>
    </section>

    <section class="intensive-roadmap-v7" id="roadmap" aria-labelledby="intensive-roadmap-title">
      <header class="intensive-roadmap-head-v7">
        <div class="eyebrow">Deine Progression</div>
        <h2 id="intensive-roadmap-title">Vier Module. Ein Trainingsweg.</h2>
        <p>Jedes Intensive funktioniert als eigener Block. Zusammen bilden sie eine klare Progression.</p>
      </header>

      <div class="intensive-modules-v7">
        {intensives.map((intensive, index) => (
          <article class:list={["intensive-module-v7", `is-${index % 3 === 0 ? "rose" : index % 3 === 1 ? "blue" : "lime"}`]}>
            <figure>
              <img src={images[index]} alt={`${intensive.name} im Elite Dance Studio`} width="720" height="900" loading="lazy" decoding="async" />
              <span>{intensive.number}</span>
            </figure>
            <div class="intensive-module-copy-v7">
              <div class="roadmap-meta"><span>{phases[index]}</span><small>{intensive.duration}</small></div>
              <h3>{intensive.name}</h3>
              <p>{intensive.summary}</p>
              <div class="intensive-module-prices-v7">
                <span><small>Training</small><strong>{intensive.standardPrice}</strong></span>
                <span><small>Premium</small><strong>{intensive.premiumPrice}</strong></span>
              </div>
              <details>
                <summary>Was du trainierst</summary>
                <ul>{intensive.points.map((point) => <li>{point}</li>)}</ul>
              </details>
              <a class="text-link" href={`https://wa.me/491633863548?text=${encodeURIComponent(`Hallo Elite, ich interessiere mich für ${intensive.name}.`)}`}>Verfügbarkeit anfragen →</a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="training-choice-v7">
      <a href="/#schedule"><span>Flexibel jede Woche</span><strong>Regular Classes</strong><b>Stundenplan →</b></a>
      <a href="/fortgeschrittene/"><span>Kontinuierlich</span><strong>Closed Groups</strong><b>Advanced Training →</b></a>
      <a href="#roadmap"><span>Fokussierter Block</span><strong>Intensives</strong><b>Module ansehen ↑</b></a>
    </section>
  </main>

  <SiteFooter brand={site.brand} nav={site.nav} />
</BaseLayout>
