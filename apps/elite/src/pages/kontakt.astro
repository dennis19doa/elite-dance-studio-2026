---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import VisitSection from "../components/VisitSection.astro";
import FaqSection from "../components/FaqSection.astro";
import LeadForm from "../components/LeadForm.astro";

import faqs from "../data/faqs.json";
import site from "../data/site.json";
---

<BaseLayout
  title="Kontakt & Anfahrt | Elite Dance Studio Berlin-Moabit"
  description="Adresse, Anfahrt, WhatsApp, E-Mail und Antworten für deinen ersten Besuch im Elite Dance Studio in Berlin-Moabit."
>
  <SiteHeader brand={site.brand} nav={site.nav} />

  <main class="page-shell page-main">
    <section class="contact-page-hero panel">
      <div class="contact-page-copy">
        <div class="eyebrow">Dein erster Besuch</div>
        <h1 class="page-title">Frag uns alles. Komm genau so, wie du bist.</h1>
        <p class="lead">
          Du brauchst keinen Partner und keine Erfahrung. Wenn du beim Kurs, Level oder bei der
          Buchung unsicher bist, helfen wir dir direkt.
        </p>
        <div class="actions">
          <a class="button primary" href="https://wa.me/491633863548">WhatsApp schreiben</a>
          <a class="button secondary" href="#visit">Anfahrt ansehen</a>
        </div>
      </div>
      <figure class="contact-page-media">
        <img
          src="/media/current-site/current-home-visual.webp"
          alt="Tanzmoment im Elite Dance Studio Berlin"
        />
      </figure>
    </section>

    <section class="contact-entrances panel">
      <div class="section-head">
        <div><div class="eyebrow">Was brauchst du?</div><h2>Der schnellste Weg zu deiner Antwort.</h2></div>
        <p>Keine allgemeine Kontaktwand: Wähle einfach, weshalb du gerade hier bist.</p>
      </div>
      <div class="contact-entrance-grid">
        <a class="contact-entrance entrance-coral" href="/starter-pass/">
          <span>01 · Ausprobieren</span><strong>Ich will Elite erst erleben.</strong><p>Zwei reguläre Classes, 10 Tage, einmal pro Person.</p><b>Welcome Pass ansehen →</b>
        </a>
        <a class="contact-entrance entrance-blue" href="/kurse/">
          <span>02 · Kurswahl</span><strong>Ich weiß noch nicht, welcher Style passt.</strong><p>Beginner-Kurse nach Energie und Format finden.</p><b>Kurse entdecken →</b>
        </a>
        <a class="contact-entrance entrance-gold" href="https://wa.me/491633863548">
          <span>03 · Persönlich</span><strong>Ich möchte kurz jemanden fragen.</strong><p>Schreib uns auf WhatsApp für eine ehrliche Empfehlung.</p><b>Nachricht starten →</b>
        </a>
      </div>
    </section>

    <LeadForm
      kind="contact"
      id="contact-form"
      eyebrow="Nachricht senden"
      title="Schreib uns, was du gerade wissen möchtest."
      description="Für Kurswahl, Membership, USC oder alles, was vor deinem ersten Besuch noch unklar ist."
    />

    <VisitSection
      visit={site.visit}
      description="Der Eingang liegt etwas versteckt. Mit diesen drei Schritten findest du ohne Suchen zu uns."
    />
    <div id="faq"><FaqSection items={faqs} /></div>
  </main>

  <SiteFooter brand={site.brand} nav={site.nav} />
</BaseLayout>
