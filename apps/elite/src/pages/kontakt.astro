---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import VisitSection from "../components/VisitSection.astro";
import FaqSection from "../components/FaqSection.astro";
import LeadForm from "../components/LeadForm.astro";

import faqs from "../data/faqs.json";
import site from "../data/site.json";
---

<BaseLayout
  title="Kontakt & Anfahrt | Elite Dance Studio Berlin-Moabit"
  description="Adresse, Anfahrt, WhatsApp, E-Mail und Antworten für deinen ersten Besuch im Elite Dance Studio in Berlin-Moabit."
  bodyClass="contact-page-v3"
>
  <SiteHeader brand={site.brand} nav={site.nav} />

  <main class="page-shell page-main contact-main-v3">
    <section class="contact-page-hero contact-hero-v3">
      <div class="contact-page-copy">
        <div class="eyebrow">Kontakt · Berlin-Moabit</div>
        <h1 class="page-title">Eine Frage? Schreib uns einfach.</h1>
        <p class="lead">Für Kurswahl, Membership, USC, Raummiete oder deinen ersten Besuch.</p>
      </div>
      <figure class="contact-page-media">
        <img src="/media/current-site/current-home-visual.webp" alt="Elite Dance Studio Berlin" />
      </figure>
    </section>

    <section class="contact-choice-v3">
      <a class="contact-choice-primary" href="https://wa.me/491633863548">
        <span>Am schnellsten</span>
        <strong>WhatsApp</strong>
        <b>Nachricht starten ↗</b>
      </a>
      <a href="#contact-form">
        <span>Etwas ausführlicher</span>
        <strong>Kontaktformular</strong>
        <b>Formular öffnen ↓</b>
      </a>
      <a href="mailto:info@elitedancestudio.de">
        <span>Direkt</span>
        <strong>E-Mail</strong>
        <b>info@elitedancestudio.de ↗</b>
      </a>
    </section>

    <LeadForm
      kind="contact"
      id="contact-form"
      eyebrow="Nachricht senden"
      title="Wie können wir helfen?"
      description=""
    />

    <VisitSection visit={site.visit} description="Wiclefstraße 16–17 · durch beide Tore · zweiter Hof links." />
    <div id="faq"><FaqSection items={faqs.slice(0, 4)} /></div>
  </main>

  <SiteFooter brand={site.brand} nav={site.nav} />
</BaseLayout>
