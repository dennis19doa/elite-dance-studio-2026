---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import FaqSection from "../components/FaqSection.astro";

import site from "../data/site.json";

const contactFaqs = [
  {
    question: "Brauche ich einen Tanzpartner?",
    answer:
      "Für viele unserer Kurse nicht. Wenn du bei einem Partner-Dance-Kurs oder bei der Kurswahl unsicher bist, schreib uns einfach kurz auf WhatsApp."
  },
  {
    question: "Welches Level ist das richtige für mich?",
    answer:
      "Wenn du neu startest, sind Level 0 und Beginner die besten Einstiege. Wenn du schon Erfahrung hast und zwischen zwei Levels schwankst, helfen wir dir gerne bei der Einschätzung."
  },
  {
    question: "Kann ich Urban Sports Club nutzen?",
    answer:
      "Ja, Urban Sports Club kannst du für unsere regulären Open Classes nutzen. Closed Groups und Intensives sind davon ausgenommen."
  },
  {
    question: "Muss ich mich vorher anmelden?",
    answer:
      "Wir empfehlen dir, deinen Platz vorab über Eversports zu reservieren. So weißt du schon vor der Anfahrt, dass dein Platz in der Class gesichert ist."
  },
  {
    question: "Wie finde ich den Eingang?",
    answer:
      "Du findest uns in der Wiclefstraße 16–17 in Berlin-Moabit. Gehe durch beide roten Tore bis in den zweiten Hinterhof. Dort liegt der Studioeingang auf der linken Seite."
  }
];
---

<BaseLayout
  title="Kontakt & Anfahrt | Elite Dance Studio Berlin-Moabit"
  description="Fragen zu Kursen, Level, Buchung oder deinem ersten Besuch? Kontaktiere das Elite Dance Studio Berlin per WhatsApp oder E-Mail und finde unsere Anfahrt."
>
  <SiteHeader brand={site.brand} nav={site.nav} />

  <main class="page-shell page-main contact-redesign">
    <section class="contact-hero-new" aria-labelledby="contact-title">
      <div class="contact-hero-copy-new">
        <div class="eyebrow">Kontakt</div>
        <h1 id="contact-title">Fragen? Schreib uns einfach.</h1>
        <p class="contact-lead">
          Du bist dir bei einem Kurs, deinem Level oder einer Buchung unsicher?
          Wir helfen dir gerne weiter.
        </p>

        <div class="contact-hero-actions">
          <a class="contact-button contact-button-primary" href={site.visit.whatsappHref}>
            WhatsApp schreiben
            <span aria-hidden="true">→</span>
          </a>
          <a class="contact-button contact-button-secondary" href={`mailto:${site.visit.email}`}>
            E-Mail senden
          </a>
        </div>

        <p class="contact-response-note">Am schnellsten erreichst du uns über WhatsApp.</p>
      </div>

      <aside class="contact-hub" aria-label="Kontaktmöglichkeiten">
        <div class="contact-hub-heading">
          <div>
            <span class="contact-hub-kicker">Elite Dance Studio</span>
            <strong>Berlin-Moabit</strong>
          </div>
          <span class="contact-status" aria-label="Kontakt möglich">Kontakt</span>
        </div>

        <div class="contact-methods">
          <a class="contact-method" href={site.visit.whatsappHref}>
            <span class="contact-method-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path d="M20 11.6a8 8 0 0 1-11.8 7l-4.2 1.1 1.1-4A8 8 0 1 1 20 11.6Z"/><path d="M8.6 8.1c.2-.4.4-.4.7-.4h.5c.1 0 .3 0 .4.3l.9 2c.1.3.1.5-.1.7l-.7.8c-.2.2-.1.4 0 .6.5.9 1.2 1.6 2.1 2.1.2.1.4.2.6 0l.9-1c.2-.2.4-.2.7-.1l1.9.9c.3.1.4.3.4.5 0 .3-.2 1.4-.9 1.9-.6.5-1.3.6-2.1.4-1-.2-2.4-.8-4.1-2.3-1.4-1.3-2.4-2.8-2.7-3.8-.3-1-.1-1.8.4-2.4l.1-.2Z"/></svg>
            </span>
            <span class="contact-method-copy">
              <small>WhatsApp</small>
              <strong>Schnell eine Frage stellen</strong>
              <span>{site.visit.phone}</span>
            </span>
            <span class="contact-method-arrow" aria-hidden="true">↗</span>
          </a>

          <a class="contact-method" href={`mailto:${site.visit.email}`}>
            <span class="contact-method-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path d="M3.5 6.5h17v11h-17z"/><path d="m4.5 7.5 7.5 6 7.5-6"/></svg>
            </span>
            <span class="contact-method-copy">
              <small>E-Mail</small>
              <strong>Für längere Anfragen</strong>
              <span>{site.visit.email}</span>
            </span>
            <span class="contact-method-arrow" aria-hidden="true">↗</span>
          </a>

          <a
            class="contact-method"
            href={site.visit.mapHref}
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="contact-method-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path d="M12 21s6-5.1 6-11a6 6 0 1 0-12 0c0 5.9 6 11 6 11Z"/><circle cx="12" cy="10" r="2.2"/></svg>
            </span>
            <span class="contact-method-copy">
              <small>Anfahrt</small>
              <strong>Studio & Route öffnen</strong>
              <span>{site.visit.address}</span>
            </span>
            <span class="contact-method-arrow" aria-hidden="true">↗</span>
          </a>
        </div>

        <div class="contact-entry-note">
          <span aria-hidden="true">01</span>
          <p>{site.visit.entryNote}</p>
        </div>
      </aside>
    </section>

    <section class="contact-shortcuts" aria-labelledby="contact-shortcuts-title">
      <div class="contact-section-heading">
        <div class="eyebrow">Direkt weiter</div>
        <h2 id="contact-shortcuts-title">Was brauchst du gerade?</h2>
      </div>

      <div class="contact-shortcut-grid">
        <a class="contact-shortcut-card" href="#faq">
          <span class="contact-shortcut-number">01</span>
          <div>
            <h3>Erster Besuch</h3>
            <p>Die wichtigsten Antworten, bevor du zum ersten Mal zu uns kommst.</p>
          </div>
          <span class="contact-shortcut-link">Antworten ansehen <b aria-hidden="true">→</b></span>
        </a>

        <a class="contact-shortcut-card" href="/kurse/">
          <span class="contact-shortcut-number">02</span>
          <div>
            <h3>Welcher Kurs passt?</h3>
            <p>Styles und Levels vergleichen und den passenden Einstieg finden.</p>
          </div>
          <span class="contact-shortcut-link">Kurse ansehen <b aria-hidden="true">→</b></span>
        </a>

        <a
          class="contact-shortcut-card"
          href={site.visit.mapHref}
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="contact-shortcut-number">03</span>
          <div>
            <h3>Anfahrt</h3>
            <p>Wiclefstraße 16–17, 10551 Berlin. Zweiter Hinterhof, links.</p>
          </div>
          <span class="contact-shortcut-link">Route öffnen <b aria-hidden="true">↗</b></span>
        </a>
      </div>
    </section>

    <FaqSection
      items={contactFaqs}
      eyebrow="Kurz beantwortet"
      title="Die wichtigsten Fragen vor deinem Besuch."
      description="Und wenn etwas offen bleibt, schreib uns einfach direkt."
    />

    <section class="contact-final-cta" aria-labelledby="contact-final-title">
      <div>
        <div class="eyebrow">Noch unsicher?</div>
        <h2 id="contact-final-title">Frag uns einfach.</h2>
        <p>Eine kurze Nachricht reicht. Wir helfen dir bei Kurs, Level oder Buchung weiter.</p>
      </div>
      <a class="contact-button contact-button-primary" href={site.visit.whatsappHref}>
        WhatsApp schreiben
        <span aria-hidden="true">→</span>
      </a>
    </section>
  </main>

  <SiteFooter brand={site.brand} nav={site.nav} />
</BaseLayout>

<style>
  .contact-redesign {
    --contact-bg: #171311;
    --contact-surface: #1e1a18;
    --contact-surface-soft: #25201d;
    --contact-line: rgba(255, 255, 255, 0.1);
    --contact-text: #f7f3ee;
    --contact-muted: rgba(247, 243, 238, 0.64);
    --contact-gold: #f2b36f;
    --contact-lime: #d2f85a;
  }

  .contact-redesign :global(.eyebrow) {
    color: var(--contact-gold) !important;
  }

  .contact-hero-new {
    display: grid;
    grid-template-columns: minmax(0, 1.03fr) minmax(380px, 0.97fr);
    gap: clamp(32px, 6vw, 84px);
    align-items: center;
    min-height: 570px;
    padding: clamp(38px, 6vw, 74px);
    overflow: hidden;
    border: 1px solid var(--contact-line);
    border-radius: 30px;
    background:
      radial-gradient(circle at 8% 0%, rgba(242, 179, 111, 0.12), transparent 29rem),
      linear-gradient(145deg, #1b1715 0%, #151210 72%);
    box-shadow: 0 28px 70px rgba(0, 0, 0, 0.22);
  }

  .contact-hero-copy-new {
    max-width: 650px;
  }

  .contact-hero-copy-new h1 {
    max-width: 9ch;
    margin: 16px 0 0;
    color: var(--contact-text);
    font-size: clamp(3.4rem, 6vw, 5.8rem);
    line-height: 0.95;
    letter-spacing: -0.06em;
  }

  .contact-lead {
    max-width: 590px;
    margin: 24px 0 0;
    color: var(--contact-muted);
    font-size: clamp(1rem, 1.35vw, 1.15rem);
    line-height: 1.65;
  }

  .contact-hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 30px;
  }

  .contact-button {
    display: inline-flex;
    min-height: 50px;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 0 20px;
    border: 1px solid transparent;
    border-radius: 12px 4px 12px 4px;
    font-size: 0.94rem;
    font-weight: 800;
    text-decoration: none;
    transition: transform 180ms ease, background-color 180ms ease, border-color 180ms ease;
  }

  .contact-button:hover {
    transform: translateY(-2px);
  }

  .contact-button-primary {
    background: var(--contact-lime);
    color: #11120e;
  }

  .contact-button-primary:hover {
    background: #defc79;
  }

  .contact-button-secondary {
    border-color: rgba(255, 255, 255, 0.17);
    background: rgba(255, 255, 255, 0.04);
    color: var(--contact-text);
  }

  .contact-button-secondary:hover {
    border-color: rgba(255, 255, 255, 0.3);
    background: rgba(255, 255, 255, 0.07);
  }

  .contact-response-note {
    margin: 15px 0 0;
    color: rgba(247, 243, 238, 0.46);
    font-size: 0.79rem;
  }

  .contact-hub {
    padding: 12px;
    border: 1px solid var(--contact-line);
    border-radius: 24px 7px 24px 7px;
    background: rgba(255, 255, 255, 0.035);
  }

  .contact-hub-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 14px 14px 20px;
  }

  .contact-hub-heading > div {
    display: grid;
    gap: 5px;
  }

  .contact-hub-kicker {
    color: var(--contact-gold);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .contact-hub-heading strong {
    color: var(--contact-text);
    font-size: 1.15rem;
  }

  .contact-status {
    display: inline-flex;
    min-height: 30px;
    align-items: center;
    padding: 0 10px;
    border: 1px solid rgba(210, 248, 90, 0.22);
    border-radius: 8px 3px 8px 3px;
    background: rgba(210, 248, 90, 0.08);
    color: var(--contact-lime);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .contact-methods {
    display: grid;
    gap: 8px;
  }

  .contact-method {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr) auto;
    gap: 14px;
    align-items: center;
    padding: 16px;
    border: 1px solid transparent;
    border-radius: 16px 5px 16px 5px;
    background: rgba(255, 255, 255, 0.045);
    color: var(--contact-text);
    text-decoration: none;
    transition: border-color 180ms ease, background-color 180ms ease, transform 180ms ease;
  }

  .contact-method:hover {
    border-color: rgba(242, 179, 111, 0.2);
    background: rgba(255, 255, 255, 0.075);
    transform: translateX(2px);
  }

  .contact-method-icon {
    display: grid;
    width: 44px;
    height: 44px;
    place-items: center;
    border: 1px solid rgba(242, 179, 111, 0.15);
    border-radius: 13px 4px 13px 4px;
    background: rgba(242, 179, 111, 0.06);
    color: var(--contact-gold);
  }

  .contact-method-icon svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.6;
  }

  .contact-method-copy {
    display: grid;
    min-width: 0;
    gap: 3px;
  }

  .contact-method-copy small {
    color: var(--contact-gold);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .contact-method-copy strong {
    color: var(--contact-text);
    font-size: 0.96rem;
  }

  .contact-method-copy > span {
    overflow: hidden;
    color: var(--contact-muted);
    font-size: 0.79rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .contact-method-arrow {
    color: rgba(247, 243, 238, 0.5);
    font-size: 1rem;
  }

  .contact-entry-note {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 12px;
    align-items: start;
    margin-top: 8px;
    padding: 15px 16px 9px;
    border-top: 1px solid var(--contact-line);
  }

  .contact-entry-note > span {
    color: var(--contact-gold);
    font-size: 0.66rem;
    font-weight: 800;
    letter-spacing: 0.08em;
  }

  .contact-entry-note p {
    margin: 0;
    color: var(--contact-muted);
    font-size: 0.79rem;
    line-height: 1.5;
  }

  .contact-shortcuts {
    margin-top: 28px;
    padding: clamp(30px, 5vw, 52px);
    border: 1px solid var(--contact-line);
    border-radius: 30px;
    background: linear-gradient(145deg, #211c19, #1b1715);
  }

  .contact-section-heading {
    max-width: 700px;
    margin-bottom: 26px;
  }

  .contact-section-heading h2 {
    max-width: 12ch;
    margin-top: 10px;
    color: var(--contact-text);
    font-size: clamp(2.1rem, 4vw, 3.6rem);
    letter-spacing: -0.055em;
  }

  .contact-shortcut-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }

  .contact-shortcut-card {
    display: flex;
    min-height: 260px;
    flex-direction: column;
    justify-content: space-between;
    padding: 24px;
    border: 1px solid var(--contact-line);
    border-radius: 22px 6px 22px 6px;
    background: rgba(255, 255, 255, 0.035);
    color: var(--contact-text);
    text-decoration: none;
    transition: transform 180ms ease, border-color 180ms ease, background-color 180ms ease;
  }

  .contact-shortcut-card:hover {
    border-color: rgba(242, 179, 111, 0.22);
    background: rgba(255, 255, 255, 0.055);
    transform: translateY(-3px);
  }

  .contact-shortcut-number {
    color: var(--contact-gold);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.1em;
  }

  .contact-shortcut-card h3 {
    margin: 0 0 10px;
    color: var(--contact-text);
    font-size: 1.45rem;
    letter-spacing: -0.035em;
  }

  .contact-shortcut-card p {
    margin: 0;
    color: var(--contact-muted);
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .contact-shortcut-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    padding-top: 18px;
    border-top: 1px solid var(--contact-line);
    color: var(--contact-text);
    font-size: 0.82rem;
    font-weight: 800;
  }

  .contact-shortcut-link b {
    color: var(--contact-lime);
    font-size: 1rem;
  }

  .contact-redesign :global(.faq-section) {
    margin-top: 28px;
    border: 1px solid var(--contact-line) !important;
    background: linear-gradient(145deg, #211c19, #1b1715) !important;
    box-shadow: none !important;
  }

  .contact-redesign :global(.faq-section h2) {
    color: var(--contact-text) !important;
  }

  .contact-redesign :global(.faq-section .section-head p) {
    color: var(--contact-muted) !important;
  }

  .contact-redesign :global(.faq-item) {
    border-color: var(--contact-line) !important;
    background: rgba(255, 255, 255, 0.035) !important;
    color: var(--contact-text) !important;
  }

  .contact-redesign :global(.faq-item summary) {
    color: var(--contact-text) !important;
  }

  .contact-redesign :global(.faq-item p) {
    color: var(--contact-muted) !important;
  }

  .contact-final-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 34px;
    margin-top: 28px;
    padding: clamp(30px, 5vw, 52px);
    border: 1px solid rgba(242, 179, 111, 0.18);
    border-radius: 30px;
    background:
      radial-gradient(circle at 5% 20%, rgba(242, 179, 111, 0.1), transparent 23rem),
      #171311;
  }

  .contact-final-cta h2 {
    margin-top: 8px;
    color: var(--contact-text);
    font-size: clamp(2.2rem, 4vw, 3.8rem);
    letter-spacing: -0.055em;
  }

  .contact-final-cta p {
    max-width: 650px;
    margin: 12px 0 0;
    color: var(--contact-muted);
    line-height: 1.6;
  }

  .contact-final-cta .contact-button {
    flex: 0 0 auto;
  }

  @media (max-width: 980px) {
    .contact-hero-new {
      grid-template-columns: 1fr;
      min-height: 0;
    }

    .contact-hero-copy-new h1 {
      max-width: 11ch;
    }

    .contact-hub {
      width: 100%;
    }

    .contact-shortcut-grid {
      grid-template-columns: 1fr;
    }

    .contact-shortcut-card {
      min-height: 210px;
    }
  }

  @media (max-width: 680px) {
    .contact-hero-new,
    .contact-shortcuts,
    .contact-final-cta {
      padding: 24px 20px;
      border-radius: 22px 6px 22px 6px;
    }

    .contact-hero-new {
      gap: 30px;
    }

    .contact-hero-copy-new h1 {
      font-size: clamp(2.9rem, 15vw, 4.2rem);
    }

    .contact-hero-actions {
      display: grid;
      grid-template-columns: 1fr;
    }

    .contact-button {
      width: 100%;
    }

    .contact-method {
      grid-template-columns: 40px minmax(0, 1fr) auto;
      gap: 11px;
      padding: 14px 12px;
    }

    .contact-method-icon {
      width: 40px;
      height: 40px;
    }

    .contact-method-copy > span {
      font-size: 0.72rem;
    }

    .contact-shortcuts {
      margin-top: 20px;
    }

    .contact-shortcut-card {
      min-height: 0;
      gap: 28px;
      padding: 20px;
    }

    .contact-final-cta {
      align-items: stretch;
      flex-direction: column;
    }
  }
</style>
