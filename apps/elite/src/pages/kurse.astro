---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import PageIntro from "../components/PageIntro.astro";
import CourseLevelGuide from "../components/CourseLevelGuide.astro";
import StylePosterGallery from "../components/StylePosterGallery.astro";
import EversportsSchedule from "../components/EversportsSchedule.astro";
import courseLevelGuide from "../data/course-level-guide.json";
import stylePosters from "../data/style-posters.json";
import site from "../data/site.json";
---
<BaseLayout
  title="Tanzkurse & Styles in Berlin | Elite Dance Studio"
  description="Entdecke 25+ Tanzstyles im Elite Dance Studio Berlin-Moabit, finde dein Level von Level 0 bis Advanced und buche direkt im Live-Stundenplan."
  bodyClass="courses-page-v4"
>
  <SiteHeader brand={site.brand} nav={site.nav} />

  <main class="page-shell page-main courses-main-v4">
    <PageIntro
      eyebrow="Tanzkurse bei Elite"
      title="Finde den Style, der dich bewegt."
      description="25+ Styles, Level 0 bis Advanced und direkte Buchung an einem Ort."
      actions={[
        { label: "Styles entdecken", href: "#style-poster-gallery", variant: "primary" },
        { label: "Diese Woche buchen", href: "#schedule", variant: "secondary" }
      ]}
    />

    <StylePosterGallery posters={stylePosters} />

    <CourseLevelGuide items={courseLevelGuide} />

    <EversportsSchedule
      eyebrow="Diese Woche"
      title="Deinen nächsten Kurs direkt buchen."
      description="Tag, Coach, Level und freie Plätze live prüfen."
    />
  </main>

  <SiteFooter brand={site.brand} nav={site.nav} />
</BaseLayout>
