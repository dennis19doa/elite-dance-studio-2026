---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Marketing Dashboard | Elite Dance Studio"
  description="Private campaign performance dashboard for Elite Dance Studio."
  noindex={true}
  bodyClass="marketing-dashboard-page"
>
  <main class="marketing-dashboard-shell">
    <header class="dashboard-header">
      <div>
        <span class="dashboard-kicker">ELITE DANCE · INTERNAL</span>
        <h1>Campaign performance</h1>
        <p>See what drives people to Eversports. Fast.</p>
      </div>
      <a href="/" class="dashboard-home-link">← Website</a>
    </header>

    <section class="dashboard-login" data-dashboard-login>
      <div data-auth-send-step>
        <span class="dashboard-kicker">Protected access</span>
        <h2>Verify your access</h2>
        <p>A one-time code will be sent to the Elite master email.</p>
        <button type="button" data-auth-send>Send login code</button>
      </div>

      <div data-auth-code-step hidden>
        <label for="dashboard-code">6-digit email code</label>
        <div class="dashboard-login-row">
          <input
            id="dashboard-code"
            type="text"
            inputmode="numeric"
            autocomplete="one-time-code"
            maxlength="6"
            placeholder="000000"
          />
          <button type="button" data-auth-verify>Open dashboard</button>
        </div>
        <button type="button" class="dashboard-auth-secondary" data-auth-resend>Send a new code</button>
      </div>

      <p data-dashboard-message>Only the Elite master account can receive a login code.</p>
    </section>

    <section class="dashboard-content" data-dashboard-content hidden>
      <div class="dashboard-toolbar">
        <div class="dashboard-toolbar-section">
          <span class="toolbar-label">Reporting period</span>
          <div class="dashboard-range" role="group" aria-label="Reporting period">
            <button type="button" data-days="7">7 days</button>
            <button type="button" data-days="30" class="is-active">30 days</button>
            <button type="button" data-days="90">90 days</button>
          </div>
        </div>

        <div class="dashboard-toolbar-actions">
          <label class="test-toggle">
            <input type="checkbox" data-include-tests />
            <span>Show test campaigns</span>
          </label>
          <span class="dashboard-user" data-dashboard-user></span>
          <button type="button" class="dashboard-quiet-button" data-dashboard-refresh>Refresh</button>
          <button type="button" class="dashboard-quiet-button" data-dashboard-logout>Sign out</button>
        </div>
      </div>

      <div class="dashboard-metrics">
        <article>
          <span>Tracked visits</span>
          <strong data-metric="visits">0</strong>
          <small>Campaign entries, not unique people</small>
        </article>
        <article class="is-primary">
          <span>Checkout intent</span>
          <strong data-metric="checkoutClicks">0</strong>
          <small>Clicks on “Welcome Pass kaufen”</small>
        </article>
        <article>
          <span>Intent rate</span>
          <strong data-metric="intentRate">0%</strong>
          <small>Checkout clicks ÷ campaign visits</small>
        </article>
        <article>
          <span>Creatives tracked</span>
          <strong data-metric="activeCreatives">0</strong>
          <small>Campaign + creative combinations</small>
        </article>
      </div>

      <section class="dashboard-panel dashboard-funnel-panel">
        <div class="dashboard-panel-head">
          <div>
            <span class="dashboard-kicker">Funnel</span>
            <h2>From ad click to buying intent</h2>
          </div>
        </div>
        <div class="dashboard-funnel">
          <div class="funnel-step">
            <span>Visits</span>
            <strong data-funnel="visits">0</strong>
          </div>
          <div class="funnel-arrow">→</div>
          <div class="funnel-step is-main">
            <span>Eversports clicks</span>
            <strong data-funnel="checkoutClicks">0</strong>
          </div>
          <div class="funnel-arrow">→</div>
          <div class="funnel-step">
            <span>Intent rate</span>
            <strong data-funnel="intentRate">0%</strong>
          </div>
        </div>
      </section>

      <section class="dashboard-panel">
        <div class="dashboard-panel-head">
          <div>
            <span class="dashboard-kicker">Creative comparison</span>
            <h2>Creative leaderboard</h2>
          </div>
          <p>Highest intent rate matters most once each creative has enough traffic.</p>
        </div>

        <div class="dashboard-table-wrap">
          <table>
            <thead>
              <tr>
                <th>Campaign</th>
                <th>Creative</th>
                <th>Visits</th>
                <th>Checkout clicks</th>
                <th>Intent rate</th>
                <th>Data quality</th>
                <th>Last activity</th>
              </tr>
            </thead>
            <tbody data-campaign-rows></tbody>
          </table>
        </div>
      </section>

      <section class="dashboard-panel">
        <div class="dashboard-panel-head">
          <div>
            <span class="dashboard-kicker">Activity over time</span>
            <h2>Trend</h2>
          </div>
          <p></p>
        </div>
        <div class="trend-chart" data-trend-chart>
          <p class="empty-state">No campaign activity yet.</p>
        </div>
        <div class="trend-legend">
          <span><i class="legend-swatch visits"></i> Visits</span>
          <span><i class="legend-swatch checkouts"></i> Checkout clicks</span>
        </div>
      </section>

      <section class="dashboard-panel dashboard-link-builder">
        <div class="dashboard-panel-head">
          <div>
            <span class="dashboard-kicker">Campaign link builder</span>
            <h2>New campaign link</h2>
          </div>
          <p>Same campaign name. Different creative name.</p>
        </div>

        <div class="dashboard-builder-grid">
          <label>
            Campaign
            <input type="text" data-builder-campaign placeholder="reggaeton_october" />
          </label>
          <label>
            Creative / video
            <input type="text" data-builder-creative placeholder="class_video_01" />
          </label>
        </div>

        <div class="dashboard-generated-link">
          <input type="text" readonly data-builder-output />
          <button type="button" data-builder-copy>Copy link</button>
        </div>

      </section>
    </section>
  </main>

  <style>
    :global(body.marketing-dashboard-page) {
      margin: 0;
      min-height: 100vh;
      background: #100d0b;
      color: #f7f2ec;
    }

    .marketing-dashboard-shell {
      width: min(1180px, calc(100% - 32px));
      margin: 0 auto;
      padding: 38px 0 70px;
    }

    .dashboard-header,
    .dashboard-toolbar,
    .dashboard-panel-head {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 24px;
    }

    .dashboard-header {
      margin-bottom: 24px;
    }

    .dashboard-header h1,
    .dashboard-panel h2,
    .dashboard-login h2 {
      margin: 5px 0 8px;
      font-family: "Sora", sans-serif;
      letter-spacing: -0.035em;
    }

    .dashboard-header h1 {
      font-size: clamp(2rem, 4vw, 3.35rem);
    }

    .dashboard-header > div > p,
    .dashboard-panel-head > p,
    .dashboard-definition p,
    .dashboard-highlight p,
    .dashboard-login p,
    .builder-note {
      margin: 0;
      color: rgba(247, 242, 236, 0.64);
      line-height: 1.55;
    }

    .dashboard-panel-head > p {
      max-width: 430px;
      font-size: 0.84rem;
    }

    .dashboard-kicker {
      font-size: 0.7rem;
      font-weight: 800;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: #f0a6b0;
    }

    .dashboard-home-link {
      color: #f7f2ec;
      text-decoration: none;
      border: 1px solid rgba(255, 255, 255, 0.15);
      border-radius: 999px;
      padding: 10px 14px;
      white-space: nowrap;
    }

    .dashboard-login,
    .dashboard-panel,
    .dashboard-metrics article,
    .dashboard-toolbar {
      border: 1px solid rgba(255, 255, 255, 0.10);
      background: rgba(255, 255, 255, 0.035);
      border-radius: 20px;
    }

    .dashboard-login {
      max-width: 620px;
      padding: 22px;
    }

    .dashboard-login label,
    .dashboard-builder-grid label,
    .toolbar-label {
      display: block;
      margin-bottom: 8px;
      font-size: 0.76rem;
      font-weight: 700;
      color: rgba(247, 242, 236, 0.68);
    }

    .dashboard-login-row,
    .dashboard-generated-link {
      display: flex;
      gap: 10px;
    }

    .dashboard-login input,
    .dashboard-builder-grid input,
    .dashboard-generated-link input {
      width: 100%;
      min-width: 0;
      border: 1px solid rgba(255, 255, 255, 0.14);
      border-radius: 12px;
      background: #181310;
      color: #fff;
      padding: 12px 14px;
      font: inherit;
    }

    .dashboard-login button,
    .dashboard-range button,
    .dashboard-quiet-button,
    .dashboard-generated-link button {
      border: 0;
      border-radius: 12px;
      padding: 11px 15px;
      font: inherit;
      font-weight: 800;
      cursor: pointer;
    }

    .dashboard-login button:not(.dashboard-auth-secondary),
    .dashboard-generated-link button {
      background: #f6ece2;
      color: #17110e;
    }

    .dashboard-auth-secondary {
      margin-top: 10px;
      padding: 0 !important;
      background: transparent;
      color: rgba(247, 242, 236, 0.66);
      text-decoration: underline;
    }

    .dashboard-content {
      display: grid;
      gap: 18px;
    }

    .dashboard-toolbar {
      padding: 14px 16px;
      align-items: center;
    }

    .dashboard-toolbar-actions {
      display: flex;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
      justify-content: flex-end;
    }

    .dashboard-user {
      color: rgba(247, 242, 236, 0.54);
      font-size: 0.76rem;
    }

    .dashboard-range {
      display: flex;
      gap: 7px;
    }

    .dashboard-range button,
    .dashboard-quiet-button {
      background: rgba(255, 255, 255, 0.07);
      color: rgba(255, 255, 255, 0.76);
    }

    .dashboard-range button.is-active {
      background: #f6ece2;
      color: #17110e;
    }

    .test-toggle {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      padding: 8px 10px;
      border-radius: 10px;
      background: rgba(255, 255, 255, 0.045);
      color: rgba(247, 242, 236, 0.68);
      font-size: 0.76rem;
      cursor: pointer;
    }

    .test-toggle input {
      accent-color: #f6ece2;
    }

    .dashboard-metrics {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 12px;
    }

    .dashboard-metrics article {
      padding: 18px;
    }

    .dashboard-metrics article.is-primary {
      border-color: rgba(212, 70, 88, 0.50);
      background: linear-gradient(145deg, rgba(157, 26, 47, 0.25), rgba(255, 255, 255, 0.035));
    }

    .dashboard-metrics span,
    .dashboard-metrics small {
      display: block;
      color: rgba(247, 242, 236, 0.60);
    }

    .dashboard-metrics strong {
      display: block;
      margin: 8px 0 5px;
      font-family: "Sora", sans-serif;
      font-size: clamp(1.8rem, 3vw, 2.65rem);
    }

    .dashboard-metrics small {
      font-size: 0.74rem;
      line-height: 1.4;
    }

    .dashboard-panel {
      padding: 21px;
    }

    .dashboard-funnel-panel {
      padding-bottom: 24px;
    }

    .dashboard-funnel {
      display: grid;
      grid-template-columns: 1fr auto 1fr auto 1fr;
      align-items: center;
      gap: 12px;
      margin-top: 18px;
    }

    .funnel-step {
      padding: 20px;
      border-radius: 16px;
      background: rgba(255,255,255,.045);
    }

    .funnel-step.is-main {
      background: rgba(157, 26, 47, 0.24);
      border: 1px solid rgba(212,70,88,.40);
    }

    .funnel-step span,
    .funnel-step strong {
      display: block;
    }

    .funnel-step span {
      color: rgba(247,242,236,.55);
      font-size: .74rem;
    }

    .funnel-step strong {
      margin-top: 6px;
      font-family: "Sora", sans-serif;
      font-size: 2rem;
    }

    .funnel-arrow {
      color: rgba(247,242,236,.35);
      font-size: 1.5rem;
    }

    .dashboard-table-wrap {
      overflow-x: auto;
      margin-top: 18px;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      min-width: 900px;
    }

    th,
    td {
      padding: 13px 12px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.075);
      text-align: left;
    }

    th {
      color: rgba(247, 242, 236, 0.50);
      font-size: 0.68rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }

    td {
      font-size: 0.86rem;
    }

    td.metric-strong {
      font-weight: 800;
      color: #fff;
    }

    .quality-badge {
      display: inline-flex;
      align-items: center;
      padding: 5px 8px;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.07);
      color: rgba(247, 242, 236, 0.72);
      font-size: 0.7rem;
      white-space: nowrap;
    }

    .quality-badge.is-ready {
      background: rgba(102, 179, 124, 0.13);
      color: #bfe9ca;
    }

    .trend-chart {
      display: flex;
      align-items: end;
      gap: 8px;
      min-height: 210px;
      margin-top: 18px;
      padding: 18px 8px 8px;
      border-top: 1px solid rgba(255, 255, 255, 0.07);
    }

    .trend-day {
      flex: 1 1 0;
      min-width: 22px;
      display: grid;
      gap: 6px;
      justify-items: center;
    }

    .trend-bars {
      width: 100%;
      height: 150px;
      display: flex;
      align-items: end;
      justify-content: center;
      gap: 3px;
    }

    .trend-bar {
      width: min(15px, 42%);
      min-height: 3px;
      border-radius: 5px 5px 2px 2px;
    }

    .trend-bar.visits {
      background: rgba(247, 242, 236, 0.30);
    }

    .trend-bar.checkouts {
      background: #d75a6d;
    }

    .trend-day-label {
      font-size: 0.64rem;
      color: rgba(247, 242, 236, 0.46);
      white-space: nowrap;
    }

    .trend-legend {
      display: flex;
      justify-content: flex-end;
      gap: 16px;
      margin-top: 10px;
      color: rgba(247, 242, 236, 0.56);
      font-size: 0.72rem;
    }

    .trend-legend span {
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }

    .legend-swatch {
      width: 9px;
      height: 9px;
      border-radius: 3px;
    }

    .legend-swatch.visits {
      background: rgba(247, 242, 236, 0.30);
    }

    .legend-swatch.checkouts {
      background: #d75a6d;
    }

    .empty-state {
      margin: auto;
      color: rgba(247, 242, 236, 0.48);
    }

    .dashboard-link-builder {
      display: grid;
      gap: 18px;
    }

    .dashboard-builder-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
    }

    .builder-note {
      font-size: 0.76rem;
    }

    @media (max-width: 900px) {
      .dashboard-metrics {
        grid-template-columns: 1fr 1fr;
      }

    }

    @media (max-width: 680px) {
      .dashboard-header,
      .dashboard-toolbar,
      .dashboard-panel-head {
        align-items: stretch;
        flex-direction: column;
      }

      .dashboard-toolbar-actions {
        justify-content: flex-start;
      }

      .dashboard-metrics,
      .dashboard-builder-grid {
        grid-template-columns: 1fr;
      }

      .dashboard-login-row,
      .dashboard-generated-link {
        flex-direction: column;
      }

      .dashboard-funnel {
        grid-template-columns: 1fr;
      }

      .funnel-arrow {
        display: none;
      }

      .trend-chart {
        overflow-x: auto;
        align-items: end;
      }

      .trend-day {
        min-width: 34px;
      }
    }
  </style>

  <script is:inline>
    (() => {
      const login = document.querySelector("[data-dashboard-login]");
      const content = document.querySelector("[data-dashboard-content]");
      const message = document.querySelector("[data-dashboard-message]");
      const sendStep = document.querySelector("[data-auth-send-step]");
      const codeStep = document.querySelector("[data-auth-code-step]");
      const codeInput = document.querySelector("#dashboard-code");
      const sendButton = document.querySelector("[data-auth-send]");
      const verifyButton = document.querySelector("[data-auth-verify]");
      const resendButton = document.querySelector("[data-auth-resend]");
      const refreshButton = document.querySelector("[data-dashboard-refresh]");
      const logoutButton = document.querySelector("[data-dashboard-logout]");
      const userLabel = document.querySelector("[data-dashboard-user]");
      const rangeButtons = [...document.querySelectorAll("[data-days]")];
      const includeTestsInput = document.querySelector("[data-include-tests]");
      const rows = document.querySelector("[data-campaign-rows]");
      const trendChart = document.querySelector("[data-trend-chart]");

      let days = 30;
      let includeTests = false;

      const metric = (name, value) => {
        const node = document.querySelector(`[data-metric="${name}"]`);
        if (node) node.textContent = value;
      };

      const percent = (numerator, denominator) => {
        if (!denominator) return "0%";
        return `${((numerator / denominator) * 100).toFixed(1)}%`;
      };

      const escapeHtml = (value) => String(value ?? "")
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#039;");

      const quality = (visits) => {
        if (visits >= 30) return { label: "Useful sample", className: "is-ready" };
        if (visits >= 10) return { label: "Building", className: "" };
        return { label: "Early data", className: "" };
      };

      const formatActivity = (iso) => {
        if (!iso) return "—";
        const date = new Date(iso);
        if (Number.isNaN(date.getTime())) return "—";
        return new Intl.DateTimeFormat("en-GB", {
          day: "2-digit",
          month: "short",
          hour: "2-digit",
          minute: "2-digit"
        }).format(date);
      };

      const renderTrend = (daily) => {
        if (!trendChart) return;
        if (!daily?.length) {
          trendChart.innerHTML = '<p class="empty-state">No campaign activity yet.</p>';
          return;
        }

        const recent = daily.slice(-Math.min(daily.length, 21));
        const maxValue = Math.max(1, ...recent.flatMap((item) => [item.visits || 0, item.checkoutClicks || 0]));

        trendChart.innerHTML = recent.map((item) => {
          const visitHeight = Math.max(3, Math.round(((item.visits || 0) / maxValue) * 145));
          const checkoutHeight = Math.max(item.checkoutClicks ? 3 : 0, Math.round(((item.checkoutClicks || 0) / maxValue) * 145));
          const label = new Intl.DateTimeFormat("en-GB", { day: "2-digit", month: "short" })
            .format(new Date(`${item.date}T12:00:00Z`));

          return `
            <div class="trend-day" title="${escapeHtml(label)} · ${item.visits} visits · ${item.checkoutClicks} checkout clicks">
              <div class="trend-bars">
                <span class="trend-bar visits" style="height:${visitHeight}px"></span>
                <span class="trend-bar checkouts" style="height:${checkoutHeight}px"></span>
              </div>
              <span class="trend-day-label">${escapeHtml(label)}</span>
            </div>
          `;
        }).join("");
      };

      const render = (data) => {
        const summary = data.summary || {};
        metric("visits", summary.visits || 0);
        metric("checkoutClicks", summary.checkoutClicks || 0);
        metric("intentRate", percent(summary.checkoutClicks || 0, summary.visits || 0));
        metric("activeCreatives", summary.activeCreatives || 0);
        const funnelVisits = document.querySelector('[data-funnel="visits"]');
        const funnelCheckout = document.querySelector('[data-funnel="checkoutClicks"]');
        const funnelRate = document.querySelector('[data-funnel="intentRate"]');
        if (funnelVisits) funnelVisits.textContent = summary.visits || 0;
        if (funnelCheckout) funnelCheckout.textContent = summary.checkoutClicks || 0;
        if (funnelRate) funnelRate.textContent = percent(summary.checkoutClicks || 0, summary.visits || 0);

        const campaigns = data.campaigns || [];
        rows.innerHTML = campaigns.length
          ? campaigns.map((item) => {
              const q = quality(item.visits);
              return `
                <tr>
                  <td class="metric-strong">${escapeHtml(item.campaign)}</td>
                  <td>${escapeHtml(item.creative || "—")}</td>
                  <td>${item.visits}</td>
                  <td class="metric-strong">${item.checkoutClicks}</td>
                  <td class="metric-strong">${percent(item.checkoutClicks, item.visits)}</td>
                  <td><span class="quality-badge ${q.className}">${q.label}</span></td>
                  <td>${escapeHtml(formatActivity(item.lastSeen))}</td>
                </tr>
              `;
            }).join("")
          : '<tr><td colspan="7">No real campaign data yet for this period.</td></tr>';

        renderTrend(data.daily || []);
      };

      const showLogin = (text) => {
        login.hidden = false;
        content.hidden = true;
        if (text) message.textContent = text;
      };

      const showSendStep = () => {
        sendStep.hidden = false;
        codeStep.hidden = true;
        codeInput.value = "";
      };

      const load = async () => {
        try {
          const params = new URLSearchParams({ days: String(days) });
          if (includeTests) params.set("tests", "1");

          const response = await fetch(`/api/marketing-stats?${params.toString()}`, {
            cache: "no-store",
            credentials: "same-origin"
          });
          const data = await response.json().catch(() => ({}));

          if (response.status === 401) {
            showLogin("Your session expired. Send a new login code to continue.");
            return false;
          }

          if (!response.ok) {
            throw new Error(data.error || "Unable to load dashboard");
          }

          render(data);
          login.hidden = true;
          content.hidden = false;
          return true;
        } catch (error) {
          showLogin(
            error.message === "analytics_not_configured" || error.message === "dashboard_auth_not_configured"
              ? "The analytics backend still needs its Cloudflare database connection."
              : "Dashboard data is temporarily unavailable."
          );
          return false;
        }
      };

      const restoreSession = async () => {
        try {
          const response = await fetch("/api/dashboard-auth-status", {
            cache: "no-store",
            credentials: "same-origin"
          });
          const data = await response.json().catch(() => ({}));

          if (response.ok && data.authenticated) {
            userLabel.textContent = data.email || "Elite master account";
            await load();
            return;
          }
        } catch {
          // Fall through to email login.
        }

        showLogin("Send a one-time code to the Elite master email to continue.");
        showSendStep();
      };

      const requestCode = async () => {
        sendButton.disabled = true;
        if (resendButton) resendButton.disabled = true;
        message.textContent = "Sending code…";

        try {
          const response = await fetch("/api/dashboard-auth-request", {
            method: "POST",
            headers: { "content-type": "application/json" },
            credentials: "same-origin",
            body: "{}"
          });
          const data = await response.json().catch(() => ({}));

          if (!response.ok) throw new Error(data.error || "Unable to send code");

          sendStep.hidden = true;
          codeStep.hidden = false;
          message.textContent = "The 6-digit code was sent to info@elitedancestudio.de. It expires in 10 minutes.";
          codeInput?.focus();
        } catch (error) {
          message.textContent = error.message === "dashboard_auth_not_configured"
            ? "The secure dashboard still needs its Cloudflare database connection."
            : "We couldn’t send the code right now.";
        } finally {
          sendButton.disabled = false;
          if (resendButton) resendButton.disabled = false;
        }
      };

      sendButton?.addEventListener("click", requestCode);
      resendButton?.addEventListener("click", requestCode);

      verifyButton?.addEventListener("click", async () => {
        const code = codeInput?.value?.trim() || "";
        if (!/^\d{6}$/.test(code)) {
          message.textContent = "Enter the 6-digit code from the email.";
          return;
        }

        verifyButton.disabled = true;
        message.textContent = "Checking code…";

        try {
          const response = await fetch("/api/dashboard-auth-verify", {
            method: "POST",
            headers: { "content-type": "application/json" },
            credentials: "same-origin",
            body: JSON.stringify({ code })
          });
          const data = await response.json().catch(() => ({}));

          if (!response.ok) throw new Error(data.error || "Unable to verify code");

          userLabel.textContent = "info@elitedancestudio.de";
          await load();
        } catch (error) {
          message.textContent = error.message === "invalid_code"
            ? "That code is incorrect or expired."
            : "We couldn’t verify the code right now.";
        } finally {
          verifyButton.disabled = false;
        }
      });

      codeInput?.addEventListener("keydown", (event) => {
        if (event.key === "Enter") verifyButton?.click();
      });

      refreshButton?.addEventListener("click", load);

      logoutButton?.addEventListener("click", async () => {
        await fetch("/api/dashboard-auth-logout", {
          method: "POST",
          credentials: "same-origin"
        }).catch(() => {});
        userLabel.textContent = "";
        showSendStep();
        showLogin("Signed out. Send a new login code to continue.");
      });

      rangeButtons.forEach((button) => {
        button.addEventListener("click", () => {
          days = Number(button.dataset.days || 30);
          rangeButtons.forEach((item) => item.classList.toggle("is-active", item === button));
          load();
        });
      });

      includeTestsInput?.addEventListener("change", () => {
        includeTests = Boolean(includeTestsInput.checked);
        load();
      });

      const campaignInput = document.querySelector("[data-builder-campaign]");
      const creativeInput = document.querySelector("[data-builder-creative]");
      const output = document.querySelector("[data-builder-output]");
      const copyButton = document.querySelector("[data-builder-copy]");

      const slug = (value) => String(value || "")
        .trim()
        .toLowerCase()
        .replace(/[^a-z0-9]+/g, "_")
        .replace(/^_+|_+$/g, "");

      const updateLink = () => {
        const campaign = slug(campaignInput?.value);
        const creative = slug(creativeInput?.value);
        const url = new URL("https://elitedancestudio.de/starter-pass/");
        if (campaign) url.searchParams.set("campaign", campaign);
        if (creative) url.searchParams.set("creative", creative);
        url.searchParams.set("utm_source", "instagram");
        url.searchParams.set("utm_medium", "paid_social");
        if (output) output.value = url.toString();
      };

      campaignInput?.addEventListener("input", updateLink);
      creativeInput?.addEventListener("input", updateLink);
      copyButton?.addEventListener("click", async () => {
        if (!output?.value) return;
        await navigator.clipboard.writeText(output.value);
        copyButton.textContent = "Copied";
        setTimeout(() => { copyButton.textContent = "Copy link"; }, 1200);
      });

      updateLink();
      restoreSession();
    })();
  </script>
</BaseLayout>
