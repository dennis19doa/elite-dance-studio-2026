---
import { readdirSync } from "node:fs";
import { extname, join, relative } from "node:path";
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import intensives from "../data/intensives.json";
import site from "../data/site.json";
import tvMedia from "../data/tv-media.json";
import tvSchedule from "../data/tv-schedule.json";

type MediaAsset = {
  src: string;
  filename: string;
  folder: string;
  kind: "image" | "video";
};

const imageExtensions = new Set([".avif", ".gif", ".jpeg", ".jpg", ".png", ".webp"]);
const videoExtensions = new Set([".mp4", ".webm"]);
const mediaDirectory = join(process.cwd(), "public", "media");

function collectMedia(directory: string): string[] {
  return readdirSync(directory, { withFileTypes: true }).flatMap((entry) => {
    const path = join(directory, entry.name);
    return entry.isDirectory() ? collectMedia(path) : [path];
  });
}

const localMedia = collectMedia(mediaDirectory)
  .map((absolutePath): MediaAsset | null => {
    const path = relative(mediaDirectory, absolutePath).replace(/\\/g, "/");
    const extension = extname(path).toLowerCase();
    const kind = imageExtensions.has(extension) ? "image" : videoExtensions.has(extension) ? "video" : null;
    if (!kind) return null;

    const [folder = "other"] = path.split("/");
    return {
      src: `/media/${path}`,
      filename: path.split("/").at(-1) ?? path,
      folder,
      kind
    };
  })
  .filter((asset): asset is MediaAsset => Boolean(asset))
  .sort((a, b) => a.src.localeCompare(b.src));

const folderDetails: Record<string, { title: string; note: string }> = {
  "current-site": {
    title: "Studio & editorial photos",
    note: "The real studio, founders, rooms, parties and current website visuals."
  },
  coaches: {
    title: "Coach portraits",
    note: "Portraits used on coach cards and profiles."
  },
  "style-posters": {
    title: "Course posters",
    note: "The style and class artwork used across the course pages."
  },
  hero: {
    title: "Homepage media",
    note: "The homepage poster and locally stored fallback videos."
  },
  placeholders: {
    title: "Concept placeholders",
    note: "Temporary concept images — these should not be treated as final studio photography."
  }
};

const localGroups = Object.entries(folderDetails)
  .map(([folder, detail]) => ({ ...detail, folder, assets: localMedia.filter((asset) => asset.folder === folder) }))
  .filter((group) => group.assets.length > 0);

const currentAssignments = [
  {
    page: "Über uns · opening",
    src: "/media/current-site/current-home-visual.webp",
    current: "Current homepage visual",
    intended: "This is the current image; no alternative has been confirmed here yet."
  },
  {
    page: "Über uns · founders",
    src: "/media/current-site/elena-dennis-founders.jpg",
    current: "Confirmed Elena & Dennis founder portrait",
    intended: "The previously missing DSC_6145.jpg has now been uploaded and assigned correctly."
  },
  ...intensives.map((intensive, index) => {
    const intendedFiles = [
      "IMG_0260-scaled.jpg",
      "IMG_9824-scaled.jpg",
      "IMG_0249-scaled.jpg",
      "20230501_210214-scaled.jpg"
    ];

    return {
      page: `Intensives · ${intensive.name}`,
      src: intensive.image,
      current: intensive.image.replace("/media/", ""),
      intended: `Confirmed shared Intensive visual. The original individual course photo ${intendedFiles[index]} is not currently uploaded.`
    };
  })
];

const tvMediaBase = "https://pub-78965290644946caade1e59ed21bf9ce.r2.dev/tv";
const tvAssetUrl = (path: string) => `${tvMediaBase}/${path.split("/").map(encodeURIComponent).join("/")}`;
const normalizeTvTitle = (value = "") =>
  value.toLowerCase().replace(/[^a-z0-9äöüß+]+/gi, " ").replace(/\s+/g, " ").trim();
const matchesTvPoster = (poster: (typeof tvMedia.posters)[number], title: string) => {
  const normalizedTitle = normalizeTvTitle(title);
  return [poster.title, ...(poster.aliases || [])].some((alias) => {
    const normalizedAlias = normalizeTvTitle(alias);
    return normalizedAlias && (normalizedTitle.includes(normalizedAlias) || normalizedAlias.includes(normalizedTitle));
  });
};
const weekdayOrder = ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"];
const scheduleTitles = Array.from(new Set(tvSchedule.map((entry) => entry.title))).sort();
const tvPosterAssignments = tvMedia.posters.map((poster) => ({
  ...poster,
  src: tvAssetUrl(poster.file),
  usedBy: scheduleTitles.filter((title) => matchesTvPoster(poster, title))
}));
const resolvedSchedule = [...tvSchedule]
  .sort((a, b) => {
    const dayDiff = weekdayOrder.indexOf(a.weekday) - weekdayOrder.indexOf(b.weekday);
    return dayDiff || a.start.localeCompare(b.start) || a.title.localeCompare(b.title);
  })
  .map((entry) => {
    const matches = tvMedia.posters.filter((poster) => matchesTvPoster(poster, entry.title));
    const activePoster = matches[0] || null;
    return {
      ...entry,
      activePoster,
      matches,
      src: activePoster ? tvAssetUrl(activePoster.file) : null
    };
  });
const scheduleByDay = weekdayOrder
  .map((weekday) => ({ weekday, entries: resolvedSchedule.filter((entry) => entry.weekday === weekday) }))
  .filter((day) => day.entries.length > 0);
const unmappedScheduleTitles = Array.from(new Set(
  resolvedSchedule.filter((entry) => !entry.activePoster).map((entry) => entry.title)
));
const ambiguousScheduleTitles = Array.from(
  new Map(
    resolvedSchedule
      .filter((entry) => entry.matches.length > 1)
      .map((entry) => [entry.title, {
        title: entry.title,
        posters: entry.matches.map((poster) => poster.title)
      }])
  ).values()
);

const remoteAssets: MediaAsset[] = [
  {
    src: "https://pub-78965290644946caade1e59ed21bf9ce.r2.dev/tv/classes/ChatGPT%20Image%20Aug%2023,%202026,%2006_04_55%20PM.png",
    filename: "ChatGPT Image Aug 23, 2026, 06_04_55 PM.png",
    folder: "Cloudflare R2 · TV/classes",
    kind: "image"
  },
  {
    src: "https://pub-78965290644946caade1e59ed21bf9ce.r2.dev/tv/classes/ChatGPT%20Image%20Sep%2026,%202026,%2002_06_50%20PM.png",
    filename: "ChatGPT Image Sep 26, 2026, 02_06_50 PM.png",
    folder: "Cloudflare R2 · TV/classes · currently unassigned",
    kind: "image"
  }
];
---

<BaseLayout
  title="Media Review | Elite Dance Studio"
  description="Internal visual review of Elite Dance Studio website media."
  noindex={true}
  bodyClass="media-review-page"
>
  <SiteHeader brand={site.brand} nav={site.nav} />

  <main class="media-review-shell page-shell page-main">
    <header class="media-review-head">
      <div>
        <span class="eyebrow">Internal review</span>
        <h1>Choose the right media, visually.</h1>
        <p>Every locally uploaded image and video is shown below with its filename. Tap an asset to open it at full size.</p>
      </div>
      <p class="media-review-count"><strong>{localMedia.length}</strong> local files<br />+ {remoteAssets.length} known Cloudflare file</p>
    </header>

    <section class="media-review-callout" aria-labelledby="media-review-current-title">
      <div>
        <span class="eyebrow">Current page assignments</span>
        <h2 id="media-review-current-title">These are the images that need reviewing.</h2>
      </div>
      <p>
        The founder portrait has now been restored. The Intensives use one confirmed shared photo until the four original individual course photos are uploaded again.
      </p>
    </section>

    <section class="assignment-grid" aria-label="Current media assignments">
      {currentAssignments.map((assignment) => (
        <article class="assignment-card">
          <a href={assignment.src} target="_blank" rel="noreferrer" class="assignment-image" aria-label={`${assignment.page} image full size`}>
            <img src={assignment.src} alt={`Current image for ${assignment.page}`} loading="lazy" decoding="async" />
          </a>
          <div>
            <span>{assignment.page}</span>
            <strong>{assignment.current}</strong>
            <p>{assignment.intended}</p>
          </div>
        </article>
      ))}
    </section>

    <section class="asset-section" id="tv-class-posters" aria-labelledby="tv-class-posters-title">
      <header>
        <div>
          <span class="eyebrow">{resolvedSchedule.length} scheduled TV class slots</span>
          <h2 id="tv-class-posters-title">TV schedule → image shown</h2>
        </div>
        <p>Ordered exactly by weekday and time. Each row shows the class slot and the image the TV currently resolves to first.</p>
      </header>

      {(unmappedScheduleTitles.length > 0 || ambiguousScheduleTitles.length > 0) && (
        <div class="tv-mapping-warnings">
          {unmappedScheduleTitles.length > 0 && (
            <div>
              <strong>No mapped poster:</strong>
              <p>{unmappedScheduleTitles.join(" · ")}</p>
            </div>
          )}
          {ambiguousScheduleTitles.length > 0 && (
            <div>
              <strong>Multiple posters can match these names:</strong>
              {ambiguousScheduleTitles.map((item) => (
                <p><b>{item.title}</b> → {item.posters.join(" / ")}. The first one listed is what the TV currently uses.</p>
              ))}
            </div>
          )}
        </div>
      )}

      <div class="tv-days">
        {scheduleByDay.map((day) => (
          <section class="tv-day" aria-labelledby={`tv-day-${day.weekday.toLowerCase()}`}>
            <div class="tv-day-title">
              <span>{day.weekday}</span>
              <small>{day.entries.length} class{day.entries.length === 1 ? "" : "es"}</small>
            </div>
            <div class="tv-schedule-grid">
              {day.entries.map((entry) => (
                <article class:list={["tv-schedule-card", { "is-unmapped": !entry.activePoster, "is-ambiguous": entry.matches.length > 1 }]}>
                  <div class="tv-time">
                    <strong>{entry.start}</strong>
                    <span>{entry.end}</span>
                  </div>
                  <div class="tv-schedule-image">
                    {entry.src ? (
                      <a href={entry.src} target="_blank" rel="noreferrer" aria-label={`Open image shown for ${entry.title}`}>
                        <img src={entry.src} alt={`Image shown for ${entry.title}`} loading="lazy" decoding="async" />
                      </a>
                    ) : (
                      <div class="tv-no-image">NO IMAGE<br />MAPPED</div>
                    )}
                  </div>
                  <div class="tv-schedule-info">
                    <span>{entry.weekday} · {entry.start}</span>
                    <strong>{entry.title}</strong>
                    {entry.activePoster ? (
                      <>
                        <p><b>TV shows:</b> {entry.activePoster.title}</p>
                        <code>{entry.activePoster.file}</code>
                        {entry.matches.length > 1 && (
                          <p class="mapping-note">Also matches: {entry.matches.slice(1).map((poster) => poster.title).join(" · ")}</p>
                        )}
                      </>
                    ) : (
                      <p class="mapping-note">This class currently has no poster connected.</p>
                    )}
                  </div>
                </article>
              ))}
            </div>
          </section>
        ))}
      </div>
    </section>

    <section class="media-review-instructions" aria-label="How to choose media">
      <strong>How to send your choices:</strong>
      <p>For the TV list above, reply with something like “Heels Beginner → use <code>High Heels Monday.png</code> on Monday only”. I can then correct the mapping directly.</p>
    </section>

    {localGroups.map((group) => (
      <section class="asset-section" aria-labelledby={`media-${group.folder}`}>
        <header>
          <div>
            <span class="eyebrow">{group.assets.length} files</span>
            <h2 id={`media-${group.folder}`}>{group.title}</h2>
          </div>
          <p>{group.note}</p>
        </header>
        <div class="asset-grid">
          {group.assets.map((asset) => (
            <a class="asset-card" href={asset.src} target="_blank" rel="noreferrer" title={`${asset.src} — open full size`}>
              <figure>
                {asset.kind === "image" ? (
                  <img src={asset.src} alt={asset.filename} loading="lazy" decoding="async" />
                ) : (
                  <video src={asset.src} controls muted preload="metadata" aria-label={asset.filename}></video>
                )}
              </figure>
              <span>{asset.filename}</span>
              <small>{asset.src}</small>
            </a>
          ))}
        </div>
      </section>
    ))}

    <section class="asset-section" aria-labelledby="cloudflare-media">
      <header>
        <div>
          <span class="eyebrow">Known active file</span>
          <h2 id="cloudflare-media">Cloudflare R2 media</h2>
        </div>
        <p>The bucket does not expose a public folder browser, so this section shows the known R2 file already used by the site.</p>
      </header>
      <div class="asset-grid">
        {remoteAssets.map((asset) => (
          <a class="asset-card" href={asset.src} target="_blank" rel="noreferrer" title={`${asset.src} — open full size`}>
            <figure><img src={asset.src} alt={asset.filename} loading="lazy" decoding="async" /></figure>
            <span>{asset.filename}</span>
            <small>{asset.folder}</small>
          </a>
        ))}
      </div>
    </section>
  </main>

  <SiteFooter brand={site.brand} nav={site.nav} />
</BaseLayout>

<style>
  .media-review-shell {
    display: grid;
    gap: 44px;
    padding-top: clamp(34px, 6vw, 78px);
    padding-bottom: 70px;
  }

  .media-review-head,
  .media-review-callout,
  .asset-section > header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(220px, 0.42fr);
    gap: 28px;
    align-items: end;
  }

  .media-review-head h1,
  .media-review-callout h2,
  .asset-section h2 {
    margin: 8px 0 0;
    color: #fff;
    font-family: var(--font-display);
    letter-spacing: -0.055em;
  }

  .media-review-head h1 { font-size: clamp(2.8rem, 6vw, 5.8rem); line-height: 0.92; }
  .media-review-callout h2,
  .asset-section h2 { font-size: clamp(1.65rem, 3vw, 2.7rem); line-height: 1; }

  .media-review-head p,
  .media-review-callout p,
  .asset-section > header p {
    margin: 14px 0 0;
    color: rgba(255, 255, 255, 0.67);
    line-height: 1.55;
  }

  .media-review-count {
    margin: 0 !important;
    padding: 18px 20px;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.06);
  }

  .media-review-count strong { color: #f3bf82; font-family: var(--font-display); font-size: 2.1rem; }

  .media-review-callout,
  .media-review-instructions {
    padding: clamp(22px, 3vw, 38px);
    border: 1px solid rgba(242, 179, 111, 0.3);
    border-radius: 22px;
    background: linear-gradient(135deg, rgba(242, 179, 111, 0.14), rgba(255, 255, 255, 0.045));
  }

  .assignment-grid,
  .asset-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 16px;
  }

  .assignment-card,
  .asset-card {
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 17px;
    background: #231d1a;
  }

  .assignment-image,
  .asset-card figure {
    display: grid;
    aspect-ratio: 4 / 3;
    margin: 0;
    place-items: center;
    background: #100d0c;
  }

  .assignment-image img,
  .asset-card img,
  .asset-card video {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .assignment-card > div { display: grid; gap: 7px; padding: 16px; }
  .assignment-card span { color: #f3bf82; font-size: 0.71rem; font-weight: 700; letter-spacing: 0.09em; text-transform: uppercase; }
  .assignment-card strong { color: #fff; line-height: 1.25; }
  .assignment-card p { margin: 0; color: rgba(255, 255, 255, 0.64); font-size: 0.84rem; line-height: 1.45; }

  .media-review-instructions { display: flex; gap: 14px; align-items: baseline; flex-wrap: wrap; }
  .media-review-instructions strong { color: #fff; }
  .media-review-instructions p { margin: 0; color: rgba(255, 255, 255, 0.76); line-height: 1.55; }
  .media-review-instructions code { color: #f3bf82; font: inherit; }

  .tv-mapping-warnings {
    display: grid;
    gap: 12px;
    padding: 18px 20px;
    border: 1px solid rgba(255, 187, 92, 0.32);
    border-radius: 16px;
    background: rgba(255, 187, 92, 0.08);
  }
  .tv-mapping-warnings strong { color: #fff; }
  .tv-mapping-warnings p { margin: 5px 0 0; color: rgba(255, 255, 255, 0.72); line-height: 1.45; }
  .tv-mapping-warnings b { color: #f3bf82; }

  .tv-days { display: grid; gap: 30px; }
  .tv-day { display: grid; gap: 13px; }
  .tv-day-title {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    padding-bottom: 9px;
    border-bottom: 1px solid rgba(255,255,255,.12);
  }
  .tv-day-title span {
    color: #fff;
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2.3vw, 2.1rem);
    font-weight: 800;
  }
  .tv-day-title small { color: rgba(255,255,255,.5); }
  .tv-schedule-grid { display: grid; gap: 10px; }
  .tv-schedule-card {
    display: grid;
    grid-template-columns: 92px minmax(150px, 230px) minmax(0, 1fr);
    min-height: 150px;
    overflow: hidden;
    border: 1px solid rgba(255,255,255,.13);
    border-radius: 16px;
    background: #211c19;
  }
  .tv-schedule-card.is-ambiguous { border-color: rgba(255,187,92,.42); }
  .tv-schedule-card.is-unmapped { border-color: rgba(255,92,92,.42); }
  .tv-time {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 4px;
    padding: 16px;
    text-align: center;
    background: rgba(255,255,255,.045);
  }
  .tv-time strong { color: #fff; font-size: 1.22rem; }
  .tv-time span { color: rgba(255,255,255,.48); font-size: .78rem; }
  .tv-schedule-image { min-height: 150px; background: #0d0b0a; }
  .tv-schedule-image a { display: block; width: 100%; height: 100%; }
  .tv-schedule-image img { display: block; width: 100%; height: 100%; object-fit: contain; }
  .tv-no-image {
    display: grid;
    width: 100%;
    height: 100%;
    min-height: 150px;
    place-items: center;
    color: rgba(255,255,255,.36);
    font-size: .75rem;
    font-weight: 800;
    letter-spacing: .12em;
    line-height: 1.5;
    text-align: center;
  }
  .tv-schedule-info { display: grid; align-content: center; gap: 7px; padding: 17px 20px; min-width: 0; }
  .tv-schedule-info > span {
    color: #f3bf82;
    font-size: .7rem;
    font-weight: 800;
    letter-spacing: .09em;
    text-transform: uppercase;
  }
  .tv-schedule-info > strong { color: #fff; font-size: 1.05rem; }
  .tv-schedule-info p { margin: 0; color: rgba(255,255,255,.65); font-size: .82rem; line-height: 1.42; }
  .tv-schedule-info code { overflow-wrap: anywhere; color: rgba(255,255,255,.46); font-size: .72rem; }
  .tv-schedule-info .mapping-note { color: #f3bf82; font-size: .76rem; }

  .asset-section { display: grid; gap: 22px; scroll-margin-top: 100px; }
  .asset-card { display: grid; text-decoration: none; transition: transform 160ms ease, border-color 160ms ease; }
  .asset-card:hover { border-color: #f3bf82; transform: translateY(-3px); }
  .asset-card span { overflow-wrap: anywhere; padding: 13px 14px 4px; color: #fff; font-size: 0.82rem; font-weight: 700; }
  .asset-card small { overflow-wrap: anywhere; padding: 0 14px 14px; color: rgba(255, 255, 255, 0.54); font-size: 0.68rem; line-height: 1.35; }

  @media (max-width: 760px) {
    .media-review-head,
    .media-review-callout,
    .asset-section > header { grid-template-columns: 1fr; }
    .media-review-head { gap: 18px; }
    .media-review-count { width: max-content; }
    .media-review-shell { gap: 30px; }
    .tv-schedule-card { grid-template-columns: 72px 128px minmax(0,1fr); }
    .tv-time { padding: 10px 8px; }
    .tv-schedule-info { padding: 12px 14px; }
  }

  @media (max-width: 560px) {
    .tv-schedule-card { grid-template-columns: 70px 1fr; }
    .tv-schedule-image { min-height: 120px; }
    .tv-schedule-info { grid-column: 1 / -1; }
  }
</style>
