---
import { readdirSync } from "node:fs";
import { extname, join, relative } from "node:path";
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import intensives from "../data/intensives.json";
import site from "../data/site.json";

type MediaAsset = {
  src: string;
  filename: string;
  folder: string;
  kind: "image" | "video";
};

const imageExtensions = new Set([".avif", ".gif", ".jpeg", ".jpg", ".png", ".webp"]);
const videoExtensions = new Set([".mp4", ".webm"]);
const mediaDirectory = join(process.cwd(), "public", "media");

function collectMedia(directory: string): string[] {
  return readdirSync(directory, { withFileTypes: true }).flatMap((entry) => {
    const path = join(directory, entry.name);
    return entry.isDirectory() ? collectMedia(path) : [path];
  });
}

const localMedia = collectMedia(mediaDirectory)
  .map((absolutePath): MediaAsset | null => {
    const path = relative(mediaDirectory, absolutePath).replace(/\\/g, "/");
    const extension = extname(path).toLowerCase();
    const kind = imageExtensions.has(extension) ? "image" : videoExtensions.has(extension) ? "video" : null;
    if (!kind) return null;

    const [folder = "other"] = path.split("/");
    return {
      src: `/media/${path}`,
      filename: path.split("/").at(-1) ?? path,
      folder,
      kind
    };
  })
  .filter((asset): asset is MediaAsset => Boolean(asset))
  .sort((a, b) => a.src.localeCompare(b.src));

const folderDetails: Record<string, { title: string; note: string }> = {
  "current-site": {
    title: "Studio & editorial photos",
    note: "The real studio, founders, rooms, parties and current website visuals."
  },
  coaches: {
    title: "Coach portraits",
    note: "Portraits used on coach cards and profiles."
  },
  "style-posters": {
    title: "Course posters",
    note: "The style and class artwork used across the course pages."
  },
  hero: {
    title: "Homepage media",
    note: "The homepage poster and locally stored fallback videos."
  },
  placeholders: {
    title: "Concept placeholders",
    note: "Temporary concept images — these should not be treated as final studio photography."
  }
};

const localGroups = Object.entries(folderDetails)
  .map(([folder, detail]) => ({ ...detail, folder, assets: localMedia.filter((asset) => asset.folder === folder) }))
  .filter((group) => group.assets.length > 0);

const currentAssignments = [
  {
    page: "Über uns · opening",
    src: "/media/current-site/current-home-visual.webp",
    current: "Current homepage visual",
    intended: "This is the current image; no alternative has been confirmed here yet."
  },
  {
    page: "Über uns · founders",
    src: "/media/current-site/elena-dennis-bachata.png",
    current: "Elena & Dennis Bachata image",
    intended: "Replace with the originally specified DSC_6145.jpg once it is uploaded again."
  },
  ...intensives.map((intensive, index) => {
    const intendedFiles = [
      "IMG_0260-scaled.jpg",
      "IMG_9824-scaled.jpg",
      "IMG_0249-scaled.jpg",
      "20230501_210214-scaled.jpg"
    ];

    return {
      page: `Intensives · ${intensive.name}`,
      src: intensive.image,
      current: intensive.image.replace("/media/", ""),
      intended: `Original migration image: ${intendedFiles[index]} — not currently uploaded.`
    };
  })
];

const remoteAssets: MediaAsset[] = [
  {
    src: "https://pub-78965290644946caade1e59ed21bf9ce.r2.dev/tv/classes/ChatGPT%20Image%20Aug%2023,%202026,%2006_04_55%20PM.png",
    filename: "ChatGPT Image Aug 23, 2026, 06_04_55 PM.png",
    folder: "Cloudflare R2 · TV/classes",
    kind: "image"
  }
];
---

<BaseLayout
  title="Media Review | Elite Dance Studio"
  description="Internal visual review of Elite Dance Studio website media."
  noindex={true}
  bodyClass="media-review-page"
>
  <SiteHeader brand={site.brand} nav={site.nav} />

  <main class="media-review-shell page-shell page-main">
    <header class="media-review-head">
      <div>
        <span class="eyebrow">Internal review</span>
        <h1>Choose the right media, visually.</h1>
        <p>Every locally uploaded image and video is shown below with its filename. Tap an asset to open it at full size.</p>
      </div>
      <p class="media-review-count"><strong>{localMedia.length}</strong> local files<br />+ {remoteAssets.length} known Cloudflare file</p>
    </header>

    <section class="media-review-callout" aria-labelledby="media-review-current-title">
      <div>
        <span class="eyebrow">Current page assignments</span>
        <h2 id="media-review-current-title">These are the images that need reviewing.</h2>
      </div>
      <p>
        The original WordPress image files for Intensives and the intended founder photo are no longer in the new site’s uploads.
        The cards below show the temporary replacements that are currently visible.
      </p>
    </section>

    <section class="assignment-grid" aria-label="Current media assignments">
      {currentAssignments.map((assignment) => (
        <article class="assignment-card">
          <a href={assignment.src} target="_blank" rel="noreferrer" class="assignment-image" aria-label={`${assignment.page} image full size`}>
            <img src={assignment.src} alt={`Current image for ${assignment.page}`} loading="lazy" decoding="async" />
          </a>
          <div>
            <span>{assignment.page}</span>
            <strong>{assignment.current}</strong>
            <p>{assignment.intended}</p>
          </div>
        </article>
      ))}
    </section>

    <section class="media-review-instructions" aria-label="How to choose media">
      <strong>How to send your choices:</strong>
      <p>Reply with, for example, “Body Movement I → <code>studio-room-blue.jpg</code>”. If the original files are on your NAS, upload the five missing originals and I will place them in Cloudflare and connect them correctly.</p>
    </section>

    {localGroups.map((group) => (
      <section class="asset-section" aria-labelledby={`media-${group.folder}`}>
        <header>
          <div>
            <span class="eyebrow">{group.assets.length} files</span>
            <h2 id={`media-${group.folder}`}>{group.title}</h2>
          </div>
          <p>{group.note}</p>
        </header>
        <div class="asset-grid">
          {group.assets.map((asset) => (
            <a class="asset-card" href={asset.src} target="_blank" rel="noreferrer" title={`${asset.src} — open full size`}>
              <figure>
                {asset.kind === "image" ? (
                  <img src={asset.src} alt={asset.filename} loading="lazy" decoding="async" />
                ) : (
                  <video src={asset.src} controls muted preload="metadata" aria-label={asset.filename}></video>
                )}
              </figure>
              <span>{asset.filename}</span>
              <small>{asset.src}</small>
            </a>
          ))}
        </div>
      </section>
    ))}

    <section class="asset-section" aria-labelledby="cloudflare-media">
      <header>
        <div>
          <span class="eyebrow">Known active file</span>
          <h2 id="cloudflare-media">Cloudflare R2 media</h2>
        </div>
        <p>The bucket does not expose a public folder browser, so this section shows the known R2 file already used by the site.</p>
      </header>
      <div class="asset-grid">
        {remoteAssets.map((asset) => (
          <a class="asset-card" href={asset.src} target="_blank" rel="noreferrer" title={`${asset.src} — open full size`}>
            <figure><img src={asset.src} alt={asset.filename} loading="lazy" decoding="async" /></figure>
            <span>{asset.filename}</span>
            <small>{asset.folder}</small>
          </a>
        ))}
      </div>
    </section>
  </main>

  <SiteFooter brand={site.brand} nav={site.nav} />
</BaseLayout>

<style>
  .media-review-shell {
    display: grid;
    gap: 44px;
    padding-top: clamp(34px, 6vw, 78px);
    padding-bottom: 70px;
  }

  .media-review-head,
  .media-review-callout,
  .asset-section > header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(220px, 0.42fr);
    gap: 28px;
    align-items: end;
  }

  .media-review-head h1,
  .media-review-callout h2,
  .asset-section h2 {
    margin: 8px 0 0;
    color: #fff;
    font-family: var(--font-display);
    letter-spacing: -0.055em;
  }

  .media-review-head h1 { font-size: clamp(2.8rem, 6vw, 5.8rem); line-height: 0.92; }
  .media-review-callout h2,
  .asset-section h2 { font-size: clamp(1.65rem, 3vw, 2.7rem); line-height: 1; }

  .media-review-head p,
  .media-review-callout p,
  .asset-section > header p {
    margin: 14px 0 0;
    color: rgba(255, 255, 255, 0.67);
    line-height: 1.55;
  }

  .media-review-count {
    margin: 0 !important;
    padding: 18px 20px;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.06);
  }

  .media-review-count strong { color: #f3bf82; font-family: var(--font-display); font-size: 2.1rem; }

  .media-review-callout,
  .media-review-instructions {
    padding: clamp(22px, 3vw, 38px);
    border: 1px solid rgba(242, 179, 111, 0.3);
    border-radius: 22px;
    background: linear-gradient(135deg, rgba(242, 179, 111, 0.14), rgba(255, 255, 255, 0.045));
  }

  .assignment-grid,
  .asset-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 16px;
  }

  .assignment-card,
  .asset-card {
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 17px;
    background: #231d1a;
  }

  .assignment-image,
  .asset-card figure {
    display: grid;
    aspect-ratio: 4 / 3;
    margin: 0;
    place-items: center;
    background: #100d0c;
  }

  .assignment-image img,
  .asset-card img,
  .asset-card video {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .assignment-card > div { display: grid; gap: 7px; padding: 16px; }
  .assignment-card span { color: #f3bf82; font-size: 0.71rem; font-weight: 700; letter-spacing: 0.09em; text-transform: uppercase; }
  .assignment-card strong { color: #fff; line-height: 1.25; }
  .assignment-card p { margin: 0; color: rgba(255, 255, 255, 0.64); font-size: 0.84rem; line-height: 1.45; }

  .media-review-instructions { display: flex; gap: 14px; align-items: baseline; flex-wrap: wrap; }
  .media-review-instructions strong { color: #fff; }
  .media-review-instructions p { margin: 0; color: rgba(255, 255, 255, 0.76); line-height: 1.55; }
  .media-review-instructions code { color: #f3bf82; font: inherit; }

  .asset-section { display: grid; gap: 22px; scroll-margin-top: 100px; }
  .asset-card { display: grid; text-decoration: none; transition: transform 160ms ease, border-color 160ms ease; }
  .asset-card:hover { border-color: #f3bf82; transform: translateY(-3px); }
  .asset-card span { overflow-wrap: anywhere; padding: 13px 14px 4px; color: #fff; font-size: 0.82rem; font-weight: 700; }
  .asset-card small { overflow-wrap: anywhere; padding: 0 14px 14px; color: rgba(255, 255, 255, 0.54); font-size: 0.68rem; line-height: 1.35; }

  @media (max-width: 760px) {
    .media-review-head,
    .media-review-callout,
    .asset-section > header { grid-template-columns: 1fr; }
    .media-review-head { gap: 18px; }
    .media-review-count { width: max-content; }
    .media-review-shell { gap: 30px; }
  }
</style>
