---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import PricingSection from "../components/PricingSection.astro";
import FaqSection from "../components/FaqSection.astro";

import pricing from "../data/pricing.json";
import pricingFaqs from "../data/pricing-faqs.json";
import site from "../data/site.json";
---

<BaseLayout
  title="Preise & Memberships | Elite Dance Studio Berlin"
  description="Welcome Pass, Drop-in, Karten, USC und Memberships für beginner-friendly Tanzkurse im Elite Dance Studio Berlin-Moabit."
  bodyClass="pricing-page-v15 pricing-page-v19 pricing-page-v19-redesign pricing-page-v24 pricing-page-v25"
>
  <SiteHeader brand={site.brand} nav={site.nav} />

  <main class="page-shell page-main pricing-main-v19-redesign">
    <section class="pricing-overview-v24 panel" aria-labelledby="pricing-overview-title">
      <div class="pricing-overview-head-v24">
        <div>
          <div class="eyebrow">Preise · Berlin-Moabit</div>
          <h1 id="pricing-overview-title">Wie möchtest du trainieren?</h1>
        </div>
        <p>Wähle deinen Weg. Die Details kommen erst danach.</p>
      </div>

      <div class="pricing-overview-grid-v24">
        <a class="pricing-path-v24 path-welcome-v24" href="#start">
          <div class="pricing-path-visual-v24 visual-welcome-v24" aria-hidden="true">
            <span>2×</span>
          </div>
          <div>
            <span class="pricing-path-kicker-v24">Neu bei Elite</span>
            <strong>Welcome Pass</strong>
            <small>Erst ausprobieren</small>
          </div>
          <span class="pricing-path-arrow-v24" aria-hidden="true">↘</span>
        </a>

        <a class="pricing-path-v24 path-membership-v24" href="#memberships">
          <div class="pricing-path-visual-v24 visual-membership-v24" aria-hidden="true">
            <i></i><i></i><i></i>
          </div>
          <div>
            <span class="pricing-path-kicker-v24">Regelmäßig</span>
            <strong>Memberships</strong>
            <small>Bronze · Silber · Gold</small>
          </div>
          <span class="pricing-path-arrow-v24" aria-hidden="true">↘</span>
        </a>

        <a class="pricing-path-v24 path-flex-v24" href="#flexible">
          <div class="pricing-path-visual-v24 visual-flex-v24" aria-hidden="true">
            <i></i><i></i><i></i>
          </div>
          <div>
            <span class="pricing-path-kicker-v24">Ohne Bindung</span>
            <strong>Flexibel</strong>
            <small>Drop-in & Karten</small>
          </div>
          <span class="pricing-path-arrow-v24" aria-hidden="true">↘</span>
        </a>

        <a class="pricing-path-v24 path-usc-v24" href="#usc">
          <div class="pricing-path-visual-v24 visual-usc-v24" aria-hidden="true">
            <span>USC</span>
          </div>
          <div>
            <span class="pricing-path-kicker-v24">Schon Mitglied</span>
            <strong>Urban Sports Club</strong>
            <small>Direkt über USC buchen</small>
          </div>
          <span class="pricing-path-arrow-v24" aria-hidden="true">↘</span>
        </a>
      </div>
    </section>

    <PricingSection pricing={pricing} />

    <FaqSection
      items={pricingFaqs}
      eyebrow="Preise FAQ"
      title="Was vor der Buchung noch wichtig ist."
      description="Welcome Pass, USC, Memberships, Intensives und die Platzreservierung kurz und verständlich erklärt."
      linkHref="/faq/"
      linkLabel="Zum vollständigen FAQ"
    />

    <section class="pricing-assurance panel">
      <div>
        <div class="eyebrow">Noch unsicher?</div>
        <h2>Wir empfehlen lieber ehrlich, statt dir zu viel zu verkaufen.</h2>
      </div>
      <div>
        <p>Schreib uns, welche Styles dich interessieren und ob du schon einmal getanzt hast. Wir nennen dir den einfachsten Start.</p>
        <a class="button primary" href="https://wa.me/491633863548">Auf WhatsApp fragen</a>
      </div>
    </section>
  </main>

  <SiteFooter brand={site.brand} nav={site.nav} />
</BaseLayout>
