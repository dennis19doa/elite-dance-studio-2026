---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import PricingSection from "../components/PricingSection.astro";
import FaqSection from "../components/FaqSection.astro";

import pricing from "../data/pricing.json";
import pricingFaqs from "../data/pricing-faqs.json";
import site from "../data/site.json";
---

<BaseLayout
  title="Preise & Memberships | Elite Dance Studio Berlin"
  description="Welcome Pass, Drop-in, Karten, USC und Memberships für beginner-friendly Tanzkurse im Elite Dance Studio Berlin-Moabit."
  bodyClass="pricing-page-v15 pricing-page-v19 pricing-page-v19-redesign pricing-page-v22"
>
  <SiteHeader brand={site.brand} nav={site.nav} />

  <main class="page-shell page-main pricing-main-v19-redesign">
    <section class="pricing-hero-v22 panel">
      <div class="pricing-hero-copy-v22">
        <div class="eyebrow">Preise · Berlin-Moabit</div>
        <h1 class="page-title">Finde direkt den Preis, der zu deinem Rhythmus passt.</h1>
        <p class="lead">Schon den Welcome Pass gemacht? Dann direkt zu Bronze, Silber oder Gold. Neu bei Elite? Starte mit 2 Classes für 20€.</p>
        <div class="actions">
          <a class="button primary" href="#memberships">Memberships ansehen</a>
          <a class="button secondary" href="#start">Neu? Welcome Pass</a>
        </div>
      </div>

      <div class="pricing-quick-grid-v22" aria-label="Preisoptionen auf einen Blick">
        <a class="pricing-quick-card-v22 pricing-quick-membership-v22" href="#memberships">
          <span>Nach dem Welcome Pass</span>
          <strong>Bronze · Silber · Gold</strong>
          <div class="pricing-quick-membership-prices-v22">
            <b>45€</b><b>79€</b><b>99€</b>
          </div>
          <small>Monatlich · reguläre Classes</small>
        </a>

        <a class="pricing-quick-card-v22" href="#start">
          <span>Neu bei Elite</span>
          <strong>Welcome Pass</strong>
          <b>20€ · 2 Classes</b>
          <small>10 Tage gültig</small>
        </a>

        <a class="pricing-quick-card-v22" href="#flexible">
          <span>Ohne Membership</span>
          <strong>Flexibel trainieren</strong>
          <b>ab 13€</b>
          <small>Drop-in · 5er · 10er Karte</small>
        </a>

        <a class="pricing-quick-card-v22" href="#usc">
          <span>Schon Mitglied?</span>
          <strong>Urban Sports Club</strong>
          <b>Über USC</b>
          <small>Für reguläre Open Classes</small>
        </a>
      </div>
    </section>

    <PricingSection pricing={pricing} />

    <FaqSection
      items={pricingFaqs}
      eyebrow="Preise FAQ"
      title="Was vor der Buchung noch wichtig ist."
      description="Welcome Pass, USC, Memberships, Intensives und die Platzreservierung kurz und verständlich erklärt."
      linkHref="/faq/"
      linkLabel="Zum vollständigen FAQ"
    />

    <section class="pricing-assurance panel">
      <div>
        <div class="eyebrow">Noch unsicher?</div>
        <h2>Wir empfehlen lieber ehrlich, statt dir zu viel zu verkaufen.</h2>
      </div>
      <div>
        <p>Schreib uns, welche Styles dich interessieren und ob du schon einmal getanzt hast. Wir nennen dir den einfachsten Start.</p>
        <a class="button primary" href="https://wa.me/491633863548">Auf WhatsApp fragen</a>
      </div>
    </section>
  </main>

  <SiteFooter brand={site.brand} nav={site.nav} />
</BaseLayout>
