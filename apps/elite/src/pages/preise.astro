---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import PricingSection from "../components/PricingSection.astro";
import FaqSection from "../components/FaqSection.astro";

import pricing from "../data/pricing.json";
import pricingFaqs from "../data/pricing-faqs.json";
import site from "../data/site.json";
---

<BaseLayout
  title="Preise & Memberships | Elite Dance Studio Berlin"
  description="Welcome Pass, Drop-in, Karten, USC und Memberships für beginner-friendly Tanzkurse im Elite Dance Studio Berlin-Moabit."
>
  <SiteHeader brand={site.brand} nav={site.nav} />

  <main class="page-shell page-main">
    <section class="pricing-page-hero pricing-page-hero-v3 panel">
      <div class="pricing-page-copy">
        <div class="eyebrow">Preise & Memberships</div>
        <h1 class="page-title">Finde deinen Rhythmus.</h1>
        <p class="lead">Erst testen, flexibel bleiben oder regelmäßig trainieren.</p>
        <div class="actions">
          <a class="button primary" href="#pricing">Preise ansehen</a>
          <a class="button secondary" href="https://wa.me/491633863548?text=Hallo%20Elite%2C%20welches%20Angebot%20passt%20zu%20mir%3F">Kurz fragen</a>
        </div>
      </div>
      <figure class="pricing-page-media">
        <img src="/media/hero/elite-homepage-poster.jpg" alt="Kursszene im Elite Dance Studio Berlin" width="1920" height="1080" />
      </figure>
    </section>

    <PricingSection
      pricing={pricing}
      eyebrow="Preise im Überblick"
      title="Start. Flexibel. Membership."
      description=""
    />

    <FaqSection
      items={pricingFaqs.slice(0, 4)}
      eyebrow="Preise FAQ"
      title="Kurz erklärt."
      description=""
      linkHref="/faq/"
      linkLabel="Alle Fragen ansehen"
    />

    <section class="pricing-assurance panel pricing-assurance-v3">
      <div>
        <div class="eyebrow">Noch unsicher?</div>
        <h2>Wir helfen dir bei der Auswahl.</h2>
      </div>
      <a class="button primary" href="https://wa.me/491633863548?text=Hallo%20Elite%2C%20ich%20bin%20bei%20den%20Preisen%20noch%20unsicher.">WhatsApp schreiben</a>
    </section>
  </main>

  <SiteFooter brand={site.brand} nav={site.nav} />
</BaseLayout>
