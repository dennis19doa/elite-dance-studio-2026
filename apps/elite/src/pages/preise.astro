---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import PricingSection from "../components/PricingSection.astro";
import FaqSection from "../components/FaqSection.astro";

import pricing from "../data/pricing.json";
import pricingFaqs from "../data/pricing-faqs.json";
import site from "../data/site.json";
---

<BaseLayout
  title="Preise & Memberships | Elite Dance Studio Berlin"
  description="Welcome Pass, Drop-in, Karten, USC und Memberships für beginner-friendly Tanzkurse im Elite Dance Studio Berlin-Moabit."
  bodyClass="pricing-page-v15 pricing-page-v19 pricing-page-v19-redesign pricing-page-v23"
>
  <SiteHeader brand={site.brand} nav={site.nav} />

  <main class="page-shell page-main pricing-main-v19-redesign">
    <section class="pricing-overview-v23 panel" aria-labelledby="pricing-overview-title">
      <div class="pricing-overview-head-v23">
        <div>
          <div class="eyebrow">Preise · Berlin-Moabit</div>
          <h1 id="pricing-overview-title">Was passt zu dir?</h1>
        </div>
        <p>Wähle direkt die Option, die zu deinem Trainingsrhythmus passt. Die wichtigsten Preise siehst du sofort.</p>
      </div>

      <div class="pricing-overview-grid-v23">
        <a class="pricing-overview-card-v23 is-membership" href="#memberships">
          <span>Regelmäßig trainieren</span>
          <strong>Memberships</strong>
          <div class="pricing-overview-prices-v23">
            <b>Bronze 45€</b>
            <b>Silber 79€</b>
            <b>Gold 99€</b>
          </div>
          <small>monatlich · reguläre Classes</small>
        </a>

        <a class="pricing-overview-card-v23" href="#start">
          <span>Neu bei Elite</span>
          <strong>Welcome Pass</strong>
          <b class="pricing-overview-main-price-v23">20€ · 2 Classes</b>
          <small>10 Tage gültig · einmal pro Person</small>
        </a>

        <a class="pricing-overview-card-v23" href="#flexible">
          <span>Ohne Membership</span>
          <strong>Flexibel</strong>
          <b class="pricing-overview-main-price-v23">ab 13€</b>
          <small>Drop-in · 5er Karte · 10er Karte</small>
        </a>

        <a class="pricing-overview-card-v23" href="#usc">
          <span>Schon USC-Mitglied?</span>
          <strong>Urban Sports Club</strong>
          <b class="pricing-overview-main-price-v23">Über USC</b>
          <small>reguläre Open Classes</small>
        </a>
      </div>
    </section>

    <PricingSection pricing={pricing} />

    <FaqSection
      items={pricingFaqs}
      eyebrow="Preise FAQ"
      title="Was vor der Buchung noch wichtig ist."
      description="Welcome Pass, USC, Memberships, Intensives und die Platzreservierung kurz und verständlich erklärt."
      linkHref="/faq/"
      linkLabel="Zum vollständigen FAQ"
    />

    <section class="pricing-assurance panel">
      <div>
        <div class="eyebrow">Noch unsicher?</div>
        <h2>Wir empfehlen lieber ehrlich, statt dir zu viel zu verkaufen.</h2>
      </div>
      <div>
        <p>Schreib uns, welche Styles dich interessieren und ob du schon einmal getanzt hast. Wir nennen dir den einfachsten Start.</p>
        <a class="button primary" href="https://wa.me/491633863548">Auf WhatsApp fragen</a>
      </div>
    </section>
  </main>

  <SiteFooter brand={site.brand} nav={site.nav} />
</BaseLayout>
