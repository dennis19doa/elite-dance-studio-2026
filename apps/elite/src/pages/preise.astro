---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import PricingSection from "../components/PricingSection.astro";
import FaqSection from "../components/FaqSection.astro";

import pricing from "../data/pricing.json";
import pricingFaqs from "../data/pricing-faqs.json";
import site from "../data/site.json";
---

<BaseLayout
  title="Preise & Memberships | Elite Dance Studio Berlin"
  description="Welcome Pass, Drop-in, Karten, USC und Memberships für beginner-friendly Tanzkurse im Elite Dance Studio Berlin-Moabit."
  bodyClass="pricing-page-v15 pricing-page-v19"
>
  <SiteHeader brand={site.brand} nav={site.nav} />

  <main class="page-shell page-main pricing-main-v15">
    <section class="pricing-page-hero panel">
      <div class="pricing-page-copy">
        <div class="eyebrow">Dein Tanzplan</div>
        <h1 class="page-title">Erst testen. Dann deinen Rhythmus finden.</h1>
        <p class="lead">
          Du musst dich nicht sofort festlegen. Starte mit zwei Classes, bleib flexibel oder
          baue eine feste Tanzroutine auf.
        </p>
        <div class="actions">
          <a class="button primary" href="#pricing-paths">Option wählen</a>
          <a class="button secondary" href="/kontakt/">Kurz beraten lassen</a>
        </div>
        <div class="hero-signals hero-signals-v15">
          <div class="hero-signal"><strong>Keine Anmeldegebühr</strong></div>
          <div class="hero-signal"><strong>Kein fester Tanzpartner nötig</strong></div>
          <div class="hero-signal"><strong>USC bei regulären Kursen möglich</strong></div>
        </div>
      </div>
      <figure class="pricing-page-media">
        <img
          src="/media/placeholders/community-beginners.jpg"
          alt="Konzeptbild einer offenen Beginner-Tanzklasse in einem hellen Studio"
        />
      </figure>
    </section>

    <section class="panel pricing-paths" id="pricing-paths">
      <div class="section-head">
        <div>
          <div class="eyebrow">Was passt heute zu dir?</div>
          <h2>Drei einfache Wege zu starten.</h2>
        </div>
        <p>Wähle nach deinem Alltag – nicht nach einer komplizierten Preistabelle.</p>
      </div>
      <div class="pricing-path-grid">
        <a class="pricing-path-card path-coral" href="/starter-pass/">
          <div><strong>Elite erst erleben.</strong><p>Zwei Classes mit dem Welcome Pass.</p></div>
          <span class="path-arrow" aria-hidden="true">→</span>
        </a>
        <a class="pricing-path-card path-blue" href="#pricing">
          <div><strong>Flexibel tanzen.</strong><p>Drop-in, 5er Karte, 10er Karte oder USC.</p></div>
          <span class="path-arrow" aria-hidden="true">→</span>
        </a>
        <a class="pricing-path-card path-gold" href="#pricing">
          <div><strong>Eine Routine aufbauen.</strong><p>Bronze, Silber oder Gold Membership.</p></div>
          <span class="path-arrow" aria-hidden="true">→</span>
        </a>
      </div>
      <div class="membership-rule-v15">
        <span>Memberships</span>
        <strong>1 Monat Laufzeit · jederzeit kündbar</strong>
        <p>Keine langfristige Bindung über den jeweiligen Mitgliedschaftsmonat hinaus.</p>
      </div>
    </section>

    <PricingSection
      pricing={pricing}
      eyebrow="Preise im Überblick"
      title="Von erster Class bis Flatrate."
      description="Teste Elite, bleib flexibel oder baue deine feste Wochenroutine auf."
    />

    <FaqSection
      items={pricingFaqs}
      eyebrow="Preise FAQ"
      title="Was vor der Buchung noch wichtig ist."
      description="Welcome Pass, USC, Memberships, Intensives und die Platzreservierung kurz und verständlich erklärt."
      linkHref="/faq/"
      linkLabel="Zum vollständigen FAQ"
    />

    <section class="pricing-assurance panel">
      <div>
        <div class="eyebrow">Noch unsicher?</div>
        <h2>Wir empfehlen lieber ehrlich, statt dir zu viel zu verkaufen.</h2>
      </div>
      <div>
        <p>Schreib uns, welche Styles dich interessieren und ob du schon einmal getanzt hast. Wir nennen dir den einfachsten Start.</p>
        <a class="button primary" href="https://wa.me/491633863548">Auf WhatsApp fragen</a>
      </div>
    </section>
  </main>

  <SiteFooter brand={site.brand} nav={site.nav} />
</BaseLayout>
