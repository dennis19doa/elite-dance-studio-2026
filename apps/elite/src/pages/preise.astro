---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import PricingSection from "../components/PricingSection.astro";
import FaqSection from "../components/FaqSection.astro";

import pricing from "../data/pricing.json";
import pricingFaqs from "../data/pricing-faqs.json";
import site from "../data/site.json";
---

<BaseLayout
  title="Preise & Memberships | Elite Dance Studio Berlin"
  description="Welcome Pass, Drop-in, Karten, USC und Memberships für beginner-friendly Tanzkurse im Elite Dance Studio Berlin-Moabit."
  bodyClass="pricing-page-v15 pricing-page-v19 pricing-page-v19-redesign"
>
  <SiteHeader brand={site.brand} nav={site.nav} />

  <main class="page-shell page-main pricing-main-v19-redesign">
    <section class="pricing-hero-v20 panel">
      <div class="pricing-hero-copy-v20">
        <div class="eyebrow">Preise · Berlin-Moabit</div>
        <h1 class="page-title">Tanz so, wie es zu deinem Leben passt.</h1>
        <p class="lead">Einmal ausprobieren, regelmäßig trainieren oder komplett flexibel bleiben. Du entscheidest erst über deinen Rhythmus – dann über den Preis.</p>
        <div class="actions">
          <a class="button primary" href="#pricing">Optionen vergleichen</a>
          <a class="button secondary" href="/kontakt/">Kurz beraten lassen</a>
        </div>
      </div>
      <aside class="pricing-hero-guide-v20" aria-label="Welche Preisoption passt zu mir?">
        <div><span>Start</span><strong>Neu bei Elite?</strong><p>2 Classes für 20€.</p></div>
        <div><span>Routine</span><strong>Feste Woche?</strong><p>Bronze, Silber oder Gold.</p></div>
        <div><span>Flexibel</span><strong>Ohne Membership?</strong><p>Drop-in, Karten oder USC.</p></div>
      </aside>
    </section>

    <PricingSection
      pricing={pricing}
      eyebrow="Deine Optionen"
      title="Einfach. Flexibel. So wie du."
      description="Klare Leistungen, klare Preise und keine langfristige Bindung bei unseren Memberships."
    />

    <FaqSection
      items={pricingFaqs}
      eyebrow="Preise FAQ"
      title="Was vor der Buchung noch wichtig ist."
      description="Welcome Pass, USC, Memberships, Intensives und die Platzreservierung kurz und verständlich erklärt."
      linkHref="/faq/"
      linkLabel="Zum vollständigen FAQ"
    />

    <section class="pricing-assurance panel">
      <div>
        <div class="eyebrow">Noch unsicher?</div>
        <h2>Wir empfehlen lieber ehrlich, statt dir zu viel zu verkaufen.</h2>
      </div>
      <div>
        <p>Schreib uns, welche Styles dich interessieren und ob du schon einmal getanzt hast. Wir nennen dir den einfachsten Start.</p>
        <a class="button primary" href="https://wa.me/491633863548">Auf WhatsApp fragen</a>
      </div>
    </section>
  </main>

  <SiteFooter brand={site.brand} nav={site.nav} />
</BaseLayout>
