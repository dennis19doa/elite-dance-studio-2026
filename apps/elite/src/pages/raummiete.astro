---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";

import site from "../data/site.json";

const rentalMessage = "https://wa.me/491633863548?text=Hallo%20Elite%20Dance%20Studio%2C%20ich%20interessiere%20mich%20f%C3%BCr%20Raummiete.%20Mein%20Wunschtermin%20ist%3A";
---

<BaseLayout
  title="Tanzstudio & Räume mieten | Elite Dance Studio Berlin"
  description="Drei Tanzräume in Berlin-Moabit für Proben, Workshops, Privatstunden, Castings und Content mieten."
>
  <SiteHeader brand={site.brand} nav={site.nav} />

  <main class="page-shell page-main">
    <section class="service-page-hero panel">
      <div class="service-page-copy">
        <div class="eyebrow">Raummiete in Berlin-Moabit</div>
        <h1 class="page-title">Raum für Training, Workshops und deine Ideen.</h1>
        <p class="lead">
          Drei unterschiedliche Studios für Proben, Privatstunden, Castings, Content-Shoots und
          Formate, die Bewegungsfreiheit brauchen.
        </p>
        <div class="actions">
          <a class="button primary" href={rentalMessage}>Verfügbarkeit anfragen</a>
          <a class="button secondary" href="mailto:info@elitedancestudio.de?subject=Anfrage%20Raummiete">E-Mail schreiben</a>
        </div>
      </div>
      <figure class="service-page-media">
        <img src="/media/current-site/studio-room-a.jpg" alt="Großer schwarzer Tanzraum im Elite Dance Studio" />
      </figure>
    </section>

    <section class="rental-room-grid" aria-label="Räume im Elite Dance Studio">
      <article class="rental-room-card">
        <img src="/media/current-site/studio-room-a.jpg" alt="Schwarzer Raum im Elite Dance Studio" loading="lazy" />
        <div><span>Größter Raum</span><h2>Schwarzer Raum</h2><p>Viel Fläche für größere Gruppen, Workshops, Proben, Trainingsformate und Events.</p></div>
      </article>
      <article class="rental-room-card">
        <img src="/media/current-site/studio-room-yellow.jpg" alt="Gelber Raum im Elite Dance Studio" loading="lazy" />
        <div><span>Flexibler Raum</span><h2>Gelber Raum</h2><p>Ideal für Kurse, Gruppenproben, private Trainings und Workshops.</p></div>
      </article>
      <article class="rental-room-card">
        <img src="/media/current-site/studio-room-blue.jpg" alt="Blauer Raum im Elite Dance Studio" loading="lazy" />
        <div><span>Kompakter Raum</span><h2>Blauer Raum</h2><p>Für kleinere Gruppen, Solo-Training, Coachings, Content und fokussierte Proben.</p></div>
      </article>
    </section>

    <section class="rental-request panel">
      <div><div class="eyebrow">Deine Anfrage</div><h2>Schreib uns deinen Wunschzeitraum.</h2></div>
      <div>
        <p>Am schnellsten können wir antworten, wenn du Datum, Uhrzeit, Raum, Personenanzahl und Nutzung direkt mitsendest.</p>
        <a class="button primary" href={rentalMessage}>Raum per WhatsApp anfragen</a>
      </div>
    </section>
  </main>

  <SiteFooter brand={site.brand} nav={site.nav} />
</BaseLayout>
