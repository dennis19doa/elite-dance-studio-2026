---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Visuelle Richtung | Elite Dance Studio"
  description="Interne Vergleichsseite für die visuelle Richtung der neuen Elite Dance Studio Website."
  noindex
  bodyClass="direction-review-page"
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Familjen+Grotesk:wght@400;500;600;700&family=Instrument+Sans:wdth,wght@90..100,400..700&family=Space+Grotesk:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </Fragment>

  <header class="review-bar">
    <a class="review-brand" href="/">
      <img src="/media/current-site/elite-mark.webp" alt="" width="270" height="270" />
      <span>Elite · Richtungswahl</span>
    </a>
    <nav aria-label="Visuelle Richtungen">
      <a href="#richtung-a"><span>A</span> Studio Pulse</a>
      <a href="#richtung-b"><span>B</span> Urban Stage</a>
      <a href="#richtung-c"><span>C</span> Open Studio</a>
    </nav>
    <a class="review-back" href="/">Aktuelle Seite</a>
  </header>

  <main class="direction-lab">
    <div class="direction-lab-shell">
      <div class="review-intro">
        <div>
          <span class="review-kicker">Visuelle Entscheidung · noch kein Redesign</span>
          <h1>Drei Richtungen.<br />Ein klares Ziel.</h1>
        </div>
        <p>
          Warm, energiegeladen und eindeutig eine Tanzschule. Alle drei Entwürfe nutzen dieselben
          Inhalte. So entscheiden wir nicht nur nach einer Farbe, sondern nach dem Gefühl der ganzen
          Seite.
        </p>
        <div class="review-principles" aria-label="Gemeinsame Prinzipien">
          <span>Video ohne Text</span>
          <span>Beginner sofort sichtbar</span>
          <span>Stundenplan früh</span>
          <span>Weniger Karten</span>
        </div>
      </div>

      <article class="concept concept-a" id="richtung-a">
        <div class="concept-label">
          <div>
            <span>Richtung A · Empfehlung</span>
            <h2>Studio Pulse</h2>
          </div>
          <p>Warm und klar. Energie kommt aus echten Menschen, Farbe und Bewegung.</p>
          <div class="palette" aria-label="Farbpalette Studio Pulse">
            <i style="--swatch: #111318"></i>
            <i style="--swatch: #f5f7fb"></i>
            <i style="--swatch: #ff5f57"></i>
            <i style="--swatch: #3568ff"></i>
            <i style="--swatch: #ffd166"></i>
          </div>
        </div>

        <div class="site-sample sample-a">
          <header class="sample-nav" data-preview-reveal="fade">
            <a class="sample-logo" href="#richtung-a" aria-label="Elite Dance Studio">
              <img
                src="/media/current-site/elite-logo.webp"
                alt="Elite Dance Studio"
                width="2560"
                height="1707"
              />
            </a>
            <nav aria-label="Beispielnavigation Studio Pulse">
              <a href="/stundenplan/">Stundenplan</a>
              <a href="/kurse/">Kurse</a>
              <a href="/styles/">Styles</a>
              <a href="/preise/">Preise</a>
              <a href="/coaches/">Coaches</a>
            </nav>
            <a class="sample-button sample-button-hot" href="/stundenplan/">Klasse buchen</a>
          </header>

          <div class="sample-a-video" data-preview-reveal="mask">
            <video
              autoplay
              muted
              loop
              playsinline
              preload="metadata"
              poster="/media/hero/elite-homepage-poster.jpg"
              aria-label="Echte Kursszenen im Elite Dance Studio"
            >
              <source src="/media/hero/elite-homepage-video-540.mp4" type="video/mp4" />
            </video>
          </div>

          <div class="sample-a-intro" data-preview-reveal="lines">
            <div>
              <span class="sample-overline">Tanzschule in Berlin-Moabit</span>
              <h3><span>Komm rein.</span><span>Tanz mit uns.</span></h3>
            </div>
            <div class="sample-a-copy">
              <p>
                Über 25 Styles. Viele Klassen für Beginner. Such dir eine Klasse aus oder teste
                zwei mit dem Welcome Pass.
              </p>
              <div class="sample-actions">
                <a class="sample-button sample-button-dark" href="/stundenplan/">Stundenplan ansehen</a>
                <a class="sample-text-link" href="/starter-pass/">Neu bei Elite? Hier entlang <b>↗</b></a>
              </div>
            </div>
          </div>

          <div class="sample-a-facts" data-preview-reveal="stagger">
            <span><b>25+</b> Tanzstyles</span>
            <span><b>Level 0</b> für den Anfang</span>
            <span><b>20 EUR</b> Welcome Pass</span>
            <span><b>Moabit</b> zwei Studios</span>
          </div>

          <div class="sample-a-schedule">
            <div class="schedule-heading" data-preview-reveal="left">
              <span>Diese Woche</span>
              <h3>Finde deine Klasse.</h3>
              <a href="/stundenplan/">Ganzer Stundenplan ↗</a>
            </div>
            <div class="class-lines" data-preview-reveal="rows">
              <a href="/stundenplan/">
                <time>18:00</time><strong>Commercial</strong><span>Level 0 · Dima</span><b>MO</b>
              </a>
              <a href="/stundenplan/">
                <time>19:00</time><strong>Bachata</strong><span>Beginner · Elena & Dennis</span><b>DI</b>
              </a>
              <a href="/stundenplan/">
                <time>20:00</time><strong>Reggaeton</strong><span>Fundamentals · Kathy</span><b>DO</b>
              </a>
              <a href="/stundenplan/">
                <time>18:30</time><strong>Hip-Hop</strong><span>Beginner · Amy</span><b>FR</b>
              </a>
            </div>
          </div>

          <div class="sample-a-styles" data-preview-reveal="gallery">
            <div class="poster poster-tall">
              <img src="/media/style-posters/20-bachata-beginner.webp" alt="Bachata Beginner" />
            </div>
            <div class="poster">
              <img src="/media/style-posters/06-hip-hop-beginner-amy.webp" alt="Hip-Hop Beginner" />
            </div>
            <div class="style-statement">
              <span>Was willst du tanzen?</span>
              <h3>Probier dich durch.</h3>
              <p>Von Bachata bis Breaking. Von Heels bis House.</p>
              <a href="/styles/">Alle Styles entdecken ↗</a>
            </div>
            <div class="poster poster-low">
              <img src="/media/style-posters/22-reggaeton-beginner.webp" alt="Reggaeton Beginner" />
            </div>
          </div>

          <div class="motion-notes">
            <span>Video: ruhige Blende</span>
            <span>Text: Zeile für Zeile</span>
            <span>Stundenplan: direkte Bedienung</span>
            <span>Bilder: Masken statt Karten</span>
          </div>
        </div>
      </article>

      <article class="concept concept-b" id="richtung-b">
        <div class="concept-label">
          <div>
            <span>Richtung B · stärker urban</span>
            <h2>Urban Stage</h2>
          </div>
          <p>Mehr Flying-Steps-Energie. Präzise, dunkel und markant, aber weniger laut als heute.</p>
          <div class="palette" aria-label="Farbpalette Urban Stage">
            <i style="--swatch: #050506"></i>
            <i style="--swatch: #f2f2ef"></i>
            <i style="--swatch: #2f72ff"></i>
            <i style="--swatch: #ff4d36"></i>
            <i style="--swatch: #9cff57"></i>
          </div>
        </div>

        <div class="site-sample sample-b">
          <header class="sample-nav" data-preview-reveal="split">
            <a class="sample-logo" href="#richtung-b" aria-label="Elite Dance Studio">
              <img
                src="/media/current-site/elite-logo.webp"
                alt="Elite Dance Studio"
                width="2560"
                height="1707"
              />
            </a>
            <nav aria-label="Beispielnavigation Urban Stage">
              <a href="/stundenplan/">Stundenplan</a>
              <a href="/kurse/">Kurse</a>
              <a href="/coaches/">Coaches</a>
              <a href="/intensives/">Intensives</a>
            </nav>
            <a class="sample-button sample-button-blue" href="/stundenplan/">Buchen ↗</a>
          </header>

          <div class="sample-b-opening">
            <div class="sample-b-title" data-preview-reveal="left">
              <span>Berlin · Moabit · seit 2018</span>
              <h3>Dein Kurs.<br />Dein Abend.</h3>
              <p>Beginner, Open Level und Intensives unter einem Dach.</p>
              <a class="sample-button sample-button-light" href="/stundenplan/">Heute tanzen</a>
            </div>
            <div class="sample-b-image" data-preview-reveal="wipe">
              <img src="/media/hero/elite-homepage-poster.jpg" alt="Kursszene im Elite Dance Studio" />
              <span aria-hidden="true">ELITE · ELITE · ELITE ·</span>
            </div>
          </div>

          <div class="sample-b-marquee" aria-label="Angebot">
            <span>LEVEL 0</span><i></i><span>BEGINNER</span><i></i><span>25+ STYLES</span><i></i>
            <span>WELCOME PASS 20 EUR</span>
          </div>

          <div class="sample-b-grid">
            <div class="sample-b-feature" data-preview-reveal="wipe">
              <img src="/media/style-posters/03-house-beginner.webp" alt="House Beginner" />
              <div><span>01</span><strong>House</strong><small>Beginner</small></div>
            </div>
            <div class="sample-b-feature feature-red" data-preview-reveal="wipe">
              <img src="/media/style-posters/09-reggaeton-fundamentals.webp" alt="Reggaeton Fundamentals" />
              <div><span>02</span><strong>Reggaeton</strong><small>Fundamentals</small></div>
            </div>
            <div class="sample-b-start" data-preview-reveal="left">
              <span>Neu hier?</span>
              <h3>Zwei Klassen.<br />20 EUR.</h3>
              <p>Mit dem Welcome Pass findest du heraus, was zu dir passt.</p>
              <a href="/starter-pass/">Welcome Pass holen ↗</a>
            </div>
          </div>

          <div class="motion-notes dark-notes">
            <span>Hero: harte Bildmaske</span>
            <span>Typo: gross, aber nur punktuell</span>
            <span>Styles: schnelle Wechsel</span>
            <span>Bedienung: sehr direkt</span>
          </div>
        </div>
      </article>

      <article class="concept concept-c" id="richtung-c">
        <div class="concept-label">
          <div>
            <span>Richtung C · offener und sozialer</span>
            <h2>Open Studio</h2>
          </div>
          <p>Mehr Leichtigkeit und Begegnung. Farbenfroh, freundlich und trotzdem klar organisiert.</p>
          <div class="palette" aria-label="Farbpalette Open Studio">
            <i style="--swatch: #f7f8fb"></i>
            <i style="--swatch: #20233a"></i>
            <i style="--swatch: #ff735c"></i>
            <i style="--swatch: #7557ff"></i>
            <i style="--swatch: #45d6b0"></i>
          </div>
        </div>

        <div class="site-sample sample-c">
          <header class="sample-nav" data-preview-reveal="fade">
            <a class="sample-logo" href="#richtung-c" aria-label="Elite Dance Studio">
              <img
                src="/media/current-site/elite-logo.webp"
                alt="Elite Dance Studio"
                width="2560"
                height="1707"
              />
            </a>
            <nav aria-label="Beispielnavigation Open Studio">
              <a href="/stundenplan/">Stundenplan</a>
              <a href="/kurse/">Kurse</a>
              <a href="/styles/">Styles</a>
              <a href="/ueber-uns/">Unser Studio</a>
            </nav>
            <a class="sample-button sample-button-coral" href="/starter-pass/">Welcome Pass</a>
          </header>

          <div class="sample-c-video" data-preview-reveal="mask">
            <img src="/media/hero/elite-homepage-poster.jpg" alt="Echte Kursszenen im Elite Dance Studio" />
          </div>

          <div class="sample-c-intro" data-preview-reveal="stagger">
            <div class="sample-c-heading">
              <span>Tanzen in Berlin-Moabit</span>
              <h3>Heute schon<br /><em>getanzt?</em></h3>
            </div>
            <div class="sample-c-start-card">
              <span>Neu bei Elite</span>
              <strong>Beginner? Genau richtig.</strong>
              <p>Starte mit Level 0, einer Beginner-Klasse oder dem Welcome Pass.</p>
              <a href="/kurse/">Deinen Start finden ↗</a>
            </div>
            <div class="sample-c-book-card">
              <span>Schon dabei</span>
              <strong>Direkt zur Klasse.</strong>
              <a href="/stundenplan/">Stundenplan öffnen ↗</a>
            </div>
          </div>

          <div class="sample-c-community">
            <div class="community-copy" data-preview-reveal="left">
              <span>Das ist Elite</span>
              <h3>Viele Styles.<br />Ein Studio.</h3>
              <p>
                Du kommst zum Tanzen und triffst Menschen, die genauso gern Musik, Bewegung und
                gemeinsame Abende mögen.
              </p>
              <a href="/ueber-uns/">Lerne uns kennen ↗</a>
            </div>
            <div class="community-collage" data-preview-reveal="collage">
              <img
                class="community-wide"
                src="/media/placeholders/community-beginners.jpg"
                alt="Tanzende Menschen in einem hellen Studio"
              />
              <img src="/media/coaches/amy.webp" alt="Coach Amy" />
              <img src="/media/coaches/dima.webp" alt="Coach Dima" />
            </div>
          </div>

          <div class="sample-c-next" data-preview-reveal="rows">
            <div>
              <span>Deine nächsten Schritte</span>
              <h3>Einfach anfangen.</h3>
            </div>
            <a href="/starter-pass/"><b>01</b><span>Welcome Pass</span><i>Zwei Klassen · 20 EUR</i><strong>↗</strong></a>
            <a href="/stundenplan/"><b>02</b><span>Stundenplan</span><i>Heute und diese Woche</i><strong>↗</strong></a>
            <a href="/kurse/"><b>03</b><span>Style finden</span><i>Kurskompass nutzen</i><strong>↗</strong></a>
          </div>

          <div class="motion-notes light-notes">
            <span>Video: ohne Ablenkung</span>
            <span>Inhalte: versetztes Raster</span>
            <span>Menschen: leichte Collage</span>
            <span>Links: grosse Klickflaechen</span>
          </div>
        </div>
      </article>

      <div class="review-conclusion">
        <span>Meine Empfehlung</span>
        <h2>Studio Pulse als Basis.<br />Open Studio für die menschlichen Momente.</h2>
        <p>
          Richtung A hat die beste Balance aus Premium, Energie und Orientierung. Von Richtung C
          würde ich die lockere Bildkomposition für Coaches, Über uns und Community übernehmen.
          Richtung B zeigt, wie viel Flying-Steps-Energie Elite vertraegt, ohne die ganze Website
          dunkel und laut zu machen.
        </p>
        <a href="#richtung-a">Richtung A noch einmal ansehen ↑</a>
      </div>
    </div>
  </main>
</BaseLayout>

<script>
  const previewItems = document.querySelectorAll<HTMLElement>("[data-preview-reveal]");
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (reducedMotion || !("IntersectionObserver" in window)) {
    previewItems.forEach((item) => item.classList.add("is-preview-visible"));
  } else {
    document.documentElement.classList.add("preview-motion-ready");
    const previewObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add("is-preview-visible");
          previewObserver.unobserve(entry.target);
        });
      },
      { rootMargin: "0px 0px -8%", threshold: 0.08 }
    );

    previewItems.forEach((item) => previewObserver.observe(item));
  }
</script>

<style>
  :global(.direction-review-page) {
    --review-ink: #17181d;
    margin: 0;
    overflow-x: hidden;
    background: #e9ebf0;
    color: var(--review-ink);
    font-family: "Instrument Sans", sans-serif;
  }

  :global(.direction-review-page .mobile-join-bar) {
    display: none;
  }

  .review-bar {
    position: sticky;
    top: 0;
    z-index: 50;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 24px;
    min-height: 74px;
    padding: 10px clamp(18px, 4vw, 56px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(14, 15, 18, 0.94);
    color: #fff;
    backdrop-filter: blur(18px);
  }

  .review-brand,
  .review-back,
  .review-bar nav a {
    color: inherit;
    text-decoration: none;
  }

  .review-brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-size: 0.76rem;
    font-weight: 650;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .review-brand img {
    width: 38px;
    height: 38px;
    object-fit: contain;
  }

  .review-bar nav {
    display: flex;
    gap: 8px;
  }

  .review-bar nav a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 9px 12px;
    border-radius: 999px;
    color: rgba(255, 255, 255, 0.66);
    font-size: 0.78rem;
    transition: background 180ms ease, color 180ms ease;
  }

  .review-bar nav a:hover {
    background: rgba(255, 255, 255, 0.08);
    color: #fff;
  }

  .review-bar nav span {
    display: grid;
    width: 23px;
    height: 23px;
    place-items: center;
    border-radius: 50%;
    background: #ff5f57;
    color: #111318;
    font-weight: 800;
  }

  .review-bar nav a:nth-child(2) span {
    background: #3568ff;
    color: #fff;
  }

  .review-bar nav a:nth-child(3) span {
    background: #45d6b0;
  }

  .review-back {
    justify-self: end;
    padding-bottom: 3px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.48);
    font-size: 0.78rem;
  }

  .direction-lab {
    min-height: 100vh;
    padding: clamp(40px, 7vw, 96px) 0 120px;
  }

  .direction-lab-shell {
    width: min(calc(100% - 32px), 1440px);
    margin: 0 auto;
  }

  .review-intro {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: clamp(32px, 7vw, 110px);
    padding: 0 clamp(0px, 3vw, 42px) clamp(60px, 9vw, 120px);
  }

  .review-kicker,
  .concept-label span,
  .review-conclusion > span {
    display: block;
    margin-bottom: 14px;
    color: #5c6170;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .review-intro h1,
  .review-conclusion h2 {
    margin: 0;
    font-family: "Familjen Grotesk", sans-serif;
    font-size: clamp(3.3rem, 7vw, 7rem);
    font-weight: 520;
    letter-spacing: -0.075em;
    line-height: 0.9;
  }

  .review-intro > p {
    align-self: end;
    max-width: 42rem;
    margin: 0;
    color: #555a67;
    font-size: clamp(1rem, 1.5vw, 1.2rem);
    line-height: 1.65;
  }

  .review-principles {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin-top: -28px;
    border-top: 1px solid rgba(23, 24, 29, 0.14);
  }

  .review-principles span {
    padding: 18px 16px 0 0;
    color: #3e424c;
    font-size: 0.8rem;
  }

  .concept {
    margin-bottom: clamp(90px, 13vw, 180px);
    scroll-margin-top: 100px;
  }

  .concept-label {
    display: grid;
    grid-template-columns: 1fr minmax(280px, 0.72fr) auto;
    align-items: end;
    gap: 34px;
    padding: 0 clamp(0px, 3vw, 42px) 24px;
  }

  .concept-label h2 {
    margin: 0;
    font-family: "Familjen Grotesk", sans-serif;
    font-size: clamp(2.4rem, 5vw, 5rem);
    font-weight: 540;
    letter-spacing: -0.065em;
    line-height: 0.9;
  }

  .concept-label p {
    max-width: 34rem;
    margin: 0;
    color: #555a67;
    line-height: 1.55;
  }

  .palette {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .palette i {
    width: 26px;
    height: 26px;
    border: 1px solid rgba(23, 24, 29, 0.14);
    border-radius: 50%;
    background: var(--swatch);
    box-shadow: 0 3px 8px rgba(16, 18, 24, 0.08);
  }

  .site-sample {
    position: relative;
    overflow: hidden;
    border-radius: 28px;
    box-shadow: 0 42px 100px rgba(28, 30, 38, 0.18);
  }

  .sample-nav {
    position: relative;
    z-index: 3;
    display: grid;
    grid-template-columns: 150px 1fr auto;
    align-items: center;
    min-height: 78px;
    padding: 10px clamp(18px, 3.2vw, 52px);
  }

  .sample-logo {
    display: block;
    width: 86px;
    height: 54px;
  }

  .sample-logo img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .sample-nav nav {
    display: flex;
    justify-content: center;
    gap: clamp(15px, 2.4vw, 36px);
  }

  .sample-nav nav a,
  .sample-text-link,
  .schedule-heading a,
  .style-statement a,
  .sample-b-start a,
  .community-copy a,
  .sample-c-start-card a,
  .sample-c-book-card a {
    color: inherit;
    font-size: 0.82rem;
    font-weight: 650;
    text-decoration: none;
  }

  .sample-button {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    padding: 0 18px;
    border-radius: 999px;
    color: inherit;
    font-size: 0.82rem;
    font-weight: 700;
    text-decoration: none;
    transition: transform 180ms ease, box-shadow 180ms ease;
  }

  .sample-button:hover,
  .sample-text-link:hover,
  .class-lines a:hover,
  .sample-c-next a:hover {
    transform: translateY(-2px);
  }

  .motion-notes {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 1px solid rgba(17, 19, 24, 0.11);
    background: #eef1f7;
  }

  .motion-notes span {
    padding: 17px 20px;
    border-right: 1px solid rgba(17, 19, 24, 0.11);
    color: #666c7a;
    font-size: 0.69rem;
    letter-spacing: 0.06em;
    text-align: center;
    text-transform: uppercase;
  }

  .motion-notes span:last-child {
    border-right: 0;
  }

  /* Direction A */
  .sample-a {
    background: #f5f7fb;
    color: #111318;
