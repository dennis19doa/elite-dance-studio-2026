  /* Each preview uses a motion language that matches its visual direction. */
  :global(.preview-motion-ready) [data-preview-reveal] {
    opacity: 0;
    transition: opacity 700ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 800ms cubic-bezier(0.22, 1, 0.36, 1),
      clip-path 900ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  :global(.preview-motion-ready) [data-preview-reveal="fade"] {
    transform: translateY(-8px);
  }

  :global(.preview-motion-ready) [data-preview-reveal="mask"] {
    clip-path: inset(0 8% 0 8% round 24px);
    transform: scale(0.985);
  }

  :global(.preview-motion-ready) [data-preview-reveal="lines"],
  :global(.preview-motion-ready) [data-preview-reveal="left"] {
    transform: translateX(-36px);
  }

  :global(.preview-motion-ready) [data-preview-reveal="rows"] {
    transform: translateX(42px);
  }

  :global(.preview-motion-ready) [data-preview-reveal="gallery"],
  :global(.preview-motion-ready) [data-preview-reveal="collage"] {
    transform: translateY(32px) scale(0.98);
  }

  :global(.preview-motion-ready) [data-preview-reveal="wipe"] {
    clip-path: inset(0 100% 0 0);
  }

  :global(.preview-motion-ready) [data-preview-reveal="split"] {
    clip-path: inset(0 48% 0 48%);
  }

  :global(.preview-motion-ready) [data-preview-reveal].is-preview-visible {
    opacity: 1;
    clip-path: inset(0 0 0 0 round 0);
    transform: none;
  }

  :global(.preview-motion-ready) [data-preview-reveal="stagger"].is-preview-visible > *,
  :global(.preview-motion-ready) [data-preview-reveal="rows"].is-preview-visible > * {
    animation: preview-rise 560ms both cubic-bezier(0.22, 1, 0.36, 1);
  }

  :global(.preview-motion-ready) [data-preview-reveal="stagger"].is-preview-visible > *:nth-child(2),
  :global(.preview-motion-ready) [data-preview-reveal="rows"].is-preview-visible > *:nth-child(2) {
    animation-delay: 80ms;
  }

  :global(.preview-motion-ready) [data-preview-reveal="stagger"].is-preview-visible > *:nth-child(3),
  :global(.preview-motion-ready) [data-preview-reveal="rows"].is-preview-visible > *:nth-child(3) {
    animation-delay: 150ms;
  }

  :global(.preview-motion-ready) [data-preview-reveal="stagger"].is-preview-visible > *:nth-child(4),
  :global(.preview-motion-ready) [data-preview-reveal="rows"].is-preview-visible > *:nth-child(4) {
    animation-delay: 220ms;
  }

  @keyframes preview-rise {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

