---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import WelcomePassHero from "../components/WelcomePassHero.astro";
import WelcomePassBenefits from "../components/WelcomePassBenefits.astro";
import WelcomePassTrust from "../components/WelcomePassTrust.astro";
import FirstVisitSection from "../components/FirstVisitSection.astro";
import FaqSection from "../components/FaqSection.astro";
import EversportsSchedule from "../components/EversportsSchedule.astro";

import site from "../data/site.json";
import welcomePass from "../data/welcome-pass.json";

const welcomePassHref = "https://www.eversports.de/org/product/eaed6a11-d4bb-44ff-8b0d-ab8acf6828f3?venueId=403f5ec1-2e5b-489c-b5d1-c424903a26c5";
---

<BaseLayout
  title="Welcome Pass | Zwei Tanzkurse bei Elite Dance Studio testen"
  description="Mit dem Welcome Pass zwei reguläre Tanzkurse bei Elite Dance Studio in Berlin-Moabit testen: 2 Classes für 20 Euro, 10 Tage gültig und einmal pro Person."
>
  <SiteHeader brand={site.brand} nav={site.nav} />

  <main class="page-shell page-main">
    <WelcomePassHero hero={welcomePass.hero} />
    <WelcomePassTrust address={site.visit.address} />
    <WelcomePassBenefits benefits={welcomePass.benefits} />

    <EversportsSchedule
      id="pass-kurse"
      eyebrow="Deine zwei Klassen"
      title="Sieh vor dem Kauf, welche Classes aktuell laufen."
      description="Der Stundenplan unten ist live. Für deinen Einstieg eignen sich besonders Level 0 und Beginner Classes. Nach dem Kauf buchst du deine zwei regulären Classes direkt über Eversports."
    />

    <FirstVisitSection
      steps={welcomePass.steps}
      eyebrow="So funktioniert es"
      title="Drei Schritte. Keine versteckten Hürden."
      description="Kaufen, zwei Classes buchen, Elite kennenlernen. Wenn du bei der Kurswahl unsicher bist, helfen wir dir natürlich persönlich weiter."
    />

    <FaqSection
      items={welcomePass.faqs}
      eyebrow="Welcome Pass FAQ"
      title="Alles, was du vor der Buchung wissen möchtest."
      description="Die wichtigsten Antworten stehen direkt hier. Für alles Persönliche kannst du uns jederzeit schreiben."
    />

    <section class="cta-banner panel welcome-final-cta">
      <div>
        <div class="eyebrow">Bereit für deinen ersten Schritt?</div>
        <h2>2 Classes · 20€ · direkt über Eversports.</h2>
        <p>Einmalig kaufen, zwei reguläre Classes testen und danach selbst entscheiden. Kein Abo, keine automatische Verlängerung.</p>
      </div>
      <div class="actions">
        <a class="button welcome-primary" href={welcomePassHref} target="_blank" rel="noreferrer">Welcome Pass für 20€ kaufen</a>
        <a class="button welcome-secondary" href="/kurse/">Kurse vergleichen</a>
      </div>
    </section>
  </main>

  <SiteFooter brand={site.brand} nav={site.nav} />
</BaseLayout>
