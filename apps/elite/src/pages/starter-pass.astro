---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import EversportsSchedule from "../components/EversportsSchedule.astro";
import FaqSection from "../components/FaqSection.astro";
import { cloudMediaBaseUrl, cloudMediaUrl } from "../lib/media";

import site from "../data/site.json";

const welcomePassHref = "https://www.eversports.de/org/product/eaed6a11-d4bb-44ff-8b0d-ab8acf6828f3?venueId=403f5ec1-2e5b-489c-b5d1-c424903a26c5";
const heroVideo = cloudMediaUrl(site.hero.videoCloudSrc);

const faqs = [
  {
    question: "Ist der Welcome Pass für Anfänger:innen?",
    answer: "Ja. Für den Einstieg empfehlen wir Level 0 oder Beginner Classes."
  },
  {
    question: "Brauche ich einen Partner?",
    answer: "Nein. Viele Classes funktionieren ohne Partner, und auch zu vielen Beginner Partner-Dance-Classes kannst du allein kommen."
  },
  {
    question: "Welche Classes sind dabei?",
    answer: "Reguläre Classes. Advanced-Kurse, Closed Groups und Intensives sind ausgenommen."
  },
  {
    question: "Wie lange ist der Pass gültig?",
    answer: "10 Tage ab deinem ersten Besuch und einmal pro Person."
  }
];
---

<BaseLayout
  title="Welcome Pass | 2 Tanzkurse für 20€ bei Elite Dance Studio"
  description="Teste Elite Dance Studio in Berlin-Moabit mit 2 regulären Classes für 20€. Viele Styles, Level 0 bis Advanced und direkte Buchung über Eversports."
>
  <link slot="head" rel="preconnect" href={cloudMediaBaseUrl} crossorigin="anonymous" />
  <SiteHeader brand={site.brand} nav={site.nav} />

  <main class="page-shell page-main welcome-main">
    <section class="welcome-hero panel">
      <div class="welcome-intro">
        <div>
          <div class="eyebrow">Welcome Pass · Berlin-Moabit</div>
          <h1>2 Classes. 20€. Finde deinen Style.</h1>
          <p>Teste Elite in zwei echten Classes und finde heraus, was zu dir passt.</p>
        </div>

        <div class="welcome-intro-actions">
          <a class="button primary" href={welcomePassHref} target="_blank" rel="noreferrer">Welcome Pass holen</a>
          <a class="button secondary" href="#pass-kurse">Classes ansehen</a>
        </div>
      </div>

      <div class="welcome-video-stage">
        <video
          class="welcome-video"
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          poster={site.hero.videoPoster}
          aria-label="Echte Kursszenen im Elite Dance Studio"
        >
          <source src={heroVideo} type="video/mp4" />
          <source src={site.hero.videoSrc} type="video/mp4" />
        </video>

        <div class="welcome-video-overlay">
          <div class="welcome-stat">
            <strong>25+</strong>
            <span>Styles</span>
          </div>
          <div class="welcome-stat">
            <strong>2</strong>
            <span>Classes</span>
          </div>
          <div class="welcome-stat">
            <strong>10 Tage</strong>
            <span>Gültig</span>
          </div>
          <div class="welcome-stat">
            <strong>Level 0 → Advanced</strong>
            <span>Für deinen nächsten Schritt</span>
          </div>
        </div>
      </div>
    </section>

    <section class="welcome-value panel">
      <div class="section-head compact-head">
        <div>
          <div class="eyebrow">Warum Elite?</div>
          <h2>Mehr Auswahl. Mehr Energie. Mehr Möglichkeiten.</h2>
        </div>
      </div>

      <div class="welcome-value-grid">
        <article>
          <img src="/media/current-site/kathy-reggaeton.png" alt="Reggaeton bei Elite Dance Studio" loading="lazy" />
          <strong>Viele Styles</strong>
          <span>Reggaeton, Bachata, Heels, Hip Hop, House und mehr.</span>
        </article>
        <article>
          <img src="/media/current-site/intensives-dance-floor.jpg" alt="Training bei Elite Dance Studio" loading="lazy" />
          <strong>Echte Classes</strong>
          <span>Trainiere direkt mit unseren Coaches und unserer Community.</span>
        </article>
        <article>
          <img src="/media/current-site/elite-party.jpg" alt="Community bei Elite Dance Studio" loading="lazy" />
          <strong>Mehr als Unterricht</strong>
          <span>Classes, Socials, Events und ein Studio zum Ankommen.</span>
        </article>
      </div>
    </section>

    <section class="welcome-quick panel">
      <div class="welcome-quick-item">
        <span>01</span>
        <strong>Pass holen</strong>
      </div>
      <div class="welcome-quick-item">
        <span>02</span>
        <strong>2 Classes wählen</strong>
      </div>
      <div class="welcome-quick-item">
        <span>03</span>
        <strong>Come dance</strong>
      </div>
    </section>

    <section id="pass-kurse" class="welcome-schedule">
      <EversportsSchedule
        id="pass-kurse-live"
        eyebrow="Live Stundenplan"
        title="Was möchtest du ausprobieren?"
        description=""
      />
    </section>

    <section class="welcome-first-visit panel">
      <div>
        <div class="eyebrow">Dein erster Besuch</div>
        <h2>Einfach kommen. Wir zeigen dir den Rest.</h2>
        <p>Komm 10–15 Minuten früher. Wenn du unsicher bist, welche Class passt, helfen wir dir direkt.</p>
        <a class="button secondary" href={site.visit.whatsappHref} target="_blank" rel="noreferrer">WhatsApp</a>
      </div>
      <img src="/media/current-site/studio-room-yellow.jpg" alt="Elite Dance Studio Berlin" loading="lazy" />
    </section>

    <section class="welcome-faq panel">
      <FaqSection
        items={faqs}
        eyebrow="Kurz beantwortet"
        title="Noch eine Frage?"
        description=""
      />
    </section>

    <section class="cta-banner panel welcome-final-cta">
      <div>
        <div class="eyebrow">Ready?</div>
        <h2>2 Classes für 20€.</h2>
        <p>Direkt über Eversports buchen und loslegen.</p>
      </div>
      <div class="actions">
        <a class="button primary" href={welcomePassHref} target="_blank" rel="noreferrer">Welcome Pass holen</a>
      </div>
    </section>
  </main>

  <SiteFooter brand={site.brand} nav={site.nav} />

  <style>
    .welcome-main {
      display: grid;
      gap: 18px;
    }

    .welcome-hero {
      display: grid;
      gap: 24px;
      padding: clamp(22px, 4vw, 44px);
    }

    .welcome-intro {
      display: flex;
      justify-content: space-between;
      gap: 28px;
      align-items: end;
    }

    .welcome-intro h1 {
      margin: 8px 0 10px;
      max-width: 760px;
      font-family: "Sora", sans-serif;
      font-size: clamp(2.6rem, 6vw, 5.8rem);
      line-height: 0.95;
      letter-spacing: -0.055em;
    }

    .welcome-intro p {
      margin: 0;
      max-width: 560px;
      font-size: 1rem;
      line-height: 1.55;
      color: var(--text-muted, #6f675f);
    }

    .welcome-intro-actions {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
      justify-content: flex-end;
    }

    .welcome-video-stage {
      position: relative;
      overflow: hidden;
      border-radius: 24px;
      background: #15100e;
      aspect-ratio: 16 / 9;
      min-height: 420px;
    }

    .welcome-video {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .welcome-video-stage::after {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(0deg, rgba(13, 9, 8, 0.68) 0%, rgba(13, 9, 8, 0.05) 52%);
      pointer-events: none;
    }

    .welcome-video-overlay {
      position: absolute;
      z-index: 2;
      left: 18px;
      right: 18px;
      bottom: 18px;
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 8px;
    }

    .welcome-stat {
      min-height: 74px;
      padding: 13px 14px;
      border: 1px solid rgba(255,255,255,.18);
      border-radius: 14px;
      background: rgba(19, 13, 11, 0.50);
      backdrop-filter: blur(10px);
      color: #fff;
    }

    .welcome-stat strong,
    .welcome-stat span {
      display: block;
    }

    .welcome-stat strong {
      font-family: "Sora", sans-serif;
      font-size: clamp(1rem, 2vw, 1.35rem);
      letter-spacing: -0.03em;
    }

    .welcome-stat span {
      margin-top: 3px;
      color: rgba(255,255,255,.67);
      font-size: .72rem;
    }

    .welcome-value {
      padding: clamp(22px, 4vw, 40px);
    }

    .compact-head {
      margin-bottom: 18px;
    }

    .welcome-value h2,
    .welcome-first-visit h2 {
      margin-top: 6px;
      max-width: 760px;
      font-size: clamp(1.9rem, 3.8vw, 3.4rem);
      letter-spacing: -0.045em;
    }

    .welcome-value-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 12px;
    }

    .welcome-value-grid article {
      position: relative;
      min-height: 300px;
      overflow: hidden;
      border-radius: 18px;
      background: #191310;
    }

    .welcome-value-grid img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .welcome-value-grid article::after {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(0deg, rgba(10,7,6,.88) 0%, rgba(10,7,6,.05) 68%);
    }

    .welcome-value-grid strong,
    .welcome-value-grid span {
      position: absolute;
      z-index: 2;
      left: 18px;
      right: 18px;
      color: #fff;
    }

    .welcome-value-grid strong {
      bottom: 46px;
      font-size: 1.05rem;
    }

    .welcome-value-grid span {
      bottom: 18px;
      color: rgba(255,255,255,.72);
      font-size: .78rem;
    }

    .welcome-quick {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 10px;
      padding: 14px;
    }

    .welcome-quick-item {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 18px;
      border-radius: 16px;
      background: rgba(255,255,255,.50);
    }

    .welcome-quick-item span {
      color: #9a3345;
      font-size: .72rem;
      font-weight: 800;
    }

    .welcome-quick-item strong {
      font-size: .95rem;
    }

    .welcome-schedule {
      min-width: 0;
    }

    .welcome-first-visit {
      display: grid;
      grid-template-columns: .9fr 1.1fr;
      gap: 16px;
      align-items: stretch;
      padding: 16px;
    }

    .welcome-first-visit > div {
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: clamp(20px, 4vw, 42px);
    }

    .welcome-first-visit p {
      max-width: 500px;
      margin: 0 0 18px;
      color: var(--text-muted, #6f675f);
      line-height: 1.6;
    }

    .welcome-first-visit img {
      width: 100%;
      min-height: 360px;
      height: 100%;
      object-fit: cover;
      border-radius: 18px;
    }

    .welcome-faq {
      padding-top: 8px;
    }

    .welcome-final-cta p {
      max-width: 520px;
    }

    @media (max-width: 900px) {
      .welcome-intro {
        align-items: flex-start;
        flex-direction: column;
      }

      .welcome-intro-actions {
        justify-content: flex-start;
      }

      .welcome-video-overlay {
        grid-template-columns: 1fr 1fr;
      }

      .welcome-value-grid,
      .welcome-first-visit {
        grid-template-columns: 1fr;
      }

      .welcome-value-grid article {
        min-height: 260px;
      }
    }

    @media (max-width: 640px) {
      .welcome-hero {
        padding: 18px;
      }

      .welcome-video-stage {
        min-height: 520px;
        aspect-ratio: 4 / 5;
      }

      .welcome-video-overlay {
        left: 10px;
        right: 10px;
        bottom: 10px;
      }

      .welcome-stat {
        min-height: 66px;
      }

      .welcome-quick {
        grid-template-columns: 1fr;
      }

      .welcome-first-visit img {
        min-height: 280px;
      }
    }
  </style>
</BaseLayout>
