---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import EversportsSchedule from "../components/EversportsSchedule.astro";

import site from "../data/site.json";
---

<BaseLayout
  title="Stundenplan & Buchung | Elite Dance Studio Berlin"
  description="Aktuelle Tanzkurse im Elite Dance Studio Berlin ansehen und deinen Platz direkt über Eversports reservieren."
  bodyClass="site-subpage schedule-page-v9"
>
  <SiteHeader brand={site.brand} nav={site.nav} />

  <main class="page-shell page-main">
    <section class="booking-intro panel">
      <div>
        <div class="eyebrow">Diese Woche bei Elite</div>
        <h1 class="page-title">Stundenplan ansehen. Platz reservieren. Tanzen.</h1>
      </div>
      <div class="booking-intro-copy">
        <p class="lead">Der Live-Kalender ist das Zentrum: aktuelle Classes, Plätze und Buchung direkt an einem Ort.</p>
        <div class="actions">
          <a class="button primary" href="#schedule">Zum Live-Kalender</a>
          <a class="button secondary" href="/starter-pass/">Welcome Pass · 20€</a>
        </div>
      </div>
    </section>

    <div class="booking-quick-v9" aria-label="Wichtige Hinweise zur Buchung">
      <span>Viele Classes beginner-friendly</span>
      <span>Oft ohne festen Partner</span>
      <span>USC bei regulären Open Classes</span>
      <span>Erster Besuch: 10–15 Min. früher</span>
    </div>

    <EversportsSchedule
      title="Deine nächste Class beginnt hier."
      description="Wähle eine Class im Live-Kalender und buche deinen Platz direkt. Wenn du beim Level unsicher bist, findest du die Kurswahl-Hilfe oben rechts."
    />
  </main>

  <SiteFooter brand={site.brand} nav={site.nav} />
</BaseLayout>
