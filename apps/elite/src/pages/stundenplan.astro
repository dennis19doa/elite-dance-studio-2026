---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import EversportsSchedule from "../components/EversportsSchedule.astro";

import site from "../data/site.json";
---

<BaseLayout
  title="Stundenplan & Buchung | Elite Dance Studio Berlin"
  description="Aktuelle Tanzkurse im Elite Dance Studio Berlin ansehen und deinen Platz direkt über Eversports reservieren."
  bodyClass="site-subpage schedule-page-v9"
>
  <SiteHeader brand={site.brand} nav={site.nav} />

  <main class="page-shell page-main">
    <section class="booking-intro panel booking-intro-v16">
      <div>
        <div class="eyebrow">Stundenplan</div>
        <h1 class="page-title">Deine nächste Class beginnt hier.</h1>
      </div>
      <div class="booking-intro-copy">
        <p class="lead">Class wählen. Platz sichern. Tanzen.</p>
        <div class="actions">
          <a class="button primary" href="#schedule">Zum Kalender</a>
          <a class="button secondary" href="/starter-pass/">Welcome Pass · 20€</a>
        </div>
      </div>
    </section>

    <div class="booking-quick-v9 booking-quick-v16" aria-label="Kurz vor deinem Besuch">
      <span>USC bei Open Classes</span>
      <span>Viele Classes ohne festen Partner</span>
      <span>Erster Besuch: 10–15 Min. früher</span>
    </div>

    <EversportsSchedule title="Live-Kalender" />
  </main>

  <SiteFooter brand={site.brand} nav={site.nav} />
</BaseLayout>
