---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import EversportsSchedule from "../components/EversportsSchedule.astro";

import site from "../data/site.json";
---

<BaseLayout
  title="Stundenplan & Buchung | Elite Dance Studio Berlin"
  description="Aktuelle Tanzkurse im Elite Dance Studio Berlin ansehen und deinen Platz direkt über Eversports reservieren."
  bodyClass="schedule-page-v3"
>
  <SiteHeader brand={site.brand} nav={site.nav} />

  <main class="page-shell page-main schedule-main-v3">
    <section class="schedule-page-hero-v3">
      <div>
        <div class="eyebrow">Stundenplan · Berlin-Moabit</div>
        <h1 class="page-title">Wähle. Buche. Tanz.</h1>
      </div>
      <div class="schedule-page-hero-side">
        <p class="lead">Alle aktuellen Classes und freien Plätze an einem Ort.</p>
        <div class="schedule-utility-links">
          <a href="/starter-pass/">Neu? 2 Classes · 20€</a>
          <a href="https://urbansportsclub.com/de/venues/elite-dance-studio-1" target="_blank" rel="noreferrer">Mit USC kommen ↗</a>
          <a href="https://wa.me/491633863548?text=Hallo%20Elite%2C%20welcher%20Kurs%20passt%20zu%20mir%3F">Kurswahl fragen</a>
        </div>
      </div>
    </section>

    <EversportsSchedule
      title="Was möchtest du diese Woche tanzen?"
      description="Klasse auswählen, Verfügbarkeit prüfen und direkt reservieren."
    />
  </main>

  <SiteFooter brand={site.brand} nav={site.nav} />
</BaseLayout>
