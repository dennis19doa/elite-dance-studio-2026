---
import tvMedia from "../data/tv-media.json";
const base = import.meta.env.BASE_URL ?? "/";
const media = (path: string) => `${base}media/${path}`;
const posters = tvMedia.posters.map((item) => ({ ...item, src: media(item.file) }));
const videos = tvMedia.videos.map(media);
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="robots" content="noindex,nofollow" />
<title>Elite TV v2</title>
<style>
:root{color-scheme:dark;font-family:Inter,system-ui,sans-serif;background:#050505;color:#fff}*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;overflow:hidden;background:#050505}.tv{position:relative;width:100vw;height:100vh;overflow:hidden}.scene{position:absolute;inset:0;opacity:0;pointer-events:none;transition:opacity .55s ease}.scene.active{opacity:1}.video video{width:100%;height:100%;object-fit:cover}.shade{position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,.1),rgba(0,0,0,.1) 55%,rgba(0,0,0,.78))}.brand{position:absolute;top:3vh;left:3vw;font-size:clamp(18px,2vw,34px);font-weight:900;letter-spacing:.12em}.clock{position:absolute;top:3vh;right:3vw;text-align:right;font-size:clamp(24px,3vw,52px);font-weight:900}.clock span{display:block;font-size:.32em;letter-spacing:.16em;opacity:.7;margin-top:.45rem}.ticker{position:absolute;left:3vw;right:3vw;bottom:3vh;padding:1rem 1.3rem;border:1px solid rgba(255,255,255,.18);background:rgba(0,0,0,.68);border-radius:18px;font-size:clamp(16px,1.6vw,28px);font-weight:750}.class-scene{background:#040404}.poster-bg{position:absolute;inset:-4%;width:108%;height:108%;object-fit:cover;filter:blur(34px) brightness(.26);transform:scale(1.07)}.poster-main{position:absolute;inset:0;width:100%;height:100%;object-fit:contain}.fade{position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,.03) 35%,rgba(0,0,0,.18) 58%,rgba(0,0,0,.94) 100%)}.info{position:absolute;z-index:5;left:3vw;right:3vw;bottom:3vh;display:grid;grid-template-columns:1fr auto;gap:2vw;align-items:end;padding:1.3vw 1.6vw;border:1px solid rgba(255,255,255,.2);background:rgba(5,5,5,.82);backdrop-filter:blur(18px);border-radius:22px;box-shadow:0 12px 45px rgba(0,0,0,.45)}.status{display:inline-flex;align-items:center;gap:.7rem;font-size:clamp(13px,1.1vw,20px);font-weight:900;text-transform:uppercase;letter-spacing:.16em}.dot{width:.8em;height:.8em;border-radius:50%;background:#ff2b2b}.live .dot{box-shadow:0 0 0 0 rgba(255,43,43,.85);animation:pulse 1.1s infinite}.live .status{color:#ff4b4b}.next .dot{background:#fff}.info h1{margin:.5rem 0 0;font-size:clamp(36px,5.2vw,94px);line-height:.86;letter-spacing:-.055em;text-transform:uppercase}.meta{text-align:right}.meta strong{display:block;font-size:clamp(38px,4.8vw,88px);line-height:.9}.meta span{display:block;margin-top:.65rem;font-size:clamp(14px,1.25vw,24px);letter-spacing:.1em;text-transform:uppercase;opacity:.76}.multi{display:grid;grid-template-columns:repeat(var(--count,2),1fr);gap:1.2vw;height:100%;padding:3vh 3vw}.card{position:relative;overflow:hidden;border-radius:24px;border:1px solid rgba(255,255,255,.16);background:#111}.card img{width:100%;height:100%;object-fit:cover}.card:after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,transparent 35%,rgba(0,0,0,.93))}.card-copy{position:absolute;z-index:2;left:1.4vw;right:1.4vw;bottom:1.4vw;padding:1.1vw;border:1px solid rgba(255,255,255,.16);background:rgba(0,0,0,.72);border-radius:16px}.card-copy strong{display:block;font-size:clamp(22px,2.5vw,46px);line-height:.95;text-transform:uppercase}.card-copy span{display:block;margin-top:.6rem;font-size:clamp(14px,1.25vw,23px);opacity:.8}.head{position:absolute;z-index:6;top:3vh;left:3vw;right:3vw;display:flex;justify-content:space-between;align-items:center}.head-title{font-size:clamp(18px,2vw,32px);font-weight:900;letter-spacing:.12em;text-transform:uppercase}.head-live{display:flex;align-items:center;gap:.7rem;font-size:clamp(16px,1.5vw,25px);font-weight:900;color:#ff4b4b}.head-live .dot{animation:pulse 1.1s infinite}.probe{position:fixed;left:-10000px;top:0;width:1400px;min-height:900px;opacity:.001;pointer-events:none}@keyframes pulse{0%{box-shadow:0 0 0 0 rgba(255,43,43,.75);opacity:1}70%{box-shadow:0 0 0 18px rgba(255,43,43,0);opacity:.55}100%{box-shadow:0 0 0 0 rgba(255,43,43,0);opacity:1}}@media(max-aspect-ratio:4/3){.info{grid-template-columns:1fr}.meta{text-align:left}.multi{grid-template-columns:1fr}}
</style>
</head>
<body>
<main class="tv">
<section class="scene video active" id="video-scene"><video id="video" autoplay muted playsinline loop></video><div class="shade"></div><div class="brand">ELITE DANCE STUDIO</div><div class="clock"><strong id="clock">--:--</strong><span id="day">BERLIN</span></div><div class="ticker">Dance · Train · Connect · Berlin-Moabit</div></section>
<section class="scene class-scene" id="single-scene"><img class="poster-bg" id="single-bg" alt=""><img class="poster-main" id="single-img" alt=""><div class="fade"></div><div class="info" id="single-info"><div><div class="status"><span class="dot"></span><span id="single-status">NEXT CLASS</span></div><h1 id="single-title">Class</h1></div><div class="meta"><strong id="single-time">18:00</strong><span id="single-room">BLACK ROOM</span></div></div></section>
<section class="scene class-scene" id="multi-scene"><div class="head"><div class="head-title" id="multi-title">LIVE NOW</div><div class="head-live" id="multi-live"><span class="dot"></span>LIVE</div></div><div class="multi" id="multi-grid"></div></section>
<div class="probe"><div id="eversports-probe" data-eversports-widget-id="061d6c37-61a5-4378-8453-714ce19d595c"></div></div>
</main>
<script type="module" src="https://widget-static.eversports.io/loader.js"></script>
<script is:inline define:vars={{ posters, videos }}>
(()=>{
const TZ="Europe/Berlin", WINDOW=15, REPEAT=2, SHOW=12; const video=document.getElementById('video'); if(videos.length) video.src=videos[0];
const scenes={video:document.getElementById('video-scene'),single:document.getElementById('single-scene'),multi:document.getElementById('multi-scene')};
let events=[],lastKey='',timer=null,posterIndex=0;
const norm=(s='')=>s.toLowerCase().replace(/[^a-z0-9äöüß+]+/gi,' ').replace(/\s+/g,' ').trim();
const posterFor=(title='')=>posters.find(p=>[p.title,...(p.aliases||[])].some(a=>{a=norm(a);const n=norm(title);return a&&(n.includes(a)||a.includes(n))}))||posters[posterIndex++%posters.length];
const text=el=>(el?.innerText||el?.textContent||'').replace(/\s+/g,' ').trim();
const parts=()=>Object.fromEntries(new Intl.DateTimeFormat('en-GB',{timeZone:TZ,weekday:'long',hour:'2-digit',minute:'2-digit',hour12:false}).formatToParts(new Date()).map(p=>[p.type,p.value]));
const min=t=>{const[h,m]=t.split(':').map(Number);return h*60+m};
function updateClock(){const p=parts();document.getElementById('clock').textContent=`${p.hour}:${p.minute}`;document.getElementById('day').textContent=`${p.weekday} · BERLIN`}
function roomFrom(s=''){s=s.toLowerCase();if(/schwarz|black/.test(s))return'BLACK ROOM';if(/gelb|yellow/.test(s))return'YELLOW ROOM';if(/blau|blue/.test(s))return'BLUE ROOM';return''}
function parse(){const root=document.getElementById('eversports-probe');if(!root)return[];const out=[],seen=new Set();for(const el of root.querySelectorAll('*')){const t=text(el);if(t.length<5||t.length>320||!(/\b\d{1,2}:\d{2}\b/.test(t)))continue;const m=t.match(/\b([01]?\d|2[0-3]):([0-5]\d)\b/);if(!m)continue;const start=m[0].padStart(5,'0');const title=t.replace(m[0],'').replace(/\b(Uhr|AM|PM)\b/gi,'').trim();const k=start+'|'+title;if(seen.has(k)||!title)continue;seen.add(k);out.push({start,title,room:roomFrom(t)});}return out.slice(0,80)}
function statusNow(){const p=parts(),now=Number(p.hour)*60+Number(p.minute);const live=events.map(e=>({...e,delta:min(e.start)-now})).filter(e=>e.delta<=0&&e.delta>=-WINDOW);if(live.length)return{type:'live',classes:live.sort((a,b)=>a.delta-b.delta)};const next=events.map(e=>({...e,delta:min(e.start)-now})).filter(e=>e.delta>=0&&e.delta<=WINDOW).sort((a,b)=>a.delta-b.delta);if(!next.length)return null;const t=next[0].start;return{type:'next',classes:next.filter(e=>e.start===t)} }
function show(name,seconds=SHOW){Object.entries(scenes).forEach(([k,v])=>v.classList.toggle('active',k===name)); if(name==='video')video.play().catch(()=>{});else video.pause();clearTimeout(timer);timer=setTimeout(()=>show('video',40),seconds*1000)}
function render(state){const cls=state.classes.slice(0,3);if(cls.length===1){const e=cls[0],p=posterFor(e.title);document.getElementById('single-bg').src=p.src;document.getElementById('single-img').src=p.src;document.getElementById('single-title').textContent=e.title;document.getElementById('single-time').textContent=e.start;document.getElementById('single-room').textContent=e.room||'ELITE DANCE STUDIO';const info=document.getElementById('single-info');info.classList.toggle('live',state.type==='live');info.classList.toggle('next',state.type==='next');document.getElementById('single-status').textContent=state.type==='live'?'LIVE NOW':'NEXT CLASS';show('single');return}
const grid=document.getElementById('multi-grid');grid.style.setProperty('--count',cls.length);document.getElementById('multi-title').textContent=state.type==='live'?'CLASSES LIVE NOW':'NEXT CLASSES';document.getElementById('multi-live').style.display=state.type==='live'?'flex':'none';grid.replaceChildren(...cls.map(e=>{const card=document.createElement('div');card.className='card';const p=posterFor(e.title);const img=document.createElement('img');img.src=p.src;const copy=document.createElement('div');copy.className='card-copy';const strong=document.createElement('strong');strong.textContent=e.title;const span=document.createElement('span');span.textContent=[e.start,e.room].filter(Boolean).join(' · ');copy.append(strong,span);card.append(img,copy);return card}));show('multi')}
function demo(){const mode=new URLSearchParams(location.search).get('demo');if(!mode)return false;const sample=mode==='live'?{type:'live',classes:[{title:'Reggaeton Beginner',start:'18:00',room:'BLACK ROOM'},{title:'Zouk Beginner',start:'18:00',room:'YELLOW ROOM'}]}:{type:'next',classes:[{title:'Bachata Beginner',start:'20:00',room:'BLACK ROOM'}]};render(sample);return true}
const obs=new MutationObserver(()=>{events=parse()});obs.observe(document.getElementById('eversports-probe'),{childList:true,subtree:true,characterData:true});setInterval(()=>{events=parse();if(demo())return;const s=statusNow();if(!s)return;const p=parts(),bucket=Math.floor((Number(p.hour)*60+Number(p.minute))/REPEAT),key=s.type+'|'+s.classes.map(c=>c.start+c.title).join('|')+'|'+bucket;if(key!==lastKey){lastKey=key;render(s)}},30000);updateClock();setInterval(updateClock,1000);setTimeout(()=>{events=parse();demo()},2500)})();
</script>
</body>
</html>