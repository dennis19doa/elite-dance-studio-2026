---
import tvMedia from "../data/tv-media.json";
const base = import.meta.env.BASE_URL ?? "/";
const localMedia = (path: string) => `${base}media/${path}`;
const tvMediaBase = (import.meta.env.PUBLIC_TV_MEDIA_BASE_URL || "https://pub-78965290644946caade1e59ed21bf9ce.r2.dev/tv").replace(/\/+$/, "");
const remoteMedia = (path: string) => `${tvMediaBase}/${path.split("/").map(encodeURIComponent).join("/")}`;
const posters = tvMedia.posters.map((item) => ({ ...item, src: remoteMedia(item.file) }));
const videos = tvMedia.videos.map(remoteMedia);
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="robots" content="noindex,nofollow" />
<title>Elite TV v2</title>
<style>
:root{color-scheme:dark;font-family:Inter,system-ui,sans-serif;background:#050505;color:#fff}*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;overflow:hidden;background:#050505}.tv{position:relative;width:100vw;height:100vh;overflow:hidden}.scene{position:absolute;inset:0;opacity:0;pointer-events:none;transition:opacity .55s ease}.scene.active{opacity:1}.video video{width:100%;height:100%;object-fit:cover}.shade{position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,.08),rgba(0,0,0,.04) 62%,rgba(0,0,0,.45))}.clock{position:absolute;top:3vh;right:3vw;text-align:right;font-size:clamp(24px,3vw,52px);font-weight:900}.clock span{display:block;font-size:.32em;letter-spacing:.16em;opacity:.7;margin-top:.45rem}.class-scene{background:#040404;padding:3vh 3vw;display:flex;flex-direction:column;gap:2.2vh}.class-header{display:flex;align-items:center;justify-content:space-between;gap:2vw;flex:0 0 auto}.class-header h1{margin:0;font-size:clamp(34px,4.5vw,78px);line-height:.94;letter-spacing:-.04em;text-transform:uppercase}.status{display:inline-flex;align-items:center;gap:.7rem;font-size:clamp(16px,1.5vw,26px);font-weight:900;text-transform:uppercase;letter-spacing:.14em;white-space:nowrap}.dot{width:.8em;height:.8em;border-radius:50%;background:#fff}.live .dot{background:#ff2b2b;box-shadow:0 0 0 0 rgba(255,43,43,.85);animation:pulse 1.1s infinite}.live .status{color:#ff4b4b}.next .status{color:#fff}.single-poster-wrap{flex:1;min-height:0;display:flex;align-items:center;justify-content:center;overflow:hidden;padding:1vh 3vw 2vh}.poster-main{width:auto;height:auto;max-width:78%;max-height:82%;object-fit:contain;object-position:center;display:block}.multi{display:grid;grid-template-columns:repeat(var(--count,2),minmax(0,1fr));gap:3vw;height:100%;min-height:0;padding:1vh 2vw 2vh}.card{min-width:0;min-height:0;display:flex;flex-direction:column;align-items:center;gap:1.5vh;background:#040404}.card-head{width:82%;display:flex;align-items:flex-start;justify-content:space-between;gap:1.2vw;flex:0 0 auto}.card-head strong{font-size:clamp(24px,2.6vw,48px);line-height:.95;letter-spacing:-.035em;text-transform:uppercase}.card-poster{width:100%;flex:1;min-height:0;display:flex;align-items:center;justify-content:center;overflow:hidden}.card-poster img{width:auto;height:auto;max-width:80%;max-height:84%;object-fit:contain;object-position:center;display:block}.probe{position:fixed;left:-10000px;top:0;width:1400px;min-height:900px;opacity:.001;pointer-events:none}@keyframes pulse{0%{box-shadow:0 0 0 0 rgba(255,43,43,.75);opacity:1}70%{box-shadow:0 0 0 18px rgba(255,43,43,0);opacity:.45}100%{box-shadow:0 0 0 0 rgba(255,43,43,0);opacity:1}}@media(max-aspect-ratio:4/3){.class-header{align-items:flex-start}.multi{grid-template-columns:1fr}.card{min-height:0}.card-head{width:92%}.card-poster img{max-width:88%;max-height:80%}.poster-main{max-width:88%;max-height:80%}}
</style>
</head>
<body>
<main class="tv">
<section class="scene video active" id="video-scene"><video id="video" autoplay muted playsinline loop></video><div class="shade"></div><div class="clock"><strong id="clock">--:--</strong><span id="day">BERLIN</span></div></section>
<section class="scene class-scene" id="single-scene"><div class="class-header"><h1 id="single-title">Class</h1><div class="live" id="single-info"><div class="status"><span class="dot"></span><span id="single-status">LIVE</span></div></div></div><div class="single-poster-wrap"><img class="poster-main" id="single-img" alt=""></div></section>
<section class="scene class-scene" id="multi-scene"><div class="multi" id="multi-grid"></div></section>
<div class="probe"><div id="eversports-probe" data-eversports-widget-id="061d6c37-61a5-4378-8453-714ce19d595c"></div></div>
</main>
<script type="module" src="https://widget-static.eversports.io/loader.js"></script>
<script is:inline define:vars={{ posters, videos }}>
(()=>{
const TZ="Europe/Berlin", WINDOW=15, REPEAT=2, SHOW=12; const video=document.getElementById('video'); if(videos.length) video.src=videos[0];
const scenes={video:document.getElementById('video-scene'),single:document.getElementById('single-scene'),multi:document.getElementById('multi-scene')};
let events=[],lastKey='',timer=null,posterIndex=0;
const norm=(s='')=>s.toLowerCase().replace(/[^a-z0-9äöüß+]+/gi,' ').replace(/\s+/g,' ').trim();
const posterFor=(title='')=>posters.find(p=>[p.title,...(p.aliases||[])].some(a=>{a=norm(a);const n=norm(title);return a&&(n.includes(a)||a.includes(n))}))||posters[posterIndex++%posters.length];
const text=el=>(el?.innerText||el?.textContent||'').replace(/\s+/g,' ').trim();
const parts=()=>Object.fromEntries(new Intl.DateTimeFormat('en-GB',{timeZone:TZ,weekday:'long',hour:'2-digit',minute:'2-digit',hour12:false}).formatToParts(new Date()).map(p=>[p.type,p.value]));
const min=t=>{const[h,m]=t.split(':').map(Number);return h*60+m};
function updateClock(){const p=parts();document.getElementById('clock').textContent=`${p.hour}:${p.minute}`;document.getElementById('day').textContent=`${p.weekday} · BERLIN`}
function roomFrom(s=''){s=s.toLowerCase();if(/schwarz|black/.test(s))return'BLACK ROOM';if(/gelb|yellow/.test(s))return'YELLOW ROOM';if(/blau|blue/.test(s))return'BLUE ROOM';return''}
function parse(){const root=document.getElementById('eversports-probe');if(!root)return[];const out=[],seen=new Set();for(const el of root.querySelectorAll('*')){const t=text(el);if(t.length<5||t.length>320||!(/\b\d{1,2}:\d{2}\b/.test(t)))continue;const m=t.match(/\b([01]?\d|2[0-3]):([0-5]\d)\b/);if(!m)continue;const start=m[0].padStart(5,'0');const title=t.replace(m[0],'').replace(/\b(Uhr|AM|PM)\b/gi,'').trim();const k=start+'|'+title;if(seen.has(k)||!title)continue;seen.add(k);out.push({start,title,room:roomFrom(t)});}return out.slice(0,80)}
function statusNow(){const p=parts(),now=Number(p.hour)*60+Number(p.minute);const live=events.map(e=>({...e,delta:min(e.start)-now})).filter(e=>e.delta<=0&&e.delta>=-WINDOW);if(live.length)return{type:'live',classes:live.sort((a,b)=>a.delta-b.delta)};const next=events.map(e=>({...e,delta:min(e.start)-now})).filter(e=>e.delta>=0&&e.delta<=WINDOW).sort((a,b)=>a.delta-b.delta);if(!next.length)return null;const t=next[0].start;return{type:'next',classes:next.filter(e=>e.start===t)} }
function show(name,seconds=SHOW){Object.entries(scenes).forEach(([k,v])=>v.classList.toggle('active',k===name)); if(name==='video')video.play().catch(()=>{});else video.pause();clearTimeout(timer);timer=setTimeout(()=>show('video',40),seconds*1000)}
function render(state){const cls=state.classes.slice(0,3);if(cls.length===1){const e=cls[0],p=posterFor(e.title);document.getElementById('single-img').src=p.src;document.getElementById('single-title').textContent=e.title;const info=document.getElementById('single-info');info.classList.toggle('live',state.type==='live');info.classList.toggle('next',state.type==='next');document.getElementById('single-status').textContent=state.type==='live'?'LIVE':'NEXT';show('single');return}
const grid=document.getElementById('multi-grid');grid.style.setProperty('--count',cls.length);grid.replaceChildren(...cls.map(e=>{const card=document.createElement('div');card.className=`card ${state.type}`;const head=document.createElement('div');head.className='card-head';const strong=document.createElement('strong');strong.textContent=e.title;const status=document.createElement('div');status.className='status';const dot=document.createElement('span');dot.className='dot';const label=document.createElement('span');label.textContent=state.type==='live'?'LIVE':'NEXT';status.append(dot,label);head.append(strong,status);const wrap=document.createElement('div');wrap.className='card-poster';const p=posterFor(e.title);const img=document.createElement('img');img.src=p.src;img.alt=e.title;wrap.append(img);card.append(head,wrap);return card}));show('multi')}
function demo(){const mode=new URLSearchParams(location.search).get('demo');if(!mode)return false;const sample=mode==='live'?{type:'live',classes:[{title:'Reggaeton Beginner',start:'18:00',room:'BLACK ROOM'},{title:'Zouk Beginner',start:'18:00',room:'YELLOW ROOM'}]}:{type:'next',classes:[{title:'Bachata Beginner',start:'20:00',room:'BLACK ROOM'}]};render(sample);return true}
const obs=new MutationObserver(()=>{events=parse()});obs.observe(document.getElementById('eversports-probe'),{childList:true,subtree:true,characterData:true});setInterval(()=>{events=parse();if(demo())return;const s=statusNow();if(!s)return;const p=parts(),bucket=Math.floor((Number(p.hour)*60+Number(p.minute))/REPEAT),key=s.type+'|'+s.classes.map(c=>c.start+c.title).join('|')+'|'+bucket;if(key!==lastKey){lastKey=key;render(s)}},30000);updateClock();setInterval(updateClock,1000);setTimeout(()=>{events=parse();demo()},2500)})();
</script>
</body>
</html>
