---
const base = import.meta.env.BASE_URL ?? "/";
const media = (path: string) => `${base}media/${path}`;

const posters = [
  ["Heels Beginner", "style-posters/01-heels-beginner.webp"],
  ["K-Pop Beginner", "style-posters/02-kpop-beginner.webp"],
  ["House Beginner", "style-posters/03-house-beginner.webp"],
  ["Zouk Beginner", "style-posters/04-zouk-beginner.webp"],
  ["Breaking", "style-posters/05-breaking.webp"],
  ["Hip Hop Beginner", "style-posters/06-hip-hop-beginner-amy.webp"],
  ["Latin Commercial", "style-posters/07-latin-commercial.webp"],
  ["Heels Intermediate", "style-posters/08-high-heels-intermediate.webp"],
  ["Reggaeton Fundamentals", "style-posters/09-reggaeton-fundamentals.webp"],
  ["Kizomba", "style-posters/12-kizomba.webp"],
  ["Commercial Beginner+", "style-posters/13-commercial-beginner-plus-dima.webp"],
  ["Contemporary Fusion", "style-posters/15-contemporary-fusion.webp"],
  ["Bachata Intermediate", "style-posters/19-bachata-intermediate.webp"],
  ["Bachata Beginner", "style-posters/20-bachata-beginner.webp"],
  ["Bachata Footwork", "style-posters/21-bachata-footwork.webp"],
  ["Reggaeton Beginner", "style-posters/22-reggaeton-beginner.webp"],
  ["Reggaeton Beg/Int", "style-posters/23-reggaeton-beginner-intermediate.webp"],
].map(([title, src]) => ({ title, src: media(src) }));

const video = media("hero/elite-homepage-video-medium.mp4");
const logo = media("current-site/elite-logo.webp");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="theme-color" content="#050505" />
    <title>Elite TV</title>
    <style>
      :root {
        color-scheme: dark;
        font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        background: #050505;
        color: #fff;
      }
      * { box-sizing: border-box; }
      html, body { width: 100%; height: 100%; margin: 0; overflow: hidden; background: #050505; }
      body { cursor: none; }
      .tv { position: relative; width: 100vw; height: 100vh; overflow: hidden; background: #050505; }
      .scene { position: absolute; inset: 0; opacity: 0; pointer-events: none; transition: opacity 700ms ease; }
      .scene.active { opacity: 1; pointer-events: auto; }
      .video-scene video { width: 100%; height: 100%; object-fit: cover; background: #000; }
      .video-shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(0,0,0,.12), transparent 55%, rgba(0,0,0,.7)); pointer-events: none; }
      .brand { position: absolute; top: 3.8vh; left: 3.2vw; z-index: 5; width: min(15vw, 250px); filter: drop-shadow(0 4px 18px rgba(0,0,0,.5)); }
      .clock { position: absolute; top: 4.4vh; right: 3.4vw; z-index: 5; text-align: right; text-shadow: 0 3px 18px rgba(0,0,0,.8); }
      .clock strong { display: block; font-size: clamp(28px, 3vw, 56px); line-height: .95; letter-spacing: -.04em; }
      .clock span { display: block; margin-top: .45rem; font-size: clamp(12px, 1.1vw, 20px); text-transform: uppercase; letter-spacing: .18em; opacity: .8; }
      .ticker { position: absolute; left: 3.2vw; right: 3.2vw; bottom: 3.8vh; z-index: 6; display: flex; gap: 1.25rem; align-items: center; padding: 1rem 1.25rem; border: 1px solid rgba(255,255,255,.18); background: rgba(5,5,5,.68); backdrop-filter: blur(16px); border-radius: 18px; }
      .ticker-label { flex: 0 0 auto; font-weight: 800; text-transform: uppercase; letter-spacing: .14em; font-size: clamp(11px, .95vw, 17px); opacity: .68; }
      .ticker-copy { min-width: 0; font-size: clamp(18px, 1.65vw, 31px); font-weight: 750; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

      .poster-scene { display: grid; grid-template-columns: 46% 54%; background: #070707; }
      .poster-image { width: 100%; height: 100%; object-fit: cover; object-position: center; }
      .poster-copy { display: flex; flex-direction: column; justify-content: center; padding: 7vw; position: relative; overflow: hidden; }
      .poster-copy::before { content: ""; position: absolute; width: 38vw; height: 38vw; border-radius: 50%; border: 1px solid rgba(255,255,255,.08); right: -17vw; top: -10vw; }
      .eyebrow { font-size: clamp(14px, 1.25vw, 23px); text-transform: uppercase; letter-spacing: .22em; opacity: .62; font-weight: 750; }
      .poster-copy h1 { margin: 1.5rem 0 1rem; max-width: 10ch; font-size: clamp(52px, 6.6vw, 126px); line-height: .86; letter-spacing: -.065em; text-transform: uppercase; }
      .poster-copy p { margin: 0; max-width: 32ch; font-size: clamp(20px, 2vw, 38px); line-height: 1.25; color: rgba(255,255,255,.78); }

      .reminder-scene { background: radial-gradient(circle at 25% 25%, rgba(121,74,255,.3), transparent 34%), #050505; display: flex; flex-direction: column; justify-content: center; padding: 7vw; }
      .reminder-top { display: flex; align-items: center; gap: 1rem; margin-bottom: 3.3vh; font-weight: 900; text-transform: uppercase; letter-spacing: .2em; font-size: clamp(14px, 1.35vw, 25px); }
      .live-dot { width: .8em; height: .8em; border-radius: 50%; background: #fff; box-shadow: 0 0 0 8px rgba(255,255,255,.08); }
      .reminder-scene h1 { margin: 0; font-size: clamp(58px, 7.5vw, 150px); line-height: .82; letter-spacing: -.07em; text-transform: uppercase; }
      .reminder-time { margin-top: 2vh; font-size: clamp(34px, 4.4vw, 82px); font-weight: 300; letter-spacing: -.04em; }
      .class-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.2vw; margin-top: 4.5vh; }
      .class-card { min-width: 0; padding: 1.5vw; border: 1px solid rgba(255,255,255,.18); border-radius: 20px; background: rgba(255,255,255,.06); }
      .class-card strong { display: block; font-size: clamp(24px, 2.5vw, 48px); line-height: 1; }
      .class-card span { display: block; margin-top: .7rem; font-size: clamp(15px, 1.35vw, 25px); opacity: .65; }

      .schedule-scene { padding: 5.5vh 5vw; background: #070707; display: flex; flex-direction: column; }
      .schedule-head { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 3vh; }
      .schedule-head h1 { margin: 0; font-size: clamp(50px, 6vw, 112px); line-height: .9; letter-spacing: -.06em; text-transform: uppercase; }
      .schedule-head p { margin: 0 0 .5rem; font-size: clamp(18px, 1.5vw, 28px); color: rgba(255,255,255,.55); }
      .schedule-frame { flex: 1; min-height: 0; overflow: hidden; position: relative; border: 1px solid rgba(255,255,255,.12); border-radius: 24px; background: #fff; color: #111; }
      .schedule-frame-inner { width: 100%; height: 100%; overflow: auto; scrollbar-width: none; }
      .schedule-frame-inner::-webkit-scrollbar { display: none; }
      #eversports-live { min-height: 100%; }

      .source-probe { position: fixed; left: -10000px; top: 0; width: 1400px; min-height: 900px; opacity: .001; pointer-events: none; }
      .debug { display: none; position: absolute; inset: 2vh 2vw; z-index: 50; overflow: auto; background: rgba(0,0,0,.94); padding: 2rem; border: 1px solid #444; white-space: pre-wrap; font: 15px/1.45 ui-monospace, SFMono-Regular, Menlo, monospace; cursor: auto; }
      .debug.active { display: block; }
      @media (max-aspect-ratio: 4/3) {
        .poster-scene { grid-template-columns: 1fr; }
        .poster-image { position: absolute; inset: 0; opacity: .42; }
        .poster-copy { z-index: 1; }
        .class-grid { grid-template-columns: 1fr; }
      }
      @media (prefers-reduced-motion: reduce) { .scene { transition: none; } }
    </style>
  </head>
  <body>
    <main class="tv" id="tv-root">
      <section class="scene video-scene active" id="scene-video" aria-label="Studio video">
        <video id="main-video" src={video} autoplay muted loop playsinline preload="auto"></video>
        <div class="video-shade"></div>
        <img class="brand" src={logo} alt="Elite Dance Studio" />
        <div class="clock"><strong id="clock-time">--:--</strong><span id="clock-day">Berlin</span></div>
        <div class="ticker">
          <span class="ticker-label">Elite Dance Studio</span>
          <span class="ticker-copy" id="ticker-copy">Dance · Train · Connect</span>
        </div>
      </section>

      <section class="scene poster-scene" id="scene-poster" aria-label="Class recommendation">
        <img class="poster-image" id="poster-image" src={posters[0].src} alt="" />
        <div class="poster-copy">
          <div class="eyebrow">Try another class</div>
          <h1 id="poster-title">{posters[0].title}</h1>
          <p>More than one style. One studio. Find your next class at Elite.</p>
        </div>
      </section>

      <section class="scene reminder-scene" id="scene-reminder" aria-label="Upcoming classes">
        <div class="reminder-top"><span class="live-dot"></span><span id="reminder-label">Starting soon</span></div>
        <h1 id="reminder-heading">Classes starting soon</h1>
        <div class="reminder-time" id="reminder-time"></div>
        <div class="class-grid" id="reminder-grid"></div>
      </section>

      <section class="scene schedule-scene" id="scene-schedule" aria-label="Live weekly schedule">
        <div class="schedule-head">
          <div><div class="eyebrow">Live schedule</div><h1>This week at Elite</h1></div>
          <p>Updated through our booking calendar</p>
        </div>
        <div class="schedule-frame">
          <div class="schedule-frame-inner">
            <div id="eversports-live" data-eversports-widget-id="061d6c37-61a5-4378-8453-714ce19d595c"></div>
          </div>
        </div>
      </section>

      <div class="source-probe" aria-hidden="true">
        <div id="eversports-probe" data-eversports-widget-id="061d6c37-61a5-4378-8453-714ce19d595c"></div>
      </div>
      <pre class="debug" id="debug-panel"></pre>
    </main>

    <script type="module" src="https://widget-static.eversports.io/loader.js"></script>
    <script is:inline define:vars={{ posters }}>
      (() => {
        const VIDEO_SECONDS = 48;
        const POSTER_SECONDS = 10;
        const SCHEDULE_SECONDS = 18;
        const REMINDER_SECONDS = 11;
        const REMINDER_WINDOW_MINUTES = 15;
        const REMINDER_REPEAT_MINUTES = 2;
        const TZ = "Europe/Berlin";

        const scenes = {
          video: document.getElementById("scene-video"),
          poster: document.getElementById("scene-poster"),
          reminder: document.getElementById("scene-reminder"),
          schedule: document.getElementById("scene-schedule")
        };
        const videoEl = document.getElementById("main-video");
        const ticker = document.getElementById("ticker-copy");
        const posterImage = document.getElementById("poster-image");
        const posterTitle = document.getElementById("poster-title");
        const reminderTime = document.getElementById("reminder-time");
        const reminderGrid = document.getElementById("reminder-grid");
        const debugPanel = document.getElementById("debug-panel");
        const probe = document.getElementById("eversports-probe");
        const live = document.getElementById("eversports-live");

        let sceneTimer = null;
        let rotationIndex = 0;
        let posterIndex = 0;
        let parsedEvents = [];
        let lastReminderKey = "";

        const rotation = ["video", "poster", "video", "schedule", "video", "poster"];

        function berlinParts(date = new Date()) {
          const parts = new Intl.DateTimeFormat("en-GB", {
            timeZone: TZ, weekday: "long", year: "numeric", month: "2-digit", day: "2-digit",
            hour: "2-digit", minute: "2-digit", hour12: false
          }).formatToParts(date);
          return Object.fromEntries(parts.map(p => [p.type, p.value]));
        }

        function updateClock() {
          const p = berlinParts();
          document.getElementById("clock-time").textContent = `${p.hour}:${p.minute}`;
          document.getElementById("clock-day").textContent = `${p.weekday} · Berlin`;
        }

        function showScene(name, durationSeconds) {
          Object.entries(scenes).forEach(([key, el]) => el.classList.toggle("active", key === name));
          if (name === "video") videoEl?.play().catch(() => {});
          else videoEl?.pause();
          clearTimeout(sceneTimer);
          sceneTimer = setTimeout(nextScene, durationSeconds * 1000);
        }

        function nextScene() {
          const reminder = getUpcomingReminder();
          if (reminder && reminder.key !== lastReminderKey) {
            lastReminderKey = reminder.key;
            renderReminder(reminder);
            showScene("reminder", REMINDER_SECONDS);
            return;
          }

          const name = rotation[rotationIndex % rotation.length];
          rotationIndex += 1;
          if (name === "poster") {
            const item = posters[posterIndex % posters.length];
            posterIndex += 1;
            posterImage.src = item.src;
            posterTitle.textContent = item.title;
            showScene("poster", POSTER_SECONDS);
          } else if (name === "schedule") {
            showScene("schedule", SCHEDULE_SECONDS);
          } else {
            ticker.textContent = parsedEvents.length ? "Live timetable connected · schedule updates automatically" : "Dance · Train · Connect · Berlin-Moabit";
            showScene("video", VIDEO_SECONDS);
          }
        }

        function compactText(el) {
          return (el?.innerText || el?.textContent || "").replace(/\s+/g, " ").trim();
        }

        function dateKeyFromText(text) {
          const days = ["monday","tuesday","wednesday","thursday","friday","saturday","sunday","montag","dienstag","mittwoch","donnerstag","freitag","samstag","sonntag"];
          const lower = text.toLowerCase();
          return days.find(day => lower.includes(day)) || "";
        }

        function parseWidget(root) {
          if (!root) return [];
          const candidates = [...root.querySelectorAll("*")]
            .map(el => ({ el, text: compactText(el) }))
            .filter(x => x.text.length >= 5 && x.text.length <= 320 && /\b\d{1,2}:\d{2}\b/.test(x.text));

          const leafish = candidates.filter(item => {
            const nested = [...item.el.children].some(child => {
              const t = compactText(child);
              return t && t !== item.text && /\b\d{1,2}:\d{2}\b/.test(t) && t.length < item.text.length * .85;
            });
            return !nested;
          });

          const seen = new Set();
          const events = [];
          for (const item of leafish) {
            const times = [...item.text.matchAll(/\b([01]?\d|2[0-3]):([0-5]\d)\b/g)].map(m => m[0]);
            if (!times.length) continue;
            const start = times[0].padStart(5, "0");
            const signature = `${start}|${item.text}`;
            if (seen.has(signature)) continue;
            seen.add(signature);

            let context = item.text;
            let parent = item.el.parentElement;
            for (let i = 0; i < 4 && parent; i += 1, parent = parent.parentElement) {
              const t = compactText(parent);
              if (t.length > context.length && t.length < 900) context += ` ${t}`;
            }
            const day = dateKeyFromText(context);
            const title = item.text
              .replace(/\b([01]?\d|2[0-3]):([0-5]\d)\b/g, "")
              .replace(/\b(AM|PM|Uhr)\b/gi, "")
              .replace(/\s{2,}/g, " ")
              .trim();
            if (!title || title.length > 240) continue;
            events.push({ start, title, day, raw: item.text });
          }
          return events.slice(0, 80);
        }

        const dayAliases = {
          monday: ["monday","montag"], tuesday: ["tuesday","dienstag"], wednesday: ["wednesday","mittwoch"],
          thursday: ["thursday","donnerstag"], friday: ["friday","freitag"], saturday: ["saturday","samstag"], sunday: ["sunday","sonntag"]
        };

        function minutesOf(time) {
          const [h, m] = time.split(":").map(Number);
          return h * 60 + m;
        }

        function currentDayMatches(eventDay, weekday) {
          if (!eventDay) return true;
          const aliases = dayAliases[weekday.toLowerCase()] || [weekday.toLowerCase()];
          return aliases.includes(eventDay);
        }

        function getUpcomingReminder() {
          if (!parsedEvents.length) return null;
          const p = berlinParts();
          const nowMin = Number(p.hour) * 60 + Number(p.minute);
          const relevant = parsedEvents
            .filter(e => currentDayMatches(e.day, p.weekday))
            .map(e => ({ ...e, delta: minutesOf(e.start) - nowMin }))
            .filter(e => e.delta >= 0 && e.delta <= REMINDER_WINDOW_MINUTES)
            .sort((a,b) => a.delta - b.delta || a.start.localeCompare(b.start));
          if (!relevant.length) return null;
          const nearest = relevant[0];
          const sameStart = relevant.filter(e => e.start === nearest.start);
          const minuteBucket = Math.floor(nowMin / REMINDER_REPEAT_MINUTES);
          return { key: `${p.year}-${p.month}-${p.day}|${nearest.start}|${minuteBucket}`, start: nearest.start, delta: nearest.delta, classes: sameStart };
        }

        function renderReminder(reminder) {
          document.getElementById("reminder-label").textContent = reminder.delta === 0 ? "Starting now" : `Starting in ${reminder.delta} min`;
          document.getElementById("reminder-heading").textContent = reminder.classes.length > 1 ? "Choose your class" : "Your class is starting";
          reminderTime.textContent = reminder.start;
          reminderGrid.replaceChildren(...reminder.classes.slice(0, 3).map(event => {
            const card = document.createElement("div");
            card.className = "class-card";
            const strong = document.createElement("strong");
            strong.textContent = event.title;
            const span = document.createElement("span");
            span.textContent = event.start;
            card.append(strong, span);
            return card;
          }));
        }

        function refreshParsedEvents() {
          const fromProbe = parseWidget(probe);
          const fromLive = parseWidget(live);
          const combined = [...fromProbe, ...fromLive];
          const unique = new Map(combined.map(e => [`${e.start}|${e.title}|${e.day}`, e]));
          parsedEvents = [...unique.values()];
          updateDebug();
        }

        function updateDebug() {
          if (!new URLSearchParams(location.search).has("debug")) return;
          debugPanel.classList.add("active");
          document.body.style.cursor = "auto";
          debugPanel.textContent = [
            "ELITE TV DEBUG",
            "",
            `Parsed events: ${parsedEvents.length}`,
            JSON.stringify(parsedEvents, null, 2),
            "",
            "PROBE TEXT:",
            compactText(probe).slice(0, 12000),
            "",
            "LIVE WIDGET TEXT:",
            compactText(live).slice(0, 12000)
          ].join("\n");
        }

        const observer = new MutationObserver(() => {
          window.clearTimeout(observer._timer);
          observer._timer = window.setTimeout(refreshParsedEvents, 600);
        });
        [probe, live].filter(Boolean).forEach(el => observer.observe(el, { childList: true, subtree: true, characterData: true }));

        window.setInterval(updateClock, 1000);
        window.setInterval(() => {
          refreshParsedEvents();
          const reminder = getUpcomingReminder();
          if (reminder && reminder.key !== lastReminderKey && !scenes.reminder.classList.contains("active")) {
            lastReminderKey = reminder.key;
            renderReminder(reminder);
            showScene("reminder", REMINDER_SECONDS);
          }
        }, 30000);

        document.addEventListener("visibilitychange", () => {
          if (!document.hidden && scenes.video.classList.contains("active")) videoEl?.play().catch(() => {});
        });

        updateClock();
        setTimeout(refreshParsedEvents, 3000);
        setTimeout(nextScene, VIDEO_SECONDS * 1000);
      })();
    </script>
  </body>
</html>
