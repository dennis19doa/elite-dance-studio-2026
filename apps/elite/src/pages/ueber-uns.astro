---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";

import site from "../data/site.json";
---

<BaseLayout
  title="Über uns | Elite Dance Studio Berlin"
  description="Lerne Elite Dance Studio Berlin kennen: 25+ Tanzstyles, starke Coaches, Socials, Community und persönlicher Fortschritt in Berlin-Moabit."
  image="/media/placeholders/community-beginners.jpg"
  bodyClass="about-page-v3"
>
  <SiteHeader brand={site.brand} nav={site.nav} />

  <main class="page-shell page-main about-main-v3">
    <section class="about-cinematic-v3">
      <figure>
        <img src="/media/placeholders/community-beginners.jpg" alt="Community im Elite Dance Studio Berlin" width="1536" height="1024" />
      </figure>
      <div class="about-cinematic-copy">
        <div class="eyebrow">Elite Dance Studio · Berlin-Moabit</div>
        <h1 class="page-title">Come to dance. Stay for the feeling.</h1>
        <p>25+ Styles, starke Coaches und eine Community, in der du auch allein anfangen kannst.</p>
        <div class="actions">
          <a class="button primary" href="/stundenplan/">Class finden</a>
          <a class="button secondary" href="/coaches/">Coaches ansehen</a>
        </div>
      </div>
    </section>

    <section class="about-manifesto-v3 about-manifesto-v4">
      <span>Warum Elite</span>
      <h2>Professionelles Training darf sich persönlich, lebendig und offen anfühlen.</h2>
      <p>
        Elite ist aus der Idee entstanden, dass Menschen mit ganz unterschiedlichen Erfahrungen
        gemeinsam trainieren können – ohne anonyme Massenabfertigung und ohne das Gefühl, schon
        perfekt sein zu müssen. Du sollst ausprobieren, Fragen stellen, Fortschritt spüren und
        deinen eigenen Weg im Tanzen finden können.
      </p>
    </section>

    <section class="about-story-grid-v4">
      <div class="about-story-copy-v4">
        <div class="eyebrow">Training mit Haltung</div>
        <h2>Mehr als Choreografie lernen.</h2>
        <p>
          Uns geht es um klare Technik, Musikalität, Körpergefühl und ehrliches Feedback – aber
          genauso um die Atmosphäre im Raum. Gutes Training entsteht dort, wo du dich sicher genug
          fühlst, wirklich auszuprobieren und gleichzeitig gefordert wirst.
        </p>
        <p>
          Deshalb findest du bei uns Level 0 und Beginner genauso selbstverständlich wie
          Intermediate, Advanced, Closed Groups und Intensives. Fortschritt soll einen Weg haben,
          aber nicht für alle gleich aussehen.
        </p>
        <a class="text-link" href="/kurse/">Unsere Kurse & Styles entdecken ↗</a>
      </div>
      <div class="about-story-images-v4">
        <img src="/media/current-site/studio-room-a.jpg" alt="Großer Trainingsraum im Elite Dance Studio" loading="lazy" />
        <img src="/media/current-site/elena-dennis-bachata.png" alt="Tanzmoment im Elite Dance Studio" loading="lazy" />
      </div>
    </section>

    <section class="about-team-v4">
      <div class="about-team-image-v4">
        <img src="/media/current-site/kathy-reggaeton.png" alt="Coach bei Elite Dance Studio" loading="lazy" />
      </div>
      <div class="about-team-copy-v4">
        <div class="eyebrow">Unser Team</div>
        <h2>Starke Coaches machen den Unterschied.</h2>
        <p>
          Ohne ein starkes Team wäre Elite Dance Studio nicht das, was es ist. Unsere Coaches
          bringen Erfahrung, Technik und echte Energie in den Raum. Wir wählen unser Team mit viel
          Bedacht aus, damit du dich sicher fühlst, Spaß hast und Schritt für Schritt besser wirst.
        </p>
        <p>
          Unterschiedliche Styles brauchen unterschiedliche Persönlichkeiten. Was sie verbindet,
          ist der Anspruch, Wissen verständlich weiterzugeben und Menschen wirklich mitzunehmen.
        </p>
        <a class="button secondary" href="/coaches/">Unser Team kennenlernen</a>
      </div>
    </section>

    <section class="about-community-v4">
      <figure>
        <img src="/media/current-site/elite-party.jpg" alt="Community und Party im Elite Dance Studio" loading="lazy" />
      </figure>
      <div>
        <div class="eyebrow">Dance · Feel · Belong</div>
        <h2>Du kommst wegen eines Styles. Oft bleibst du wegen der Menschen.</h2>
        <p>
          Kurse sind der Anfang. Socials, Workshops, Events und gemeinsame Trainings machen aus
          einem Stundenplan eine Community und aus Tanzen einen Teil deiner Woche.
        </p>
        <a class="text-link" href="/events/">Events & Socials entdecken ↗</a>
      </div>
    </section>

    <section class="about-values-band-v3" aria-label="Elite Dance Studio Eigenschaften">
      <strong>Beginner-friendly</strong>
      <span>25+ Styles</span>
      <strong>Level 0 → Advanced</strong>
      <span>Partner & Solo</span>
      <strong>Community</strong>
    </section>

    <section class="cta-banner home-final-cta">
      <div><div class="eyebrow">Dein nächster Schritt</div><h2>Komm vorbei und erlebe Elite selbst.</h2></div>
      <div class="actions"><a class="button primary" href="/starter-pass/">2 Classes · 20€</a></div>
    </section>
  </main>

  <SiteFooter brand={site.brand} nav={site.nav} />
</BaseLayout>
