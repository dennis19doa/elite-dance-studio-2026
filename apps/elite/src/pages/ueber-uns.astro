---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";

import site from "../data/site.json";
---

<BaseLayout
  title="Über uns | Elite Dance Studio Berlin"
  description="Lerne Elite Dance Studio Berlin kennen: beginner-friendly Tanzkurse, starke Coaches, Socials, Community und persönlicher Fortschritt in Berlin-Moabit."
  image="/media/placeholders/community-beginners.jpg"
>
  <SiteHeader brand={site.brand} nav={site.nav} />

  <main class="page-shell page-main">
    <section class="service-page-hero about-hero panel">
      <div class="service-page-copy">
        <div class="eyebrow">Warum Elite Dance Studio?</div>
        <h1 class="page-title">Dein Ort zum Tanzen in Berlin.</h1>
        <p class="lead">
          Beginner-friendly Kurse, starke Coaches, Socials und Community in Berlin-Moabit. Du
          brauchst keinen festen Tanzpartner. Du brauchst nur den ersten Schritt.
        </p>
        <div class="actions">
          <a class="button primary" href="/starter-pass/">Welcome Pass · 20€</a>
          <a class="button secondary" href="/coaches/">Coaches kennenlernen</a>
        </div>
      </div>
      <figure class="service-page-media about-hero-media">
        <img
          src="/media/placeholders/community-beginners.jpg"
          alt="Offene Tanzgruppe in einer freundlichen Studioatmosphäre"
          width="1536"
          height="1024"
        />
      </figure>
    </section>

    <section class="about-value-grid" aria-label="Was Elite Dance Studio ausmacht">
      <article><span>01</span><h3>Einfach starten</h3><p>Wir helfen dir, den passenden Kurs und das richtige Level zu finden.</p></article>
      <article><span>02</span><h3>Kein Partner nötig</h3><p>Du kannst allein kommen. In vielen Partner-Dance-Kursen wird gewechselt.</p></article>
      <article><span>03</span><h3>Viele Styles</h3><p>Von Bachata und Zouk bis Reggaeton, Heels, K-Pop und Contemporary.</p></article>
      <article><span>04</span><h3>Community</h3><p>Kurse, Socials, Partys und Workshops machen Elite zu mehr als einem Studio.</p></article>
    </section>

    <section class="about-story panel">
      <div class="about-story-copy">
        <div class="eyebrow">Wenn du noch zögerst</div>
        <h2>Du musst nicht perfekt sein, um anzufangen.</h2>
        <p>
          Viele starten mit Unsicherheit. Nach ein paar Stunden merken sie: Tanzen fühlt sich
          leichter an, wenn Raum, Musik und Menschen stimmen.
        </p>
        <p>
          Bei Elite bekommst du klare Orientierung, verständliche Technik und eine Atmosphäre,
          in der du dich bewegen darfst, ohne dich beweisen zu müssen.
        </p>
      </div>
      <div class="about-story-images">
        <img src="/media/current-site/elena-dennis-bachata.png" alt="Elena und Dennis, Bachata Coaches bei Elite Dance Studio" loading="lazy" />
        <img src="/media/current-site/studio-room-a.jpg" alt="Großer Trainingsraum im Elite Dance Studio Berlin" loading="lazy" />
      </div>
    </section>

    <section class="about-journey panel">
      <div class="section-head">
        <div>
          <div class="eyebrow">Dein Weg bei uns</div>
          <h2>Reinkommen, mitmachen, sicherer werden.</h2>
        </div>
        <p>Fortschritt soll sich persönlich und lebendig anfühlen, nicht steif oder anonym.</p>
      </div>
      <div class="about-journey-grid">
        <div><span>01</span><strong>Ankommen</strong><p>Wir zeigen dir den Ablauf und helfen dir beim Einstieg.</p></div>
        <div><span>02</span><strong>Mitmachen</strong><p>Klare Erklärungen, gute Musik und eine offene Gruppe.</p></div>
        <div><span>03</span><strong>Fortschritt spüren</strong><p>Technik, kleine Korrekturen und mehr Vertrauen in deinen Körper.</p></div>
        <div><span>04</span><strong>Community werden</strong><p>Socials, Partys und Workshops machen Tanzen zu deiner Woche.</p></div>
      </div>
    </section>

    <section class="cta-banner panel">
      <div>
        <div class="eyebrow">Dein nächster Schritt</div>
        <h2>Komm vorbei. Wir helfen dir beim Einstieg.</h2>
        <p>Elite ist modern, herzlich und mitten in Moabit.</p>
      </div>
      <div class="actions">
        <a class="button primary" href="/stundenplan/">Klasse finden</a>
        <a class="button secondary" href="/kontakt/">Frage stellen</a>
      </div>
    </section>
  </main>

  <SiteFooter brand={site.brand} nav={site.nav} />
</BaseLayout>
