---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";

import site from "../data/site.json";

const baseUrl = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const scheduleHref = `${baseUrl}#schedule`;
---

<BaseLayout
  title="Über uns | Elite Dance Studio Berlin"
  description="Lerne Elite Dance Studio Berlin kennen: Social Dance, Solo Styles, starke Coaches, Community und persönlicher Fortschritt in Berlin-Moabit."
  image="/media/current-site/current-home-visual.webp"
  bodyClass="about-page-v12 about-page-v18 about-page-editorial-v19"
>
  <SiteHeader brand={site.brand} nav={site.nav} />

  <main class="page-shell page-main about-main-v12 about-main-v18">
    <section class="about-opening-v12">
      <img src="/media/current-site/current-home-visual.webp" alt="Tanzmoment bei Elite Dance in Berlin" />
      <div class="about-opening-shade-v12"></div>
      <div class="about-opening-copy-v12">
        <span>Elite Dance · Berlin-Moabit</span>
        <h1>Come to dance.<br />Stay for the feeling.</h1>
        <p>Social Dance, Solo Styles, Technik und Community – an einem Ort.</p>
      </div>
    </section>

    <section class="about-founders-v12 about-founders-v18 about-founders-magazine-v19">
      <div class="about-founders-quote-v12">
        <span>Founders · Elena & Dennis</span>
        <h2>Social Dance, Solo Styles und eine Community unter einem Dach.</h2>
        <p class="about-editorial-lead-v19">
          Elite ist aus der Idee entstanden, Tanzwelten zusammenzubringen, die oft getrennt voneinander gedacht werden.
        </p>
        <p>
          Unsere Wurzeln liegen im Social Dance und in lateinamerikanischen Tanzstilen. Dort haben wir gelernt,
          wie viel Connection, Musik, Community und Lebensfreude im Tanzen stecken können.
        </p>
        <p>
          Gleichzeitig lieben wir Solo Styles, Technik, Choreografie und die Freiheit, immer wieder etwas Neues auszuprobieren.
          Elite Dance ist daraus entstanden: ein Studio, in dem diese Welten nebeneinander wachsen können.
        </p>
      </div>
      <figure>
        <img src="https://elitedancestudio.de/wp-content/uploads/2025/12/DSC_6145.jpg" alt="Elena und Dennis, Founders von Elite Dance" loading="lazy" decoding="async" />
        <figcaption>Elena & Dennis · Founders of Elite Dance · Berlin</figcaption>
      </figure>
    </section>

    <section class="about-mission-v18 about-editorial-section-v19">
      <div class="eyebrow">Unser Ziel</div>
      <div class="about-mission-grid-v18">
        <h2>Ein Studio, in dem jede Person etwas Neues finden kann.</h2>
        <div>
          <p>
            Vielleicht kommst du wegen Bachata und entdeckst später Contemporary. Vielleicht startest du mit Hip-Hop,
            probierst Heels oder findest in einem Partner Dance plötzlich eine ganz neue Seite an dir.
          </p>
          <p>
            Für uns soll Tanzen nicht nur Training sein. Es darf Begegnung sein, Ausgleich, Herausforderung und einfach ein guter Teil des Lebens.
            Deshalb wollen wir einen Ort schaffen, an dem Menschen neugierig bleiben, sich entwickeln und gemeinsam Spaß am Tanzen haben können.
          </p>
        </div>
      </div>
    </section>

    <section class="about-path-v12 about-editorial-section-v19" aria-label="Dein Weg bei Elite">
      <header>
        <span>Dein Weg muss nicht gerade sein</span>
        <h2>Probieren. Bleiben. Wechseln. Tiefer gehen.</h2>
      </header>

      <div class="about-path-row-v12">
        <strong>Entdecken</strong>
        <p>Viele Styles und unterschiedliche Coaches geben dir Raum, Neues zu testen, ohne dich sofort festlegen zu müssen.</p>
      </div>
      <div class="about-path-row-v12">
        <strong>Wachsen</strong>
        <p>Level 0, Beginner, Intermediate, Advanced, Closed Groups und Intensives geben dir echte nächste Schritte.</p>
      </div>
      <div class="about-path-row-v12">
        <strong>Dazugehören</strong>
        <p>Classes, Events, Socials und das Team gehören zu demselben Studioleben – nicht zu getrennten Produkten.</p>
      </div>
    </section>

    <section class="about-closing-v12">
      <img src="/media/current-site/studio-room-a.jpg" alt="Trainingsraum bei Elite Dance Berlin" loading="lazy" />
      <div class="about-closing-copy-v12">
        <span>Dance · Feel · Belong</span>
        <h2>Finde etwas, das dich bewegt – und einen Ort, an den du gern zurückkommst.</h2>
        <div>
          <a class="button primary" href={scheduleHref}>Class finden</a>
          <a class="button secondary" href="/coaches/">Team kennenlernen</a>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter brand={site.brand} nav={site.nav} />
</BaseLayout>
