---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";

import site from "../data/site.json";

const baseUrl = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const scheduleHref = `${baseUrl}#schedule`;
---

<BaseLayout
  title="Über uns | Elite Dance Studio Berlin"
  description="Lerne Elite Dance Studio Berlin kennen: starke Coaches, viele Styles, Socials, Community und persönlicher Fortschritt in Berlin-Moabit."
  image="/media/current-site/current-home-visual.webp"
  bodyClass="about-page-v12"
>
  <SiteHeader brand={site.brand} nav={site.nav} />

  <main class="page-shell page-main about-main-v12">
    <section class="about-opening-v12">
      <img src="/media/current-site/current-home-visual.webp" alt="Tanzmoment im Elite Dance Studio Berlin" />
      <div class="about-opening-shade-v12"></div>
      <div class="about-opening-copy-v12">
        <span>Elite Dance Studio · Berlin-Moabit</span>
        <h1>Come to dance.<br />Stay for the feeling.</h1>
        <p>Ein Ort zum Ausprobieren, Trainieren, Wachsen und Dazugehören.</p>
      </div>
    </section>

    <section class="about-founders-v12">
      <div class="about-founders-quote-v12">
        <span>Warum es Elite gibt</span>
        <h2>Wir wollten keinen Ort bauen, an dem Menschen nur eine Stunde konsumieren und wieder gehen.</h2>
        <p>
          Elite ist aus der Idee entstanden, dass gutes Training und echte Community zusammengehören.
          Professionell, ohne anonym zu werden. Offen, ohne beliebig zu sein.
        </p>
      </div>
      <figure>
        <img src="/media/current-site/elena-dennis-bachata.png" alt="Elena und Dennis vom Elite Dance Studio Berlin" loading="lazy" />
        <figcaption>Elena & Dennis · Founders</figcaption>
      </figure>
    </section>

    <section class="about-path-v12" aria-label="Dein Weg bei Elite">
      <header>
        <span>Dein Weg muss nicht gerade sein</span>
        <h2>Probieren. Bleiben. Wechseln. Tiefer gehen.</h2>
      </header>

      <div class="about-path-row-v12">
        <strong>Entdecken</strong>
        <p>Du kannst Styles, Coaches und Musikwelten testen, bevor du dich irgendwo festlegst.</p>
      </div>
      <div class="about-path-row-v12">
        <strong>Wachsen</strong>
        <p>Level 0, Beginner, Intermediate, Advanced, Closed Groups und Intensives geben dir echte nächste Schritte.</p>
      </div>
      <div class="about-path-row-v12">
        <strong>Dazugehören</strong>
        <p>Classes, Events, Socials und das Team gehören zu demselben Studioleben – nicht zu getrennten Produkten.</p>
      </div>
    </section>

    <section class="about-closing-v12">
      <img src="/media/current-site/studio-room-a.jpg" alt="Trainingsraum im Elite Dance Studio Berlin" loading="lazy" />
      <div class="about-closing-copy-v12">
        <span>Unser Anspruch</span>
        <h2>Sicher genug, Neues zu probieren. Anspruchsvoll genug, wirklich besser zu werden.</h2>
        <div>
          <a class="button primary" href={scheduleHref}>Class finden</a>
          <a class="button secondary" href="/coaches/">Team kennenlernen</a>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter brand={site.brand} nav={site.nav} />
</BaseLayout>
