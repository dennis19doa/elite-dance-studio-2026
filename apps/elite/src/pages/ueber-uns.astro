---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";

import site from "../data/site.json";
---

<BaseLayout
  title="Über uns | Elite Dance Studio Berlin"
  description="Lerne Elite Dance Studio Berlin kennen: beginner-friendly Tanzkurse, starke Coaches, Socials, Community und persönlicher Fortschritt in Berlin-Moabit."
  image="/media/placeholders/community-beginners.jpg"
  bodyClass="about-page-v3"
>
  <SiteHeader brand={site.brand} nav={site.nav} />

  <main class="page-shell page-main about-main-v3">
    <section class="about-cinematic-v3">
      <figure>
        <img src="/media/placeholders/community-beginners.jpg" alt="Community im Elite Dance Studio Berlin" width="1536" height="1024" />
      </figure>
      <div class="about-cinematic-copy">
        <div class="eyebrow">Elite Dance Studio · Berlin-Moabit</div>
        <h1 class="page-title">Come to dance. Stay for the feeling.</h1>
        <p>25+ Styles, starke Coaches und eine Community, in der du auch allein anfangen kannst.</p>
        <div class="actions">
          <a class="button primary" href="/stundenplan/">Class finden</a>
          <a class="button secondary" href="/coaches/">Coaches ansehen</a>
        </div>
      </div>
    </section>

    <section class="about-manifesto-v3">
      <span>Wofür wir stehen</span>
      <h2>Gutes Training soll sich persönlich, lebendig und nie einschüchternd anfühlen.</h2>
    </section>

    <section class="about-editorial-v3">
      <div class="about-editorial-images">
        <img src="/media/current-site/elena-dennis-bachata.png" alt="Elena und Dennis bei Elite Dance Studio" loading="lazy" />
        <img src="/media/current-site/studio-room-a.jpg" alt="Großer Trainingsraum im Elite Dance Studio" loading="lazy" />
      </div>
      <div class="about-editorial-copy">
        <div class="eyebrow">Learn · Move · Belong</div>
        <h2>Mehr als nur eine Class.</h2>
        <p>Du kommst wegen eines Styles. Mit der Zeit entstehen Technik, Sicherheit und echte Verbindung zur Community.</p>
        <a class="text-link" href="/events/">Events & Socials entdecken ↗</a>
      </div>
    </section>

    <section class="about-values-band-v3" aria-label="Elite Dance Studio Eigenschaften">
      <strong>Beginner-friendly</strong>
      <span>25+ Styles</span>
      <strong>Berlin-Moabit</strong>
      <span>Partner & Solo</span>
      <strong>Community</strong>
    </section>

    <section class="cta-banner home-final-cta">
      <div><div class="eyebrow">Dein nächster Schritt</div><h2>Komm vorbei und erlebe Elite selbst.</h2></div>
      <div class="actions"><a class="button primary" href="/starter-pass/">2 Classes · 20€</a></div>
    </section>
  </main>

  <SiteFooter brand={site.brand} nav={site.nav} />
</BaseLayout>
