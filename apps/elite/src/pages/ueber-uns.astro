---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";

import site from "../data/site.json";
---

<BaseLayout
  title="Über uns | Elite Dance Studio Berlin"
  description="Lerne Elite Dance Studio Berlin kennen: starke Coaches, viele Styles, Socials, Community und persönlicher Fortschritt in Berlin-Moabit."
  image="/media/current-site/current-home-visual.webp"
  bodyClass="site-subpage about-page-v9"
>
  <SiteHeader brand={site.brand} nav={site.nav} />

  <main class="page-shell page-main">
    <section class="about-hero-v9">
      <img src="/media/current-site/current-home-visual.webp" alt="Tanzmoment im Elite Dance Studio Berlin" />
      <div class="about-hero-copy-v9">
        <div class="eyebrow">Elite Dance Studio · Berlin-Moabit</div>
        <h1 class="page-title">Come to dance. Stay for the feeling.</h1>
        <p class="lead">
          Elite ist ein Ort für Training, Ausdruck und Menschen. Du kannst hier anfangen,
          ausprobieren, ernsthaft besser werden und trotzdem du selbst bleiben.
        </p>
        <div class="actions">
          <a class="button primary" href="/#schedule">Class finden</a>
          <a class="button secondary" href="/coaches/">Team kennenlernen</a>
        </div>
      </div>
    </section>

    <section class="about-story-v9">
      <figure>
        <img src="/media/current-site/elena-dennis-bachata.png" alt="Elena und Dennis vom Elite Dance Studio Berlin" loading="lazy" />
      </figure>
      <div class="about-story-copy-v9">
        <div class="eyebrow">Unsere Geschichte</div>
        <h2>Wir wollten keinen Ort bauen, an dem du nur eine Stunde konsumierst.</h2>
        <p>
          Elite ist aus der Idee entstanden, dass gutes Training und echte Community zusammengehören.
          Ein Studio darf professionell sein, ohne unpersönlich zu werden – und offen, ohne beliebig zu sein.
        </p>
        <p>
          Deshalb bringen wir viele unterschiedliche Styles und Persönlichkeiten an einen Ort. Du kannst
          deine Richtung wechseln, neue Coaches kennenlernen oder tiefer trainieren, ohne jedes Mal wieder
          bei null anzufangen.
        </p>
      </div>
    </section>

    <section class="about-teaching-v9">
      <div class="about-teaching-copy-v9">
        <div class="eyebrow">Wie wir unterrichten</div>
        <h2>Technik, Energie und Persönlichkeit gehören zusammen.</h2>
        <p>
          Wir suchen Coaches nicht nur nach Tanzlevel aus. Entscheidend ist auch, ob sie erklären,
          Menschen lesen, Atmosphäre schaffen und ihren Style mit einer klaren eigenen Handschrift vermitteln können.
        </p>
        <p>
          Das Ergebnis soll sich nicht wie ein anonymer Kursplan anfühlen, sondern wie ein Team, in dem du
          schnell merkst, welche Energie zu dir passt.
        </p>
      </div>
      <figure>
        <img src="/media/current-site/studio-room-a.jpg" alt="Großer Trainingsraum im Elite Dance Studio Berlin" loading="lazy" />
      </figure>
    </section>

    <section class="about-statement-v9">
      <div>
        <div class="eyebrow">Was Elite für uns bedeutet</div>
        <h2>Du sollst dich sicher genug fühlen, Neues auszuprobieren – und gut genug trainiert werden, um wirklich Fortschritt zu spüren.</h2>
        <p>Classes, Intensives, Socials, Workshops und ein Team, das dich nicht wie eine Buchungsnummer behandelt.</p>
      </div>
      <div class="actions">
        <a class="button primary" href="/starter-pass/">Welcome Pass · 20€</a>
        <a class="button secondary" href="/events/">Events ansehen</a>
      </div>
    </section>
  </main>

  <SiteFooter brand={site.brand} nav={site.nav} />
</BaseLayout>
